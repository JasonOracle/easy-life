    ①修复旧草稿编译必炸问题（capEndStyle 括号不配对、badgeRef/animFrame/startTime/easeOutCubic
      重复声明、computed/watch 未 import、animate 死分支、createCanvasContext().then() 编造 API、
      device.level 不存在→store getter 为 tier）；
    ②几何按 Dz3YV 重算：环心 (132,100)、带 54..70、圆头帽在带中线 r62（旧 cap-start 写死 top:22 不在环上）；
    ③蒙层改黑 50%（旧为绿 50%）；进度环改 140 圆环带 conic（旧铺满 264×256 圆角矩形=方形色块）＋补 mint15% 轨道；
    ④BudgetRow 语义修正为「今日 加入后总量 / 目标」（旧误为 before/after），千位空格分隔；
    ⑤动效按 MU1O4 九轨补全：L4 今日行 480ms 上移淡入／L5 夜宵行 600ms／L6 图标 620ms 弹入／
      L9 退出 scale→0.94+淡出 220ms（旧全为注释未实现）；单一 progress 同驱环扫角+中心计数+触感帧；
    ⑥严格自动关：删掉旧草稿的蒙层点按关闭；⑦类名全量 sb- 前缀（旧 .mask/.badge 裸名违反铁律）。]
  修改时间：2026-09-21
  AI模型：Muse Spark
  修改内容：[新建：结算徽章（弹层③）首版草稿（未接线未编译）]
-->

<template>
  <view class="sb-overlay" :class="{ 'sb-overlay-active': active }" v-if="render">
    <view class="sb-badge" :class="{ 'sb-badge-active': active, 'sb-badge-out': exiting, 'sb-badge-low': lowMode }">
      <!-- 环：轨道圆 + 中心盖孔 + canvas绘制进度与双头帽 -->
      <view class="sb-track"></view>
      <canvas class="sb-canvas" type="2d" id="sb-ring" @ready="onCanvasReady"></canvas>
      <view class="sb-hole"></view>
      <view class="sb-num-stack">
        <text class="sb-big-num">{{ shownText }}</text>
        <text class="sb-unit">kcal</text>
      </view>
      <view class="sb-budget-row">
        <text class="sb-budget-text" :class="{ 'sb-budget-text-over': overBudget }">{{ budgetText }}</text>
      </view>
      <view class="sb-meal-row">
        <image class="sb-meal-ico" :src="overBudget ? '/static/settle/sb_alert.png' : '/static/settle/sb_check.png'" mode="aspectFit"></image>
        <text class="sb-meal-text">{{ mealText }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, watch, getCurrentInstance, onUnmounted, nextTick } from 'vue'
import { useDeviceStore } from '../stores/device'
import { useSettingsStore } from '../stores/settings'

/**
 * 弹层③ 结算徽章（Pencil Dz3YV 结构 + MU1O4 动效时间轴）。
 * 单一 progress（0..1，140ms 起 620ms easeOutCubic）同驱：环扫角、中心计数、到位触感帧。
 * 严格 2160ms 自动关（无点按关闭）。low 档只留淡入淡出、直落终值。
 */

const props = defineProps<{
  show: boolean
  kcal: number
  after: number
  goal: number
  meal: string
}>()

const emit = defineEmits<{
  (e: 'update:show', v: boolean): void
  (e: 'close'): void
}>()

const inst = getCurrentInstance()
const device = useDeviceStore()
const settings = useSettingsStore()

// —— MU1O4 时间轴常量（ms） ——
const RING_DELAY = 140
const RING_MS = 620
const EXIT_AT = 2160
const CLOSE_AT = 2380

// —— 环几何（Dz3YV：环心 (132,100)，带 54..70，帽在带中线 r62） ——
const CX = 132
const CY = 100
const BAND_MID_R = 62

const progress = ref(0)
const exiting = ref(false)
const lowMode = ref(false)
const render = ref(false)
const active = ref(false)

let ringTimer = 0
let exitTimer = 0
let closeTimer = 0
let activeTimer = 0
let animStart = 0

const overBudget = computed<boolean>(() => props.after > props.goal)
const ringColor = computed<string>(() => overBudget.value ? '#E8B54D' : '#1FBF8F')
const finalRatio = computed<number>(() => {
  if (props.goal <= 0) return 1
  const r = props.after / props.goal
  return r > 1 ? 1 : r
})
const sweep = computed<number>(() => finalRatio.value * progress.value)

function easeOutCubic(t: number): number {
  const k = t < 0 ? 0 : (t > 1 ? 1 : t)
  return 1 - Math.pow(1 - k, 3)
}

/** 千位空格分隔（稿面「1 120 / 1 800」），双端安全的手工实现 */
function fmt(n: number): string {
  const s = '' + n
  let out = ''
  for (let i = 0; i < s.length; i++) {
    if (i > 0 && (s.length - i) % 3 == 0) out = out + ' '
    out = out + s.charAt(i)
  }
  return out
}

const shownText = computed<string>(() => '' + Math.round(props.kcal * progress.value))
const budgetText = computed<string>(() => '今日 ' + fmt(props.after) + ' / ' + fmt(props.goal) + ' kcal')
const mealText = computed<string>(() => props.meal + ' · 已加入')

// —— Canvas 绘制逻辑（双端通用） ——
let ringCtx: any | null = null

function onCanvasReady(): void {
  // #ifdef APP
  try {
    const el = uni.getElementById('sb-ring') as UniCanvasElement | null
    if (el != null) ringCtx = el.getContext('2d')
  } catch (e) {
    ringCtx = null
  }
  // #endif
}

function initCanvasMp(): void {
  // #ifdef MP-WEIXIN
  if (inst != null && inst.proxy != null) {
    uni.createSelectorQuery()
      .in(inst.proxy)
      .select('#sb-ring')
      .node((res: any) => {
        if (res != null && res.node != null) {
          const canvas = res.node
          // 适配高分屏
          const sys = uni.getSystemInfoSync()
          const dpr = sys.pixelRatio
          canvas.width = 264 * dpr
          canvas.height = 256 * dpr
          ringCtx = canvas.getContext('2d')
          ringCtx.scale(dpr, dpr)
        }
      })
      .exec()
  }
  // #endif
}

function drawRing(): void {
  const ctx = ringCtx
  if (ctx == null) return
  
  // App 与微信的 CanvasRenderingContext2D 在清除方法上基本一致
  try {
    ctx.clearRect(0, 0, 264, 256)
  } catch (e) {}

  // 轨道 (仅通过 view 渲染，或这里再补一层保险？不，使用 sb-track view 即可)
  
  // 进度（圆头由 lineCap round 天然给出）
  if (sweep.value > 0.001) {
    ctx.beginPath()
    ctx.arc(CX, CY, BAND_MID_R, -Math.PI / 2, -Math.PI / 2 + sweep.value * Math.PI * 2)
    ctx.lineWidth = 16
    ctx.lineCap = 'round'
    ctx.strokeStyle = ringColor.value
    ctx.stroke()
  }
}

function tick(): void {
  const p = easeOutCubic((Date.now() - animStart) / RING_MS)
  progress.value = p
  drawRing()
  if (p >= 1) {
    clearInterval(ringTimer)
    ringTimer = 0
  }
}

function clearTimers(): void {
  if (ringTimer != 0) { clearInterval(ringTimer); ringTimer = 0 }
  if (exitTimer != 0) { clearInterval(exitTimer); exitTimer = 0 }
  if (closeTimer != 0) { clearInterval(closeTimer); closeTimer = 0 }
  if (activeTimer != 0) { clearTimeout(activeTimer); activeTimer = 0 }
}

/** 离场结束，兜底同步父级关闭态 */
function onAfterLeave(): void {
  emit('update:show', false)
  emit('close')
}

function open(): void {
  exiting.value = false
  lowMode.value = device.tier === 'low'
  if (lowMode.value) {
    progress.value = 1
    drawRing()
  } else {
    progress.value = 0
    animStart = Date.now() + RING_DELAY
    ringTimer = setInterval(() => { tick() }, 16)
  }
  exitTimer = setInterval(() => {
    clearInterval(exitTimer)
    exitTimer = 0
    exiting.value = true
  }, EXIT_AT)
  closeTimer = setInterval(() => {
    clearInterval(closeTimer)
    closeTimer = 0
    emit('update:show', false)
    emit('close')
  }, CLOSE_AT)
}

watch(
  () => props.show,
  (v: boolean) => {
    clearTimers()
    if (v) {
      render.value = true
      nextTick(() => {
        initCanvasMp()
      })
      activeTimer = setTimeout(() => {
        active.value = true
        activeTimer = 0
      }, 50) as unknown as number
      open()
    } else {
      progress.value = 0
      exiting.value = false
      active.value = false
      render.value = false
    }
  }
)

onUnmounted(() => { clearTimers() })
</script>

<style>
.sb-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 900;
  opacity: 0;
  transition-property: opacity;
  transition-duration: 220ms;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sb-overlay-active {
  opacity: 1;
}

/* —— L2 徽章：264×256 r28 —— */
.sb-badge {
  width: 264px;
  height: 256px;
  border-radius: 28px;
  background-color: #F2FAF5;
  position: relative;
  box-shadow: 0 14px 36px rgba(10, 79, 61, 0.14);
  flex-shrink: 0;
  transform: scale(0.9);
  opacity: 0;
  transition-property: transform, opacity;
  transition-duration: 400ms, 220ms;
  transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1), ease;
}
.sb-badge-active {
  transform: scale(1);
  opacity: 1;
}
.sb-badge-out {
  transform: scale(0.94);
  opacity: 0;
  transition-property: transform, opacity;
  transition-duration: 220ms;
  transition-timing-function: ease;
}

/* —— 环（MP：轨道 + conic 进度 + 盖孔 + 双圆头帽） —— */
.sb-track {
  position: absolute;
  left: 62px;
  top: 30px;
  width: 140px;
  height: 140px;
  border-radius: 70px;
  background-color: rgba(31, 191, 143, 0.15);
}
.sb-hole {
  position: absolute;
  left: 78px;
  top: 46px;
  width: 108px;
  height: 108px;
  border-radius: 54px;
  background-color: #F2FAF5;
}
.sb-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 264px;
  height: 256px;
}

/* —— 中心数字栈（只占环心 108 见方，数字与单位上下排） —— */
.sb-num-stack {
  position: absolute;
  left: 0;
  top: 70px;
  width: 264px;
  height: 60px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.sb-big-num {
  font-size: 34px;
  font-weight: bold;
  color: #0A4F3D;
  line-height: 41px;
}
.sb-unit {
  font-size: 11px;
  font-weight: bold;
  color: rgba(15, 79, 61, 0.6);
  line-height: 16px;
}

/* —— L4 今日行 —— */
.sb-budget-row {
  position: absolute;
  left: 0;
  top: 182px;
  width: 264px;
  height: 20px;
  justify-content: center;
  align-items: center;
}
.sb-budget-text {
  font-size: 13px;
  font-weight: bold;
  color: #0A7A5C;
}
.sb-budget-text-over {
  color: #FF9E7D;
}

/* —— L5 夜宵行与图标 —— */
.sb-meal-row {
  position: absolute;
  left: 0;
  top: 208px;
  width: 264px;
  height: 18px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.sb-meal-ico {
  width: 12px;
  height: 12px;
  margin-right: 4px;
}
.sb-meal-text {
  font-size: 12px;
  color: #73918B;
}
</style>
