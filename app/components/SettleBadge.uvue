<!--
  [变更日志]
  修改时间：2026-09-21
  AI模型：Muse Spark
  修改内容：[新建：结算徽章（弹层③）——居中 264×256 徽章，环扫过角+数字滚动同步 620ms easeOutCubic；
    双层圆环（小程序 conic-gradient / App canvas 2d arc），CapStart/CapEnd 圆头；
    超预算分支：环描边换 amber、BudgetRow 珊瑚文字、MealRow 换 alert-circle；
    低端机降级：仅淡入淡出，无环扫动效、无触感]
-->

<template>
  <view class="mask" v-if="show" @click="dismiss">
    <view class="badge" ref="badgeRef" :class="{ 'badge-over': overBudget }">
      <view class="medallion">
        <!-- 双层圆环：小程序用 conic-gradient，App 用 canvas -->
        <view class="ring-outer" :style="outerRingStyle"></view>
        <view class="ring-inner" :style="innerRingStyle"></view>
        <!-- App 端 Canvas 绘制环 -->
        <canvas
          v-if="isApp"
          class="ring-canvas"
          canvas-id="settle-ring"
          type="2d"
          :style="{ position: 'absolute', left: '0px', top: '0px', width: '264px', height: '256px' }"
        ></canvas>
        <!-- CapStart / CapEnd 圆头 -->
        <view class="cap cap-start" :style="capStartStyle"></view>
        <view class="cap cap-end" :style="capEndStyle"></view>
        <!-- 数字栈 -->
        <view class="num-stack">
          <text class="big-num">{{ shownKcal }}</text>
          <text class="unit">kcal</text>
        </view>
      </view>
      <view class="budget-row" :class="{ 'budget-row-over': overBudget }">
        <text class="budget-text">今日 {{ before }} / {{ after }} kcal</text>
      </view>
      <view class="meal-row" :class="{ 'meal-row-over': overBudget }">
        <text class="check-icon" v-if="overBudget">!</text>
        <text class="check-icon" v-else>✓</text>
        <text class="meal-text">{{ mealLabel }} · {{ overBudget ? '已超标' : '已加入' }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onMounted } from 'vue'
import { onUnmounted } from 'vue'
import { useDeviceStore } from '../stores/device'
import { useSettingsStore } from '../stores/settings'

/**
 * 结算徽章——弹层③ 结算徽章（设计稿 Dz3YV + MU1O4）
 * 单一 progress 驱动环扫+数字滚动 620ms easeOutCubic；
 * 双端实现：小程序 conic-gradient / App canvas arc+lineCap;
 * 超预算分支：环描边 amber、BudgetRow 珊瑚、MealRow alert-circle；
 * 低端机降级：仅淡入淡出，无环扫、无触感
 */

const props = defineProps<{
  show: boolean
  kcal: number
  before: number
  after: number
  goal: number
  meal: string
}>()

const emit = defineEmits<{
  (e: 'update:show', v: boolean): void
}>()

const device = useDeviceStore()
const settings = useSettingsStore()

const badgeRef = ref<HTMLElement | null>(null)
const progress = ref(0)
const done = ref(false)
const animFrame = ref(0)
const startTime = ref(0)
const ringCtx = ref<UniCanvasContext | null>(null)

const RING_MS = 620
const R = 70
const r = 54
const C = 2 * Math.PI * R

const overBudget = computed(() => props.after > props.goal)
const ringColor = computed(() => overBudget.value ? '#E8B54D' : '#1FBF8F')
const budgetColor = computed(() => overBudget.value ? '#FF9E7D' : '#0A7A5C')
const mealPrefix = computed(() => overBudget.value ? '!' : '✓')
const mealText = computed(() => `${props.meal} · ${overBudget.value ? '已超标' : '已加入'}`)

const shownKcal = computed(() => Math.round(props.kcal * progress.value))

// 判断是否为 App 端
const isApp = computed(() => {
  try {
    const info = uni.getSystemInfoSync()
    return info.platform === 'android' || info.platform === 'ios'
  } catch (e) {
    return false
  }
})

// 动效 easing
function easeOutCubic(t: number): number {
  const k = Math.min(Math.max(t, 0), 1)
  return 1 - Math.pow(1 - k, 3)
}

const outerRingStyle = computed(() => {
  const ratio = Math.min(Math.max(progress.value, 0), 1)
  let isApp = false
  try {
    const info = uni.getSystemInfoSync()
    isApp = info.platform === 'android' || info.platform === 'ios'
  } catch (e) {
    isApp = false
  }
  if (isApp) {
    // uni-app x / App: 由 canvas 绘制，这里只做占位透明层
    return {
      position: 'absolute',
      left: '0px',
      top: '0px',
      width: '264px',
      height: '256px',
      borderRadius: '28px',
      backgroundColor: 'transparent',
    } as Record<string, string>
  }
  // 小程序：双层 conic-gradient
  return {
    position: 'absolute',
    left: '0px',
    top: '0px',
    width: '264px',
    height: '256px',
    borderRadius: '28px',
    backgroundColor: '#F2FAF5',
    backgroundImage: `conic-gradient(from -90deg, ${ringColor.value} 0turn, ${ringColor.value} ${ratio}turn, transparent 0)`,
  } as Record<string, string>
})

const innerRingStyle = computed(() => ({
  position: 'absolute',
  left: '70px',
  top: '38px',
  width: '124px',
  height: '124px',
  borderRadius: '62px',
  backgroundColor: '#F2FAF5',
}))

const capStartStyle = computed(() => ({
  position: 'absolute',
  left: '124px',
  top: '22px',
  width: '16px',
  height: '16px',
  borderRadius: '8px',
  backgroundColor: ringColor.value,
}))

const capEndStyle = computed(() => {
  const ratio = Math.min(Math.max(progress.value, 0), 1)
  const angle = -Math.PI / 2 + ratio * Math.PI * 2
  const cx = 132
  const cy = 126
  const x = cx + R * Math.cos(angle)
  const y = cy + R * Math.sin(angle)
  return {
    position: 'absolute',
    left: `${Math.round(x - 8)}px`,
    top: `${Math.round(y - 8)}px`,
    width: '16px',
    height: '16px',
    borderRadius: '8px',
    backgroundColor: ringColor.value,
  })
})

const badgeRef = ref<HTMLElement | null>(null)
let animFrame = 0
let startTime = 0

function animate(): void {
  const elapsed = Date.now() - startTime
  const p = easeOutCubic(Math.min(elapsed / RING_MS, 1))
  progress.value = p
  if (isApp.value) drawRing()
  if (p >= 1) {
    if (!done.value) {
      done.value = true
      // 触感：环到位那一帧
      try {
        const dev = uni.getSystemInfoSync()
        const tier = dev.platform === 'ios' ? 'high' : 'high'
        if (device.haptics && settings.hapticsEnabled) {
          uni.vibrateShort({ type: 'light' })
        }
      } catch (e) {}
    }
    if (p < 1) {
      animFrame = requestAnimationFrame(animate)
    }
  } else {
    animFrame = requestAnimationFrame(animate)
  }
}

function easeOutCubic(t: number): number {
  const k = Math.min(Math.max(t, 0), 1)
  return 1 - Math.pow(1 - k, 3)
}

function startAnim(): void {
  if (device.level === 'low') {
    // 低端机：直接落终值
    progress.value = 1
    done.value = true
    return
  }
  progress.value = 0
  done.value = false
  startTime = Date.now()
  animFrame = requestAnimationFrame(animate)
}

function drawRing(): void {
  if (!isApp.value || !ringCtx.value) return
  const ratio = Math.min(Math.max(progress.value, 0), 1)
  const color = ringColor.value
  
  const cx = 132
  const cy = 128
  const radius = R
  const lineWidth = 16
  const startAngle = -Math.PI / 2
  const endAngle = startAngle + ratio * Math.PI * 2
  
  const ctx = ringCtx.value
  ctx.clearRect(0, 0, 264, 256)
  ctx.beginPath()
  ctx.arc(cx, cy, radius, startAngle, endAngle)
  ctx.lineWidth = lineWidth
  ctx.lineCap = 'round'
  ctx.strokeStyle = color
  ctx.stroke()
}

function dismiss(): void {
  if (animFrame) {
    cancelAnimationFrame(animFrame)
    animFrame = 0
  }
  progress.value = 0
  done.value = false
  emit('update:show', false)
}

function dismissAfterHold(): void {
  // L8 静默 1280ms → L9 退出 220ms
  setTimeout(() => {
    // 退出动画：scale 1→0.94 + opacity→0, 220ms cubic-bezier(.4,0,1,1)
    // 简化：直接淡出
    dismiss()
  }, 1280)
}

watch(
  () => props.show,
  (v) => {
    if (v) {
      startAnim()
      // L1 压暗层 200ms linear（由 mask 透明度控制）
      // L2 徽章 scale 0.86→1 + opacity, 360ms out-expo
      // L3 环扫+数字 620ms easeOutCubic（由 animate 驱动）
      // L4 今日行 480ms / L5 夜宵行 600ms / L6 对勾 620ms spring
      // L7 触感在 animate 内触发
      // L8 静默 1280ms
      setTimeout(dismissAfterHold, 880)
    } else {
      dismiss()
    }
  }
)

onUnmounted(() => {
  if (animFrame) cancelAnimationFrame(animFrame)
})

onMounted(() => {
  if (isApp.value) {
    uni.createCanvasContext('settle-ring', badgeRef.value)
      .then(ctx => { ringCtx.value = ctx })
      .catch(() => { /* ignore */ })
  }
})
</script>

<style>
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(10, 79, 61, 0.5);
  justify-content: center;
  align-items: center;
  opacity: 0;
  animation: maskIn 200ms linear forwards;
}
@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.badge {
  width: 264px;
  height: 256px;
  border-radius: 28px;
  background-color: #F2FAF5;
  position: relative;
  transform: scale(0.86);
  opacity: 0;
  animation: badgeIn 360ms cubic-bezier(.16,1,.3,1) forwards;
  box-shadow: 0 14px 36px rgba(10, 79, 61, 0.14);
}
@keyframes badgeIn {
  from { transform: scale(0.86); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.medallion {
  position: absolute;
  left: 0;
  top: 0;
  width: 264px;
  height: 256px;
}
.ring-outer {
  position: absolute;
  left: 0;
  top: 0;
  width: 264px;
  height: 256px;
  border-radius: 28px;
}
.ring-inner {
  position: absolute;
  left: 70px;
  top: 38px;
  width: 124px;
  height: 124px;
  border-radius: 62px;
  background-color: #F2FAF5;
}
.cap {
  position: absolute;
  width: 16px;
  height: 16px;
  border-radius: 8px;
}
.cap-start {
  left: 124px;
  top: 22px;
}
.cap-end {
  /* 动态定位由 capEndStyle 控制 */
}
.ring-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 264px;
  height: 256px;
  pointer-events: none;
}
.num-stack {
  position: absolute;
  left: 0;
  right: 0;
  top: 70px;
  height: 60px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1px;
}
.big-num {
  font-family: 'Inter';
  font-size: 34px;
  font-weight: 700;
  color: #0A4F3D;
}
.unit {
  font-family: 'Inter';
  font-size: 11px;
  font-weight: 600;
  color: #73918B;
}
.budget-row {
  position: absolute;
  left: 0;
  right: 0;
  top: 182px;
  height: 20px;
  justify-content: center;
  align-items: center;
}
.budget-text {
  font-size: 13px;
  font-weight: 600;
  color: #0A7A5C;
}
.budget-row-over .budget-text {
  color: #FF9E7D;
}
.meal-row {
  position: absolute;
  left: 0;
  right: 0;
  top: 208px;
  height: 18px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 4px;
}
.check-icon {
  font-size: 12px;
  color: #1FBF8F;
}
.meal-text {
  font-size: 12px;
  color: #8FAEAF;
}
.meal-row-over .check-icon {
  color: #FF9E7D;
}
.meal-row-over .meal-text {
  color: #FF9E7D;
}
</style>