<template>
  <view class="sb-overlay" :class="{ 'sb-overlay-active': active }" v-if="render">
    <view class="sb-badge" :class="{ 'sb-badge-active': active, 'sb-badge-out': exiting, 'sb-badge-low': lowMode }">
      <!-- 环形进度：底轨为纯 CSS 圆环（双端同构），画布只画进度弧 -->
      <view class="sb-track"></view>
      <canvas class="sb-canvas" type="2d" id="sb-ring" @ready="onCanvasReady"></canvas>
      <view class="sb-num-stack">
        <text class="sb-big-num">{{ shownText }}</text>
        <text class="sb-unit">kcal</text>
      </view>
      <view class="sb-budget-row">
        <text class="sb-budget-text" :style="{ color: calStatus.color }">{{ budgetText }}</text>
      </view>
      <view class="sb-meal-row">
        <image class="sb-meal-ico" :src="calStatus.type === 'coral' ? '/static/settle/sb_alert_coral.svg' : (calStatus.type === 'amber' ? '/static/settle/sb_alert.svg' : '/static/settle/sb_check.svg')" mode="aspectFit"></image>
        <text class="sb-meal-text">{{ mealText }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
// [变更日志] 2026-09-24: 环形动画根因修复 → 废弃 nextTick/200/400/600ms/tick 五路抢跑初始化（surface 未附加时 getContext 拿到死上下文并锁死 readyFired，真 @ready 反被吞），改为 @ready 唯一入口＋500ms 单次兜底（对齐 BottleLiquid 范式）；删除无响应性的 :key="canvasKey"；变更日志按 ADR-003 #7 落位 script 内，严禁 .uvue 根层 HTML 注释
import { ref, computed, watch, getCurrentInstance, onUnmounted, nextTick } from 'vue'
import { useDeviceStore } from '../stores/device'
import { useSettingsStore } from '../stores/settings'
import { getCalorieStatus } from '../stores/goal'

/**
 * 弹层③ 结算徽章（Pencil Dz3YV 结构 + MU1O4 动效时间轴）。
 * 单一 progress（0..1，140ms 起 620ms easeOutCubic）同驱：环扫角、中心计数、到位触感帧。
 * 严格 2160ms 自动关（无点按关闭）。low 档只留淡入淡出、直落终值。
 */

const props = defineProps<{
  show: boolean
  kcal: number
  after: number
  goal: number
  meal: string
}>()

const emit = defineEmits<{
  (e: 'update:show', v: boolean): void
  (e: 'close'): void
}>()

const inst = getCurrentInstance()
const device = useDeviceStore()
const settings = useSettingsStore()

// —— MU1O4 时间轴常量（ms） ——
const RING_DELAY = 140
const RING_MS = 620
const EXIT_AT = 2160
const CLOSE_AT = 2380

const progress = ref(0)
const exiting = ref(false)
const lowMode = ref(false)
const render = ref(false)
const active = ref(false)

let ringTimer = 0
let exitTimer = 0
let closeTimer = 0
let activeTimer = 0
let animStart = 0
let initFallback = 0

// 画布尺寸状态记录
let cvWidth = 148
let cvHeight = 148

// —— Canvas 绘制逻辑 ——
let ringCtx: any | null = null
let readyFired = false

const calStatus = computed(() => getCalorieStatus(props.after, props.goal))
const RING_COLOR: Record<string, string> = {
  green: 'rgba(31, 191, 143, 1)',
  amber: 'rgba(232, 181, 77, 1)',
  coral: 'rgba(255, 158, 125, 1)'
}
const ringColor = computed<string>(() => RING_COLOR[calStatus.value.type])
const finalRatio = computed<number>(() => {
  if (props.goal <= 0) return 1
  const r = props.after / props.goal
  return r > 1 ? 1 : r
})
const sweep = computed<number>(() => finalRatio.value * progress.value)

function easeOutCubic(t: number): number {
  const k = t < 0 ? 0 : (t > 1 ? 1 : t)
  return 1 - Math.pow(1 - k, 3)
}

/** 千位空格分隔（稿面「1 120 / 1 800」），双端安全的手工实现 */
function fmt(n: number): string {
  const s = '' + n
  let out = ''
  for (let i = 0; i < s.length; i++) {
    if (i > 0 && (s.length - i) % 3 == 0) out = out + ' '
    out = out + s.charAt(i)
  }
  return out
}

const shownText = computed<string>(() => '' + Math.round(props.kcal * progress.value))
const budgetText = computed<string>(() => '今日 ' + fmt(props.after) + ' / ' + fmt(props.goal) + ' kcal')
const mealText = computed<string>(() => props.meal + ' · 已加入')

/** App 端画布初始化：仅允许由 @ready（surface 附加信号）或 500ms 兜底触发，
    严禁在挂载同帧抢跑——此时 getContext 会拿到绑在未附加缓冲区上的死上下文且非 null，判空失效 */
function initAppCanvas(): void {
  // #ifdef APP
  if (readyFired || !render.value) return
  try {
    const el = uni.getElementById('sb-ring') as UniCanvasElement | null
    if (el == null) return
    const dpr = uni.getDeviceInfo().devicePixelRatio ?? 1
    const cssW = el.offsetWidth
    const cssH = el.offsetHeight
    if (cssW <= 0 || cssH <= 0) return
    el.width = Math.round(cssW * dpr)
    el.height = Math.round(cssH * dpr)
    cvWidth = el.width
    cvHeight = el.height
    const ctx = el.getContext('2d')
    if (ctx == null) return
    ringCtx = ctx
    readyFired = true
    drawRing()
  } catch (e) {
    ringCtx = null
  }
  // #endif
}

/** canvas @ready 事件：App 端 surface 就绪的唯一首选信号 */
function onCanvasReady(): void {
  // #ifdef APP
  initAppCanvas()
  // #endif
}

function initCanvasMp(): void {
  // #ifdef MP-WEIXIN
  if (readyFired) return
  if (inst != null && inst.proxy != null) {
    uni.createSelectorQuery()
      .in(inst.proxy)
      .select('#sb-ring')
      .fields({ node: true, size: true }, (res: any) => {
        if (res != null && res.node != null) {
          const canvas = res.node
          const sys = uni.getSystemInfoSync()
          const dpr = sys.pixelRatio ?? 1
          cvWidth = res.width > 0 ? res.width : 148
          cvHeight = res.height > 0 ? res.height : 148
          canvas.width = cvWidth * dpr
          canvas.height = cvHeight * dpr
          ringCtx = canvas.getContext('2d')
          ringCtx.scale(dpr, dpr)
          readyFired = true
          drawRing()
        }
      })
      .exec()
  }
  // #endif
}

function drawRing(): void {
  const ctx = ringCtx
  if (ctx == null) return

  const w = cvWidth
  const h = cvHeight
  const cx = w / 2
  const cy = h / 2
  const lineW = Math.max(12, Math.round(18 * (w / 148)))
  const r = (w - lineW) / 2 - 2

  try {
    ctx.clearRect(0, 0, w, h)
  } catch (e) {}

  // 底轨由 .sb-track（CSS 圆环）承担，画布每帧只负责进度弧
  if (sweep.value <= 0.001) return

  // 满圈时起止角恰好相差 2π，按零弧长处理会整条不绘制，故封顶 0.9995 圈
  const turn = sweep.value > 0.9995 ? 0.9995 : sweep.value
  const a0 = 0 - Math.PI / 2
  const a1 = a0 + turn * Math.PI * 2

  // #ifdef APP
  // App 端 gcanvas 的 stroke() 实测零输出（缓冲区与几何均正确、调用无异常），fill() 可用，
  // 故进度弧以「外弧点列 + 内弧逆序点列」的环形扇区多边形填充实现，两端再补圆头。
  const rOut = r + lineW / 2
  const rIn = r - lineW / 2
  const segs = Math.max(2, Math.round((a1 - a0) / 0.1047197551))
  ctx.beginPath()
  for (let k = 0; k <= segs; k++) {
    const a = a0 + (a1 - a0) * (k / segs)
    const ox = cx + rOut * Math.cos(a)
    const oy = cy + rOut * Math.sin(a)
    if (k == 0) {
      ctx.moveTo(ox, oy)
    } else {
      ctx.lineTo(ox, oy)
    }
  }
  for (let k2 = segs; k2 >= 0; k2--) {
    const a2 = a0 + (a1 - a0) * (k2 / segs)
    ctx.lineTo(cx + rIn * Math.cos(a2), cy + rIn * Math.sin(a2))
  }
  ctx.closePath()
  ctx.fillStyle = ringColor.value
  ctx.fill()

  const capR = lineW / 2
  ctx.beginPath()
  ctx.arc(cx + r * Math.cos(a0), cy + r * Math.sin(a0), capR, 0, Math.PI * 2)
  ctx.fill()
  ctx.beginPath()
  ctx.arc(cx + r * Math.cos(a1), cy + r * Math.sin(a1), capR, 0, Math.PI * 2)
  ctx.fill()
  // #endif

  // #ifndef APP
  ctx.beginPath()
  ctx.arc(cx, cy, r, Math.PI * 1.5, Math.PI * 1.5 + turn * Math.PI * 2)
  ctx.lineWidth = lineW
  ctx.lineCap = 'round'
  ctx.strokeStyle = ringColor.value
  ctx.stroke()
  // #endif
}

function tick(): void {
  const p = easeOutCubic((Date.now() - animStart) / RING_MS)
  progress.value = p
  drawRing()
  if (p >= 1) {
    // 收尾无条件停表；若 ctx 此刻仍未就绪，稍后初始化路径会以 progress=1 自补画终态
    clearInterval(ringTimer)
    ringTimer = 0
    drawRing()
  }
}

function clearTimers(): void {
  if (ringTimer != 0) { clearInterval(ringTimer); ringTimer = 0 }
  if (exitTimer != 0) { clearInterval(exitTimer); exitTimer = 0 }
  if (closeTimer != 0) { clearInterval(closeTimer); closeTimer = 0 }
  if (activeTimer != 0) { clearTimeout(activeTimer); activeTimer = 0 }
  if (initFallback != 0) { clearTimeout(initFallback); initFallback = 0 }
}

/** 离场结束，兜底同步父级关闭态 */
function onAfterLeave(): void {
  emit('update:show', false)
  emit('close')
}

function open(): void {
  exiting.value = false
  lowMode.value = device.tier === 'low'
  if (lowMode.value) {
    progress.value = 1
    drawRing()
  } else {
    progress.value = 0
    animStart = Date.now() + RING_DELAY
    ringTimer = setInterval(() => { tick() }, 16)
  }
  exitTimer = setInterval(() => {
    clearInterval(exitTimer)
    exitTimer = 0
    exiting.value = true
  }, EXIT_AT)
  closeTimer = setInterval(() => {
    clearInterval(closeTimer)
    closeTimer = 0
    emit('update:show', false)
    emit('close')
  }, CLOSE_AT)
}

watch(
  () => props.show,
  (v: boolean) => {
    clearTimers()
    if (v) {
      render.value = true
      readyFired = false
      ringCtx = null
      // #ifdef MP-WEIXIN
      // 小程序端：节点挂载后走一次 selectorQuery（异步回调自带就绪语义）
      nextTick(() => {
        initCanvasMp()
      })
      // #endif
      // #ifdef APP
      // 原生端：@ready 为首选信号；500ms 后仍未就绪才手动补一次（App @ready 偶发不触发，BottleLiquid 同款兜底）
      initFallback = setTimeout(() => {
        initAppCanvas()
        initFallback = 0
      }, 500) as unknown as number
      // #endif
      activeTimer = setTimeout(() => {
        active.value = true
        activeTimer = 0
      }, 50) as unknown as number
      open()
    } else {
      progress.value = 0
      exiting.value = false
      active.value = false
      render.value = false
      readyFired = false
      ringCtx = null
    }
  }
)

onUnmounted(() => { clearTimers() })
</script>

<style>
.sb-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 900;
  opacity: 0;
  transition-property: opacity;
  transition-duration: 220ms;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sb-overlay-active {
  opacity: 1;
}

/* —— L2 徽章：528×512 r56 —— */
.sb-badge {
  width: 528rpx;
  height: 512rpx;
  border-radius: 56rpx;
  background-color: #F2FAF5;
  position: relative;
  box-shadow: 0 28rpx 72rpx rgba(10, 79, 61, 0.14);
  flex-shrink: 0;
  transform: scale(0.9);
  opacity: 0;
  /* #ifdef MP-WEIXIN */
  /* 逗号多值 transition 在原生渲染为非法语法，仅小程序端启用 */
  transition-property: transform, opacity;
  transition-duration: 400ms, 220ms;
  transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1), ease;
  /* #endif */
}
.sb-badge-active {
  transform: scale(1);
  opacity: 1;
}
.sb-badge-out {
  transform: scale(0.94);
  opacity: 0;
  /* #ifdef MP-WEIXIN */
  transition-property: transform, opacity;
  transition-duration: 220ms;
  transition-timing-function: ease;
  /* #endif */
}

/* —— 环形底轨：与画布进度弧同心同宽（中心线半径 128rpx / 线宽 36rpx） —— */
.sb-track {
  position: absolute;
  left: 118rpx;
  top: 46rpx;
  width: 292rpx;
  height: 292rpx;
  border-width: 36rpx;
  border-style: solid;
  border-color: rgba(31, 191, 143, 0.16);
  border-radius: 146rpx;
}

/* —— 环形画布：正中精准定位 —— */
.sb-canvas {
  position: absolute;
  left: 116rpx;
  top: 44rpx;
  width: 296rpx;
  height: 296rpx;
}

/* —— 中心数字栈 —— */
.sb-num-stack {
  position: absolute;
  left: 0;
  top: 140rpx;
  width: 528rpx;
  height: 120rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.sb-big-num {
  font-size: 68rpx;
  font-weight: bold;
  color: #0A4F3D;
  line-height: 82rpx;
}
.sb-unit {
  font-size: 22rpx;
  font-weight: bold;
  color: rgba(15, 79, 61, 0.6);
  line-height: 32rpx;
}

/* —— L4 今日行 —— */
.sb-budget-row {
  position: absolute;
  left: 0;
  top: 364rpx;
  width: 528rpx;
  height: 40rpx;
  justify-content: center;
  align-items: center;
}
.sb-budget-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #0A7A5C;
}
.sb-budget-text-over {
  color: #FF9E7D;
}

/* —— L5 夜宵行与图标 —— */
.sb-meal-row {
  position: absolute;
  left: 0;
  top: 416rpx;
  width: 528rpx;
  height: 36rpx;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.sb-meal-ico {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}
.sb-meal-text {
  font-size: 24rpx;
  color: #73918B;
}
</style>
