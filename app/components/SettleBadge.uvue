
<template>
  <view class="sb-overlay" :class="{ 'sb-overlay-active': active }" v-if="render">
    <view class="sb-badge" :class="{ 'sb-badge-active': active, 'sb-badge-out': exiting, 'sb-badge-low': lowMode }">
      <!-- 环形进度画布：正中 296rpx 正方居中，底轨与进度条由 Canvas 一体化绘制，彻底消除左上角圆圈 -->
      <canvas class="sb-canvas" type="2d" id="sb-ring" @ready="onCanvasReady"></canvas>
      <view class="sb-num-stack">
        <text class="sb-big-num">{{ shownText }}</text>
        <text class="sb-unit">kcal</text>
      </view>
      <view class="sb-budget-row">
        <text class="sb-budget-text" :class="{ 'sb-budget-text-over': overBudget }">{{ budgetText }}</text>
      </view>
      <view class="sb-meal-row">
        <image class="sb-meal-ico" :src="overBudget ? '/static/settle/sb_alert.svg' : '/static/settle/sb_check.svg'" mode="aspectFit"></image>
        <text class="sb-meal-text">{{ mealText }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, watch, getCurrentInstance, onUnmounted, nextTick } from 'vue'
import { useDeviceStore } from '../stores/device'
import { useSettingsStore } from '../stores/settings'

/**
 * 弹层③ 结算徽章（Pencil Dz3YV 结构 + MU1O4 动效时间轴）。
 * 单一 progress（0..1，140ms 起 620ms easeOutCubic）同驱：环扫角、中心计数、到位触感帧。
 * 严格 2160ms 自动关（无点按关闭）。low 档只留淡入淡出、直落终值。
 */

const props = defineProps<{
  show: boolean
  kcal: number
  after: number
  goal: number
  meal: string
}>()

const emit = defineEmits<{
  (e: 'update:show', v: boolean): void
  (e: 'close'): void
}>()

const inst = getCurrentInstance()
const device = useDeviceStore()
const settings = useSettingsStore()

// —— MU1O4 时间轴常量（ms） ——
const RING_DELAY = 140
const RING_MS = 620
const EXIT_AT = 2160
const CLOSE_AT = 2380

const progress = ref(0)
const exiting = ref(false)
const lowMode = ref(false)
const render = ref(false)
const active = ref(false)

let ringTimer = 0
let exitTimer = 0
let closeTimer = 0
let activeTimer = 0
let animStart = 0

// 画布尺寸状态记录
let cvWidth = 148
let cvHeight = 148

const overBudget = computed<boolean>(() => props.after > props.goal)
const ringColor = computed<string>(() => overBudget.value ? '#E8B54D' : '#1FBF8F')
const finalRatio = computed<number>(() => {
  if (props.goal <= 0) return 1
  const r = props.after / props.goal
  return r > 1 ? 1 : r
})
const sweep = computed<number>(() => finalRatio.value * progress.value)

function easeOutCubic(t: number): number {
  const k = t < 0 ? 0 : (t > 1 ? 1 : t)
  return 1 - Math.pow(1 - k, 3)
}

/** 千位空格分隔（稿面「1 120 / 1 800」），双端安全的手工实现 */
function fmt(n: number): string {
  const s = '' + n
  let out = ''
  for (let i = 0; i < s.length; i++) {
    if (i > 0 && (s.length - i) % 3 == 0) out = out + ' '
    out = out + s.charAt(i)
  }
  return out
}

const shownText = computed<string>(() => '' + Math.round(props.kcal * progress.value))
const budgetText = computed<string>(() => '今日 ' + fmt(props.after) + ' / ' + fmt(props.goal) + ' kcal')
const mealText = computed<string>(() => props.meal + ' · 已加入')

// —— Canvas 绘制逻辑 ——
let ringCtx: any | null = null

function onCanvasReady(): void {
  // #ifdef APP
  try {
    const el = uni.getElementById('sb-ring') as UniCanvasElement | null
    if (el != null) {
      ringCtx = el.getContext('2d')
      cvWidth = 148
      cvHeight = 148
      drawRing()
    }
  } catch (e) {
    ringCtx = null
  }
  // #endif
}

function initCanvasMp(): void {
  // #ifdef MP-WEIXIN
  if (inst != null && inst.proxy != null) {
    uni.createSelectorQuery()
      .in(inst.proxy)
      .select('#sb-ring')
      .fields({ node: true, size: true }, (res: any) => {
        if (res != null && res.node != null) {
          const canvas = res.node
          const sys = uni.getSystemInfoSync()
          const dpr = sys.pixelRatio ?? 1
          cvWidth = res.width > 0 ? res.width : 148
          cvHeight = res.height > 0 ? res.height : 148
          canvas.width = cvWidth * dpr
          canvas.height = cvHeight * dpr
          ringCtx = canvas.getContext('2d')
          ringCtx.scale(dpr, dpr)
          drawRing()
        }
      })
      .exec()
  }
  // #endif
}

function drawRing(): void {
  const ctx = ringCtx
  if (ctx == null) return
  
  const w = cvWidth
  const h = cvHeight
  const cx = w / 2
  const cy = h / 2
  const lineW = Math.max(12, Math.round(18 * (w / 148)))
  const r = (w - lineW) / 2 - 2

  try {
    ctx.clearRect(0, 0, w, h)
  } catch (e) {}

  // 1. 完整底轨圆环（浅薄荷透明绿）
  ctx.beginPath()
  ctx.arc(cx, cy, r, 0, Math.PI * 2)
  ctx.lineWidth = lineW
  ctx.strokeStyle = 'rgba(31, 191, 143, 0.16)'
  ctx.stroke()

  // 2. 顺时针进度条（带圆头，饱满轻律翡翠绿或超标暖橙）
  if (sweep.value > 0.001) {
    ctx.beginPath()
    ctx.arc(cx, cy, r, -Math.PI / 2, -Math.PI / 2 + sweep.value * Math.PI * 2)
    ctx.lineWidth = lineW
    ctx.lineCap = 'round'
    ctx.strokeStyle = ringColor.value
    ctx.stroke()
  }
}

function tick(): void {
  const p = easeOutCubic((Date.now() - animStart) / RING_MS)
  progress.value = p
  if (ringCtx != null) {
    drawRing()
  } else {
    // 异步容错补测
    initCanvasMp()
    // #ifdef APP
    onCanvasReady()
    // #endif
  }
  if (p >= 1) {
    clearInterval(ringTimer)
    ringTimer = 0
    drawRing()
  }
}

function clearTimers(): void {
  if (ringTimer != 0) { clearInterval(ringTimer); ringTimer = 0 }
  if (exitTimer != 0) { clearInterval(exitTimer); exitTimer = 0 }
  if (closeTimer != 0) { clearInterval(closeTimer); closeTimer = 0 }
  if (activeTimer != 0) { clearTimeout(activeTimer); activeTimer = 0 }
}

/** 离场结束，兜底同步父级关闭态 */
function onAfterLeave(): void {
  emit('update:show', false)
  emit('close')
}

function open(): void {
  exiting.value = false
  lowMode.value = device.tier === 'low'
  if (lowMode.value) {
    progress.value = 1
    drawRing()
  } else {
    progress.value = 0
    animStart = Date.now() + RING_DELAY
    ringTimer = setInterval(() => { tick() }, 16)
  }
  exitTimer = setInterval(() => {
    clearInterval(exitTimer)
    exitTimer = 0
    exiting.value = true
  }, EXIT_AT)
  closeTimer = setInterval(() => {
    clearInterval(closeTimer)
    closeTimer = 0
    emit('update:show', false)
    emit('close')
  }, CLOSE_AT)
}

watch(
  () => props.show,
  (v: boolean) => {
    clearTimers()
    if (v) {
      render.value = true
      nextTick(() => {
        initCanvasMp()
      })
      activeTimer = setTimeout(() => {
        active.value = true
        activeTimer = 0
      }, 50) as unknown as number
      open()
    } else {
      progress.value = 0
      exiting.value = false
      active.value = false
      render.value = false
    }
  }
)

onUnmounted(() => { clearTimers() })
</script>

<style>
.sb-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 900;
  opacity: 0;
  transition-property: opacity;
  transition-duration: 220ms;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sb-overlay-active {
  opacity: 1;
}

/* —— L2 徽章：528×512 r56 —— */
.sb-badge {
  width: 528rpx;
  height: 512rpx;
  border-radius: 56rpx;
  background-color: #F2FAF5;
  position: relative;
  box-shadow: 0 28rpx 72rpx rgba(10, 79, 61, 0.14);
  flex-shrink: 0;
  transform: scale(0.9);
  opacity: 0;
  transition-property: transform, opacity;
  transition-duration: 400ms, 220ms;
  transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1), ease;
}
.sb-badge-active {
  transform: scale(1);
  opacity: 1;
}
.sb-badge-out {
  transform: scale(0.94);
  opacity: 0;
  transition-property: transform, opacity;
  transition-duration: 220ms;
  transition-timing-function: ease;
}

/* —— 环形画布：正中精准定位 —— */
.sb-canvas {
  position: absolute;
  left: 116rpx;
  top: 44rpx;
  width: 296rpx;
  height: 296rpx;
}

/* —— 中心数字栈 —— */
.sb-num-stack {
  position: absolute;
  left: 0;
  top: 140rpx;
  width: 528rpx;
  height: 120rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.sb-big-num {
  font-size: 68rpx;
  font-weight: bold;
  color: #0A4F3D;
  line-height: 82rpx;
}
.sb-unit {
  font-size: 22rpx;
  font-weight: bold;
  color: rgba(15, 79, 61, 0.6);
  line-height: 32rpx;
}

/* —— L4 今日行 —— */
.sb-budget-row {
  position: absolute;
  left: 0;
  top: 364rpx;
  width: 528rpx;
  height: 40rpx;
  justify-content: center;
  align-items: center;
}
.sb-budget-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #0A7A5C;
}
.sb-budget-text-over {
  color: #FF9E7D;
}

/* —— L5 夜宵行与图标 —— */
.sb-meal-row {
  position: absolute;
  left: 0;
  top: 416rpx;
  width: 528rpx;
  height: 36rpx;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.sb-meal-ico {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}
.sb-meal-text {
  font-size: 24rpx;
  color: #73918B;
}
</style>
