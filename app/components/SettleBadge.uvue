<!--
  [变更日志]
  修改时间：2026-09-21
  AI模型：Qoder (Claude)
  修改内容：[弹层③ 定稿重写（Boss 拍板：双端实现／严格 2160ms 自动关／音效暂缓）：
    ①修复旧草稿编译必炸问题（capEndStyle 括号不配对、badgeRef/animFrame/startTime/easeOutCubic
      重复声明、computed/watch 未 import、animate 死分支、createCanvasContext().then() 编造 API、
      device.level 不存在→store getter 为 tier）；
    ②几何按 Dz3YV 重算：环心 (132,100)、带 54..70、圆头帽在带中线 r62（旧 cap-start 写死 top:22 不在环上）；
    ③蒙层改黑 50%（旧为绿 50%）；进度环改 140 圆环带 conic（旧铺满 264×256 圆角矩形=方形色块）＋补 mint15% 轨道；
    ④BudgetRow 语义修正为「今日 加入后总量 / 目标」（旧误为 before/after），千位空格分隔；
    ⑤动效按 MU1O4 九轨补全：L4 今日行 480ms 上移淡入／L5 夜宵行 600ms／L6 图标 620ms 弹入／
      L9 退出 scale→0.94+淡出 220ms（旧全为注释未实现）；单一 progress 同驱环扫角+中心计数+触感帧；
    ⑥严格自动关：删掉旧草稿的蒙层点按关闭；⑦类名全量 sb- 前缀（旧 .mask/.badge 裸名违反铁律）。]
  修改时间：2026-09-21
  AI模型：Muse Spark
  修改内容：[新建：结算徽章（弹层③）首版草稿（未接线未编译）]
-->

<template>
  <page-container <!-- #ifdef MP -->
    v-if="show"
    <!-- #endif -->
    :show="show" position="center" :overlay="true" :duration="220"
    overlay-style="background-color: rgba(0, 0, 0, 0.5);"
    custom-style="width:100%;height:100%;background-color:transparent;display:flex;align-items:center;justify-content:center;"
    @afterleave="onAfterLeave">
    <view class="sb-badge" :class="{ 'sb-badge-out': exiting, 'sb-badge-low': lowMode }">
      <!-- #ifdef MP-WEIXIN -->
      <!-- 环＝轨道圆 + conic 进度 + 中心盖孔 + 两端圆头帽（单一 progress 驱动） -->
      <view class="sb-track"></view>
      <view class="sb-prog" :style="progStyle"></view>
      <view class="sb-hole"></view>
      <view class="sb-cap" :style="capStartStyle"></view>
      <view class="sb-cap" :style="capEndStyle"></view>
      <!-- #endif -->
      <!-- #ifdef APP -->
      <canvas class="sb-canvas" id="sb-ring" @ready="onCanvasReady"></canvas>
      <!-- #endif -->
      <view class="sb-num-stack">
        <text class="sb-big-num">{{ shownText }}</text>
        <text class="sb-unit">kcal</text>
      </view>
      <view class="sb-budget-row">
        <text class="sb-budget-text" :class="{ 'sb-budget-text-over': overBudget }">{{ budgetText }}</text>
      </view>
      <view class="sb-meal-row">
        <image class="sb-meal-ico" :src="overBudget ? '/static/settle/sb_alert.png' : '/static/settle/sb_check.png'" mode="aspectFit"></image>
        <text class="sb-meal-text">{{ mealText }}</text>
      </view>
    </view>
  </page-container>
</template>

<script setup lang="uts">
import { ref, computed, watch } from 'vue'
import { onUnmounted } from 'vue'
import { useDeviceStore } from '../stores/device'
import { useSettingsStore } from '../stores/settings'

/**
 * 弹层③ 结算徽章（Pencil Dz3YV 结构 + MU1O4 动效时间轴）。
 * 单一 progress（0..1，140ms 起 620ms easeOutCubic）同驱：环扫角、中心计数、到位触感帧。
 * 严格 2160ms 自动关（无点按关闭）。low 档只留淡入淡出、直落终值。
 */

const props = defineProps<{
  show: boolean
  kcal: number
  after: number
  goal: number
  meal: string
}>()

const emit = defineEmits<{
  (e: 'update:show', v: boolean): void
}>()

const device = useDeviceStore()
const settings = useSettingsStore()

// —— MU1O4 时间轴常量（ms） ——
const RING_DELAY = 140
const RING_MS = 620
const EXIT_AT = 2160
const CLOSE_AT = 2380

// —— 环几何（Dz3YV：环心 (132,100)，带 54..70，帽在带中线 r62） ——
const CX = 132
const CY = 100
const BAND_MID_R = 62

const progress = ref(0)
const exiting = ref(false)
const lowMode = ref(false)

let ringTimer = 0
let exitTimer = 0
let closeTimer = 0
let animStart = 0

const overBudget = computed<boolean>(() => props.after > props.goal)
const ringColor = computed<string>(() => overBudget.value ? '#E8B54D' : '#1FBF8F')
const finalRatio = computed<number>(() => {
  if (props.goal <= 0) return 1
  const r = props.after / props.goal
  return r > 1 ? 1 : r
})
const sweep = computed<number>(() => finalRatio.value * progress.value)

function easeOutCubic(t: number): number {
  const k = t < 0 ? 0 : (t > 1 ? 1 : t)
  return 1 - Math.pow(1 - k, 3)
}

/** 千位空格分隔（稿面「1 120 / 1 800」），双端安全的手工实现 */
function fmt(n: number): string {
  const s = '' + n
  let out = ''
  for (let i = 0; i < s.length; i++) {
    if (i > 0 && (s.length - i) % 3 == 0) out = out + ' '
    out = out + s.charAt(i)
  }
  return out
}

const shownText = computed<string>(() => '' + Math.round(props.kcal * progress.value))
const budgetText = computed<string>(() => '今日 ' + fmt(props.after) + ' / ' + fmt(props.goal) + ' kcal')
const mealText = computed<string>(() => props.meal + ' · 已加入')

// —— MP 端环样式 ——
const progStyle = computed<Record<string, string>>(() => {
  const pct = (sweep.value * 100).toFixed(2) + '%'
  return {
    backgroundImage: 'conic-gradient(' + ringColor.value + ' 0% ' + pct + ', rgba(0,0,0,0) ' + pct + ' 100%)',
  } as Record<string, string>
})

const capStartStyle = computed<Record<string, string>>(() => {
  return {
    left: (CX - 8) + 'px',
    top: (CY - BAND_MID_R - 8) + 'px',
    backgroundColor: ringColor.value,
  } as Record<string, string>
})

const capEndStyle = computed<Record<string, string>>(() => {
  const ang = -Math.PI / 2 + sweep.value * Math.PI * 2
  const x = CX + BAND_MID_R * Math.cos(ang)
  const y = CY + BAND_MID_R * Math.sin(ang)
  return {
    left: Math.round(x - 8) + 'px',
    top: Math.round(y - 8) + 'px',
    backgroundColor: ringColor.value,
    opacity: sweep.value > 0.001 ? '1' : '0',
  } as Record<string, string>
})

// —— App 端 canvas 环（uni-app x 原生渲染不支持 conic-gradient） ——
// #ifdef APP
let ringCtx: CanvasRenderingContext2D | null = null

function onCanvasReady(): void {
  try {
    const el = uni.getElementById('sb-ring') as UniCanvasElement | null
    if (el != null) ringCtx = el.getContext('2d')
  } catch (e) {
    ringCtx = null
  }
}

function drawRing(): void {
  const ctx = ringCtx
  if (ctx == null) return
  ctx.clearRect(0, 0, 264, 256)
  // 轨道
  ctx.beginPath()
  ctx.arc(CX, CY, BAND_MID_R, 0, Math.PI * 2)
  ctx.lineWidth = 16
  ctx.strokeStyle = 'rgba(31,191,143,0.15)'
  ctx.stroke()
  // 进度（圆头由 lineCap round 天然给出）
  if (sweep.value > 0.001) {
    ctx.beginPath()
    ctx.arc(CX, CY, BAND_MID_R, -Math.PI / 2, -Math.PI / 2 + sweep.value * Math.PI * 2)
    ctx.lineWidth = 16
    ctx.lineCap = 'round'
    ctx.strokeStyle = ringColor.value
    ctx.stroke()
  }
}
// #endif

function tick(): void {
  const p = easeOutCubic((Date.now() - animStart) / RING_MS)
  progress.value = p
  // #ifdef APP
  drawRing()
  // #endif
  if (p >= 1) {
    clearInterval(ringTimer)
    ringTimer = 0
    // L7 触感：环到位那一帧
    if (device.haptics && settings.hapticsEnabled) {
      try { uni.vibrateShort({ success: () => {}, fail: () => {} }) } catch (e) {}
    }
  }
}

function clearTimers(): void {
  if (ringTimer != 0) { clearInterval(ringTimer); ringTimer = 0 }
  if (exitTimer != 0) { clearInterval(exitTimer); exitTimer = 0 }
  if (closeTimer != 0) { clearInterval(closeTimer); closeTimer = 0 }
}

/** page-container 离场结束（2160ms 自动关/系统返回），兜底同步父级关闭态 */
function onAfterLeave(): void {
  emit('update:show', false)
}

function open(): void {
  exiting.value = false
  lowMode.value = device.tier === 'low'
  if (lowMode.value) {
    progress.value = 1
    // #ifdef APP
    drawRing()
    // #endif
  } else {
    progress.value = 0
    animStart = Date.now() + RING_DELAY
    ringTimer = setInterval(() => { tick() }, 16)
  }
  exitTimer = setInterval(() => {
    clearInterval(exitTimer)
    exitTimer = 0
    exiting.value = true
  }, EXIT_AT)
  closeTimer = setInterval(() => {
    clearInterval(closeTimer)
    closeTimer = 0
    emit('update:show', false)
  }, CLOSE_AT)
}

watch(
  () => props.show,
  (v: boolean) => {
    clearTimers()
    if (v) {
      open()
    } else {
      progress.value = 0
      exiting.value = false
    }
  }
)

onUnmounted(() => { clearTimers() })
</script>

<style>
/* 压暗层已迁 page-container 原生蒙层（overlay-style 黑 50%），容器透明、徽章自带外观 */
@keyframes sbFadeIn { from { opacity: 0; } to { opacity: 1; } }

/* —— L2 徽章：264×256 r28，scale 0.86→1 + opacity 360ms out-expo；阴影静态不动画 —— */
.sb-badge {
  width: 264px;
  height: 256px;
  border-radius: 28px;
  background-color: #F2FAF5;
  position: relative;
  box-shadow: 0 14px 36px rgba(10, 79, 61, 0.14);
  animation: sbBadgeIn 360ms cubic-bezier(0.16, 1, 0.3, 1) both;
  flex-shrink: 0;
}
.sb-badge-out {
  animation: sbBadgeOut 220ms cubic-bezier(0.4, 0, 1, 1) both;
}
.sb-badge-low {
  animation: sbFadeIn 200ms linear both;
}
@keyframes sbBadgeIn {
  from { transform: scale(0.86); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
@keyframes sbBadgeOut {
  from { transform: scale(1); opacity: 1; }
  to { transform: scale(0.94); opacity: 0; }
}

/* —— 环（MP：轨道 + conic 进度 + 盖孔 + 双圆头帽） —— */
.sb-track {
  position: absolute;
  left: 62px;
  top: 30px;
  width: 140px;
  height: 140px;
  border-radius: 70px;
  background-color: rgba(31, 191, 143, 0.15);
}
.sb-prog {
  position: absolute;
  left: 62px;
  top: 30px;
  width: 140px;
  height: 140px;
  border-radius: 70px;
}
.sb-hole {
  position: absolute;
  left: 78px;
  top: 46px;
  width: 108px;
  height: 108px;
  border-radius: 54px;
  background-color: #F2FAF5;
}
.sb-cap {
  position: absolute;
  width: 16px;
  height: 16px;
  border-radius: 8px;
}
.sb-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 264px;
  height: 256px;
}

/* —— 中心数字栈（只占环心 108 见方，数字与单位上下排） —— */
.sb-num-stack {
  position: absolute;
  left: 0;
  top: 70px;
  width: 264px;
  height: 60px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.sb-big-num {
  font-size: 34px;
  font-weight: bold;
  color: #0A4F3D;
  line-height: 41px;
}
.sb-unit {
  font-size: 11px;
  font-weight: 600;
  color: rgba(15, 79, 61, 0.6);
  line-height: 16px;
}

/* —— L4 今日行：480ms 起，opacity + 上移 8px，240ms ease-out —— */
.sb-budget-row {
  position: absolute;
  left: 0;
  top: 182px;
  width: 264px;
  height: 20px;
  justify-content: center;
  align-items: center;
  animation: sbRise 240ms ease-out 480ms both;
}
@keyframes sbRise {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}
.sb-budget-text {
  font-size: 13px;
  font-weight: 600;
  color: #0A7A5C;
}
.sb-budget-text-over {
  color: #FF9E7D;
}

/* —— L5 夜宵行 600ms 淡入；L6 图标 620ms 起 scale 0.4→1 弹入 —— */
.sb-meal-row {
  position: absolute;
  left: 0;
  top: 208px;
  width: 264px;
  height: 18px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  animation: sbFadeIn 200ms ease-out 600ms both;
}
.sb-meal-ico {
  width: 12px;
  height: 12px;
  margin-right: 4px;
  animation: sbIcoPop 260ms cubic-bezier(0.34, 1.56, 0.64, 1) 620ms both;
}
@keyframes sbIcoPop {
  from { transform: scale(0.4); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.sb-meal-text {
  font-size: 12px;
  color: #73918B;
}

/* —— low 档：只留淡入淡出，行/图标不再各自入场 —— */
.sb-badge-low .sb-budget-row,
.sb-badge-low .sb-meal-row,
.sb-badge-low .sb-meal-ico {
  animation: none;
}
</style>
