/**
 * [变更日志]
 * 修改时间：2026-09-19
 * AI模型：CodeBuddy (DeepSeek-V4.1-Flash)
 * 修改内容：[新建：玻璃瓶组件。几何/玻璃材质/双高光按 design/VisualLanguage.md §4，
 *           水位位移公式按 §5.1（translateY = (1-pct)×132），
 *           渐变与超标珊瑚色按 design/DesignTokens.md。
 *           实现说明：uvue 不支持内联 SVG，全部用 view+CSS 圆角矩形还原；
 *           液面波纹（34 段正弦，§5.2）待 canvas 方案，本版为平液面——
 *           它同时就是低端机（liquidWave=false）的降级形态，不是缺陷。]
 */

<template>
  <view class="box">
    <view class="stage">
      <!-- 瓶盖 #CFEDE2 -->
      <view class="cap" />
      <!-- 瓶颈（玻璃同色系） -->
      <view class="neck" />
      <!-- 瓶身：玻璃 -->
      <view class="body">
        <!-- 内腔：液体裁剪区 -->
        <view class="cavity">
          <view class="liquid" :class="{ over: over }" :style="liquidStyle">
            <view class="surface" />
          </view>
        </view>
        <!-- 双高光（玻璃反光） -->
        <view class="hl-main" />
        <view class="hl-sub" />
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'

const props = defineProps({
  /** 水位 0~1（已摄入/目标；>1 自动钳到 1，显示满瓶） */
  pct: { type: Number, default: 0 },
  /** 超标态：液体由薄荷转珊瑚（VisualLanguage §3.2：超标用珊瑚不用红） */
  over: { type: Boolean, default: false },
})

/** VisualLanguage §5.1：translateY = (1 - pct) × 132；0=满瓶，132=空瓶 */
const liquidStyle = computed((): string => {
  const p = Math.min(Math.max(props.pct, 0), 1)
  const y = (1 - p) * 132
  return 'transform: translateY(' + y.toFixed(2) + 'px);'
})
</script>

<style>
.box {
  width: 122px;
  height: 171px;
  align-items: center;
}
/* 120×168 与 SVG viewBox 一致；外框 122×171 的差值用居中吸收（ScreenSpecs 实测尺寸） */
.stage {
  width: 120px;
  height: 168px;
  position: relative;
}
.cap {
  position: absolute;
  left: 44px;
  top: 2px;
  width: 32px;
  height: 13px;
  border-radius: 4px;
  background-color: #CFEDE2;
}
.neck {
  position: absolute;
  left: 52px;
  top: 13px;
  width: 16px;
  height: 12px;
  background-color: rgba(255, 255, 255, 0.42);
}
.body {
  position: absolute;
  left: 14px;
  top: 24px;
  width: 92px;
  height: 140px;
  border-radius: 18px;
  background-color: rgba(255, 255, 255, 0.42);
  border: 1px solid rgba(255, 255, 255, 0.9);
  /* 薄荷色投影，不是黑（VisualLanguage §4.2） */
  box-shadow: 0 8px 20px rgba(13, 120, 90, 0.14);
}
.cavity {
  position: absolute;
  left: 4px;
  top: 4px;
  width: 84px;
  height: 132px;
  border-radius: 15px;
  overflow: hidden;
}
.liquid {
  position: absolute;
  left: 0;
  top: 0;
  width: 84px;
  height: 132px;
  /* 上浅下深：光从上方来（VisualLanguage §3.1） */
  background-image: linear-gradient(180deg, #7DEBC7 0%, #1FBF8F 52%, #0D9C73 100%);
  /* §5.1：水位 1.15s 物理曲线 */
  transition: transform 1.15s cubic-bezier(0.22, 1, 0.36, 1);
}
/* 超标：珊瑚渐变（不用纯红） */
.liquid.over {
  background-image: linear-gradient(180deg, #FFC9B4 0%, #FF9E7D 60%, #F0835F 100%);
}
/* 液面高光带：让"液面"可被一眼读出 */
.surface {
  position: absolute;
  left: 0;
  top: 0;
  width: 84px;
  height: 3px;
  background-color: rgba(255, 255, 255, 0.5);
  border-radius: 2px;
}
.hl-main {
  position: absolute;
  left: 9px;
  top: 14px;
  width: 9px;
  height: 92px;
  border-radius: 4.5px;
  background-color: rgba(255, 255, 255, 0.55);
}
.hl-sub {
  position: absolute;
  left: 78px;
  top: 28px;
  width: 4px;
  height: 58px;
  border-radius: 2px;
  background-color: rgba(255, 255, 255, 0.32);
}
</style>
