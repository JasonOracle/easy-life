
<template>
  <view class="ft-mask" v-if="show" @click="dismiss">
    <!-- [变更日志] App 原生渲染无样式继承，toast 全部色值（卡面/强调底/文字/描边）逐元素绑 useTheme token，切主题与暗黑即时生效 -->
    <view class="ft-toast">
      <view class="ft-cup-circle" :style="{ backgroundColor: theme.accent }">
        <text class="ft-cup-glyph" :style="{ color: theme.onAccent }">✓</text>
      </view>
      <view class="ft-toast-card" :style="{ backgroundColor: theme.card }">
        <text class="ft-plus-num" :style="{ color: theme.ink1 }">+{{ kcal }}</text>
        <text class="ft-plus-unit" :style="{ color: theme.ink1 }">kcal</text>
        <text class="ft-sub" :style="{ color: theme.ink3 }">{{ tf('ft.added', [mealLabel]) }}</text>
      </view>
      <view class="ft-pill" :style="{ backgroundColor: theme.accent }">
        <text class="ft-pill-text" :style="{ color: theme.onAccent }">{{ t('ft.done') }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { watch } from 'vue'
import { onUnmounted } from 'vue'
import { useDeviceStore } from '../stores/device'
import { useSettingsStore } from '../stores/settings'
import { t, tf } from '../composables/i18n'
import { useTheme } from '../composables/useTheme'

/**
 * 添加成功 toast（设计稿 弹窗③）。
 * 出现即 L3 反馈（长触觉；音效资产缺失暂略）；2s 自动消失，点按立即关闭。
 */

const props = defineProps<{
  show: boolean
  kcal: number
  mealLabel: string
}>()

const emit = defineEmits<{
  (e: 'update:show', v: boolean): void
}>()

const device = useDeviceStore()
const settings = useSettingsStore()
const { theme } = useTheme()
const timer = ref(0)

function dismiss(): void {
  emit('update:show', false)
}

function arm(): void {
  if (timer.value > 0) {
    clearTimeout(timer.value)
    timer.value = 0
  }
  if (!props.show) return
  timer.value = setTimeout(() => {
    timer.value = 0
    emit('update:show', false)
  }, 2000) as unknown as number
}

watch(
  () => props.show,
  () => {
    arm()
  }
)

onUnmounted(() => {
  if (timer.value > 0) clearTimeout(timer.value)
})
</script>

<style>
.ft-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(10, 79, 61, 0.35);
  justify-content: center;
  align-items: center;
}
.ft-toast {
  align-items: center;
}
.ft-cup-circle {
  width: 144rpx;
  height: 144rpx;
  border-radius: 72rpx;
  justify-content: center;
  align-items: center;
  box-shadow: 0 16rpx 40rpx rgba(31, 191, 143, 0.4);
}
.ft-cup-glyph {
  font-size: 68rpx;
}
.ft-toast-card {
  flex-direction: row;
  align-items: center;
  border-radius: 36rpx;
  padding: 28rpx 44rpx;
  margin-top: 28rpx;
}
.ft-plus-num {
  font-size: 60rpx;
  font-weight: bold;
}
.ft-plus-unit {
  font-size: 28rpx;
  margin-left: 8rpx;
}
.ft-sub {
  font-size: 26rpx;
  margin-left: 20rpx;
}
.ft-pill {
  border-radius: 28rpx;
  padding-left: 36rpx;
  padding-right: 36rpx;
  height: 56rpx;
  justify-content: center;
  margin-top: 24rpx;
}
.ft-pill-text {
  font-size: 26rpx;
}
</style>
