  box-shadow: 0 16rpx 40rpx rgba(31, 191, 143, 0.4);
}
.ft-cup-glyph {
  font-size: 68rpx;
  color: #FFFFFF;
}
.ft-toast-card {
  flex-direction: row;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 36rpx;
  padding: 28rpx 44rpx;
  margin-top: 28rpx;
}
.ft-plus-num {
  font-size: 60rpx;
  font-weight: bold;
  color: #0A4F3D;
}
.ft-plus-unit {
  font-size: 28rpx;
  color: #0A4F3D;
  margin-left: 8rpx;
}
.ft-sub {
  font-size: 26rpx;
  color: #73918B;
  margin-left: 20rpx;
}
.ft-pill {
  background-color: #1FBF8F;
  border-radius: 28rpx;
  padding-left: 36rpx;
  padding-right: 36rpx;
  height: 56rpx;
  justify-content: center;
  margin-top: 24rpx;
}
