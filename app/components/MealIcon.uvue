<template>
  <view class="icon" :class="active ? 'on' : 'off'">
    <!-- 午餐：白圆环 25 + 白圆 13（太阳） -->
    <view v-if="type === 'lunch'" class="ring" />
    <view v-if="type === 'lunch'" class="l-dot" />
    <!-- 晚餐：白月牙近似（竖椭圆）+ 白点 80%（星星） -->
    <view v-if="type === 'dinner'" class="moon" />
    <view v-if="type === 'dinner'" class="star" />
    <!-- 早餐：碗线（横线 + 两条弧的近似） -->
    <view v-if="type === 'breakfast'" class="b-arc-top" />
    <view v-if="type === 'breakfast'" class="b-arc-mid" />
    <view v-if="type === 'breakfast'" class="b-line" />
    <!-- 加餐：白圆曲奇 + 4 颗灰点（设计稿 #8AA79C） -->
    <view v-if="type === 'snack'" class="cookie" />
    <view v-if="type === 'snack'" class="chip c1" />
    <view v-if="type === 'snack'" class="chip c2" />
    <view v-if="type === 'snack'" class="chip c3" />
    <view v-if="type === 'snack'" class="chip c4" />
  </view>
</template>

<script setup lang="uts">
const props = defineProps({
  /** 餐次类型：breakfast / lunch / dinner / snack */
  type: { type: String, default: 'breakfast' },
  /** true=已有记录（薄荷渐变底）；false=未记录（灰绿底） */
  active: { type: Boolean, default: true },
})
</script>

