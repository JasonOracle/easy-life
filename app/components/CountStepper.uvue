-->
<!--
  [变更日志]
  修改时间：2026-09-21
  AI模型：Qoder (Claude)
  修改内容：[按「计数步进器·规格」板补齐：能量条改三段静态渐变类（mint 渐变/amber/coral，
    阈值不变），条宽 240ms ease-out-back 过渡；数字变化 scale 1→1.12→1 160ms 弹跳；
    2026-09-21 Boss 实拍修复：.block 加 flex-shrink:0 防被 sheet 压扁]
-->
<!--
  [变更日志]
  修改时间：2026-09-21
  AI模型：Muse Spark
  修改内容：[新建：计数步进器（默认 3，上限 100，对数能量条＋阈值三色＋键入态＋截界抖动）；
    算法与阈值来自 food store（portionRatio/portionLevel/MAX_COUNT）]
-->

<template>
  <view class="block">
    <view class="row1">
      <view
        class="step-btn ui-pressable"
        :class="{ 'step-btn-disabled': count <= minCount }"
        hover-class="ui-pressed"
        :hover-stay-time="120"
        @click="stepDec"
      >
        <text class="step-glyph" :class="{ 'step-glyph-disabled': count <= minCount }">−</text>
      </view>
      <view
        class="capsule ui-pressable"
        :class="{ 'capsule-editing': editing, 'capsule-w2': digitCount === 2, 'capsule-w3': digitCount === 3 }"
        hover-class="ui-pressed"
        :hover-stay-time="120"
        @click="beginInput"
      >
        <text class="capsule-num" :class="{ 'capsule-num-small': digitCount === 3, 'capsule-num-pop': popping }" v-if="!editing">{{ count }}</text>
        <text class="capsule-unit" v-if="!editing">{{ unitLabel }}</text>
        <input
          v-if="editing"
          class="capsule-input"
          type="number"
          :value="inputText"
          @input="onInput"
          @confirm="commitInput"
          @blur="commitInput"
          :focus="editing"
        ></input>
      </view>
      <view
        class="step-btn ui-pressable"
        :class="{ 'step-btn-disabled': count >= maxCount }"
        hover-class="ui-pressed"
        :hover-stay-time="120"
        @click="stepInc"
      >
        <text class="step-glyph" :class="{ 'step-glyph-disabled': count >= maxCount }">＋</text>
      </view>
    </view>
    <view class="track" :class="{ 'track-shake': shaking }">
      <view class="fill" :class="barClass" :style="{ width: fillPct + '%' }"></view>
      <text class="tick" :style="{ left: '15%' }">1</text>
      <text class="tick" :style="{ left: '39%' }">5</text>
      <text class="tick" :style="{ left: '70%' }">25</text>
      <text class="tick" :style="{ left: '100%' }">100</text>
    </view>
    <text class="meta">每{{ unitLabel }} ≈ {{ gramsPerUnit }}g · {{ kcalPerUnit }} kcal</text>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { computed } from 'vue'
import { watch } from 'vue'
import { onUnmounted } from 'vue'
import { MAX_COUNT, portionRatio, portionLevel } from '../stores/food'
import { triggerHaptic } from '../stores/settings'

/**
 * 计数步进器（个/片/串）。
 * 能量条 p(n) = ln(1+n)/ln(101)；阈值 mint≤4 / amber 5–24 / coral≥25；
 * 上/下界按钮置灰＋轨道抖 4px；点数字进入键入态，clamp 到 [1,100]。
 */

const props = defineProps<{
  modelValue: number
  unitLabel: string
  gramsPerUnit: number
  kcalPerUnit: number
}>()

const emit = defineEmits<{
  (e: 'update:modelValue', v: number): void
}>()

const minCount = 1
const maxCount = MAX_COUNT
const count = computed(() => props.modelValue)
const editing = ref(false)
const inputText = ref('')
const shaking = ref(false)
const popping = ref(false)
let shakeTimer = 0
let popTimer = 0
let dismissTimer = 0

const digitCount = computed(() => count.value.toString().length)
const fillPct = computed(() => Math.round(portionRatio(count.value) * 1000) / 10)
const barClass = computed(() => {
  const lv = portionLevel(count.value)
  if (lv === 1) return 'fill-amber'
  if (lv === 2) return 'fill-coral'
  return 'fill-mint'
})

watch(count, () => {
  popping.value = false
  if (popTimer > 0) clearTimeout(popTimer)
  popping.value = true
  popTimer = setTimeout(() => {
    popping.value = false
    popTimer = 0
  }, 170) as unknown as number
})

function clamp(n: number): number {
  if (n < minCount) return minCount
  if (n > maxCount) return maxCount
  return Math.round(n)
}

function shake(): void {
  shaking.value = false
  if (shakeTimer > 0) {
    clearTimeout(shakeTimer)
    shakeTimer = 0
  }
  shaking.value = true
  triggerHaptic('heavy')
  shakeTimer = setTimeout(() => {
    shaking.value = false
    shakeTimer = 0
  }, 300) as unknown as number
}

function stepDec(): void {
  if (editing.value) return
  const next = count.value - 1
  if (next < minCount) {
    shake()
    return
  }
  triggerHaptic('light')
  emit('update:modelValue', next)
}

function stepInc(): void {
  if (editing.value) return
  const next = count.value + 1
  if (next > maxCount) {
    shake()
    return
  }
  triggerHaptic('light')
  emit('update:modelValue', next)
}

function beginInput(): void {
  triggerHaptic('light')
  inputText.value = count.value.toString()
  editing.value = true
}

function onInput(e: { detail: { value: string } }): void {
  inputText.value = e.detail.value
}

function commitInput(): void {
  if (!editing.value) return
  editing.value = false
  const v = parseInt(inputText.value, 10)
  if (isNaN(v)) return
  emit('update:modelValue', clamp(v))
}

onUnmounted(() => {
  if (shakeTimer > 0) clearTimeout(shakeTimer)
  if (popTimer > 0) clearTimeout(popTimer)
  if (dismissTimer > 0) clearTimeout(dismissTimer)
})
</script>

<style>
.block {
  border-radius: 40rpx;
  padding: 32rpx 28rpx 24rpx 28rpx;
  flex-shrink: 0;
}
.row1 {
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}
.step-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #FFFFFF;
  justify-content: center;
  align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(26, 102, 77, 0.1);
}
.step-btn-disabled {
  box-shadow: none;
}
.step-glyph {
  font-size: 40rpx;
  color: #0A7A5C;
}
.step-glyph-disabled {
  color: #A9BAB3;
}
.capsule {
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  background-color: #FFFFFF;
  border-radius: 44rpx;
  min-width: 178rpx;
  height: 104rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}
.capsule-w2 {
  min-width: 198rpx;
}
.capsule-w3 {
  min-width: 220rpx;
}
.capsule-editing {
  border-width: 2px;
  border-color: #1FBF8F;
}
.capsule-num {
  font-size: 68rpx;
  font-weight: bold;
  color: #0A4F3D;
}
.capsule-num-small {
  font-size: 60rpx;
}
.capsule-unit {
  font-size: 26rpx;
  color: #8FAEAF;
  margin-left: 4rpx;
}
.capsule-input {
  font-size: 60rpx;
  color: #0A4F3D;
  width: 140rpx;
  text-align: center;
}
.track {
  position: relative;
  height: 16rpx;
  border-radius: 8rpx;
  background-color: #DCEDE6;
  margin: 28rpx 48rpx 0 48rpx;
}
.fill {
  height: 16rpx;
  border-radius: 8rpx;
  transition-property: width;
  transition-duration: 240ms;
  transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
}
.fill-mint {
  background-image: linear-gradient(90deg, #7DEBC7, #1FBF8F);
}
.fill-amber {
  background-color: #E8B54D;
}
.fill-coral {
  background-color: #FF9E7D;
}
.tick {
  position: absolute;
  top: 24rpx;
  font-size: 20rpx;
  color: #8FAEAF;
}
.meta {
  font-size: 24rpx;
  color: #73918B;
  text-align: center;
  margin-top: 52rpx;
}
</style>
