
<template>
  <view class="tray">
    <view
      class="opt ui-pressable"
      hover-class="ui-pressed"
      :hover-stay-time="120"
      v-for="(optItem, optIdx) in options"
      :key="optIdx"
      @click="select(optItem.key)"
    >
      <view class="float" :class="{ 'float-on': optItem.key === modelValue, 'float-card': optItem.key === modelValue && optItem.art === '' }">
        <view class="art-wrap" v-if="optItem.art !== ''">
          <view
            class="halo"
            v-if="optItem.key === modelValue"
            :style="{ width: haloW(optItem) + 'px', height: haloH(optItem) + 'px', marginLeft: (-haloW(optItem) / 2) + 'px', top: (optItem.artH - haloH(optItem)) / 2 + 'px' }"
          ></view>
          <view class="art-row">
            <image
              class="opt-art"
              v-for="(unitNum, unitIdx) in optItem.count"
              :key="unitIdx"
              :src="optItem.art"
              mode="aspectFit"
              :style="{ width: optItem.artW + 'px', height: optItem.artH + 'px', opacity: optItem.key === modelValue ? 1 : (optItem.solid ? 0.85 : 0.62) }"
            ></image>
          </view>
          <image
            v-if="optItem.key === modelValue"
            class="opt-shadow"
            :src="'/static/common/shadow512.png'"
            mode="scaleToFill"
            :style="{ width: shadowW(optItem) + 'px', height: shadowH(optItem) + 'px', marginLeft: (-shadowW(optItem) / 2) + 'px', bottom: (2 - shadowH(optItem) / 2) + 'px' }"
          ></image>
        </view>
        <text class="opt-name" :class="{ 'opt-name-on': optItem.key === modelValue }">{{ optItem.label }}</text>
        <text class="opt-sub" :class="{ 'opt-sub-on': optItem.key === modelValue }" v-if="optItem.sub !== ''">{{ optItem.sub }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
/**
 * 单选底槽（分量/糖包等单选组通用）。
 * 设计哲学（pOYw3）：「去卡片、用体积与光」——选中件不套白卡，靠 抬升＋光晕＋落地影＋文字加粗 表达；
 * 光晕/落地影按素材体积公式动态算（接触宽逐素材，由调用方随 TrayOption.contact 传入）。
 * 未选中压暗：透明/浅色素材 0.62，实心不透明素材（金属砝码）0.85。
 * 动效：220ms 位移/透明过渡；选中 scale 0.94→1 弹性入场。
 */

import { playSound, triggerHaptic } from '../stores/settings'

export type TrayOption = {
  key: string
  label: string
  sub: string
  art: string
  artW: number
  artH: number
  /** 并排颗数（砝码类 1/2/3 颗；常规为 1） */
  count: number
  /** 接触宽系数（设计实测：瓶0.93/罐0.93/碗0.64/盘0.49/杯0.64/串0.13） */
  contact: number
  /** 实心不透明素材（未选中压暗 0.85 而非 0.62） */
  solid: boolean
}

const props = defineProps<{
  options: TrayOption[]
  modelValue: string
}>()

const emit = defineEmits<{
  (e: 'update:modelValue', v: string): void
}>()

/** 组宽：多颗砝码按整排算（颗间 4px） */
function groupW(opt: TrayOption): number {
  return opt.artW * opt.count + 4 * (opt.count - 1)
}

function haloW(opt: TrayOption): number {
  return Math.round(groupW(opt) * 1.5)
}

function haloH(opt: TrayOption): number {
  return Math.round(Math.max(opt.artH * 1.35, groupW(opt) * 0.45))
}

function shadowW(opt: TrayOption): number {
  const ar = groupW(opt) / opt.artH
  const k = ar >= 1.6 ? 1.5 : 1.35
  return Math.round(groupW(opt) * opt.contact * k)
}

function shadowH(opt: TrayOption): number {
  return Math.max(10, Math.round(shadowW(opt) * 0.16))
}

function select(key: string): void {
  if (key === props.modelValue) {
    triggerHaptic('light')
    return
  }
  playSound('card')
  emit('update:modelValue', key)
  triggerHaptic('light')
}
</script>

<style>
.tray {
  flex-direction: row;
  border-radius: 40rpx;
  padding: 24rpx 20rpx;
  flex-shrink: 0;
}
.opt {
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  position: relative;
  padding-top: 20rpx;
  padding-bottom: 12rpx;
  overflow: visible;
}
.art-wrap {
  position: relative;
  align-items: center;
  overflow: visible;
}
.halo {
  position: absolute;
  left: 50%;
  border-radius: 90rpx;
  background-color: rgba(46, 207, 160, 0.22);
}
.art-row {
  flex-direction: row;
  align-items: flex-end;
}
.float {
  align-items: center;
  border-radius: 28rpx;
  padding: 16rpx 12rpx;
  overflow: visible;
  flex-shrink: 0;
  transform: translateY(0px);
  transition-property: transform, background-color, box-shadow;
  transition-duration: 220ms;
}
.float-on {
  transform: translateY(-8rpx);
}
.float-card {
  background-color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(10, 79, 61, 0.25);
}
.opt-art {
  margin-left: 4rpx;
  margin-right: 4rpx;
  transition-property: opacity;
  transition-duration: 220ms;
}
.opt-name {
  font-size: 26rpx;
  color: #73918B;
  margin-top: 12rpx;
}
.opt-name-on {
  color: #0A4F3D;
  font-weight: bold;
}
.opt-sub {
  font-size: 22rpx;
  color: #8FAEAF;
  margin-top: 4rpx;
}
.opt-sub-on {
  color: #0A7A5C;
}
.opt-shadow {
  position: absolute;
  left: 50%;
}
</style>
