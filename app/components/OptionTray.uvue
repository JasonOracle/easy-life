
<template>
  <view class="tray">
    <view
      class="opt ui-pressable"
      hover-class="ui-pressed"
      :hover-stay-time="120"
      v-for="(optItem, optIdx) in options"
      :key="optIdx"
      @click="select(optItem.key)"
    >
      <view class="float" :class="{ 'float-on': optItem.key === modelValue, 'float-card': optItem.key === modelValue && optItem.art === '' }" :style="floatStyle(optItem.key === modelValue, optItem.art === '')">
        <view class="art-wrap" v-if="optItem.art !== ''">
          <view class="art-row">
            <image
              class="opt-art"
              v-for="(unitNum, unitIdx) in optItem.count"
              :key="unitIdx"
              :src="optItem.art"
              mode="aspectFit"
              :style="{ width: optItem.artW + 'px', height: optItem.artH + 'px', opacity: optItem.key === modelValue ? 1 : (optItem.solid ? 0.85 : 0.62) }"
            ></image>
          </view>
        </view>
        <text class="opt-name" :class="{ 'opt-name-on': optItem.key === modelValue }" :style="{ color: nameColor(optItem.key === modelValue) }">{{ optItem.label }}</text>
        <text class="opt-sub" :class="{ 'opt-sub-on': optItem.key === modelValue }" :style="{ color: subColor(optItem.key === modelValue) }" v-if="optItem.sub !== ''">{{ optItem.sub }}</text>
        <view class="opt-underline" v-if="optItem.key === modelValue" :style="{ backgroundColor: theme.accent }"></view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
// [变更日志] 2026-09-24: 选中态去色块 → 废弃 .halo 实心光晕与 shadow512.png 薄荷色落地影（贴图本身 #0A4F3D 调，白底渲染成绿光），选中态＝抬升＋文字加粗＋薄荷绿下划短线 .opt-underline；日志落位 script 内（ADR-003 #7）
/**
 * 单选底槽（分量/糖包等单选组通用）。
 * 设计哲学（pOYw3）：「去卡片」——选中件不套白卡、不用任何垫底色块，靠 抬升＋文字加粗＋薄荷绿下划短线 表达。
 * 未选中压暗：透明/浅色素材 0.62，实心不透明素材（金属砝码）0.85。
 * 动效：220ms 位移/透明过渡；选中 scale 0.94→1 弹性入场。
 */

import { playSound, triggerHaptic } from '../stores/settings'
import { useTheme } from '../composables/useTheme'

export type TrayOption = {
  key: string
  label: string
  sub: string
  art: string
  artW: number
  artH: number
  /** 并排颗数（砝码类 1/2/3 颗；常规为 1） */
  count: number
  /** 接触宽系数（设计实测：瓶0.93/罐0.93/碗0.64/盘0.49/杯0.64/串0.13） */
  contact: number
  /** 实心不透明素材（未选中压暗 0.85 而非 0.62） */
  solid: boolean
}

const props = defineProps<{
  options: TrayOption[]
  modelValue: string
}>()

const emit = defineEmits<{
  (e: 'update:modelValue', v: string): void
}>()

const { theme, isDark } = useTheme()

/** 选中件＝抬升＋加粗＋下划短线；无器皿图时补一层卡面（暗档改走更亮的 chip 以免比未选态更暗） */
function floatStyle(on: boolean, noArt: boolean): Record<string, string> {
  const st = {} as Record<string, string>
  if (on && noArt) {
    st['background-color'] = isDark.value ? theme.value.chip : theme.value.card
  }
  return st
}

function nameColor(on: boolean): string {
  return on ? theme.value.ink1 : theme.value.ink3
}
function subColor(on: boolean): string {
  return on ? theme.value.accentDeep : theme.value.ink3
}

function select(key: string): void {
  if (key === props.modelValue) {
    triggerHaptic('light')
    return
  }
  playSound('card')
  emit('update:modelValue', key)
  triggerHaptic('light')
}
</script>

<style>
.tray {
  flex-direction: row;
  border-radius: 40rpx;
  padding: 24rpx 20rpx;
  flex-shrink: 0;
}
.opt {
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  position: relative;
  padding-top: 20rpx;
  padding-bottom: 12rpx;
  overflow: visible;
}
.art-wrap {
  position: relative;
  align-items: center;
  overflow: visible;
}
.art-row {
  flex-direction: row;
  align-items: flex-end;
}
.float {
  align-items: center;
  border-radius: 28rpx;
  padding: 16rpx 12rpx;
  overflow: visible;
  flex-shrink: 0;
  transform: translateY(0px);
  transition-property: transform, background-color, box-shadow;
  transition-duration: 220ms;
}
.float-on {
  transform: translateY(-8rpx);
}
.float-card {
  box-shadow: 0 10rpx 24rpx rgba(10, 79, 61, 0.25);
}
.opt-art {
  margin-left: 4rpx;
  margin-right: 4rpx;
  transition-property: opacity;
  transition-duration: 220ms;
}
.opt-name {
  font-size: 26rpx;
  margin-top: 12rpx;
}
.opt-name-on {
  font-weight: bold;
}
.opt-sub {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.opt-sub-on {
}
/* 选中态唯一色彩信号：文字下方居中的薄荷绿短线（替代旧 halo 实心光晕色块，
   白底器皿图叠色块观感差；uvue 无伪元素/radial-gradient，短线是最稳的表达） */
.opt-underline {
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-top: 10rpx;
}
</style>
