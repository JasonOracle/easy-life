<!-- [变更日志] 三 Tab 悬浮玻璃胶囊；2026-09-25 标签色／暗态胶囊底改逐元素 :style 下发（App 端无后代选择器，原 MP 暗态规则在 App 上是死代码）；图标换 /static/tab 矢量资产并按 (accent, mode) 取变体；2026-09-28 外层胶囊提白到 80%＋App 端放开真磨砂（backdrop-filter 原被 #ifdef MP-WEIXIN 挡在 App 外，蒸汽模式 5.25+ 本就支持）；选中气泡改主题色淡染（外层提白后 18% 白只差 1.8% 亮度，靠色相区分）；未选中标签/图标 #8A8A8A→#5F6B66 保对比度；2026-09-28 v2 老板拍板改「参考实现的两层结构」——胶囊 80%→52% 白(真透)＋新增全宽托底渐隐条承担可读性，选中气泡删描边/投影/自身blur只留 accent 12% 淡染，胶囊加 inset 内高光、模糊降为单层；2026-09-28(3) 修编译报错——App 端 backdrop-filter 只接受 `none`|`blur()`，原 blur20/saturate150% 触发 ERROR 且整条失效，App 侧改裸 blur(20px)、饱和增强版隔离进 MP-WEIXIN，-webkit- 前缀同移出 App；2026-09-28(4) 撤掉「全宽托底渐隐条」——实测它有真实高度时会吃掉屏幕底部整条的页面点击（带内 0 命中 / 带外对照 2 命中），而 App 端 pointer-events:none 连子级一起屏蔽、无法只让背景穿透，故组件根节点回归胶囊本体；2026-09-28(5) 修「向上柔影从未渲染」——`box-shadow` 里带 `inset` 会让**整条声明失效**（拍平引擎不支持 inset），去掉 inset 后单值外阴影 0.18 正常，胶囊在近白页面上终于有了可见的悬浮边；2026-09-28(6) 选中气泡底色由 accent 12% 淡染改为**中性反差**（浅态 rgba(26,26,26,0.08) 加暗／暗态 13% 白加亮）——对齐参考实现 tab-bar.vue 的 `.active` 规则，品牌色只由图标/文字承担，accentTint() 一并删除 -->
<template>
  <!-- 根节点＝胶囊本体（几何由 :style 逐帧下发）。
       ⚠️ 不要在外面再包一层容器：①零高度（height:0）的 fixed 父级会把后代整棵裁掉
       （Android ViewGroup 默认 clipChildren，实测 fixed 子节点也一起消失）；
       ②有真实高度的全宽父级会挡住屏幕底部整条的页面点击（实测：带内点击 0 命中、带外对照 2 命中），
       而 App 端 pointer-events:none 会连子级一起屏蔽、无法只让背景穿透。 -->
  <view class="tb-bar" :class="barClass" :style="barStyle">
    <!-- 选中气泡：稿面完全内嵌于胶囊（上下各留 6、左右各留 4），几何由 :style 逐帧下发 -->
      <view class="tb-bubble" :class="bubbleClass" :style="bubbleStyle"></view>
      <view class="tb-item" @click="onTap(0)">
        <image class="tb-ic tb-ic-home" :src="iconSrc(0)" mode="aspectFit"></image>
        <text class="tb-label" :style="{ color: labelColor(0) }">{{ tabLabels.home }}</text>
      </view>
      <view class="tb-item" @click="onTap(1)">
        <image class="tb-ic tb-ic-rec" :src="iconSrc(1)" mode="aspectFit"></image>
        <text class="tb-label" :style="{ color: labelColor(1) }">{{ tabLabels.records }}</text>
      </view>
      <view class="tb-item" @click="onTap(2)">
        <image class="tb-ic tb-ic-me" :src="iconSrc(2)" mode="aspectFit"></image>
        <text class="tb-label" :style="{ color: labelColor(2) }">{{ tabLabels.me }}</text>
      </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref, onMounted } from 'vue'
import { useDeviceStore } from '../stores/device'
import { t } from '../composables/i18n'
import { useTheme, themeAsset } from '../composables/useTheme'

const props = defineProps<{
  /** 当前激活页：home | records | profile */
  active: string
}>()

// ── 稿面几何（DesignTokens §7.2，按 750rpx 规范自适应，基准宽 750rpx 对应 375dp）────
const device = useDeviceStore()
const glass = computed((): boolean => device.backdropBlur)
const { theme, isDark, accentId } = useTheme()

type TabLabels = { home: string, records: string, me: string }
const tabLabels = computed((): TabLabels => {
  const L: TabLabels = { home: t('tab.home'), records: t('tab.records'), me: t('tab.me') }
  return L
})

const KEYS = ['home', 'records', 'profile']
const PAGES = ['home/Home', 'records/Records', 'profile/Profile']
/** 气泡飞行起点（上一个 Tab 的下标）跨页载体：redirectTo 会重挂载组件，模块级状态在小程序端不可靠 */
const ORIGIN_KEY = 'ct_tab_origin'
// 矢量底稿（toolchain/gen_tab_icons 系），变体由 gen_theme_variants.py 按 (accent, mode) 五档生成
const ICONS = [
  ['/static/tab/tab_home.svg', '/static/tab/tab_home_sel.svg'],
  ['/static/tab/tab_calendar.svg', '/static/tab/tab_calendar_sel.svg'],
  ['/static/tab/tab_profile.svg', '/static/tab/tab_profile_sel.svg']
]

function readOrigin(): number {
  let from = -1
  try {
    const raw = uni.getStorageSync(ORIGIN_KEY)
    if (typeof raw === 'string') {
      const n = parseInt(raw)
      if (!isNaN(n)) from = n
    }
    // 一次性消费：读完即清，冷启动才不会拿上次会话的残留起点乱飞
    uni.removeStorageSync(ORIGIN_KEY)
  } catch (e) {
    // 存储不可用时不做飞入动画
  }
  return from
}

function writeOrigin(idx: number): void {
  try {
    uni.setStorageSync(ORIGIN_KEY, '' + idx)
  } catch (e) {
    // 同上，起点丢了只是这一次不飞
  }
}

const myIdx = computed((): number => {
  const i = KEYS.indexOf(props.active)
  return i < 0 ? 0 : i
})

// ── 运行时尺寸（严格按 750rpx 比例等比映射到实际屏幕宽度）：──────────────────────
const sys = uni.getSystemInfoSync()
const scaleRatio = sys.windowWidth / 750
const MARGIN = 32 * scaleRatio       // 32rpx 左右边距
const BAR_H = 112 * scaleRatio       // 112rpx 胶囊高
const BUB_W = 192 * scaleRatio       // 192rpx 气泡静止宽
const BUB_H = 88 * scaleRatio        // 88rpx 气泡静止高
const S_PRESS = 0.96   // 按下
const S_TRAVEL_X = 1.12 // 移动：横向拉伸
const S_TRAVEL_Y = 0.94 // 移动：纵向压扁
const S_SETTLE_X = 1.06 // 落位：过冲
const S_SETTLE_Y = 0.97

const slotW = (sys.windowWidth - MARGIN * 2) / 3
const baseW = Math.min(BUB_W, slotW - 8 * scaleRatio)
const safeBottom = sys.safeAreaInsets?.bottom ?? 0

function centerOf(idx: number): number {
  return slotW * (idx + 0.5)
}

/** 按下态气泡所在槽（＝上一页的 Tab）；其余阶段气泡恒指向本页槽位 */
const anchorIdx = ref<number>(myIdx.value)
/** rest | press | travel | settle —— 与稿面四关键帧一一对应 */
const phase = ref<string>('rest')

// 入场起点必须在 setup 内同步定：首帧就得画在「上一页那一格」，
// 放 onMounted 会让气泡先在目标槽闪一帧再跳回起点（automator 采样实测到）
const enterFrom = readOrigin()
if (enterFrom >= 0 && enterFrom != myIdx.value) {
  anchorIdx.value = enterFrom
  phase.value = 'press'
}

/** 胶囊底边距视口底：有小白条＝贴在安全区上方 24rpx（稿面「距 Home 指示条 12px」）；无小白条＝44rpx 离底 */
const barBottomPx = safeBottom > 0 ? safeBottom + 24 * scaleRatio : 44 * scaleRatio

const barStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['left'] = MARGIN + 'px'
  st['right'] = MARGIN + 'px'
  // 暗态胶囊底走 token（各主题 card 加 alpha），浅态由 .tb-glass/.tb-flat 类承担
  if (isDark.value) st['background-color'] = theme.value.tbBarDark
  st['bottom'] = barBottomPx + 'px'
  st['height'] = BAR_H + 'px'
  return st
})

const bubbleStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  let w = baseW
  let h = BUB_H
  if (phase.value == 'press') {
    w = baseW * S_PRESS
    h = BUB_H * S_PRESS
  } else if (phase.value == 'travel') {
    w = baseW * S_TRAVEL_X
    h = BUB_H * S_TRAVEL_Y
  } else if (phase.value == 'settle') {
    w = baseW * S_SETTLE_X
    h = BUB_H * S_SETTLE_Y
  }
  // 左边缘由宽反算＝压扁／拉伸天然居中
  const at = phase.value == 'press' ? anchorIdx.value : myIdx.value
  st['left'] = (centerOf(at) - w / 2) + 'px'
  st['top'] = ((BAR_H - h) / 2) + 'px'
  st['width'] = w + 'px'
  st['height'] = h + 'px'
  // 底色在运行时下发（不写成 .a.b 复合类选择器：App 端只认单类），取值＝DesignTokens §7.2
  const dm = isDark.value
  // 选中态＝**中性反差**，不带品牌色相（对齐参考实现 tab-bar.vue 的 `.active { background: rgba(26,26,26,0.08) }`）：
  //   浅态玻璃档 → 8% 黑加暗；暗态玻璃档 → 13% 白加亮。两态都只改明度、不动色相。
  // 不用 accent 染底：品牌色铺在气泡上会让「选中」读成「一块绿」，且与「真透玻璃」的预期相悖；
  // 品牌色的表达交给图标与文字（见 labelColor → tbTextOn），与参考实现用蓝字而非蓝底同理。
  st['background-color'] = glass.value
    ? (dm ? 'rgba(255, 255, 255, 0.13)' : 'rgba(26, 26, 26, 0.08)')
    : 'rgba(255, 255, 255, 0.88)'
  // #ifdef MP-WEIXIN
  st['transition-property'] = 'left, width, height'
  st['transition-timing-function'] = 'cubic-bezier(0.34, 1.56, 0.64, 1)'
  st['transition-duration'] = phase.value == 'press' ? '90ms'
    : (phase.value == 'travel' ? '320ms' : (phase.value == 'settle' ? '120ms' : '140ms'))
  // #endif
  return st
})

const barClass = computed((): string[] => {
  const c = ['tb-bar'] as string[]
  c.push(glass.value ? 'tb-glass' : 'tb-flat')
  if (isDark.value) c.push('tb-dark')
  return c
})

/** 玻璃档气泡只靠 :style 下发的中性反差底色区分（描边/投影/自身 blur 已全删）；
 *  flat 降级档底为不透明 #F8FCFA，气泡必须保留描边＋投影才看得出选中态 */
const bubbleClass = computed((): string[] => {
  const c = ['tb-bubble'] as string[]
  if (!glass.value) c.push('tb-bub-flat')
  return c
})

function iconSrc(idx: number): string {
  const base = idx == myIdx.value ? ICONS[idx][1] : ICONS[idx][0]
  return themeAsset(accentId.value, isDark.value, base)
}

/** 逐元素下发文字色：App 端无后代选择器，浅档未选＝#5F6B66，暗档＝该档 ink3
 *  2026-09-28：#8A8A8A 压在外层 80% 白上只有 2.6:1（WCAG 要 4.5:1），
 *  加深到 #5F6B66 后底纹浅时 ≈5.4:1、中灰时 4.4:1；同色的 tab_*.svg 底稿一并改 */
function labelColor(idx: number): string {
  if (idx == myIdx.value) return theme.value.tbTextOn
  return isDark.value ? theme.value.ink3 : '#5F6B66'
}

/** 入场时间线：起点态已在 setup 内就位（press＋anchorIdx），此处只推进 移动→落位→静止 三段 */
function playEnter(): void {
  setTimeout(() => {
    phase.value = 'travel'
    setTimeout(() => {
      phase.value = 'settle'
      setTimeout(() => {
        phase.value = 'rest'
      }, 120)
    }, 320)
  }, 16)
}

onMounted(() => {
  if (phase.value == 'press' && anchorIdx.value != myIdx.value) {
    playEnter()
  }
})

function onTap(idx: number): void {
  if (idx == myIdx.value) return
  // L1 反馈（切 Tab）：按下压扁动画，震动已按指令统一移除
  anchorIdx.value = myIdx.value
  phase.value = 'press'
  writeOrigin(myIdx.value)
  // 90ms＝稿面「静止→按下」时长，让压扁被看见一瞬再换页（换页后由新页继续飞入→落位）
  setTimeout(() => {
    uni.redirectTo({ url: '/pages/' + PAGES[idx] })
  }, 90)
}
</script>

<style>
/* ── 胶囊：悬浮、四周留空气，靠朝上柔影与背景模糊撑起体积。
   自 2026-09-28 起它同时是组件根节点（不再套外层容器，原因见模板注释） ── */
.tb-bar {
  position: fixed;
  z-index: 30;
  flex-direction: row;
  border-radius: 56rpx;
  /* 不设 overflow:hidden：①背景自带圆角裁切，本元素无需裁子节点；②app-ios 上 box-shadow 与
     overflow:hidden 互斥（官方文档），去掉可避免阴影在 iOS 失效 */
}
/* 玻璃档（backdropBlur=true）：**未选中区域＝不太透明的白色磨砂**（68% 白 ＋ 顶部折光兼作内高光
   ＋ 白描边）；选中格的「更高透」由气泡叠一层中性加暗实现（见 bubbleStyle），本元素只提供白底。
   参数对齐参考实现 tab-bar.vue：容器 rgba(255,255,255,0.5) 渐变 ＋ blur，选中格叠 rgba(26,26,26,0.08)。
   提白到 68% 的原因：页面底本身就是近白（#F6FBF8），50% 白合成后只高 5 级、读不出「白磨砂」；
   参考实现是靠 wrapper 上那条不透明底部渐变托底才显得出白，而 App 端做不了全宽托底层（会吃点击）。 */
.tb-glass {
  background-color: rgba(255, 255, 255, 0.68);
  background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0) 45%);
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
  border-top-color: rgba(255, 255, 255, 0.8);
  border-right-color: rgba(255, 255, 255, 0.8);
  border-bottom-color: rgba(255, 255, 255, 0.8);
  border-left-color: rgba(255, 255, 255, 0.8);
  border-style: solid;
  /* ⚠️ 拍平(Vapor/蒸汽)引擎不支持 inset——**同一条声明里只要出现 inset，整条 box-shadow 都会被丢弃**
     （2026-09-28 实测：inset + 外阴影 → 胶囊上缘零压暗，与页面底逐像素相同；删掉 inset 只留单值 0.55 →
     立刻出现 −87 级暗带）。故只保留这一条外阴影：它是近白页面上**唯一**能让胶囊被看见的手段
     （纯白叠近白，alpha 从 0.20 到 1.00 也只能拉开 2~9 级 R 差）。原「左上 inset 内高光」由上面的
     顶部折光渐变承担（背景渐变在拍平引擎上正常）。
     档位：**小模糊 + 低 alpha**。原稿 48rpx/0.14 与实测 48rpx/0.18 都会「透过半透胶囊」——
     0.18 时胶囊内底降到 (215,227,224)、比页面底 (236,244,240) 还暗，看着像灰玻璃而非白玻璃；
     改 12rpx/0.12 让暗影只贴外沿（约 10px），内部保持干净。*/
  /* 深阴影（原稿 48rpx/0.14 与实测 0.18、12rpx/0.12 三档）在真机上都会**透过 52% 半透胶囊**，
     把内部压到比页面底还暗（实测 215~223 vs 236~246）＝看着像灰玻璃，与「带一点白色」相反。
     外阴影必然画在元素身下，半透元素避不开——故浅色态改用**白色光晕**：透过胶囊只会更亮（兼作内高光），
     外侧也只是一圈极淡的提亮，在近白页面上 Δ≤+9。 */
  box-shadow: 0 -6rpx 20rpx rgba(255, 255, 255, 0.9);
}
/* 真磨砂：Web 4.0+ / App 蒸汽模式(Vapor) 5.25+ / 微信小程序 支持（VDOM 端静默无效）。
   2026-09-28 前这组被 #ifdef MP-WEIXIN 挡在 App 外，真机上只有半透白、没有磨砂。
   ⚠️ App 端 uvue-css 编译器对 backdrop-filter 只接受 `none` | `blur()`：
      写 saturate() → ERROR「not supported for backdrop-filter」且整条声明失效；
      写 -webkit- 前缀 → WARNING「not a standard property name」。
   故 App 侧只留裸 blur(20px)；带饱和增强的版本隔离到 MP-WEIXIN（真 WebView，两条都认）。 */
.tb-glass {
  backdrop-filter: blur(20px);
}
/* #ifdef MP-WEIXIN */
.tb-glass {
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  backdrop-filter: blur(20px) saturate(150%);
}
/* #endif */
/* 降级档（low 机／无模糊能力）：稿面「胶囊改不透明 #F8FCFA」，折光与投影保留 */
.tb-flat {
  background-color: #F8FCFA;
  background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0) 45%);
  box-shadow: 0 -8rpx 48rpx rgba(10, 79, 61, 0.14);
}
/* 暗黑档材质：折光与描边为中性白、投影改向下黑；胶囊底色由 :style 按主题 card 下发 */
.tb-dark {
  background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0) 45%);
  border-top-color: rgba(255, 255, 255, 0.1);
  border-right-color: rgba(255, 255, 255, 0.1);
  border-bottom-color: rgba(255, 255, 255, 0.1);
  border-left-color: rgba(255, 255, 255, 0.1);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.3);
}

/* ── 三颗 Tab：图标在左、文字在右 ── */
.tb-item {
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  position: relative;
  z-index: 2;
}
.tb-ic {
  width: 44rpx;
  height: 44rpx;
}
/* 源图留白不等，按稿面逐个回调到视觉等大 */
.tb-ic-home {
  width: 44rpx;
  height: 44rpx;
}
.tb-ic-rec {
  width: 46rpx;
  height: 46rpx;
}
.tb-ic-me {
  width: 47rpx;
  height: 47rpx;
}
.tb-label {
  font-size: 24rpx;
  font-weight: bold;
  color: #5F6B66;
  margin-left: 12rpx;
}

/* ── 选中气泡 ── */
.tb-bubble {
  position: absolute;
  z-index: 1;
  border-radius: 44rpx;
}
/* 玻璃档气泡：不设任何描边／投影／自身模糊——只靠 :style 下发的中性反差底色区分选中
   （浅态 8% 黑加暗、暗态 13% 白加亮，见 bubbleStyle）。那三样叠加会把气泡撑成实心色块。
   文字色高亮过渡仍留在下面（仅小程序需要） */
/* #ifdef MP-WEIXIN */
/* 图标／文字高亮比气泡晚 40ms */
.tb-label {
  transition-property: color;
  transition-duration: 120ms;
  transition-delay: 40ms;
}
/* #endif */
.tb-bub-flat {
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
  border-style: solid;
  border-color: #E3EFE8;
  box-shadow: 0 8rpx 28rpx rgba(10, 79, 61, 0.1);
}

</style>
