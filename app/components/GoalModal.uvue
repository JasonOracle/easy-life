  width: 239px;
  height: 8px;
  border-radius: 4px;
  background-color: #DCEDE6;
}
/* 稿面 RFYeq：渐变 #7DEBC7→#1FBF8F，宽=ratio*239 */
.gm-fill {
  position: absolute;
