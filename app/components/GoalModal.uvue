}
/* 稿面 DUI7r：整卡宽居中，BigNum 46/700 与 unit 13.5/600 底部对齐，gap6；
   左右让开 −/＋钮 */
.gm-numrow {
  position: absolute;
  left: 176rpx;
  right: 176rpx;
  top: 32rpx;
  height: 112rpx;
  flex-direction: row;
  justify-content: center;
  align-items: flex-end;
}
