<template>
  <view class="gm-overlay" :class="{ 'gm-overlay-active': active }" v-if="render" @click="onOverlayTap">
    <view class="gm-container" :class="{ 'gm-container-active': active }" @click.stop>
      <view class="gm-sheet">
      <view class="gm-head">
        <view class="gm-badge">
          <image class="gm-badge-ic" :src="'/static/goal/gm_target.png'" mode="aspectFit"></image>
        </view>
        <view class="gm-headtxt">
          <text class="gm-title">设置每日热量目标</text>
          <text class="gm-sub">根据你的目标，调整每日摄入热量</text>
        </view>
        <view class="gm-closebtn" @click="close">
          <image class="gm-close-ic" :src="'/static/goal/gm_close.png'" mode="aspectFit"></image>
        </view>
      </view>

      <view class="gm-dial" id="gm-dial">
        <view class="gm-stepbtn ui-pressable" :class="{ 'gm-stepbtn-off': picked <= MIN }" hover-class="ui-pressed" :hover-stay-time="120" @click="step(-1)">
          <image class="gm-step-ic" :src="'/static/goal/gm_minus.png'" mode="aspectFit"></image>
        </view>
        <view class="gm-stepbtn gm-stepbtn-r ui-pressable" :class="{ 'gm-stepbtn-off': picked >= MAX }" hover-class="ui-pressed" :hover-stay-time="120" @click="step(1)">
          <image class="gm-step-ic" :src="'/static/goal/gm_plus.png'" mode="aspectFit"></image>
        </view>
        <view class="gm-numrow">
          <text class="gm-bignum" :class="statusStyle.textClass">{{ picked }}</text>
          <text class="gm-unit" :class="statusStyle.textClass">kcal</text>
        </view>
        <view
          class="gm-dragzone"
          @touchstart="onDragStart"
          @touchmove="onDragMove"
          @touchend="onDragEnd"
          @touchcancel="onDragEnd"
        >
          <view class="gm-track"></view>
          <view class="gm-fill" :class="statusStyle.bgClass" :style="{ width: fillW + 'px' }"></view>
          <view class="gm-thumb" :style="{ left: (TRACK_X + fillW - 10) + 'px', borderColor: statusStyle.hex }"></view>
        </view>
        <view class="gm-ticks">
          <text
            class="gm-tick"
            :class="{ 'gm-tick-on': tickItem === picked }"
            v-for="(tickItem, tickIdx) in TICKS"
            :key="tickIdx"
          >{{ tickItem }}</text>
        </view>
      </view>

      <text class="gm-qlabel">快速选择</text>
      <view class="gm-qtray">
        <view
          class="gm-qslot ui-pressable"
          :class="{ 'gm-qslot-on': quickItem === picked }"
          hover-class="ui-pressed"
          :hover-stay-time="120"
          v-for="(quickItem, quickIdx) in TICKS"
          :key="quickIdx"
          @click="pick(quickItem)"
        >
          <text class="gm-qnum" :class="{ 'gm-qnum-on': quickItem === picked }">{{ quickItem }}</text>
          <text class="gm-qunit" :class="{ 'gm-qunit-on': quickItem === picked }">kcal</text>
        </view>
      </view>

      <view class="gm-tip">
        <image class="gm-tip-ic" :src="'/static/goal/gm_bulb.png'" mode="aspectFit"></image>
        <view class="gm-tip-txt">
          <text class="gm-tip-title">合理的热量目标有助于健康减重</text>
          <text class="gm-tip-sub">建议根据你的性别、年龄、身高、体重和运动量进行设置</text>
        </view>
        <image class="gm-tip-arrow" :src="'/static/goal/gm_chev.png'" mode="aspectFit"></image>
      </view>

      <view class="gm-save ui-pressable" hover-class="gm-btn-pressed" :hover-stay-time="140" @click="save">
        <text class="gm-save-txt">保存设置</text>
      </view>
    </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { computed } from 'vue'
import { watch } from 'vue'
import { nextTick } from 'vue'
import { getCurrentInstance } from 'vue'

/**
 * 设置每日热量目标（Pencil qnNST 整卡量取重建）。
 * 横向滑条：Track x48 宽 239（值域 1200–2400 吸附 100），Fill/Thumb 由 ratio 驱动；
 * 拖拽用 touch clientX − Dial 卡页面左偏移换算，Dial 左偏移在弹窗打开时查询一次，
 * 查询失败仅禁用拖拽（−/＋钮与快速选择始终可用）。保存 emit 给父调 setGoal。
 */

import { playSound, triggerHaptic } from '../stores/settings'

const props = defineProps<{
  show: boolean
  initial: number
}>()

const emit = defineEmits<{
  (e: 'update:show', v: boolean): void
  (e: 'save', v: number): void
}>()

const render = ref(false)
const active = ref(false)
let timer = 0

const MIN = 1200
const MAX = 2400
const STEP = 100
/** 稿面 Dial 卡内：Track 左缘 x48、宽 239 */
const TRACK_X = 48
const TRACK_W = 239
const TICKS = [1200, 1500, 1800, 2100, 2400]

const picked = ref(clamp(props.initial))
/** Dial 卡相对页面的左偏移；-1 = 未取到，拖拽禁用 */
const dialLeft = ref(-1)
const inst = getCurrentInstance()

function clamp(v: number): number {
  const snapped = Math.round((v - MIN) / STEP) * STEP + MIN
  return Math.min(Math.max(snapped, MIN), MAX)
}

const ratio = computed<number>(() => (picked.value - MIN) / (MAX - MIN))
const fillW = computed<number>(() => Math.round(ratio.value * TRACK_W * 10) / 10)

const statusStyle = computed(() => {
  if (picked.value <= 1800) {
    return { textClass: 'clr-mint', bgClass: 'bg-mint', hex: '#1FBF8F' }
  } else if (picked.value <= 2100) {
    return { textClass: 'clr-amber', bgClass: 'bg-amber', hex: '#E8B54D' }
  } else {
    return { textClass: 'clr-coral', bgClass: 'bg-coral', hex: '#FF9E7D' }
  }
})

watch(
  () => props.show,
  (v) => {
    if (v) {
      if (timer > 0) { clearTimeout(timer); timer = 0; }
      render.value = true
      picked.value = clamp(props.initial)
      nextTick(() => {
        try {
          uni
            .createSelectorQuery()
            .in(inst != null ? inst.proxy : null)
            .select('#gm-dial')
            .boundingClientRect((rect) => {
              if (rect != null) dialLeft.value = rect.left
            })
            .exec()
        } catch (e) {
          dialLeft.value = -1
        }
      })
      setTimeout(() => {
        active.value = true
      }, 50)
    } else {
      active.value = false
      if (timer > 0) { clearTimeout(timer); timer = 0; }
      timer = setTimeout(() => {
        render.value = false
        onAfterLeave()
        timer = 0
      }, 300) as unknown as number
    }
  }
)

function bump(): void {
  // 震动已按指令统一移除
}

function playCard(): void {
  playSound('card')
}

function playSlide(): void {
  playSound('slide')
}

function pick(v: number): void {
  const next = clamp(v)
  if (next === picked.value) {
    triggerHaptic('light')
    return
  }
  picked.value = next
  playCard()
  triggerHaptic('light')
}

function step(dir: number): void {
  const next = picked.value + dir * STEP
  if (next < MIN || next > MAX) {
    triggerHaptic('heavy')
    return
  }
  picked.value = next
  playSlide()
  triggerHaptic('light')
}

function onDragStart(e: any): void {
  updateFromTouch(e)
}

function onDragMove(e: any): void {
  updateFromTouch(e)
}

function onDragEnd(): void {
  playSlide()
}

function updateFromTouch(e: any): void {
  if (dialLeft.value < 0) return
  const list = e.touches.length > 0 ? e.touches : e.changedTouches
  if (list.length === 0) return
  const x = list[0].clientX - dialLeft.value - TRACK_X
  const r = Math.min(Math.max(x / TRACK_W, 0), 1)
  const next = clamp(MIN + r * (MAX - MIN))
  if (next !== picked.value) {
    picked.value = next
    playSlide()
    triggerHaptic('light')
  }
}

function close(): void {
  emit('update:show', false)
}

/** 原生蒙层不自动关闭，点按时回传 show=false 触发离场动画 */
function onOverlayTap(): void {
  emit('update:show', false)
}

/** page-container 离场结束（含系统返回拦截），兜底同步父级关闭态 */
function onAfterLeave(): void {
  emit('update:show', false)
}

function save(): void {
  triggerHaptic('medium')
  playSound('success')
  emit('save', picked.value)
  emit('update:show', false)
}
</script>

<style>
