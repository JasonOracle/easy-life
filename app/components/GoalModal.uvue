  height: 300rpx;
  margin-top: 36rpx;
  background-color: #F2FAF5;
  border-radius: 40rpx;
  overflow: visible;
  flex-shrink: 0;
}
/* 稿面 uI0Rz/E72bQ：44×44 白圆 r22，x44 / x287（卡内），y14 */
.gm-stepbtn {
  position: absolute;
  left: 88rpx;
  top: 28rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
