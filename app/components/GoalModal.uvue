}
/* 稿面 DUI7r：整卡宽居中，BigNum 46/700 与 unit 13.5/600 底部对齐，gap6；
   左右让开 −/＋钮（各占 44..88 / 243..287） */
.gm-numrow {
  position: absolute;
  left: 88px;
  right: 88px;
  top: 16px;
  height: 56px;
  flex-direction: row;
  justify-content: center;
  align-items: flex-end;
}
.gm-bignum {
  font-size: 46px;
