  color: rgba(15, 79, 61, 0.6);
  margin-left: 12rpx;
  margin-bottom: 12rpx;
}
/* 拖拽热区：覆盖 Track 上下留白，宽整卡 */
.gm-dragzone {
  position: absolute;
  left: 0;
  right: 0;
  top: 156rpx;
  height: 84rpx;
}
/* 饱满胶囊轨道：高度 24rpx，圆角 12rpx，背景浅薄荷 */
.gm-track {
  position: absolute;
  left: 96rpx;
  top: 30rpx;
  width: 478rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background-color: #E2F0EA;
}
