.gm-head {
  flex-direction: row;
  align-items: flex-start;
  margin-top: 8rpx;
  flex-shrink: 0;
}
/* 稿面 qhjRQ：44×44 $mintsoft r14，target 图标 22 居中 */
.gm-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background-color: #EAF9F3;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.gm-badge-ic {
  width: 44rpx;
  height: 44rpx;
}
.gm-headtxt {
  flex: 1;
  margin-left: 24rpx;
  margin-top: 4rpx;
}
/* 稿面 q0iCfa：17/700 $ink */
.gm-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0A4F3D;
}
/* 稿面 e2vUw：12 $muted */
.gm-sub {
  font-size: 24rpx;
  color: rgba(15, 79, 61, 0.6);
  margin-top: 10rpx;
}
/* 稿面 cPaDA：32 白圆 r16 阴影 #0A4F3D24，x 图标 16 */
.gm-closebtn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background-color: #FFFFFF;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(10, 79, 61, 0.14);
  flex-shrink: 0;
}
.gm-close-ic {
  width: 32rpx;
  height: 32rpx;
}
/* 稿面 V5LOp：335×150 $bg r20（页宽 375−左右 20＝自然满宽） */
.gm-dial {
  position: relative;
  height: 300rpx;
  margin-top: 36rpx;
  background-color: #F2FAF5;
  border-radius: 40rpx;
  overflow: visible;
  flex-shrink: 0;
}
/* 稿面 uI0Rz/E72bQ：44×44 白圆 r22，x44 / x287（卡内），y14 */
.gm-stepbtn {
  position: absolute;
  left: 88rpx;
  top: 28rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #FFFFFF;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(10, 79, 61, 0.1);
}
.gm-stepbtn-r {
  left: 486rpx;
}
.gm-step-ic {
  width: 40rpx;
  height: 40rpx;
}
.gm-stepbtn-off {
  opacity: 0.4;
}
/* 稿面 DUI7r：整卡宽居中，BigNum 46/700 与 unit 13.5/600 底部对齐，gap6；
   左右让开 −/＋钮 */
.gm-numrow {
  position: absolute;
  left: 176rpx;
  right: 176rpx;
  top: 32rpx;
  height: 112rpx;
  flex-direction: row;
  justify-content: center;
  align-items: flex-end;
}
.gm-bignum {
  font-size: 92rpx;
  font-weight: 700;
  color: #0A4F3D;
  line-height: 112rpx;
}
.gm-unit {
  font-size: 27rpx;
  font-weight: bold;
  color: rgba(15, 79, 61, 0.6);
  margin-left: 12rpx;
  margin-bottom: 12rpx;
}
/* 拖拽热区：覆盖 Track 上下留白，宽整卡 */
.gm-dragzone {
  position: absolute;
  left: 0;
  right: 0;
  top: 156rpx;
  height: 84rpx;
}
/* 饱满胶囊轨道：高度 24rpx，圆角 12rpx，背景浅薄荷 */
.gm-track {
  position: absolute;
  left: 96rpx;
  top: 30rpx;
  width: 478rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background-color: #E2F0EA;
}
/* 填充轨道：高度 24rpx，饱满圆角 */
.gm-fill {
  position: absolute;
  left: 96rpx;
  top: 30rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background-color: #1FBF8F;
  background-image: linear-gradient(90deg, #52D6AC, #1FBF8F);
  /* #ifdef MP-WEIXIN */
  transition: background-color 0.2s, background-image 0.2s;
  /* #endif */
}
.gm-bg-mint {
  background-color: #1FBF8F;
  background-image: linear-gradient(90deg, #52D6AC, #1FBF8F);
}
.gm-bg-amber {
  background-color: #E8B54D;
  background-image: linear-gradient(90deg, #FAD961, #E8B54D);
}
.gm-bg-coral {
  background-color: #FF9E7D;
  background-image: linear-gradient(90deg, #FFB89E, #FF9E7D);
}
.gm-clr-mint {
  color: #0A4F3D;
}
.gm-clr-amber {
  color: #B28322;
}
.gm-clr-coral {
