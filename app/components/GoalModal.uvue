
<template>
  <view class="gm-overlay" :class="{ 'gm-overlay-active': active }" v-if="render" @click="onOverlayTap">
    <!-- [变更日志] 2026-09-27: 保存钮渐变深端 accentDeep→accentMid（消除右下角发黑） -->
    <!-- [变更日志] 目标弹窗色面（卡面/徽章/滑轨/标题文字）逐元素绑 useTheme token，图标按 themeAsset 取五档变体，App 端三主题×双模式已真机核验 -->
    <view class="gm-container" :class="{ 'gm-container-active': active }" :style="{ backgroundColor: theme.card }" @click.stop>
      <view class="gm-sheet" :style="gmSheetStyle">
      <view class="gm-head">
        <view class="gm-badge" :style="{ backgroundColor: theme.thumbStroke }">
          <image class="gm-badge-ic" :src="asset('goal/gm_target.svg')" mode="aspectFit"></image>
        </view>
        <view class="gm-headtxt">
          <text class="gm-title" :style="{ color: theme.ink1 }">{{ t('gm.title') }}</text>
          <text class="gm-sub" :style="{ color: theme.ink2 }">{{ t('gm.sub') }}</text>
        </view>
        <view class="gm-closebtn" :style="{ backgroundColor: theme.card }" @click="close">
          <image class="gm-close-ic" :src="asset('goal/gm_close.svg')" mode="aspectFit"></image>
        </view>
      </view>

      <view class="gm-dial" id="gm-dial" :style="{ backgroundColor: theme.cardSoft }">
        <view class="gm-stepbtn ui-pressable" :class="{ 'gm-stepbtn-off': picked <= MIN }" :style="{ backgroundColor: theme.card }" hover-class="ui-pressed" :hover-stay-time="120" @click="step(-1)">
          <image class="gm-step-ic" :src="asset('goal/gm_minus.svg')" mode="aspectFit"></image>
        </view>
        <view class="gm-stepbtn gm-stepbtn-r ui-pressable" :class="{ 'gm-stepbtn-off': picked >= MAX }" :style="{ backgroundColor: theme.card }" hover-class="ui-pressed" :hover-stay-time="120" @click="step(1)">
          <image class="gm-step-ic" :src="asset('goal/gm_plus.svg')" mode="aspectFit"></image>
        </view>
        <view class="gm-numrow">
          <text class="gm-bignum" :style="{ color: statusTextColor }">{{ picked }}</text>
          <text class="gm-unit" :style="{ color: statusTextColor }">kcal</text>
        </view>
        <view
          class="gm-dragzone"
          @touchstart="onDragStart"
          @touchmove="onDragMove"
          @touchend="onDragEnd"
          @touchcancel="onDragEnd"
        >
          <view class="gm-track" :style="{ backgroundColor: theme.line }"></view>
          <view class="gm-fill" :style="fillStyle"></view>
          <view class="gm-thumb" :style="thumbStyle"></view>
        </view>
        <view class="gm-ticks">
          <text
            class="gm-tick"
            :class="{ 'gm-tick-on': tickItem === picked }"
            :style="{ color: tickColor(tickItem === picked) }"
            v-for="(tickItem, tickIdx) in TICKS"
            :key="tickIdx"
          >{{ tickItem }}</text>
        </view>
      </view>

      <text class="gm-qlabel" :style="{ color: theme.ink1 }">{{ t('gm.quick') }}</text>
      <view class="gm-qtray">
        <view
          class="gm-qslot ui-pressable"
          :class="{ 'gm-qslot-on': quickItem === picked }"
          :style="qslotStyle(quickItem === picked)"
          hover-class="ui-pressed"
          :hover-stay-time="120"
          v-for="(quickItem, quickIdx) in TICKS"
          :key="quickIdx"
          @click="pick(quickItem)"
        >
          <text class="gm-qnum" :class="{ 'gm-qnum-on': quickItem === picked }" :style="{ color: qnumColor(quickItem === picked) }">{{ quickItem }}</text>
          <text class="gm-qunit" :class="{ 'gm-qunit-on': quickItem === picked }" :style="{ color: qunitColor(quickItem === picked) }">kcal</text>
        </view>
      </view>

      <view class="gm-tip" :style="{ backgroundColor: theme.chip }">
        <image class="gm-tip-ic" :src="asset('goal/gm_bulb.svg')" mode="aspectFit"></image>
        <view class="gm-tip-txt">
          <text class="gm-tip-title" :style="{ color: theme.ink1 }">{{ t('gm.tipT') }}</text>
          <text class="gm-tip-sub" :style="{ color: theme.ink2 }">{{ t('gm.tipS') }}</text>
        </view>
        <image class="gm-tip-arrow" :src="asset('goal/gm_chev.svg')" mode="aspectFit"></image>
      </view>

      <view class="gm-save ui-pressable" :style="saveStyle" hover-class="gm-btn-pressed" :hover-stay-time="140" @click="save">
        <text class="gm-save-txt" :style="{ color: theme.onAccent }">{{ t('gm.save') }}</text>
      </view>
    </view>
    </view>
  </view>
</template>

<script setup lang="uts">
// [变更日志] 2026-09-24: 保存钮渐变带角度(135deg)在 App 原生端报 Invalid value → 角度版包入 #ifdef MP-WEIXIN，App 端用无色标渐变
import { ref } from 'vue'
import { t } from '../composables/i18n'
import { computed } from 'vue'
import { watch } from 'vue'
import { nextTick } from 'vue'
import { getCurrentInstance } from 'vue'

import { playSound, triggerHaptic } from '../stores/settings'
import { useTheme, themeAsset, FIXED_COLORS } from '../composables/useTheme'

const props = defineProps<{
  show: boolean
  initial: number
}>()

const emit = defineEmits<{
  (e: 'update:show', v: boolean): void
  (e: 'save', v: number): void
}>()

const render = ref(false)
const active = ref(false)
let timer = 0

const MIN = 1200
const MAX = 2400
const STEP = 100
/** 稿面 Dial 卡内：Track 左缘 x48、宽 239 */
const TRACK_X = 48
const TRACK_W = 239
const TICKS = [1200, 1500, 1800, 2100, 2400]

const picked = ref(clamp(props.initial))
/** Dial 卡相对页面的左偏移；-1 = 未取到，拖拽禁用 */
const dialLeft = ref(-1)
const inst = getCurrentInstance()

function clamp(v: number): number {
  const snapped = Math.round((v - MIN) / STEP) * STEP + MIN
  return Math.min(Math.max(snapped, MIN), MAX)
}

const ratio = computed<number>(() => (picked.value - MIN) / (MAX - MIN))
const fillW = computed<number>(() => Math.round(ratio.value * TRACK_W * 10) / 10)

const { theme, isDark, accentId } = useTheme()

// [变更日志] 2026-09-25: App 端弹层底部安全区补齐——类内 calc(env) padding-bottom 仅 MP 生效，原生端保存钮距底仅剩固定 48rpx 可被小白条压住，按 safeAreaInsets 运行时下发（MP 返回空对象不覆盖类规则）
/** 弹层底距：App 原生端无 env() 通道，＝设计底衬 48rpx 换算 px ＋ 安全区；MP 端交回类内 calc 规则 */
const gmSheetStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  // #ifdef APP
  const sysGm = uni.getSystemInfoSync()
  const insetsGm = sysGm.safeAreaInsets
  const sbGm = insetsGm != null ? insetsGm.bottom : 0
  st['padding-bottom'] = (48 * sysGm.windowWidth / 750 + sbGm) + 'px'
  // #endif
  return st
})

/** 资产按 (accent, mode) 取五档变体；未登记底稿自动回落原路径 */
function asset(path: string): string {
  return themeAsset(accentId.value, isDark.value, '/static/' + path)
}

// 阈值跟随滑块范围（MIN..MAX）的比例，不写死绝对值——范围变更时分档自动同步
const statusMint = computed<boolean>(() => ratio.value <= 0.5)
const statusWarn = computed<boolean>(() => ratio.value <= 0.75)

/** 绿档＝该档 accent 轴随主题轮值；琥珀／珊瑚＝§8.3 固定语义色，暗态提亮以保住对比度 */
const statusTextColor = computed<string>(() => {
  if (statusMint.value) return theme.value.ink1
  if (statusWarn.value) return isDark.value ? FIXED_COLORS.statusAmber : '#B28322'
  return isDark.value ? FIXED_COLORS.statusCoral : '#D35C37'
})
const statusHex = computed<string>(() => {
  if (statusMint.value) return theme.value.accent
  return statusWarn.value ? FIXED_COLORS.statusAmber : FIXED_COLORS.statusCoral
})
const fillStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['width'] = (ratio.value * 478) + 'rpx'
  if (statusMint.value) {
    st['background-color'] = theme.value.accent
    st['background-image'] = 'linear-gradient(to right, ' + theme.value.accent2 + ', ' + theme.value.accent + ')'
  } else if (statusWarn.value) {
    st['background-color'] = FIXED_COLORS.statusAmber
    st['background-image'] = 'linear-gradient(to right, #FAD961, ' + FIXED_COLORS.statusAmber + ')'
  } else {
    st['background-color'] = FIXED_COLORS.statusCoral
    st['background-image'] = 'linear-gradient(to right, #FFB89E, ' + FIXED_COLORS.statusCoral + ')'
  }
  return st
})
const thumbStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['left'] = (96 + ratio.value * 478 - 26) + 'rpx'
  st['background-color'] = theme.value.card
  st['border-color'] = statusHex.value
  return st
})

function tickColor(on: boolean): string {
  return on ? theme.value.ink1 : theme.value.ink3
}
function qnumColor(on: boolean): string {
  return on ? theme.value.ink1 : theme.value.ink2
}
function qunitColor(on: boolean): string {
  return on ? theme.value.accent : theme.value.ink3
}
/** 快选胶囊：选中件抬起为卡面（暗档无更亮白，改走 chip），未选件＝cardSoft 凹底 */
function qslotStyle(on: boolean): Record<string, string> {
  const st = {} as Record<string, string>
  if (on) {
    st['background-color'] = isDark.value ? theme.value.chip : theme.value.card
  } else {
    st['background-color'] = theme.value.cardSoft
  }
  st['border-color'] = theme.value.line
  return st
}
/** 保存钮：浅态 accent→accentDeep 渐变，暗态改纯色（暗档 accentDeep 是亮色，不能当渐变尾色） */
const saveStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['background-color'] = theme.value.accent
  if (!isDark.value) {
    st['background-image'] = 'linear-gradient(' + theme.value.accent + ', ' + theme.value.accentMid + ')'
  }
  return st
})

watch(
  () => props.show,
  (v) => {
    if (v) {
      if (timer > 0) { clearTimeout(timer); timer = 0; }
      render.value = true
      picked.value = clamp(props.initial)
      nextTick(() => {
        try {
          uni
            .createSelectorQuery()
            .in(inst != null ? inst.proxy : null)
            .select('#gm-dial')
            .boundingClientRect((rect) => {
              if (rect != null) dialLeft.value = rect.left
            })
            .exec()
        } catch (e) {
          dialLeft.value = -1
        }
      })
      nextTick(() => {
        active.value = true
      })
    } else {
      active.value = false
      if (timer > 0) { clearTimeout(timer); timer = 0; }
      timer = setTimeout(() => {
        render.value = false
        onAfterLeave()
        timer = 0
      }, 180) as unknown as number
    }
  }
)

function bump(): void {
  // 震动已按指令统一移除
}

function playCard(): void {
  playSound('card')
}

function playSlide(): void {
  playSound('slide')
}

function pick(v: number): void {
  const next = clamp(v)
  if (next === picked.value) {
    triggerHaptic('light')
    return
  }
  picked.value = next
  playCard()
  triggerHaptic('light')
}

function step(dir: number): void {
  const next = picked.value + dir * STEP
  if (next < MIN || next > MAX) {
    triggerHaptic('heavy')
    return
  }
  picked.value = next
  playSlide()
  triggerHaptic('light')
}

function onDragStart(e: any): void {
  updateFromTouch(e)
}

function onDragMove(e: any): void {
  updateFromTouch(e)
}

function onDragEnd(): void {
  playSlide()
}

function updateFromTouch(e: any): void {
  if (dialLeft.value < 0) return
  const list = e.touches.length > 0 ? e.touches : e.changedTouches
  if (list.length === 0) return
  const sys = uni.getSystemInfoSync()
  const scaleRatio = sys.windowWidth / 750
  const trackXPx = 96 * scaleRatio
  const trackWPx = 478 * scaleRatio
  const x = list[0].clientX - dialLeft.value - trackXPx
  const r = Math.min(Math.max(x / trackWPx, 0), 1)
  const next = clamp(MIN + r * (MAX - MIN))
  if (next !== picked.value) {
    picked.value = next
    playSlide()
    triggerHaptic('light')
  }
}

function close(): void {
  emit('update:show', false)
}

/** 原生蒙层不自动关闭，点按时回传 show=false 触发离场动画 */
function onOverlayTap(): void {
  emit('update:show', false)
}

/** page-container 离场结束（含系统返回拦截），兜底同步父级关闭态 */
function onAfterLeave(): void {
  emit('update:show', false)
}

function save(): void {
  triggerHaptic('medium')
  playSound('success')
  emit('save', picked.value)
  emit('update:show', false)
}
</script>

<style>
.gm-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 900;
  opacity: 0;
  transition-property: opacity;
  transition-duration: 180ms;
}
.gm-overlay-active {
  opacity: 1;
}
.gm-container {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: auto;
  min-height: 1140rpx;
  border-top-left-radius: 68rpx;
  border-top-right-radius: 68rpx;
  transform: translateY(100%);
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
}
.gm-container-active {
  transform: translateY(0);
}
/* 稿面 D3308：高 560 顶部圆角 34（容器外观已迁 page-container custom-style） */
.gm-sheet {
  flex: 1;
  padding: 36rpx 40rpx 48rpx 40rpx;
  /* #ifdef MP-WEIXIN */
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  /* #endif */
}
/* 头部：徽章与标题 */
.gm-head {
  flex-direction: row;
  align-items: flex-start;
  margin-top: 8rpx;
  flex-shrink: 0;
}
/* 稿面 qhjRQ：44×44 $mintsoft r14，target 图标 22 居中 */
.gm-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.gm-badge-ic {
  width: 44rpx;
  height: 44rpx;
}
.gm-headtxt {
  flex: 1;
  margin-left: 24rpx;
  margin-top: 4rpx;
}
/* 稿面 q0iCfa：17/700 $ink */
.gm-title {
  font-size: 34rpx;
  font-weight: 700;
}
/* 稿面 e2vUw：12 $muted */
.gm-sub {
  font-size: 24rpx;
  margin-top: 10rpx;
}
/* 稿面 cPaDA：32 白圆 r16 阴影 #0A4F3D24，x 图标 16 */
.gm-closebtn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(10, 79, 61, 0.14);
  flex-shrink: 0;
}
.gm-close-ic {
  width: 32rpx;
  height: 32rpx;
}
/* 稿面 V5LOp：335×150 $bg r20（页宽 375−左右 20＝自然满宽） */
.gm-dial {
  position: relative;
  height: 300rpx;
  margin-top: 36rpx;
  border-radius: 40rpx;
  overflow: visible;
  flex-shrink: 0;
}
/* 稿面 uI0Rz/E72bQ：44×44 白圆 r22，x44 / x287（卡内），y14 */
.gm-stepbtn {
  position: absolute;
  left: 88rpx;
  top: 28rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(10, 79, 61, 0.1);
}
.gm-stepbtn-r {
  left: 486rpx;
}
.gm-step-ic {
  width: 40rpx;
  height: 40rpx;
}
.gm-stepbtn-off {
  opacity: 0.4;
}
/* 稿面 DUI7r：整卡宽居中，BigNum 46/700 与 unit 13.5/600 底部对齐，gap6；
   左右让开 −/＋钮 */
.gm-numrow {
  position: absolute;
  left: 176rpx;
  right: 176rpx;
  top: 32rpx;
  height: 112rpx;
  flex-direction: row;
  justify-content: center;
  align-items: flex-end;
}
.gm-bignum {
  font-size: 92rpx;
  font-weight: 700;
  line-height: 112rpx;
}
.gm-unit {
  font-size: 27rpx;
  font-weight: bold;
  margin-left: 12rpx;
  margin-bottom: 12rpx;
}
/* 拖拽热区：覆盖 Track 上下留白，宽整卡 */
.gm-dragzone {
  position: absolute;
  left: 0;
  right: 0;
  top: 156rpx;
  height: 84rpx;
}
/* 饱满胶囊轨道：高度 24rpx，圆角 12rpx，背景浅薄荷 */
.gm-track {
  position: absolute;
  left: 96rpx;
  top: 30rpx;
  width: 478rpx;
  height: 24rpx;
  border-radius: 12rpx;
}
/* 填充轨道：高度 24rpx，饱满圆角 */
.gm-fill {
  position: absolute;
  left: 96rpx;
  top: 30rpx;
  height: 24rpx;
  border-radius: 12rpx;
  /* #ifdef MP-WEIXIN */
  transition: background-color 0.2s, background-image 0.2s;
  /* #endif */
}
/* 增大为 52rpx 直径白底滑钮，带精致立体阴影与 3.5px 强调环 */
.gm-thumb {
  position: absolute;
  top: 16rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  border-width: 3.5px;
  border-style: solid;
  box-shadow: 0 4rpx 16rpx rgba(10, 79, 61, 0.22);
  /* #ifdef MP-WEIXIN */
  transition: border-color 0.2s;
  /* #endif */
}
/* 刻度行：严格对齐 5 个档位 */
.gm-ticks {
  position: absolute;
  left: 52rpx;
  right: 52rpx;
  top: 228rpx;
  height: 36rpx;
  flex-direction: row;
  justify-content: space-between;
}
.gm-tick {
  width: 88rpx;
  text-align: center;
  font-size: 24rpx;
}
.gm-tick-on {
  font-weight: 700;
}
.gm-qlabel {
  font-size: 28rpx;
  font-weight: 700;
  margin-top: 40rpx;
  flex-shrink: 0;
}
/* 快速选择：废除灰色大托盘，改为 5 个独立的圆角胶囊药丸并排 */
.gm-qtray {
  margin-top: 16rpx;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.gm-qslot {
  width: 124rpx;
  height: 116rpx;
  border-radius: 28rpx;
  border-width: 1px;
  border-style: solid;
  justify-content: center;
  align-items: center;
}
/* 快速选择选中态：纯白底 + 明显柔和投影 + 翠绿细边框 */
.gm-qslot-on {
  box-shadow: 0 8rpx 20rpx rgba(10, 79, 61, 0.12);
}
.gm-qnum {
  font-size: 30rpx;
  font-weight: bold;
}
.gm-qnum-on {
  font-weight: 700;
}
.gm-qunit {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.gm-qunit-on {
  font-weight: bold;
}
/* 提示卡片 */
.gm-tip {
  height: 144rpx;
  margin-top: 36rpx;
  border-radius: 32rpx;
  flex-direction: row;
  align-items: center;
  padding-left: 32rpx;
  padding-right: 32rpx;
  flex-shrink: 0;
}
.gm-tip-ic {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.gm-tip-txt {
  flex: 1;
  margin-left: 24rpx;
}
.gm-tip-title {
  font-size: 27rpx;
  font-weight: bold;
}
.gm-tip-sub {
  font-size: 23rpx;
  margin-top: 8rpx;
}
.gm-tip-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
/* 保存按钮：饱和深翠绿渐变，白字 4.8:1 超强对比度 */
.gm-save {
  height: 104rpx;
  margin-top: 56rpx;
  border-radius: 52rpx;
  box-shadow: 0 12rpx 32rpx rgba(13, 156, 115, 0.35);
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.gm-btn-pressed {
  transform: scale(0.965);
  box-shadow: 0 4rpx 12rpx rgba(13, 156, 115, 0.22);
}
.gm-save-txt {
  font-size: 32rpx;
  font-weight: 700;
}
</style>
