  font-size: 13.5px;
  font-weight: bold;
  color: rgba(15, 79, 61, 0.6);
  margin-left: 6px;
  margin-bottom: 6px;
}
/* 拖拽热区：覆盖 Track 上下留白，宽整卡 */
.gm-dragzone {
  position: absolute;
  left: 0;
  right: 0;
  top: 82px;
  height: 36px;
}
/* 稿面 BvkEj：x48 y96 239×8 r4 $line */
.gm-track {
  position: absolute;
  left: 48px;
