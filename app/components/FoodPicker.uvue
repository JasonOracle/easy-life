  修改内容：[mp-weixin 组件样式平铺导致跨组件类名冲突（与 AddFood/GoalModal 的 .mask/.sheet/.handle/.chip/.chip-on
    互相污染），本组件冲突类统一加 fp- 前缀]
-->
<!--
  [变更日志]
  修改时间：2026-09-21
  AI模型：Qoder (Claude)
  修改内容：[修复蒙层点击不关闭 bug：mask 加 @click closeMask（L1 轻触觉），sheet @click.stop 阻断冒泡]
-->
<!--
  [变更日志]
  修改时间：2026-09-21
  AI模型：Qoder (Claude)
  修改内容：[新建：弹层⓪ 食物选择列表（pencil n3dgv 还原）——
    搜索框（名称/全拼/首字母，走 stores/food.searchFoods 同规则）、
    分类 chips 取库内真实 7 类（全部＋首次出现序）、行缩略图用真实 webp 图标、
    单选点行即选中并关闭；selectedId 回显高亮，首次打开无选中；
    重开时 scroll-into-view 把选中行滚进视野（验收截图发现残留滚动位不露选中行）]
-->

<template>
  <page-container <!-- #ifdef MP -->
    v-if="show"
    <!-- #endif -->
    :show="show" position="bottom" :overlay="true" :duration="300"
    custom-style="height:560px;background-color:#FFFFFF;border-top-left-radius:34px;border-top-right-radius:34px;"
    @clickoverlay="onOverlayTap" @afterleave="onAfterLeave">
    <view class="fp-sheet">
      <view class="fp-handle"></view>

      <view class="search-box">
        <image class="search-icon" :src="'/static/common/search_icon.png'" mode="aspectFit"></image>
        <input
          class="search-input"
          v-model="keyword"
          placeholder="搜索食物 · 支持拼音 / 别名"
          placeholder-style="color:#9CB8B0;font-size:13.5px;"
        />
      </view>

      <scroll-view class="chip-bar" direction="horizontal" :show-scrollbar="false">
        <view
          class="fp-chip"
          :class="{ 'fp-chip-on': catItem === cat }"
          v-for="(catItem, catIdx) in cats"
          :key="catIdx"
          @click="pickCat(catItem)"
        >
          <text class="chip-text" :class="{ 'chip-text-on': catItem === cat }">{{ catItem }}</text>
        </view>
      </scroll-view>

      <scroll-view class="food-list" direction="vertical" :show-scrollbar="false" :scroll-into-view="intoView">
        <view
          class="row"
          :class="{ 'row-on': item.id === selectedId }"
          :id="'row-' + item.id"
          v-for="(item, rowIdx) in results"
          :key="item.id"
          @click="pickFood(item.id)"
        >
          <image class="row-thumb" :src="'/static/icons/' + item.img" mode="aspectFill"></image>
          <view class="row-text">
            <text class="row-name">{{ item.name }}</text>
            <text class="row-sub" :class="{ 'row-sub-on': item.id === selectedId }">{{ subLine(item) }}</text>
          </view>
          <view class="radio" :class="{ 'radio-on': item.id === selectedId }">
            <text class="radio-check" v-if="item.id === selectedId">✓</text>
          </view>
          <view class="row-div" v-if="rowIdx < results.length - 1"></view>
        </view>
      </scroll-view>
    </view>
  </page-container>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { computed } from 'vue'
import { watch } from 'vue'
import { ALL_FOODS, searchFoods, vesselLabelOf, vesselSizesOf, type FoodBase } from '../stores/food'

/**
 * 弹层⓪ 食物选择列表（pencil 画板 n3dgv）。
 * 单选：点行 = 选中 + 关闭（emit select）；selectedId 用于 AddFood「更换」时的回显。
 * 弹层内部定高滚动才用 scroll-view，页面级滚动一律走原生（见 AGENTS.md 滚动陷阱条目）。
 */

const props = defineProps<{
  show: boolean
  selectedId: string
}>()

const emit = defineEmits<{
  (e: 'update:show', v: boolean): void
  (e: 'select', foodId: string): void
}>()

/** 分类 chips：全部 + 库内真实分类（按首次出现顺序去重） */
const cats: string[] = ['全部']
for (const f of ALL_FOODS) {
  if (!cats.includes(f.cat)) cats.push(f.cat)
}

const ALL_CAT = '全部'
const keyword = ref('')
const cat = ref(ALL_CAT)

/** 打开时把选中行滚进视野（弹层每次开合整树重挂载，挂载即生效） */
const intoView = computed<string>(() => props.selectedId !== '' ? 'row-' + props.selectedId : '')

const results = computed<FoodBase[]>(() => {
  const base = searchFoods(keyword.value)
  if (cat.value === ALL_CAT) return base
  return base.filter((f) => f.cat === cat.value)
})

/** 副行：热量 + 一条有用提示（优先级：可选项 > 默认份量克重） */
function subLine(food: FoodBase): string {
  let s = food.kcal.toString() + ' kcal / 100' + food.unit
  if (food.opts != null && food.opts.length > 0) return s + ' · 支持杯型与甜度'
  if (food.vessel != null) {
    const label = vesselLabelOf(food.vessel!)
    const sizes = vesselSizesOf(food.vessel!)
    const dft = sizes.length > 1 ? sizes[1] : sizes[0]
    // 计件类（个/片/串）档位单位不是 g/ml，不加后缀，与稿面香蕉/苹果行一致
    if (label !== '' && dft != null && (dft.unit === 'g' || dft.unit === 'ml')) {
      s += ' · 一' + label + '约 ' + dft.amount.toString() + dft.unit
    }
  }
  return s
}

function pickCat(name: string): void {
  if (name === cat.value) return
  cat.value = name
  try {
    uni.vibrateShort()
  } catch (e) {
    // 无触觉设备忽略
  }
}

function pickFood(id: string): void {
  try {
    uni.vibrateShort()
  } catch (e) {
    // 无触觉设备忽略
  }
  emit('update:show', false)
  emit('select', id)
}

/** 原生蒙层不自动关闭（官方示例亦然），点按时由我们回传 show=false 触发离场动画 */
function onOverlayTap(): void {
  try {
    uni.vibrateShort()
  } catch (e) {
    // 无触觉设备忽略
  }
  emit('update:show', false)
}

/** 原生蒙层点按/系统返回触发 page-container 离场，动画结束后回传关闭态 */
function onAfterLeave(): void {
  try {
    uni.vibrateShort()
  } catch (e) {
    // 无触觉设备忽略
  }
  emit('update:show', false)
}

/** 每次打开重置搜索与分类（选中回显仍由 selectedId 驱动） */
watch(
  () => props.show,
  (v: boolean) => {
    if (v) {
      keyword.value = ''
      cat.value = ALL_CAT
    }
  }
)
</script>

<style>
.fp-sheet {
  flex: 1;
  padding: 12px 20px 0 20px;
}
.fp-handle {
  width: 41px;
  height: 4px;
  border-radius: 2px;
  background-color: #DCEDE6;
  align-self: center;
}
.search-box {
  flex-direction: row;
  align-items: center;
  height: 46px;
  margin-top: 12px;
  border-radius: 23px;
  background-color: #F5FAF8;
  border-width: 1px;
  border-color: #EAF3EF;
  padding-left: 18px;
  padding-right: 14px;
}
.search-icon {
  width: 18px;
  height: 18px;
}
.search-input {
  flex: 1;
  font-size: 13.5px;
  color: #0A4F3D;
  margin-left: 8px;
}
.chip-bar {
  height: 34px;
  margin-top: 16px;
  flex-direction: row;
  flex-shrink: 0;
}
.fp-chip {
  width: 60px;
  height: 34px;
  border-radius: 17px;
  background-color: #F8F9FC;
  justify-content: center;
  align-items: center;
  margin-right: 8px;
  flex-shrink: 0;
}
.fp-chip-on {
  background-color: #1FBF8F;
}
.chip-text {
  font-size: 13px;
  font-weight: 500;
  color: #8FAEAF;
}
.chip-text-on {
  color: #FFFFFF;
  font-weight: 600;
}
.food-list {
  flex: 1;
  margin-top: 16px;
}
.row {
  position: relative;
  flex-direction: row;
  align-items: center;
  height: 76px;
  border-radius: 16px;
}
.row-on {
  background-color: #F2FAF5;
}
.row-thumb {
  width: 48px;
  height: 48px;
  border-radius: 16px;
  background-color: #EAF9F3;
}
.row-text {
  flex: 1;
  margin-left: 12px;
}
.row-name {
  font-size: 15.5px;
  font-weight: bold;
  color: #0A4F3D;
}
.row-sub {
  font-size: 12px;
  color: #8FAEAF;
  margin-top: 4px;
}
.row-sub-on {
  color: #0F4F3D;
  font-weight: 600;
}
.radio {
  width: 22px;
  height: 22px;
  border-radius: 11px;
  border-width: 1.5px;
  border-color: #BFE3D6;
  justify-content: center;
  align-items: center;
  margin-left: 10px;
  margin-right: 10px;
}
.radio-on {
  background-color: #1FBF8F;
  border-color: #1FBF8F;
}
.radio-check {
  font-size: 12px;
  color: #FFFFFF;
}
.row-div {
  position: absolute;
  left: 60px;
  right: 0;
  bottom: 0;
  height: 1px;
  background-color: #EAF3EF;
}
</style>
