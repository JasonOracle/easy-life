
<template>
  <view class="fp-overlay" :class="{ 'fp-overlay-active': active, 'fp-hidden': !render }" @click="onOverlayTap">
    <view class="fp-container" :class="{ 'fp-container-active': active, 'fp-container-detail': step === 'detail' }" :style="fpContainerStyle" @click.stop>
    <view class="fp-sheet" v-if="step === 'list'" :style="fpSheetStyle">
      <view class="fp-top-row">
        <view class="fp-search-box" :style="searchBoxStyle">
          <image class="fp-search-icon" :src="asset('common/search_icon.svg')" mode="aspectFit"></image>
          <input
            class="fp-search-input"
            :style="{ color: theme.ink1 }"
            v-model="keyword"
            :placeholder="t('fp.searchPh')"
            :placeholder-style="searchPlaceholderStyle"
          ></input>
        </view>
        <view class="fp-closebtn" :style="{ backgroundColor: theme.card }" hover-class="icon-pressed" :hover-stay-time="120" @click="close">
          <image class="fp-close-ic" :src="asset('goal/gm_close.svg')" mode="aspectFit"></image>
        </view>
      </view>

      <scroll-view class="fp-chip-bar" direction="horizontal" :show-scrollbar="false">
        <view
          class="fp-chip ui-pressable"
          :style="chipStyle(catItem === cat)"
          hover-class="ui-pressed"
          :hover-stay-time="120"
          v-for="(catItem, catIdx) in cats"
          :key="catIdx"
          @click="pickCat(catItem)"
        >
          <text class="fp-chip-text" :style="{ color: chipTextColor(catItem === cat) }">{{ catLabel(catItem) }}</text>
        </view>
      </scroll-view>

      <scroll-view class="fp-food-list" direction="vertical" :show-scrollbar="false" :scroll-into-view="intoView" @scrolltolower="onLoadMore">
        <view
          class="fp-row ui-pressable"
          hover-class="ui-pressed"
          :hover-stay-time="120"
          :id="'row-' + item.id"
          v-for="(item, rowIdx) in displayedResults"
          :key="item.id"
          @click="pickFood(item.id)"
        >
          <image class="fp-row-thumb" :style="{ backgroundColor: theme.thumbStroke }" :src="'/static/icons/' + item.img" mode="aspectFill"></image>
          <view class="fp-row-text">
            <text class="fp-row-name" :style="{ color: theme.ink1 }">{{ item.name }}</text>
            <text class="fp-row-sub" :class="{ 'fp-row-sub-on': item.id === activeFoodId }" :style="{ color: subTextColor(item.id === activeFoodId) }">{{ subLine(item) }}</text>
          </view>
          <view class="fp-radio" :style="radioStyle(item.id === activeFoodId)">
            <text class="fp-radio-check" v-if="item.id === activeFoodId" :style="{ color: theme.onAccent }">✓</text>
          </view>
          <view class="fp-row-div" v-if="rowIdx < displayedResults.length - 1" :style="{ backgroundColor: theme.line }"></view>
        </view>
      </scroll-view>
    </view>
    <view class="fp-detail-wrap" v-else-if="step === 'detail'">
      <AddFood
        :food-id="activeFoodId"
        @confirm="onDetailConfirm"
        @change="onDetailChange"
        @close="close"
      ></AddFood>
    </view>
    </view>
  </view>
</template>

<script setup lang="uts">
// [变更日志] 2026-09-24: FAB 顽疾修复——弹层根由 v-if 挂载改为常驻＋display:none 隐藏（消除每次约 1s 冷启动重挂载）；离场淡出窗口内蒙层点击改为 emit show=true 立即重开（不再吞击）
// [变更日志] 2026-09-24: 食物列表选中态重构 → 废弃整行绿底 .fp-row-on（白底图标叠绿底色块难看），改为左侧薄荷绿竖条 .fp-row-accent ＋ 既有文字加深加粗；日志落位 script 内（ADR-003 #7 禁 .uvue 根层 HTML 注释）
// [变更日志] 2026-09-25: 新增 startStep 属性——百科「添加到本餐」经 ct_pending_add 交接后，Home 以 startStep='detail'+selectedId 直接打开该项详情步
// [变更日志] 2026-09-27: 删除食物列表选中态的左侧绿竖条 .fp-row-accent（老板定稿：以「右侧选择圈✓＋文字加深加粗」为选中态，竖条冗余）
// [变更日志] 2026-09-27: 详情弹层容器 .fp-container-detail 由写死 1080rpx 改为 height:auto + max-height:90%（贴合内容，长内容交内部 scroll-view）；.fp-detail-wrap 补 min-height:0
// [变更日志] 2026-09-28: 修上面一条的 App 端编译 ERROR——uvue-css 的 max-height 只接受 number|pixel，`90%` 静默失效；改由 fpContainerStyle 运行时下发 windowHeight*0.9+'px'，类里不再写 max-height
import { ref, computed, watch } from 'vue'
import { t, tf } from '../composables/i18n'
import { resolveLang } from '../composables/useLocale'
import { categoryName } from '../stores/encyclopedia'
import { ALL_FOODS, searchFoods, vesselLabelOf, vesselSizesOf, type FoodBase } from '../stores/food'
import { triggerHaptic, playSound } from '../stores/settings'
import AddFood from './AddFood.uvue'
import type { AddPayload } from './AddFood.uvue'
import { useTheme, themeAsset } from '../composables/useTheme'
export type { AddPayload }

/**
 * 弹层⓪ 食物选择与添加单流程整合容器（pencil 画板 n3dgv + 弹窗①）。
 * 内部 step 在 list 和 detail 原地切换，全流程仅使用一个原生 page-container 容器。
 */

const props = defineProps<{
  show: boolean
  selectedId?: string
  /** 打开时直接进入的步骤：'detail' 用于百科「添加到本餐」的一键交接（配合 selectedId 预填食物） */
  startStep?: string
}>()

const emit = defineEmits<{
  (e: 'update:show', v: boolean): void
  (e: 'select', foodId: string): void
  (e: 'confirm', payload: AddPayload): void
}>()

const render = ref(false)
const active = ref(false)
let timer = 0

const step = ref<'list' | 'detail'>('list')
const activeFoodId = ref('')

const { theme, isDark, accentId } = useTheme()

// [变更日志] 2026-09-25: App 端弹层底部安全区补齐——类内 calc(env) padding-bottom 仅 MP 生效，原生端底 padding 为 0 致列表末行被小白条遮挡，按 safeAreaInsets 运行时下发（MP 返回空对象不覆盖类规则）
/** 弹层底距：App 原生端无 env() 通道，＝设计底衬 28rpx 换算 px ＋ 安全区；MP 端交回类内 calc 规则 */
const fpSheetStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  // #ifdef APP
  const sysFp = uni.getSystemInfoSync()
  const insetsFp = sysFp.safeAreaInsets
  const sbFp = insetsFp != null ? insetsFp.bottom : 0
  st['padding-bottom'] = (28 * sysFp.windowWidth / 750 + sbFp) + 'px'
  // #endif
  return st
})

// [变更日志] 2026-09-28: 详情容器 max-height 改运行时下发——App 端 uvue-css 对 max-height 只接受
//   number|pixel，类里写 `90%` 会报 ERROR 且**整条静默失效**（2026-09-27 那次「贴合内容」的修复
//   在真机上从未生效：长内容照样溢出、确认钮照样被顶出屏外）。参照物＝.fp-overlay（fixed 满屏），
//   故取视口高的 90%。
const fpContainerStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['background-color'] = theme.value.card
  if (step.value === 'detail') {
    const sysC = uni.getSystemInfoSync()
    st['max-height'] = (sysC.windowHeight * 0.9) + 'px'
  }
  return st
})

/** 资产按 (accent, mode) 取五档变体；未登记底稿自动回落原路径 */
function asset(path: string): string {
  return themeAsset(accentId.value, isDark.value, '/static/' + path)
}

/** 选中态由运行时函数出色——内联 style 优先级高于类名，条件类无法与主题色共存 */
const searchBoxStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  // [变更日志] 2026-09-27: 原为 theme.chip（薄荷绿凸面），与设计稿 #F5FAF8 中性近白不符
  //   ——改造前是裸 hex #F5FAF8，改造时因 v2 色板无「中性浅面」档而拿 chip 顶替。
  //   改用 theme.bg（mint 亮 #F6FBF8）做「淡凹面」，视觉回到设计稿。
  st['background-color'] = theme.value.bg
  st['border-color'] = theme.value.line
  return st
})
const searchPlaceholderStyle = computed<string>(() => 'color:' + theme.value.ink3 + ';font-size:13.5px;')

function chipStyle(on: boolean): Record<string, string> {
  const st = {} as Record<string, string>
  // [变更日志] 2026-09-27: 未选件原为 theme.chip（薄荷绿），设计稿是 #F8F9FC 冷调近白；
  //   同 searchBoxStyle，改用 theme.bg 回到中性凹面。
  st['background-color'] = on ? theme.value.accent : theme.value.bg
  return st
}
function chipTextColor(on: boolean): string {
  return on ? theme.value.onAccent : theme.value.ink3
}
function subTextColor(on: boolean): string {
  return on ? theme.value.ink1 : theme.value.ink3
}
function radioStyle(on: boolean): Record<string, string> {
  const st = {} as Record<string, string>
  st['background-color'] = on ? theme.value.accent : theme.value.card
  st['border-color'] = on ? theme.value.accent : theme.value.line
  return st
}

/** 分类 chips：全部 + 库内真实分类（按首次出现顺序去重） */
const cats: string[] = ['全部']  // 数据值＝food_library 原始 cat 字面量
for (const f of ALL_FOODS) {
  if (!cats.includes(f.cat)) cats.push(f.cat)
}

const ALL_CAT = '全部'
/** chip 展示名：数据值保持中文原样用于过滤，仅显示层按语言映射 */
function catLabel(c: string): string {
  if (c === ALL_CAT) return t('fp.all')
  const n = categoryName(c)
  return resolveLang() == 'en' ? n.en : n.zh
}
const keyword = ref('')
const cat = ref(ALL_CAT)
const displayLimit = ref(20)

/** 打开时把选中行滚进视野 */
const intoView = computed<string>(() => activeFoodId.value !== '' ? 'row-' + activeFoodId.value : '')

const allFilteredResults = computed<FoodBase[]>(() => {
  const base = searchFoods(keyword.value)
  if (cat.value === ALL_CAT) return base
  return base.filter((f) => f.cat === cat.value)
})

const displayedResults = computed<FoodBase[]>(() => {
  const all = allFilteredResults.value
  if (keyword.value.trim() !== '') {
    return all.slice(0, 50)
  }
  return all.slice(0, displayLimit.value)
})

function onLoadMore(): void {
  if (displayLimit.value < allFilteredResults.value.length) {
    displayLimit.value += 20
  }
}

/** 副行：热量 + 一条有用提示（优先级：可选项 > 默认份量克重） */
function subLine(food: FoodBase): string {
  let s = food.kcal.toString() + ' kcal / 100' + food.unit
  if (food.opts != null && food.opts.length > 0) return s + t('fp.optsHint')
  if (food.vessel != null) {
    const label = vesselLabelOf(food.vessel!)
    const sizes = vesselSizesOf(food.vessel!)
    const dft = sizes.length > 1 ? sizes[1] : sizes[0]
    // 计件类（个/片/串）档位单位不是 g/ml，不加后缀，与稿面香蕉/苹果行一致
    if (label !== '' && dft != null && (dft.unit === 'g' || dft.unit === 'ml')) {
      s += tf('fp.unitHint', [label, dft.amount.toString(), dft.unit])
    }
  }
  return s
}

function pickCat(name: string): void {
  if (name === cat.value) {
    return
  }
  cat.value = name
}

function pickFood(id: string): void {
  playSound('click')
  activeFoodId.value = id
  step.value = 'detail'
  emit('select', id)
}

function onDetailChange(): void {
  step.value = 'list'
}

function onDetailConfirm(payload: AddPayload): void {
  emit('confirm', payload)
  close()
}

/** 原生蒙层点按时回传 show=false 触发离场动画；离场淡出窗口内（active 已 false、尚未 display:none）再点＝立即重开，避免吞击 */
function onOverlayTap(): void {
  if (!active.value) {
    emit('update:show', true)
    return
  }
  close()
}

/** 原生蒙层点按/系统返回触发 page-container 离场，动画结束后重置并回传关闭态 */
function onAfterLeave(): void {
  step.value = 'list'
  emit('update:show', false)
}

function close(): void {
  emit('update:show', false)
}

/** 每次打开重置搜索、分类与步骤（选中回显由 selectedId 驱动） */
watch(
  () => props.show,
  (v: boolean) => {
    if (v) {
      if (timer > 0) { clearTimeout(timer); timer = 0; }
      render.value = true
      keyword.value = ''
      cat.value = ALL_CAT
      displayLimit.value = 20
      activeFoodId.value = props.selectedId ?? ''
      step.value = ((props.startStep ?? 'list') === 'detail' && activeFoodId.value !== '') ? 'detail' : 'list'
      nextTick(() => {
        active.value = true
      })
    } else {
      active.value = false
      if (timer > 0) { clearTimeout(timer); timer = 0; }
      timer = setTimeout(() => {
        render.value = false
        onAfterLeave()
        timer = 0
      }, 180) as unknown as number
    }
  }
)
</script>

<style>
.fp-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 900;
  opacity: 0;
  transition-property: opacity;
  transition-duration: 180ms;
}
.fp-overlay-active {
  opacity: 1;
}
/* 常驻不卸载：隐藏态用 display:none 摘掉命中与绘制，重开＝纯 class 切换，免去整棵子树重挂载的约 1s 冷启动 */
.fp-hidden {
  display: none;
}
.fp-container {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1040rpx;
  /* #ifdef MP-WEIXIN */
  height: calc(1040rpx + env(safe-area-inset-bottom));
  /* #endif */
  border-top-left-radius: 68rpx;
  border-top-right-radius: 68rpx;
  /* #ifdef MP-WEIXIN */
  /* App 端带 transform 的浮层子树收不到触摸命中，位移入场仅保留小程序端 */
  transform: translateY(100%);
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  /* #endif */
  display: flex;
  flex-direction: column;
}
/* #ifdef MP-WEIXIN */
.fp-container-active {
  transform: translateY(0);
}
/* #endif */
/* [变更日志] 2026-09-27: 原 height:1080rpx 是写死的猜测值——真机实测米饭内容已 1108.5rpx
   （默认即溢出 28.5rpx，选大碗 1124.4rpx），奶茶类 1365.4rpx 更把确认钮整个顶出屏外；
   内容顶对齐 → 溢出全落底部 → padding-bottom 与确认钮一起被裁（实测底距 18.7/2.9rpx，CSS 声明 48rpx）。
   改为贴合内容高度：短内容不留白、长内容由 max-height 兜底交内部 scroll-view 滚动。
   [变更日志] 2026-09-28: 上面那条的 `max-height:90%` 在 App 端是编译 ERROR 且静默失效
   （uvue-css 只接受 number|pixel），已移到 :style 运行时下发，见 script 的 fpContainerStyle。 */
.fp-container-detail {
  height: auto;
  display: flex;
  flex-direction: column;
}
.fp-sheet {
  flex: 1;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 32rpx 40rpx 0 40rpx;
  /* #ifdef MP-WEIXIN */
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  /* #endif */
  overflow: hidden;
}
.fp-detail-wrap {
  flex: 1;
  /* min-height:0 允许容器被 max-height 限住时收缩，把溢出交给内部 .af-scroll 滚动 */
  min-height: 0;
  height: 100%;
  overflow: hidden;
}
.fp-top-row {
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
}
.fp-search-box {
  flex: 1;
  flex-direction: row;
  align-items: center;
  height: 92rpx;
  border-radius: 46rpx;
  border-width: 1px;
  padding-left: 36rpx;
  padding-right: 28rpx;
}
.fp-closebtn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(10, 79, 61, 0.14);
  margin-left: 20rpx;
  flex-shrink: 0;
}
.fp-close-ic {
  width: 32rpx;
  height: 32rpx;
}
.fp-search-icon {
  width: 36rpx;
  height: 36rpx;
}
.fp-search-input {
  flex: 1;
  font-size: 27rpx;
  margin-left: 16rpx;
}
.fp-chip-bar {
  height: 68rpx;
  margin-top: 32rpx;
  flex-direction: row;
  flex-shrink: 0;
}
.fp-chip {
  height: 68rpx;
  padding-left: 34rpx;
  padding-right: 34rpx;
  border-radius: 34rpx;
  justify-content: center;
  align-items: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.fp-chip-text {
  font-size: 26rpx;
  font-weight: bold;
}
.fp-food-list {
  flex: 1;
  height: 0;
  min-height: 0;
  margin-top: 32rpx;
}
.fp-row {
  position: relative;
  flex-direction: row;
  align-items: center;
  height: 152rpx;
  border-radius: 32rpx;
}
.fp-row-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
}
.fp-row-text {
  flex: 1;
  margin-left: 24rpx;
}
.fp-row-name {
  font-size: 31rpx;
  font-weight: bold;
}
.fp-row-sub {
  font-size: 24rpx;
  margin-top: 8rpx;
}
.fp-row-sub-on {
  font-weight: bold;
}
.fp-radio {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  border-width: 1.5px;
  justify-content: center;
  align-items: center;
  margin-left: 20rpx;
  margin-right: 20rpx;
}
.fp-radio-check {
  font-size: 24rpx;
}
.fp-row-div {
  position: absolute;
  left: 120rpx;
  right: 0;
  bottom: 0;
  height: 1px;
}
</style>
