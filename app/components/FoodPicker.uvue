  opacity: 1;
}
.fp-container {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(520px + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top-left-radius: 34px;
  border-top-right-radius: 34px;
  transform: translateY(100%);
  transition-property: transform;
  transition-duration: 300ms;
  display: flex;
  flex-direction: column;
}
.fp-container-active {
  transform: translateY(0);
}
.fp-sheet {
  flex: 1;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 16px 20px 0 20px;
  /* #ifdef MP-WEIXIN */
  padding-bottom: calc(14px + env(safe-area-inset-bottom));
  /* #endif */
  overflow: hidden;
}
.fp-detail-wrap {
  flex: 1;
  height: 100%;
  overflow: hidden;
}
.fp-top-row {
  flex-direction: row;
  align-items: center;
  margin-top: 4px;
}
.fp-search-box {
  flex: 1;
  flex-direction: row;
  align-items: center;
  height: 46px;
  border-radius: 23px;
  background-color: #F5FAF8;
  border-width: 1px;
  border-color: #EAF3EF;
  padding-left: 18px;
  padding-right: 14px;
}
.fp-closebtn {
  width: 32px;
  height: 32px;
  border-radius: 16px;
  background-color: #FFFFFF;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2px 8px rgba(10, 79, 61, 0.14);
  margin-left: 10px;
  flex-shrink: 0;
}
.fp-close-ic {
  width: 16px;
  height: 16px;
}
.fp-search-icon {
  width: 18px;
  height: 18px;
}
.fp-search-input {
  flex: 1;
  font-size: 13.5px;
  color: #0A4F3D;
  margin-left: 8px;
}
.fp-chip-bar {
  height: 34px;
  margin-top: 16px;
  flex-direction: row;
  flex-shrink: 0;
}
.fp-chip {
  width: 60px;
  height: 34px;
  border-radius: 17px;
  background-color: #F8F9FC;
  justify-content: center;
  align-items: center;
  margin-right: 8px;
  flex-shrink: 0;
}
.fp-chip-on {
  background-color: #1FBF8F;
}
.fp-chip-text {
  font-size: 13px;
  font-weight: bold;
  color: #8FAEAF;
}
.fp-chip-text-on {
  color: #FFFFFF;
  font-weight: bold;
}
.fp-food-list {
  flex: 1;
  height: 0;
  min-height: 0;
  margin-top: 16px;
}
.fp-row {
  position: relative;
  flex-direction: row;
  align-items: center;
  height: 76px;
  border-radius: 16px;
}
.fp-row-on {
  background-color: #F2FAF5;
}
.fp-row-thumb {
  width: 48px;
  height: 48px;
  border-radius: 16px;
  background-color: #EAF9F3;
}
.fp-row-text {
  flex: 1;
  margin-left: 12px;
}
.fp-row-name {
  font-size: 15.5px;
  font-weight: bold;
  color: #0A4F3D;
}
.fp-row-sub {
  font-size: 12px;
  color: #8FAEAF;
  margin-top: 4px;
}
.fp-row-sub-on {
  color: #0F4F3D;
  font-weight: bold;
}
.fp-radio {
  width: 22px;
  height: 22px;
  border-radius: 11px;
  border-width: 1.5px;
  border-color: #BFE3D6;
  justify-content: center;
  align-items: center;
  margin-left: 10px;
  margin-right: 10px;
}
.fp-radio-on {
  background-color: #1FBF8F;
  border-color: #1FBF8F;
}
.fp-radio-check {
  font-size: 12px;
  color: #FFFFFF;
}
.fp-row-div {
  position: absolute;
  left: 60px;
  right: 0;
  bottom: 0;
  height: 1px;
  background-color: #EAF3EF;
}
</style>
