
<template>
  <view class="fp-overlay" :class="{ 'fp-overlay-active': active, 'fp-hidden': !render }" @click="onOverlayTap">
    <view class="fp-container" :class="{ 'fp-container-active': active, 'fp-container-detail': step === 'detail' }" @click.stop>
    <view class="fp-sheet" v-if="step === 'list'">
      <view class="fp-top-row">
        <view class="fp-search-box">
          <image class="fp-search-icon" :src="'/static/common/search_icon.svg'" mode="aspectFit"></image>
          <input
            class="fp-search-input"
            v-model="keyword"
            placeholder="搜索食物 · 支持拼音 / 别名"
            placeholder-style="color:#9CB8B0;font-size:13.5px;"
          ></input>
        </view>
        <view class="fp-closebtn" hover-class="icon-pressed" :hover-stay-time="120" @click="close">
          <image class="fp-close-ic" :src="'/static/goal/gm_close.svg'" mode="aspectFit"></image>
        </view>
      </view>

      <scroll-view class="fp-chip-bar" direction="horizontal" :show-scrollbar="false">
        <view
          class="fp-chip ui-pressable"
          :class="{ 'fp-chip-on': catItem === cat }"
          hover-class="ui-pressed"
          :hover-stay-time="120"
          v-for="(catItem, catIdx) in cats"
          :key="catIdx"
          @click="pickCat(catItem)"
        >
          <text class="fp-chip-text" :class="{ 'fp-chip-text-on': catItem === cat }">{{ catItem }}</text>
        </view>
      </scroll-view>

      <scroll-view class="fp-food-list" direction="vertical" :show-scrollbar="false" :scroll-into-view="intoView" @scrolltolower="onLoadMore">
        <view
          class="fp-row ui-pressable"
          hover-class="ui-pressed"
          :hover-stay-time="120"
          :id="'row-' + item.id"
          v-for="(item, rowIdx) in displayedResults"
          :key="item.id"
          @click="pickFood(item.id)"
        >
          <view class="fp-row-accent" v-if="item.id === activeFoodId"></view>
          <image class="fp-row-thumb" :src="'/static/icons/' + item.img" mode="aspectFill"></image>
          <view class="fp-row-text">
            <text class="fp-row-name">{{ item.name }}</text>
            <text class="fp-row-sub" :class="{ 'fp-row-sub-on': item.id === activeFoodId }">{{ subLine(item) }}</text>
          </view>
          <view class="fp-radio" :class="{ 'fp-radio-on': item.id === activeFoodId }">
            <text class="fp-radio-check" v-if="item.id === activeFoodId">✓</text>
          </view>
          <view class="fp-row-div" v-if="rowIdx < displayedResults.length - 1"></view>
        </view>
      </scroll-view>
    </view>
    <view class="fp-detail-wrap" v-else-if="step === 'detail'">
      <AddFood
        :food-id="activeFoodId"
        @confirm="onDetailConfirm"
        @change="onDetailChange"
        @close="close"
      ></AddFood>
    </view>
    </view>
  </view>
</template>

<script setup lang="uts">
// [变更日志] 2026-09-24: FAB 顽疾修复——弹层根由 v-if 挂载改为常驻＋display:none 隐藏（消除每次约 1s 冷启动重挂载）；离场淡出窗口内蒙层点击改为 emit show=true 立即重开（不再吞击）
// [变更日志] 2026-09-24: 食物列表选中态重构 → 废弃整行绿底 .fp-row-on（白底图标叠绿底色块难看），改为左侧薄荷绿竖条 .fp-row-accent ＋ 既有文字加深加粗；日志落位 script 内（ADR-003 #7 禁 .uvue 根层 HTML 注释）
// [变更日志] 2026-09-25: 新增 startStep 属性——百科「添加到本餐」经 ct_pending_add 交接后，Home 以 startStep='detail'+selectedId 直接打开该项详情步
import { ref, computed, watch } from 'vue'
import { ALL_FOODS, searchFoods, vesselLabelOf, vesselSizesOf, type FoodBase } from '../stores/food'
import { triggerHaptic, playSound } from '../stores/settings'
import AddFood from './AddFood.uvue'
import type { AddPayload } from './AddFood.uvue'
export type { AddPayload }

/**
 * 弹层⓪ 食物选择与添加单流程整合容器（pencil 画板 n3dgv + 弹窗①）。
 * 内部 step 在 list 和 detail 原地切换，全流程仅使用一个原生 page-container 容器。
 */

const props = defineProps<{
  show: boolean
  selectedId?: string
  /** 打开时直接进入的步骤：'detail' 用于百科「添加到本餐」的一键交接（配合 selectedId 预填食物） */
  startStep?: string
}>()

const emit = defineEmits<{
  (e: 'update:show', v: boolean): void
  (e: 'select', foodId: string): void
  (e: 'confirm', payload: AddPayload): void
}>()

const render = ref(false)
const active = ref(false)
let timer = 0

const step = ref<'list' | 'detail'>('list')
const activeFoodId = ref('')

/** 分类 chips：全部 + 库内真实分类（按首次出现顺序去重） */
const cats: string[] = ['全部']
for (const f of ALL_FOODS) {
  if (!cats.includes(f.cat)) cats.push(f.cat)
}

const ALL_CAT = '全部'
const keyword = ref('')
const cat = ref(ALL_CAT)
const displayLimit = ref(20)

/** 打开时把选中行滚进视野 */
const intoView = computed<string>(() => activeFoodId.value !== '' ? 'row-' + activeFoodId.value : '')

const allFilteredResults = computed<FoodBase[]>(() => {
  const base = searchFoods(keyword.value)
  if (cat.value === ALL_CAT) return base
  return base.filter((f) => f.cat === cat.value)
})

const displayedResults = computed<FoodBase[]>(() => {
  const all = allFilteredResults.value
  if (keyword.value.trim() !== '') {
    return all.slice(0, 50)
  }
  return all.slice(0, displayLimit.value)
})

function onLoadMore(): void {
  if (displayLimit.value < allFilteredResults.value.length) {
    displayLimit.value += 20
  }
}

/** 副行：热量 + 一条有用提示（优先级：可选项 > 默认份量克重） */
function subLine(food: FoodBase): string {
  let s = food.kcal.toString() + ' kcal / 100' + food.unit
  if (food.opts != null && food.opts.length > 0) return s + ' · 支持杯型与甜度'
  if (food.vessel != null) {
    const label = vesselLabelOf(food.vessel!)
    const sizes = vesselSizesOf(food.vessel!)
    const dft = sizes.length > 1 ? sizes[1] : sizes[0]
    // 计件类（个/片/串）档位单位不是 g/ml，不加后缀，与稿面香蕉/苹果行一致
    if (label !== '' && dft != null && (dft.unit === 'g' || dft.unit === 'ml')) {
      s += ' · 一' + label + '约 ' + dft.amount.toString() + dft.unit
    }
  }
  return s
}

function pickCat(name: string): void {
  if (name === cat.value) {
    return
  }
  cat.value = name
}

function pickFood(id: string): void {
  playSound('click')
  activeFoodId.value = id
  step.value = 'detail'
  emit('select', id)
}

function onDetailChange(): void {
  step.value = 'list'
}

function onDetailConfirm(payload: AddPayload): void {
  emit('confirm', payload)
  close()
}

/** 原生蒙层点按时回传 show=false 触发离场动画；离场淡出窗口内（active 已 false、尚未 display:none）再点＝立即重开，避免吞击 */
function onOverlayTap(): void {
  if (!active.value) {
    emit('update:show', true)
    return
  }
  close()
}

/** 原生蒙层点按/系统返回触发 page-container 离场，动画结束后重置并回传关闭态 */
function onAfterLeave(): void {
  step.value = 'list'
  emit('update:show', false)
}

function close(): void {
  emit('update:show', false)
}

/** 每次打开重置搜索、分类与步骤（选中回显由 selectedId 驱动） */
watch(
  () => props.show,
  (v: boolean) => {
    if (v) {
      if (timer > 0) { clearTimeout(timer); timer = 0; }
      render.value = true
      keyword.value = ''
      cat.value = ALL_CAT
      displayLimit.value = 20
      activeFoodId.value = props.selectedId ?? ''
      step.value = ((props.startStep ?? 'list') === 'detail' && activeFoodId.value !== '') ? 'detail' : 'list'
      nextTick(() => {
        active.value = true
      })
    } else {
      active.value = false
      if (timer > 0) { clearTimeout(timer); timer = 0; }
      timer = setTimeout(() => {
        render.value = false
        onAfterLeave()
        timer = 0
      }, 180) as unknown as number
    }
  }
)
</script>

<style>
.fp-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 900;
  opacity: 0;
  transition-property: opacity;
  transition-duration: 180ms;
}
.fp-overlay-active {
  opacity: 1;
}
/* 常驻不卸载：隐藏态用 display:none 摘掉命中与绘制，重开＝纯 class 切换，免去整棵子树重挂载的约 1s 冷启动 */
.fp-hidden {
  display: none;
}
.fp-container {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1040rpx;
  /* #ifdef MP-WEIXIN */
  height: calc(1040rpx + env(safe-area-inset-bottom));
  /* #endif */
  background-color: #FFFFFF;
  border-top-left-radius: 68rpx;
  border-top-right-radius: 68rpx;
  /* #ifdef MP-WEIXIN */
  /* App 端带 transform 的浮层子树收不到触摸命中，位移入场仅保留小程序端 */
  transform: translateY(100%);
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  /* #endif */
  display: flex;
  flex-direction: column;
}
/* #ifdef MP-WEIXIN */
.fp-container-active {
  transform: translateY(0);
}
/* #endif */
.fp-container-detail {
  /* 贴合分量弹层实内容高，超出部分交给内部 scroll-view，避免确认键下方留大片空白 */
  height: 1080rpx;
  /* #ifdef MP-WEIXIN */
  height: calc(1080rpx + env(safe-area-inset-bottom));
  /* #endif */
}
.fp-sheet {
  flex: 1;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 32rpx 40rpx 0 40rpx;
  /* #ifdef MP-WEIXIN */
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  /* #endif */
  overflow: hidden;
}
.fp-detail-wrap {
  flex: 1;
  height: 100%;
  overflow: hidden;
}
.fp-top-row {
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
}
.fp-search-box {
  flex: 1;
  flex-direction: row;
  align-items: center;
  height: 92rpx;
  border-radius: 46rpx;
  background-color: #F5FAF8;
  border-width: 1px;
  border-color: #EAF3EF;
  padding-left: 36rpx;
  padding-right: 28rpx;
}
.fp-closebtn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background-color: #FFFFFF;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(10, 79, 61, 0.14);
  margin-left: 20rpx;
  flex-shrink: 0;
}
.fp-close-ic {
  width: 32rpx;
  height: 32rpx;
}
.fp-search-icon {
  width: 36rpx;
  height: 36rpx;
}
.fp-search-input {
  flex: 1;
  font-size: 27rpx;
  color: #0A4F3D;
  margin-left: 16rpx;
}
.fp-chip-bar {
  height: 68rpx;
  margin-top: 32rpx;
  flex-direction: row;
  flex-shrink: 0;
}
.fp-chip {
  width: 120rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background-color: #F8F9FC;
  justify-content: center;
  align-items: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.fp-chip-on {
  background-color: #1FBF8F;
}
.fp-chip-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #8FAEAF;
}
.fp-chip-text-on {
  color: #FFFFFF;
  font-weight: bold;
}
.fp-food-list {
  flex: 1;
  height: 0;
  min-height: 0;
  margin-top: 32rpx;
}
.fp-row {
  position: relative;
  flex-direction: row;
  align-items: center;
  height: 152rpx;
  border-radius: 32rpx;
}
/* 选中态＝左侧薄荷绿竖条（与缩略图等高、垂直居中），不再用整行绿底压白底图标 */
.fp-row-accent {
  position: absolute;
  left: 0;
  top: 28rpx;
  width: 6rpx;
  height: 96rpx;
  border-radius: 3rpx;
  background-color: #1FBF8F;
}
.fp-row-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background-color: #EAF9F3;
}
.fp-row-text {
  flex: 1;
  margin-left: 24rpx;
}
.fp-row-name {
  font-size: 31rpx;
  font-weight: bold;
  color: #0A4F3D;
}
.fp-row-sub {
  font-size: 24rpx;
  color: #8FAEAF;
  margin-top: 8rpx;
}
.fp-row-sub-on {
  color: #0F4F3D;
  font-weight: bold;
}
.fp-radio {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  border-width: 1.5px;
  border-color: #BFE3D6;
  justify-content: center;
  align-items: center;
  margin-left: 20rpx;
  margin-right: 20rpx;
}
.fp-radio-on {
  background-color: #1FBF8F;
  border-color: #1FBF8F;
}
.fp-radio-check {
  font-size: 24rpx;
  color: #FFFFFF;
}
.fp-row-div {
  position: absolute;
  left: 120rpx;
  right: 0;
  bottom: 0;
  height: 1px;
  background-color: #EAF3EF;
}
</style>
