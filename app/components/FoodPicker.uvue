  修改时间：2026-09-21
  AI模型：Qoder (Claude)
  修改内容：[新建：弹层⓪ 食物选择列表（pencil n3dgv 还原）——
    搜索框（名称/全拼/首字母，走 stores/food.searchFoods 同规则）、
    分类 chips 取库内真实 7 类（全部＋首次出现序）、行缩略图用真实 webp 图标、
    单选点行即选中并关闭；selectedId 回显高亮，首次打开无选中；
    重开时 scroll-into-view 把选中行滚进视野（验收截图发现残留滚动位不露选中行）]
-->

<template>
  <view class="fp-overlay" :class="{ 'fp-overlay-active': active }" v-if="render" @click="onOverlayTap">
    <view class="fp-container" :class="{ 'fp-container-active': active }" @click.stop>
    <view class="fp-sheet" v-if="step === 'list'">
      <view class="fp-top-row">
        <view class="fp-search-box">
          <image class="fp-search-icon" :src="'/static/common/search_icon.png'" mode="aspectFit"></image>
          <input
            class="fp-search-input"
            v-model="keyword"
            placeholder="搜索食物 · 支持拼音 / 别名"
            placeholder-style="color:#9CB8B0;font-size:13.5px;"
          ></input>
        </view>
        <view class="fp-closebtn" hover-class="icon-pressed" :hover-stay-time="120" @click="close">
          <image class="fp-close-ic" :src="'/static/goal/gm_close.png'" mode="aspectFit"></image>
        </view>
      </view>

      <scroll-view class="fp-chip-bar" direction="horizontal" :show-scrollbar="false">
        <view
          class="fp-chip ui-pressable"
          :class="{ 'fp-chip-on': catItem === cat }"
          hover-class="ui-pressed"
          :hover-stay-time="120"
          v-for="(catItem, catIdx) in cats"
          :key="catIdx"
          @click="pickCat(catItem)"
        >
          <text class="fp-chip-text" :class="{ 'fp-chip-text-on': catItem === cat }">{{ catItem }}</text>
        </view>
      </scroll-view>

      <scroll-view class="fp-food-list" direction="vertical" :show-scrollbar="false" :scroll-into-view="intoView">
        <view
          class="fp-row ui-pressable"
          :class="{ 'fp-row-on': item.id === activeFoodId }"
          hover-class="ui-pressed"
          :hover-stay-time="120"
          :id="'row-' + item.id"
          v-for="(item, rowIdx) in results"
          :key="item.id"
          @click="pickFood(item.id)"
        >
          <image class="fp-row-thumb" :src="'/static/icons/' + item.img" mode="aspectFill"></image>
          <view class="fp-row-text">
            <text class="fp-row-name">{{ item.name }}</text>
            <text class="fp-row-sub" :class="{ 'fp-row-sub-on': item.id === activeFoodId }">{{ subLine(item) }}</text>
          </view>
          <view class="fp-radio" :class="{ 'fp-radio-on': item.id === activeFoodId }">
            <text class="fp-radio-check" v-if="item.id === activeFoodId">✓</text>
          </view>
          <view class="fp-row-div" v-if="rowIdx < results.length - 1"></view>
        </view>
      </scroll-view>
    </view>
    <view class="fp-detail-wrap" v-else-if="step === 'detail'">
      <AddFood
        :food-id="activeFoodId"
        @confirm="onDetailConfirm"
        @change="onDetailChange"
        @close="close"
      ></AddFood>
    </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, watch } from 'vue'
import { ALL_FOODS, searchFoods, vesselLabelOf, vesselSizesOf, type FoodBase } from '../stores/food'
import { triggerHaptic, playSound } from '../stores/settings'
import AddFood from './AddFood.uvue'
import type { AddPayload } from './AddFood.uvue'
export type { AddPayload }

/**
 * 弹层⓪ 食物选择与添加单流程整合容器（pencil 画板 n3dgv + 弹窗①）。
 * 内部 step 在 list 和 detail 原地切换，全流程仅使用一个原生 page-container 容器。
 */

const props = defineProps<{
  show: boolean
  selectedId?: string
}>()

const emit = defineEmits<{
  (e: 'update:show', v: boolean): void
  (e: 'select', foodId: string): void
  (e: 'confirm', payload: AddPayload): void
}>()

const render = ref(false)
const active = ref(false)
let timer = 0

const step = ref<'list' | 'detail'>('list')
const activeFoodId = ref('')

/** 分类 chips：全部 + 库内真实分类（按首次出现顺序去重） */
const cats: string[] = ['全部']
for (const f of ALL_FOODS) {
  if (!cats.includes(f.cat)) cats.push(f.cat)
}

const ALL_CAT = '全部'
const keyword = ref('')
const cat = ref(ALL_CAT)

/** 打开时把选中行滚进视野 */
const intoView = computed<string>(() => activeFoodId.value !== '' ? 'row-' + activeFoodId.value : '')

const results = computed<FoodBase[]>(() => {
  const base = searchFoods(keyword.value)
  if (cat.value === ALL_CAT) return base
  return base.filter((f) => f.cat === cat.value)
})

/** 副行：热量 + 一条有用提示（优先级：可选项 > 默认份量克重） */
function subLine(food: FoodBase): string {
  let s = food.kcal.toString() + ' kcal / 100' + food.unit
  if (food.opts != null && food.opts.length > 0) return s + ' · 支持杯型与甜度'
  if (food.vessel != null) {
    const label = vesselLabelOf(food.vessel!)
    const sizes = vesselSizesOf(food.vessel!)
    const dft = sizes.length > 1 ? sizes[1] : sizes[0]
    // 计件类（个/片/串）档位单位不是 g/ml，不加后缀，与稿面香蕉/苹果行一致
    if (label !== '' && dft != null && (dft.unit === 'g' || dft.unit === 'ml')) {
      s += ' · 一' + label + '约 ' + dft.amount.toString() + dft.unit
    }
  }
  return s
}

function pickCat(name: string): void {
  if (name === cat.value) {
    return
  }
  cat.value = name
}

function pickFood(id: string): void {
  playSound('click')
  activeFoodId.value = id
  step.value = 'detail'
  emit('select', id)
}

function onDetailChange(): void {
  step.value = 'list'
}

function onDetailConfirm(payload: AddPayload): void {
  emit('confirm', payload)
  close()
}

/** 原生蒙层点按时回传 show=false 触发离场动画 */
function onOverlayTap(): void {
  close()
}

/** 原生蒙层点按/系统返回触发 page-container 离场，动画结束后重置并回传关闭态 */
function onAfterLeave(): void {
  step.value = 'list'
  emit('update:show', false)
}

function close(): void {
  emit('update:show', false)
}

/** 每次打开重置搜索、分类与步骤（选中回显由 selectedId 驱动） */
watch(
  () => props.show,
  (v: boolean) => {
    if (v) {
      if (timer > 0) { clearTimeout(timer); timer = 0; }
      render.value = true
      step.value = 'list'
      keyword.value = ''
      cat.value = ALL_CAT
      activeFoodId.value = props.selectedId ?? ''
      setTimeout(() => {
        active.value = true
      }, 50)
    } else {
      active.value = false
      if (timer > 0) { clearTimeout(timer); timer = 0; }
      timer = setTimeout(() => {
        render.value = false
        onAfterLeave()
        timer = 0
      }, 300) as unknown as number
    }
  }
)
</script>

<style>
.fp-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 900;
  opacity: 0;
  transition-property: opacity;
  transition-duration: 300ms;
}
