
<template>
  <scroll-view class="af-scroll" direction="vertical" :show-scrollbar="false" v-if="food != null">
    <!-- [变更日志] 2026-09-27: 确认钮渐变深端 accentDeep→accentMid（消除右下角发黑） -->
    <!-- [变更日志] 2026-09-27: 关闭钮底色 theme.chip→theme.card(白) + 补 box-shadow，对齐 GoalModal/FoodPicker 关闭钮三件套 -->
    <!-- [变更日志] 2026-09-24: 确认钮渐变带角度(135deg)在 App 原生端报 Invalid value → 角度版包入 #ifdef MP-WEIXIN，App 端用无色标渐变 -->
    <!-- [变更日志] 2026-09-27: .af-sheet 改绑 afSheetStyle（底色 ＋ App 端运行时安全区底距） -->
    <view class="af-sheet" :style="afSheetStyle">
    <view class="food-row">
        <image class="food-thumb" :style="{ backgroundColor: theme.thumbStroke }" :src="'/static/icons/' + food.img" mode="aspectFill"></image>
        <view class="food-text">
          <text class="food-name" :style="{ color: theme.ink1 }">{{ food.name }}</text>
          <text class="food-unit" :style="{ color: theme.ink3 }">{{ unitLine }}</text>
        </view>
        <text class="big-kcal" :style="{ color: theme.ink1 }">{{ totalKcal }}</text>
        <text class="kcal-unit" :style="{ color: theme.accentDeep }">kcal</text>
        <view class="change-btn ui-pressable" :style="{ backgroundColor: theme.chip }" hover-class="ui-pressed" :hover-stay-time="120" @click="onChange">
          <image class="change-icon" :src="asset('common/change_icon.svg')" mode="aspectFit"></image>
          <text class="change-text" :style="{ color: theme.ink1 }">{{ t('af.change') }}</text>
        </view>
        <view class="af-closebtn" :style="{ backgroundColor: theme.card }" hover-class="icon-pressed" :hover-stay-time="120" @click="close">
          <image class="af-close-ic" :src="asset('goal/gm_close.svg')" mode="aspectFit"></image>
        </view>
      </view>
      <view class="sub-row">
        <text class="sub-plain" :style="{ color: theme.ink3 }">{{ t('af.calcHead') }}</text>
        <text class="sub-bold" :style="{ color: theme.accentDeep }">{{ calcBold }}</text>
        <text class="sub-plain" :style="{ color: theme.ink3 }">{{ calcTail }}</text>
      </view>

      <text class="form-label" :style="{ color: theme.ink1 }" v-if="!isCountUnit">{{ t('af.portion') }}</text>
      <CountStepper
        v-if="isCountUnit"
        v-model="count"
        :unit-label="vesselLabel"
        :grams-per-unit="pieceWeight"
        :kcal-per-unit="kcalPerUnit"
      ></CountStepper>
      <OptionTray v-else :options="sizeOpts" v-model="sizeKey" ></OptionTray>

      <template v-for="(grpItem, grpIdx) in singleGroups" :key="grpIdx">
        <text class="form-label" :style="{ color: theme.ink1 }">{{ grpItem.label }}</text>
        <view class="sweet-tray" :style="{ backgroundColor: theme.chip }" v-if="grpItem.key === 'sweet'">
          <view
            class="sweet-pill"
            :style="sweetPillStyle(grpItem)"
          ></view>
          <view
            class="sweet-seg ui-pressable"
            hover-class="ui-pressed"
            :hover-stay-time="120"
            v-for="(optItem, optIdx) in sweetOpts(grpItem)"
            :key="optIdx"
            @click="pickSweet(grpItem.key, optItem.key)"
          >
            <view class="batt" :class="{ 'batt-on': sweetPick(grpItem.key) === optItem.key }">
              <view
                class="batt-bar"
                :style="battStyle(barIdx < sweetFill(optItem.key), sweetPick(grpItem.key) === optItem.key)"
                v-for="barIdx in 10"
                :key="barIdx"
              ></view>
            </view>
            <text class="sweet-name" :class="{ 'sweet-name-on': sweetPick(grpItem.key) === optItem.key }" :style="{ color: sweetNameColor(sweetPick(grpItem.key) === optItem.key) }">{{ optItem.label }}</text>
            <text class="sweet-frac" :style="{ color: theme.ink3 }">{{ sweetFill(optItem.key) }}/10</text>
          </view>
        </view>
        <OptionTray v-else :options="sweetOpts(grpItem)" :model-value="sweetPick(grpItem.key)" @update:modelValue="(v) => setSweet(grpItem.key, v)" ></OptionTray>
      </template>

      <text class="form-label" :style="{ color: theme.ink1 }">{{ t('af.mealSec') }}</text>
      <view class="af-meal-row">
        <view
          class="af-meal-card ui-pressable"
          :class="{ 'af-meal-card-on': mealItem.key === meal }"
          hover-class="ui-pressed"
          :hover-stay-time="120"
          v-for="(mealItem, mealIdx) in mealCards"
          :key="mealIdx"
          @click="pickMeal(mealItem.key)"
        >
          <image class="af-meal-photo" :src="mealItem.photo" mode="aspectFill"></image>
          <view class="af-meal-scrim" v-if="mealItem.key !== meal"></view>
          <view class="af-meal-shade"></view>
          <text class="af-meal-name" :class="{ 'af-meal-name-on': mealItem.key === meal }">{{ mealItem.label }}</text>
          <view class="seal" v-if="mealItem.key === meal" :style="{ backgroundColor: theme.accent, borderColor: theme.card }">
            <text class="seal-glyph" :style="{ color: theme.onAccent }">✓</text>
          </view>
        </view>
      </view>

      <view class="confirm-btn ui-pressable" :style="confirmStyle" hover-class="af-btn-pressed" :hover-stay-time="140" @click="confirm">
        <text class="confirm-text" :style="{ color: theme.onAccent }">{{ tf('af.confirm', [mealLabel, totalKcal.toString()]) }}</text>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { t, tf } from '../composables/i18n'
import { computed } from 'vue'
import { watch } from 'vue'
import OptionTray from './OptionTray.uvue'
import type { TrayOption } from './OptionTray.uvue'
import CountStepper from './CountStepper.uvue'
import { useTheme, themeAsset } from '../composables/useTheme'
import { playSound, triggerHaptic } from '../stores/settings'
import {
  getFoodById,
  gramsOf,
  optGroupsOf,
  optDeltaOf,
  vesselSizesOf,
  DEFAULT_COUNT,
  COUNT_UNITS,
  type FoodBase,
  type OptGroup,
} from '../stores/food'

/**
 * 公共添加食物弹层（pencil 弹窗①–⑥⑧ 统一结构）。
 * 奶茶有甜度组，其余只有分量＋餐次；计件类（个/片/串）分量区走步进器，其余走底槽分段。
 * multi 型选项组（加料）本轮不渲染；确认只 emit payload，不写库。
 */

const props = defineProps<{
  show?: boolean
  foodId: string
}>()

const emit = defineEmits<{
  (e: 'update:show', v: boolean): void
  (e: 'confirm', v: AddPayload): void
  (e: 'change'): void
  (e: 'close'): void
}>()

export type AddPayload = {
  foodId: string
  amount: number
  unit: string
  meal: string
  sweets: Record<string, string>
  extraKcal: number
  kcal: number
}

/**
 * 器皿素材元数据（pencil 对照A/B/C/D 定案）：
 * natW/natH = 素材原始像素比；contact = 接触宽（设计稿实测仅 瓶0.93/罐0.93/碗0.64/盘0.49/杯0.64/串0.13，
 * 未实测器形取 0.64 保守值）；solid = 实心不透明素材（金属砝码，未选中压暗 0.85 而非 0.62）；
 * unitFixed = 按份计数类（单颗尺寸固定 33×30，只变颗数不变单体）。
 */
type VesselArtMeta = {
  src: string
  natW: number
  natH: number
  contact: number
  solid: boolean
  unitFixed: boolean
}

const VESSEL_ART: Record<string, VesselArtMeta> = {
  cup: { src: '/static/vessels/v3_cup.png', natW: 157, natH: 300, contact: 0.64, solid: false, unitFixed: false },
  cup_coffee: { src: '/static/vessels/v3_cup.png', natW: 157, natH: 300, contact: 0.64, solid: false, unitFixed: false },
  cup_soda: { src: '/static/vessels/v3_cup.png', natW: 157, natH: 300, contact: 0.64, solid: false, unitFixed: false },
  mug: { src: '/static/vessels/v3_mug.png', natW: 300, natH: 260, contact: 0.64, solid: false, unitFixed: false },
  glass: { src: '/static/vessels/v3_glass.png', natW: 154, natH: 300, contact: 0.64, solid: false, unitFixed: false },
  glass_wine: { src: '/static/vessels/v3_glass_wine.png', natW: 119, natH: 300, contact: 0.64, solid: false, unitFixed: false },
  shot: { src: '/static/vessels/v3_shot.png', natW: 179, natH: 300, contact: 0.64, solid: false, unitFixed: false },
  bottle: { src: '/static/vessels/v3_bottle.png', natW: 102, natH: 300, contact: 0.93, solid: false, unitFixed: false },
  can: { src: '/static/vessels/v3_can.png', natW: 170, natH: 300, contact: 0.93, solid: false, unitFixed: false },
  bowl_rice: { src: '/static/vessels/v3_bowl.png', natW: 300, natH: 269, contact: 0.64, solid: false, unitFixed: false },
  bowl_noodle: { src: '/static/vessels/v3_bowl.png', natW: 300, natH: 269, contact: 0.64, solid: false, unitFixed: false },
  bowl_soup: { src: '/static/vessels/v3_bowl.png', natW: 300, natH: 269, contact: 0.64, solid: false, unitFixed: false },
  pot: { src: '/static/vessels/v3_weight.png', natW: 300, natH: 271, contact: 0.93, solid: true, unitFixed: true },
  plate: { src: '/static/vessels/v3_plate.png', natW: 300, natH: 119, contact: 0.49, solid: false, unitFixed: false },
  bag: { src: '/static/vessels/v3_bag.png', natW: 209, natH: 300, contact: 0.64, solid: false, unitFixed: false },
}

/** 设计定案：三档=同一张图 scale 0.60/0.80/1.00；两档按容量立方根；单档 1.0 */
const TIER_SCALES = [0.60, 0.80, 1.00]
const ART_BOX_W = 96
const ART_BOX_H = 72
/** 甜度电量格数映射（展示层：三分/五分/七分/全糖 = 3/5/7/10 格） */
const SWEET_BARS: Record<string, number> = { none: 0, light: 3, half: 5, less: 7, full: 10 }

type MealCard = { key: string; label: string; photo: string }
const MEAL_CARDS = computed<MealCard[]>((): MealCard[] => [
  { key: 'breakfast', label: t('meal.breakfast'), photo: '/static/meals/sky_breakfast.png' },
  { key: 'lunch', label: t('meal.lunch'), photo: '/static/meals/sky_lunch.png' },
  { key: 'dinner', label: t('meal.dinner'), photo: '/static/meals/sky_dinner.png' },
  { key: 'snack', label: t('meal.snack'), photo: '/static/meals/sky_night.png' },
])

function defaultMeal(): string {
  const h = new Date().getHours()
  if (h < 10) return 'breakfast'
  if (h < 15) return 'lunch'
  if (h < 21) return 'dinner'
  return 'snack'
}

const food = computed<FoodBase | null>(() => getFoodById(props.foodId) ?? null)
const vesselLabel = computed(() => {
  const f = food.value
  if (f == null || f.vessel == null) return ''
  const keys: Record<string, string> = {
    cup: 'af.uCup', cup_coffee: 'af.uCup', cup_soda: 'af.uCup', mug: 'af.uCup', glass: 'af.uCup',
    glass_wine: 'af.uCup', shot: 'af.uCup', bottle: 'af.uBottle', can: 'af.uCan', bowl_rice: 'af.uBowl',
    bowl_noodle: 'af.uBowl', bowl_soup: 'af.uBowl', pot: 'af.uPot', plate: 'af.uPot', bag: 'af.uBag',
    piece: 'af.uPiece', slice: 'af.uSlice', skewer: 'af.uSkewer',
  }
  const k = keys[f.vessel]
  return k != null ? t(k) : ''
})
const isCountUnit = computed(() => {
  const f = food.value
  if (f == null) return false
  const lbl = vesselLabel.value
  return COUNT_UNITS.some((u): boolean => u === lbl)
})
const pieceWeight = computed(() => food.value?.pieceWeight ?? 0)
const kcalPerUnit = computed(() => {
  const f = food.value
  if (f == null) return 0
  return Math.round(f.kcal * pieceWeight.value / 100)
})

const count = ref(DEFAULT_COUNT)
const sizeKey = ref('')
const sweetSel = ref<Record<string, string>>({})
const meal = ref(defaultMeal())
const mealCards = computed<MealCard[]>((): MealCard[] => MEAL_CARDS.value)

const { theme, isDark, accentId } = useTheme()

// [变更日志] 2026-09-27: 详情弹层底部安全区补齐——类内 calc(env) padding-bottom 仅 MP 生效，App 端裸 48rpx，
//   真实带手势条机型会被系统条压住（本机 safeAreaInsets.bottom=0 掩盖了该问题），按 safeAreaInsets 运行时下发
/** 详情底距：App 端 = 设计底衬 48rpx 换算 px ＋ 安全区；MP 端交回类内 calc 规则（getSystemInfoSync 在 MP 无 insets，不覆盖） */
const afSheetStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['background-color'] = theme.value.card
  // #ifdef APP
  const sysAf = uni.getSystemInfoSync()
  const insetsAf = sysAf.safeAreaInsets
  const sbAf = insetsAf != null ? insetsAf.bottom : 0
  st['padding-bottom'] = (48 * sysAf.windowWidth / 750 + sbAf) + 'px'
  // #endif
  return st
})

/** 资产按 (accent, mode) 取五档变体；未登记底稿自动回落原路径 */
function asset(path: string): string {
  return themeAsset(accentId.value, isDark.value, '/static/' + path)
}

/** 甜度底槽白胶囊：位移与主题面一并运行时下发（内联优先级高于类，条件类不再承担配色） */
function sweetPillStyle(grp: OptGroup): Record<string, string> {
  const st = {} as Record<string, string>
  st['left'] = sweetPillLeft(grp)
  st['background-color'] = theme.value.card
  st['border-color'] = theme.value.line
  return st
}

/** 电量格：选中段整体升高 4rpx，填充格走该档 accent，空格走分隔线色 */
function battStyle(filled: boolean, on: boolean): Record<string, string> {
  const st = {} as Record<string, string>
  st['height'] = on ? '30rpx' : '26rpx'
  st['background-color'] = filled ? theme.value.accent : theme.value.line
  return st
}

function sweetNameColor(on: boolean): string {
  return on ? theme.value.ink1 : theme.value.ink3
}

/** 确认钮：浅态走该档 accent→accentDeep 渐变，暗态改 accent 纯色（accentDeep 在暗档是亮色，不能当渐变色尾） */
const confirmStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['background-color'] = theme.value.accent
  if (!isDark.value) {
    st['background-image'] = 'linear-gradient(' + theme.value.accent + ', ' + theme.value.accentMid + ')'
  }
  return st
})

function resetForFood(): void {
  const f = food.value
  count.value = DEFAULT_COUNT
  meal.value = defaultMeal()
  const sel: Record<string, string> = {}
  if (f != null) {
    const sizes = vesselSizesOf(f.vessel ?? '')
    if (sizes.length > 1) {
      sizeKey.value = sizes[1]?.k ?? sizes[0]?.k ?? ''
    } else {
      sizeKey.value = sizes[0]?.k ?? ''
    }
    for (const g of optGroupsOf(f)) {
      if (g.type === 'single' && typeof g.def === 'string') sel[g.key] = g.def
    }
  } else {
    sizeKey.value = ''
  }
  sweetSel.value = sel
}

watch(
  () => props.foodId,
  () => {
    resetForFood()
  }
)
resetForFood()

const singleGroups = computed<OptGroup[]>(() => {
  const f = food.value
  if (f == null) return []
  return optGroupsOf(f).filter((g) => g.type === 'single')
})

function sweetPick(key: string): string {
  return sweetSel.value[key] ?? ''
}

function setSweet(key: string, v: string): void {
  const next = { ...sweetSel.value }
  next[key] = v
  sweetSel.value = next
}

const sizeOpts = computed<TrayOption[]>(() => {
  const f = food.value
  if (f == null) return []
  const sizes = vesselSizesOf(f.vessel ?? '')
  const maxAmt = sizes.reduce((m, s) => (s.amount > m ? s.amount : m), 1)
  const art = VESSEL_ART[f.vessel ?? '']
  return sizes.map((s, idx): TrayOption => {
    const label = s.name + ' ' + s.amount.toString() + s.unit
    const sub = Math.round(f.kcal * s.amount / 100).toString() + ' kcal'
    if (art == null) {
      return { key: s.k, label, sub, art: '', artW: 0, artH: 0, count: 1, contact: 0.64, solid: false }
    }
    if (art.unitFixed) {
      // 砝码类：单颗固定 33×30，小份/一份/大份 = 1/2/3 颗
      return { key: s.k, label, sub, art: art.src, artW: 33, artH: 30, count: idx + 1, contact: art.contact, solid: true }
    }
    let scale = 1.0
    if (sizes.length === 3) {
      scale = TIER_SCALES[idx]
    } else if (sizes.length > 1) {
      scale = Math.cbrt(s.amount / maxAmt)
    }
    const fit = Math.min(ART_BOX_W / art.natW, ART_BOX_H / art.natH) * scale
    return {
      key: s.k,
      label,
      sub,
      art: art.src,
      artW: Math.round(art.natW * fit),
      artH: Math.round(art.natH * fit),
      count: 1,
      contact: art.contact,
      solid: art.solid,
    }
  })
})

function sweetOpts(grp: OptGroup): TrayOption[] {
  const grams = currentGrams()
  return grp.items.map((it) => {
    const d = optDeltaOf(grp, it, grams)
    return {
      key: it.k,
      label: it.name,
      sub: d > 0 ? '+' + d.toString() + ' kcal' : '',
      art: '',
      artW: 0,
      artH: 0,
      count: 1,
      contact: 0.64,
      solid: false,
    }
  })
}

function sweetFill(k: string): number {
  return SWEET_BARS[k] ?? 10
}

/** 白胶囊在 5 等分段间做 x 位移（段不动只动胶囊） */
function sweetPillLeft(grp: OptGroup): string {
  const sel = sweetPick(grp.key)
  let idx = 0
  for (let i = 0; i < grp.items.length; i++) {
    if (grp.items[i].k === sel) idx = i
  }
  return (idx * 20).toString() + '%'
}

function pickSweet(key: string, v: string): void {
  if (sweetPick(key) === v) {
    triggerHaptic('light')
    return
  }
  playSound('card')
  setSweet(key, v)
  triggerHaptic('light')
}

/** 头部副行：计件类=每单位热量，其余=每100单位热量 */
const unitLine = computed<string>(() => {
  const f = food.value
  if (f == null) return ''
  if (isCountUnit.value) return kcalPerUnit.value.toString() + ' kcal / ' + vesselLabel.value
  return f.kcal.toString() + ' kcal / 100' + f.unit
})

/** 「已按 X 计算」：器皿档名+克量；步进器带「约 Ng」 */
const calcBold = computed<string>(() => {
  const f = food.value
  if (f == null) return ''
  if (isCountUnit.value) return count.value.toString() + vesselLabel.value
  const sizes = vesselSizesOf(f.vessel ?? '')
  const hit = sizes.find((s) => s.k === sizeKey.value)
  if (hit == null) return ''
  return hit.name + ' ' + hit.amount.toString() + hit.unit
})

const calcTail = computed<string>(() => {
  const f = food.value
  if (f == null) return t('af.calcTail')
  if (isCountUnit.value && pieceWeight.value > 0) {
    return tf('af.calcTailP', [(count.value * pieceWeight.value).toString()])
  }
  return t('af.calcTail')
})

const mealLabel = computed<string>(() => t('meal.' + meal.value))

function currentGrams(): number {
  const f = food.value
  if (f == null) return 0
  if (isCountUnit.value) return gramsOf(f, count.value, vesselLabel.value)
  const sizes = vesselSizesOf(f.vessel ?? '')
  const hit = sizes.find((s) => s.k === sizeKey.value)
  return hit != null ? hit.amount : 0
}

function extraKcalOf(): number {
  const f = food.value
  if (f == null) return 0
  const grams = currentGrams()
  let extra = 0
  for (const g of singleGroups.value) {
    const k = sweetSel.value[g.key] ?? ''
    const it = g.items.find((x) => x.k === k)
    if (it != null) extra += optDeltaOf(g, it, grams)
  }
  return extra
}

const totalKcal = computed(() => {
  const f = food.value
  if (f == null) return 0
  const grams = currentGrams()
  return Math.round(f.kcal * grams / 100 + extraKcalOf())
})

function pickMeal(key: string): void {
  if (key === meal.value) {
    triggerHaptic('light')
    return
  }
  playSound('card')
  meal.value = key
  triggerHaptic('light')
}

function onChange(): void {
  triggerHaptic('light')
  emit('change')
}

function close(): void {
  emit('update:show', false)
  emit('close')
}

function confirm(): void {
  const f = food.value
  if (f == null) return
  const sizes = vesselSizesOf(f.vessel ?? '')
  const hit = sizes.find((s) => s.k === sizeKey.value)
  triggerHaptic('medium')
  emit('confirm', {
    foodId: f.id,
    amount: isCountUnit.value ? count.value : (hit != null ? hit.amount : 0),
    unit: isCountUnit.value ? vesselLabel.value : (hit != null ? hit.unit : f.unit),
    meal: meal.value,
    sweets: { ...sweetSel.value },
    extraKcal: extraKcalOf(),
    kcal: totalKcal.value,
  })
}
</script>

<style>
.af-scroll {
  flex: 1;
  height: 100%;
}
.af-sheet {
  position: relative;
  border-top-left-radius: 68rpx;
  border-top-right-radius: 68rpx;
  padding: 32rpx 36rpx 48rpx 36rpx;
  /* #ifdef MP-WEIXIN */
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  /* #endif */
  flex-shrink: 0;
}
.af-closebtn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(10, 79, 61, 0.14);
  flex-shrink: 0;
  margin-left: 16rpx;
}
.af-close-ic {
  width: 32rpx;
  height: 32rpx;
}
.food-row {
