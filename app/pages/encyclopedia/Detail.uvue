<!-- [变更日志] 百科详情页 SFC：详情+搜索双态、全 token 三主题/暗色、中英双语、餐次 CTA 交接 -->
<template>
  <view class="ec-page" :style="{ backgroundColor: theme.bg }">
    <!-- 顶栏：返回 / 标题 / 搜索 -->
    <view class="ec-header" :style="{ backgroundColor: theme.bg }">
      <view :style="{ height: sbH + 'px' }"></view>
      <view class="ec-nav">
        <view class="ec-nav-btn" hover-class="ec-press" :hover-stay-time="100" @click="goBack">
          <image v-if="isDark" class="ec-nav-icon" src="/static/encyclopedia/back_light.svg" mode="aspectFit"></image>
          <image v-else class="ec-nav-icon" src="/static/encyclopedia/back_dark.svg" mode="aspectFit"></image>
        </view>
        <text class="ec-nav-title" :style="{ color: theme.ink1 }">{{ t('ec.title') }}</text>
        <view class="ec-nav-btn" hover-class="ec-press" :hover-stay-time="100" @click="openSearch">
          <image v-if="isDark" class="ec-nav-icon" src="/static/encyclopedia/search_light.svg" mode="aspectFit"></image>
          <image v-else class="ec-nav-icon" src="/static/encyclopedia/search_dark.svg" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <scroll-view v-if="food != null" class="ec-body" direction="vertical" :show-scrollbar="false" :style="{ height: bodyH + 'px' }">
      <!-- Hero：图 + 名 + 徽章 + 热量 + 宏量标签 -->
      <view class="ec-hero" :style="{ backgroundColor: theme.card }">
        <view class="ec-hero-art" :style="{ backgroundColor: theme.cardSoft }">
          <image class="ec-hero-img" :src="heroImg" mode="aspectFit"></image>
        </view>
        <view class="ec-hero-info">
          <view class="ec-name-row">
            <text class="ec-name" :style="{ color: theme.ink1 }">{{ zhName }}</text>
            <view class="ec-badge" :style="{ backgroundColor: theme.chip }">
              <text class="ec-badge-text" :style="{ color: theme.accentDeep }">{{ badgeText }}</text>
            </view>
          </view>
          <view class="ec-cal-row">
            <text class="ec-cal-num" :style="{ color: theme.accent }">{{ heroCalText }}</text>
            <text class="ec-cal-unit" :style="{ color: theme.accent }">kcal</text>
          </view>
          <text class="ec-piece" :style="{ color: theme.ink3 }">{{ pieceText }}</text>
          <view class="ec-chips">
            <view class="ec-chip" v-for="(chip, chipIdx) in chipList" :key="chipIdx" :style="{ backgroundColor: theme.cardSoft }">
              <text class="ec-chip-text" :style="{ color: theme.ink2 }">{{ chip }}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 主要营养成分（每 100g） -->
      <view class="ec-card" :style="{ backgroundColor: theme.card }">
        <text class="ec-card-title" :style="{ color: theme.ink1 }">{{ t('ec.nutrition') }}<text class="ec-card-sub" :style="{ color: theme.ink3 }">{{ t('ec.per100') }}</text></text>
        <view class="ec-nut-row">
          <view class="ec-nut-col" v-for="(col, colIdx) in nutCols" :key="colIdx">
            <view class="ec-nut-icon" :style="{ backgroundColor: col.tint }">
              <text class="ec-nut-emoji">{{ col.emoji }}</text>
            </view>
            <text class="ec-nut-label" :style="{ color: theme.ink2 }">{{ col.label }}</text>
            <text class="ec-nut-value" :style="{ color: theme.ink1 }">{{ col.value }}</text>
            <view class="ec-nut-track" :style="{ backgroundColor: theme.line }">
              <view class="ec-nut-fill" :style="{ width: col.pctWidth, backgroundColor: col.tint }"></view>
            </view>
            <text class="ec-nut-pct" :style="{ color: theme.ink3 }">{{ col.pctText }}</text>
          </view>
        </view>
      </view>

      <!-- 营养点评 + 三列指引 -->
      <view class="ec-card" :style="{ backgroundColor: theme.card }">
        <view class="ec-review-head">
          <view class="ec-review-dot" :style="{ backgroundColor: theme.chip }">
            <text class="ec-review-dot-emoji"></text>
          </view>
          <text class="ec-card-title" :style="{ color: theme.ink1 }">{{ t('ec.review') }}</text>
        </view>
        <text class="ec-review-text" :style="{ color: theme.ink2 }">{{ reviewBody }}</text>
        <view class="ec-guide" :style="{ borderTopColor: theme.line }">
          <view class="ec-guide-col" v-for="(g, gIdx) in guideRows" :key="gIdx">
            <text class="ec-guide-title" :style="{ color: theme.accentDeep }">{{ g.emoji }} {{ g.title }}</text>
            <text class="ec-guide-text" :style="{ color: theme.ink3 }">{{ g.text }}</text>
          </view>
        </view>
      </view>

      <!-- 相关食物 -->
      <view class="ec-related-block">
        <view class="ec-related-head">
          <text class="ec-related-emoji">🍽</text>
          <text class="ec-section-title" :style="{ color: theme.ink1 }">{{ t('ec.related') }}</text>
        </view>
        <scroll-view class="ec-related-scroll" direction="horizontal" :show-scrollbar="false">
          <view class="ec-related-row">
            <view class="ec-rel-card" :class="{ 'ec-rel-current': rel.id == currentId }" v-for="(rel, relIdx) in relatedList" :key="relIdx" :style="{ backgroundColor: theme.card, borderColor: rel.id == currentId ? theme.accent : theme.card }" hover-class="ec-press" :hover-stay-time="100" @click="goFood(rel.id)">
              <image class="ec-rel-img" :src="rel.img" mode="aspectFit"></image>
              <text class="ec-rel-name" :style="{ color: theme.ink1 }">{{ rel.name }}</text>
              <text class="ec-rel-cal" :style="{ color: theme.ink3 }">{{ rel.calText }}</text>
            </view>
          </view>
        </scroll-view>
      </view>
      <view class="ec-bottom-space"></view>
    </scroll-view>

    <!-- 底部 CTA：添加到当前餐次 -->
    <view v-if="food != null" class="ec-cta-wrap" :style="{ backgroundColor: theme.bg, paddingBottom: (20 + safeBottom) + 'px' }">
      <view class="ec-cta" :style="{ backgroundImage: ctaGradient }" hover-class="ec-cta-press" :hover-stay-time="120" @click="addToMeal">
        <text class="ec-cta-plus">＋</text>
        <text class="ec-cta-text" :style="{ color: theme.onAccent }">{{ ctaText }}</text>
      </view>
    </view>

    <!-- 搜索态（全屏覆盖） -->
    <view v-if="searchOpen" class="ec-search" :style="{ backgroundColor: theme.bg }">
      <view :style="{ height: sbH + 'px' }"></view>
      <view class="ec-search-bar">
        <view class="ec-nav-btn" hover-class="ec-press" :hover-stay-time="100" @click="closeSearch">
          <image v-if="isDark" class="ec-nav-icon" src="/static/encyclopedia/back_light.svg" mode="aspectFit"></image>
          <image v-else class="ec-nav-icon" src="/static/encyclopedia/back_dark.svg" mode="aspectFit"></image>
        </view>
        <view class="ec-input-box" :style="{ backgroundColor: theme.card }">
          <text class="ec-input-glyph">⌕</text>
          <input class="ec-input" :focus="searchFocus" :placeholder="t('ec.searchPh')" :placeholder-style="'color:' + theme.ink3" v-model="query" confirm-type="search"></input>
          <text v-if="query.length > 0" class="ec-input-clear" @click="clearQuery">✕</text>
        </view>
        <text class="ec-cancel" :style="{ color: theme.accentDeep }" @click="closeSearch">{{ t('ec.cancel') }}</text>
      </view>

      <scroll-view class="ec-results" direction="vertical" :show-scrollbar="false" :style="{ height: (winH - sbH - 50) + 'px' }">
        <view class="ec-result" v-for="(r, rIdx) in results" :key="rIdx" :style="{ backgroundColor: r.id == currentId ? theme.chip : theme.card }" hover-class="ec-press" :hover-stay-time="100" @click="pickResult(r.id)">
          <image class="ec-result-img" :src="r.img" mode="aspectFit"></image>
          <view class="ec-result-info">
            <text class="ec-result-name" :style="{ color: theme.ink1 }">{{ r.name }}</text>
            <text class="ec-result-sub" :style="{ color: theme.ink3 }">{{ r.sub }}</text>
          </view>
          <text v-if="r.id == currentId" class="ec-result-check" :style="{ color: theme.accent }">✓</text>
          <text v-else class="ec-result-chev" :style="{ color: theme.ink3 }">›</text>
        </view>
        <text v-if="query.length > 0 && results.length == 0" class="ec-empty" :style="{ color: theme.ink3 }">{{ t('ec.empty') }}</text>

        <view class="ec-hot">
          <text class="ec-hot-title" :style="{ color: theme.ink1 }">🔥 {{ t('ec.hot') }}</text>
          <view class="ec-hot-chips">
            <view class="ec-hot-chip" v-for="(h, hIdx) in hotNames" :key="hIdx" :style="{ backgroundColor: theme.card }" hover-class="ec-press" :hover-stay-time="100" @click="searchHot(h)">
              <text class="ec-hot-chip-text" :style="{ color: theme.ink2 }">{{ h }}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="uts">
// [变更日志] 页首摘要：百科详情页＋全屏搜索态单文件双态（viewMode），全 token 驱动三主题/暗色/双语。
// [变更日志] 食物百科详情页：hero/营养四列/点评+三列指引/相关食物/添加到餐次 CTA + 全屏搜索态；
//       数据 = food_library（营养与图）⊕ food_encyclopedia 伴生表（英文名/档位/模板），颜色全走 useTheme token。
import { ref, computed } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { useTheme, FIXED_COLORS } from '../../composables/useTheme'
import { resolveLang } from '../../composables/useLocale'
import { t, tf } from '../../composables/i18n'
import { currentMealKey } from '../../composables/mealWindow'
import { ALL_FOODS, getFoodById, searchFoods } from '../../stores/food'
import type { FoodBase } from '../../stores/food'
import { triggerHaptic, playSound } from '../../stores/settings'
import {
  getEncEntry, enNameOf, badgeOf, guidanceOf, reviewText, hotFoodIds,
} from '../../stores/encyclopedia'
import type { EncEntry } from '../../stores/encyclopedia'

const { theme, isDark } = useTheme()

const sbH = ref<number>(uni.getSystemInfoSync().statusBarHeight ?? 0)
const insets = uni.getSystemInfoSync().safeAreaInsets
const safeBottom = insets != null ? insets.bottom : 0
// 滚动区高度 = 视口 − 顶栏 − CTA（rpx 按 750 稿宽折算 px，原生端 :style 禁跨单位 calc）
const winH = uni.getSystemInfoSync().windowHeight
const winW = uni.getSystemInfoSync().windowWidth
const rpx = (v: number): number => v / 750 * winW
const bodyH = ref<number>(winH - (sbH.value + rpx(280) + safeBottom))

// 空串起步：库内首条兜底会让「参数没接上」伪装成「显示了米饭」，零报错难查
const currentId = ref('')
const searchOpen = ref(false)
const searchFocus = ref(false)
const query = ref('')

const lang = computed((): string => resolveLang())

// ===== 当前条目 =====
const food = computed((): FoodBase | null => {
  const f = getFoodById(currentId.value)
  return f != null ? f : null
})

const CAT_DIR: Record<string, string> = {
  '主食': 'staple', '菜品': 'dish', '肉类蛋类': 'protein', '蔬菜': 'vegetable',
  '水果': 'fruit', '饮品': 'drink', '零食': 'snack',
}

const heroImg = computed((): string => {
  const f = food.value
  if (f == null) return ''
  return '/static/icons/' + (CAT_DIR[f.cat] ?? 'dish') + '/' + f.id + '.webp'
})

const zhName = computed((): string => {
  const f = food.value
  if (f == null) return ''
  if (lang.value == 'en') {
    const e = getEncEntry(f.id)
    if (e != null) return e.en
  }
  return f.name
})

const entry = computed((): EncEntry | null => getEncEntry(currentId.value))

const badgeText = computed((): string => {
  const e = entry.value
  if (e == null) return ''
  const b = badgeOf(e.cls)
  return lang.value == 'en' ? b.en : b.zh
})

/** 展示口径：有单块重则折算 1 个，否则按每 100g/ml */
const heroCalText = computed((): string => {
  const f = food.value
  if (f == null) return '0'
  if (f.unit == 'g' && f.pieceWeight != null && f.pieceWeight > 0) {
    return Math.round(f.kcal * f.pieceWeight / 100).toString()
  }
  return Math.round(f.kcal).toString()
})

const pieceText = computed((): string => {
  const f = food.value
  if (f == null) return ''
  if (f.unit == 'g' && f.pieceWeight != null && f.pieceWeight > 0) {
    return '/ ' + tf('ec.piece', [f.pieceWeight.toString()])
  }
  return '/ ' + tf('ec.per100u', [f.unit])
})

/** 宏量标签：按供能比给 2-3 个短标签 */
const chipList = computed((): string[] => {
  const out: string[] = []
  const f = food.value
  if (f == null) return out
  const pE = (f.protein ?? 0) * 4
  const cE = (f.carb ?? 0) * 4
  const fE = (f.fat ?? 0) * 9
  const tot = pE + cE + fE
  if (tot <= 0) {
    out.push(t('ec.loC'))
    out.push(t('ec.loF'))
    return out
  }
  if (pE / tot >= 0.30) out.push(t('ec.hiP'))
  out.push(fE / tot <= 0.35 ? t('ec.loF') : t('ec.hiF'))
  if (cE / tot <= 0.40) out.push(t('ec.loC'))
  else if (cE / tot >= 0.60) out.push(t('ec.hiC'))
  return out
})

// ===== 营养四列 =====
type NutCol = { emoji: string; label: string; value: string; pctWidth: string; pctText: string; tint: string }

const nutCols = computed((): NutCol[] => {
  const out: NutCol[] = []
  const f = food.value
  if (f == null) return out
  const p = f.protein ?? 0
  const c = f.carb ?? 0
  const fat = f.fat ?? 0
  const pE = p * 4
  const cE = c * 4
  const fE = fat * 9
  const tot = pE + cE + fE
  const pct = (e: number): number => tot > 0 ? Math.round(e * 100 / tot) : 0
  const mk = (emoji: string, labelKey: string, value: string, share: number, tint: string): NutCol => ({
    emoji: emoji, label: t(labelKey), value: value,
    pctWidth: (share < 3 ? 3 : share) + '%',
    pctText: tot > 0 ? '(' + share + '%)' : '—',
    tint: tint,
  })
  out.push(mk('💪', 'dd.protein', p + 'g', pct(pE), theme.value.accent))
  out.push(mk('💧', 'dd.fat', fat + 'g', pct(fE), FIXED_COLORS.infoCarb))
  out.push(mk('🌾', 'dd.carb', c + 'g', pct(cE), theme.value.accentDeep))
  out.push(mk('🔥', 'ec.calorie', Math.round(f.kcal) + ' kcal', 100, FIXED_COLORS.infoCalorie))
  return out
})

// ===== 点评 + 三列指引 =====
const reviewBody = computed((): string => {
  const f = food.value
  const e = entry.value
  if (f == null || e == null) return ''
  return reviewText(e.cls, lang.value, Math.round(f.kcal), f.protein ?? 0, f.carb ?? 0, f.fat ?? 0)
})

type GuideRow = { emoji: string; title: string; text: string }

const guideRows = computed((): GuideRow[] => {
  const out: GuideRow[] = []
  const e = entry.value
  if (e == null) return out
  const g = guidanceOf(e.cls)
  const en = lang.value == 'en'
  out.push({ emoji: '👥', title: t('ec.audience'), text: en ? g.audience.en : g.audience.zh })
  out.push({ emoji: '⚠️', title: t('ec.cautions'), text: en ? g.cautions.en : g.cautions.zh })
  out.push({ emoji: '🍳', title: t('ec.serving'), text: en ? g.serving.en : g.serving.zh })
  return out
})

// ===== 相关食物（当前项 + 同档近似 3 条） =====
type RelItem = { id: string; name: string; img: string; calText: string }

const relatedList = computed((): RelItem[] => {
  const out: RelItem[] = []
  const e = entry.value
  if (e == null) return out
  const ids: string[] = [currentId.value]
  for (const rid of e.related) ids.push(rid)
  for (const id of ids) {
    const f = getFoodById(id)
    if (f == null) continue
    const en = lang.value == 'en'
    const name = en ? (enNameOf(id).length > 0 ? enNameOf(id) : f.name) : f.name
    let calText = Math.round(f.kcal) + ' kcal/100' + f.unit
    if (f.unit == 'g' && f.pieceWeight != null && f.pieceWeight > 0) {
      calText = Math.round(f.kcal * f.pieceWeight / 100) + ' kcal/' + t('ec.pcUnit')
    }
    out.push({ id: id, name: name, img: '/static/icons/' + (CAT_DIR[f.cat] ?? 'dish') + '/' + id + '.webp', calText: calText })
  }
  return out
})

// ===== CTA =====
const mealKey = computed((): string => currentMealKey())

const mealName = computed((): string => {
  const k = mealKey.value
  if (k == 'breakfast') return t('meal.breakfast')
  if (k == 'lunch') return t('meal.lunch')
  if (k == 'dinner') return t('meal.dinner')
  return t('meal.snack')
})

const ctaText = computed((): string => {
  return tf('af.confirm', [mealName.value, heroCalText.value])
})

const ctaGradient = computed((): string => 'linear-gradient(' + theme.value.accent2 + ', ' + theme.value.accent + ')')

function addToMeal(): void {
  triggerHaptic('medium')
  playSound('confirm')
  // 一次性交接：回首页由 Home 消费 ct_pending_add，打开 FoodPicker 详情步预填该食物
  uni.setStorageSync('ct_pending_add', JSON.parse(JSON.stringify({ id: currentId.value, meal: mealKey.value })))
  uni.navigateBack({
    fail: () => { uni.reLaunch({ url: '/pages/home/Home' }) },
  })
}

// ===== 搜索态 =====
function openSearch(): void {
  triggerHaptic('light')
  searchOpen.value = true
  setTimeout(() => { searchFocus.value = true }, 300)
}

function closeSearch(): void {
  searchFocus.value = false
  searchOpen.value = false
}

function clearQuery(): void {
  query.value = ''
}

type SearchResult = { id: string; name: string; img: string; sub: string }

const enMap = computed((): Map<string, string> => {
  const m = new Map<string, string>()
  for (const f of ALL_FOODS) {
    const en = enNameOf(f.id)
    if (en.length > 0) m.set(f.id, en)
  }
  return m
})

const results = computed((): SearchResult[] => {
  const q = query.value.trim()
  if (q.length == 0) return []
  const list = searchFoods(q, enMap.value)
  const out: SearchResult[] = []
  for (const f of list) {
    if (out.length >= 40) break
    const en = lang.value == 'en'
    const name = en ? (enNameOf(f.id).length > 0 ? enNameOf(f.id) : f.name) : f.name
    let sub = Math.round(f.kcal) + ' kcal / 100' + f.unit
    if (f.unit == 'g' && f.pieceWeight != null && f.pieceWeight > 0) {
      sub = Math.round(f.kcal * f.pieceWeight / 100) + ' kcal / ' + tf('ec.piece', [f.pieceWeight.toString()])
    }
    out.push({ id: f.id, name: name, img: '/static/icons/' + (CAT_DIR[f.cat] ?? 'dish') + '/' + f.id + '.webp', sub: sub })
  }
  return out
})

const HOT_IDS = hotFoodIds()

const hotNames = computed((): string[] => {
  const out: string[] = []
  for (const id of HOT_IDS) {
    const f = getFoodById(id)
    if (f == null) continue
    out.push(lang.value == 'en' && enNameOf(id).length > 0 ? enNameOf(id) : f.name)
  }
  return out
})

function findIdByName(name: string): string {
  for (const id of HOT_IDS) {
    const f = getFoodById(id)
    if (f != null && (f.name == name || enNameOf(id) == name)) return id
  }
  return ''
}

function searchHot(name: string): void {
  triggerHaptic('light')
  const id = findIdByName(name)
  if (id.length > 0) {
    pickResult(id)
    return
  }
  query.value = name
}

function pickResult(id: string): void {
  triggerHaptic('light')
  currentId.value = id
  closeSearch()
}

function goFood(id: string): void {
  triggerHaptic('light')
  currentId.value = id
}

function goBack(): void {
  triggerHaptic('light')
  uni.navigateBack({
    fail: () => { uni.reLaunch({ url: '/pages/home/Home' }) },
  })
}

onLoad((options: OnLoadOptions) => {
  // 深链 id 形如 pNNN（4 位），只按「能否查到条目」判定；长度校验会把有效 id 全判死
  const id = options['id'] ?? ''
  if (id.length > 0) {
    const f = getFoodById(id)
    if (f != null) currentId.value = id
  }
})
</script>

<style>
.ec-page {
  flex-direction: column;
}
.ec-header {
  flex-shrink: 0;
}
.ec-nav {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
}
.ec-nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  align-items: center;
  justify-content: center;
}
.ec-nav-icon {
  width: 44rpx;
  height: 44rpx;
}
.ec-nav-title {
  font-size: 34rpx;
  font-weight: bold;
}
.ec-press {
  opacity: 0.7;
  transform: scale(0.97);
}
.ec-body {
  flex-shrink: 0;
}
.ec-hero {
  flex-direction: row;
  margin: 16rpx 32rpx 0 32rpx;
  padding: 32rpx;
  border-radius: 40rpx;
  align-items: center;
}
.ec-hero-art {
  width: 200rpx;
  height: 200rpx;
  border-radius: 32rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ec-hero-img {
  width: 176rpx;
  height: 176rpx;
}
.ec-hero-info {
  flex: 1;
  margin-left: 28rpx;
}
.ec-name-row {
  flex-direction: row;
  align-items: center;
}
.ec-name {
  font-size: 40rpx;
  font-weight: bold;
  margin-right: 16rpx;
}
.ec-badge {
  padding-left: 16rpx;
  padding-right: 16rpx;
  padding-top: 6rpx;
  padding-bottom: 6rpx;
  border-radius: 999rpx;
}
.ec-badge-text {
  font-size: 22rpx;
}
