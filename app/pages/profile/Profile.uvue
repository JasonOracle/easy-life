<template>
  <view class="page" :class="{ 'page-dark': dk }">
    <!-- 头图 -->
    <view class="header" :style="{ paddingTop: sbH + 'px' }">
      <view class="header-row">
        <view class="avatar-ring">
          <image class="avatar" :src="'/static/profile/avatar.png'" mode="aspectFill"></image>
        </view>
        <view class="header-text">
          <text class="name">{{ user.name }}</text>
          <text class="sub">已连续记录  {{ user.streakDays }} 天  ·  每日目标  {{ goal.calorieGoal }} kcal</text>
        </view>
      </view>
      <image class="header-wave" :src="'/static/profile/header_wave.png'" mode="widthFix"></image>
    </view>
    <!-- 设置齿轮：挂在页面根上相对 .page 定位（小程序端 .header 内的 absolute 基准实测会偏移一个状态栏高度） -->
    <view class="gear-circle" :style="{ right: gearRight, top: gearTop }" @click="goSettings">
      <image class="gear" :src="'/static/profile/gear.png'" mode="aspectFit"></image>
    </view>

    <!-- 今日热量卡 -->
    <view class="cal-card">
      <view class="cal-head">
        <image class="cal-flame" :src="'/static/profile/flame.png'" mode="aspectFit"></image>
        <text class="cal-title">今日热量</text>
        <view class="pill">
          <text class="pill-text">{{ remainCal > 0 ? '还可以吃' : '已超标' }}</text>
        </view>
      </view>
      <view class="ring" :style="ringStyleText">
        <view class="ring-inner">
          <text class="ring-pct">{{ progPct }}%</text>
          <text class="ring-lbl">已摄入</text>
        </view>
      </view>
      <view class="bignum-row">
        <text class="bignum">{{ Math.abs(remainCal) }}</text>
        <text class="bignum-unit">kcal</text>
      </view>
      <view class="prog-track">
        <view class="prog-fill" :style="'width: ' + progPct + '%; background-color: ' + calStatus.color + ';'"></view>
      </view>
      <view class="prog-row">
        <view class="pl-side">
          <text class="pl-txt">已摄入</text>
          <text class="pl-num">{{ food.totalCal }}</text>
          <text class="pl-txt pl-txt2">kcal</text>
        </view>
        <view class="pl-side pl-right">
          <text class="pl-txt">目标</text>
          <text class="pl-num">{{ goal.calorieGoal }}</text>
          <text class="pl-txt pl-txt2">kcal</text>
        </view>
      </view>
      <view class="stat-panel">
        <view class="stat-col">
          <view class="stat-top">
            <view class="stat-chip">
              <image class="stat-ico" :src="'/static/profile/stat_target.svg'" mode="aspectFit"></image>
            </view>
            <text class="stat-num">{{ goal.calorieGoal }}</text>
          </view>
          <text class="stat-lbl">目标热量 / kcal</text>
        </view>
        <view class="stat-div"></view>
        <view class="stat-col">
          <view class="stat-top">
            <view class="stat-chip">
              <image class="stat-ico" :src="'/static/profile/stat_consumed.svg'" mode="aspectFit"></image>
            </view>
            <text class="stat-num">{{ food.totalCal }}</text>
          </view>
          <text class="stat-lbl">已摄入 / kcal</text>
        </view>
        <view class="stat-div"></view>
        <view class="stat-col">
          <view class="stat-top">
            <view class="stat-chip">
              <image class="stat-ico" :src="'/static/profile/stat_remain.svg'" mode="aspectFit"></image>
            </view>
            <text :class="remainCal > 0 ? 'stat-num-green' : 'stat-num-coral'">{{ displayRemainCal }}</text>
          </view>
          <text class="stat-lbl">还能吃 / kcal</text>
        </view>
      </view>
      <!-- 达标 Banner：支持达标绿态与超额橙态状态机自适应 -->
      <view class="banner" :class="bannerState.cardClass">
        <view class="check-circle" :class="bannerState.circleClass">
          <image v-if="bannerState.isOk" class="check" :src="'/static/profile/check.png'" mode="aspectFit"></image>
          <text v-else class="banner-excl">!</text>
        </view>
        <view class="banner-text">
          <text class="banner-title" :class="{ 'banner-title-over': !bannerState.isOk }">{{ bannerState.title }}</text>
          <text class="banner-sub">{{ bannerState.sub }}</text>
        </view>
        <image class="banner-chev" :src="'/static/profile/chev_banner.png'" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 本周概览 -->
    <view class="card week-card">
      <view class="card-head">
        <text class="card-title">本周概览</text>
        <view class="head-right">
          <text class="week-num">{{ weekOkCount }}/7</text>
          <text class="week-lbl">天达标</text>
          <image class="chev-mini" :src="'/static/profile/chev_week.png'" mode="aspectFit"></image>
        </view>
      </view>
      <view class="dots-row">
        <view class="dot-col" v-for="(dayItem, dayIdx) in weekDots" :key="dayIdx">
          <view class="dot" :class="{ 'dot-empty': dayItem.state === 'none' }" :style="{ backgroundColor: dayItem.bg }">
            <image v-if="dayItem.state === 'ok'" class="dot-check" :src="'/static/profile/check.png'" mode="aspectFit"></image>
            <text v-else-if="dayItem.state === 'over'" class="dot-excl">!</text>
          </view>
          <text class="dot-lbl">{{ dayItem.lbl }}</text>
        </view>
      </view>
    </view>

    <!-- 热量趋势 -->
    <view class="card trend-card">
      <view class="card-head">
        <image class="trend-icon" :src="'/static/profile/trend_icon.png'" mode="aspectFit"></image>
        <text class="card-title">热量趋势</text>
        <view class="head-right">
          <text class="view-all">查看全部</text>
          <image class="chev-mini" :src="'/static/profile/chev_trend.png'" mode="aspectFit"></image>
        </view>
      </view>
      <view class="chart">
        <view class="yaxis">
          <text class="ax">2400</text>
          <text class="ax-green">1800</text>
          <text class="ax">1200</text>
          <text class="ax">600</text>
          <text class="ax">0</text>
        </view>
        <view class="bars-area">
          <view class="target-line"></view>
          <view class="bars-row">
            <view class="bar-col" v-for="(barItem, barIdx) in bars" :key="barIdx">
              <text class="bar-val" :class="{ 'bar-val-over': barItem.over }">{{ barItem.val }}</text>
              <view class="bar" :class="{ 'bar-over': barItem.over }" :style="{ height: barItem.h + 'px' }"></view>
              <text class="bar-date">{{ barItem.date }}</text>
            </view>
          </view>
          <view class="target-tag">
            <text class="target-tag-text">目标</text>
            <text class="target-tag-text">{{ goal.calorieGoal }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 最近记录 -->
    <view class="card rec-card">
      <view class="card-head">
        <text class="card-title">最近记录</text>
        <view class="head-right" @click="goRecords">
          <text class="view-all">查看全部</text>
          <image class="chev-mini" :src="'/static/profile/chev_rec.png'" mode="aspectFit"></image>
        </view>
      </view>
      <view v-for="(recItem, recIdx) in records" :key="recIdx">
        <view class="rec-row">
          <view class="rec-left">
            <text class="rec-date">{{ recItem.date }}</text>
            <text class="rec-wday">{{ recItem.wday }}</text>
          </view>
          <view class="rec-right">
            <text class="rec-num">{{ recItem.num }}</text>
            <text class="rec-unit">kcal</text>
            <view class="rec-badge" :class="{ 'rec-badge-over': recItem.over }">
              <text class="rec-badge-text" :class="{ 'rec-badge-text-over': recItem.over }">{{ recItem.badge }}</text>
            </view>
          </view>
          <image class="chev-row" :src="recItem.chev" mode="aspectFit"></image>
        </view>
        <view class="rec-div" v-if="recIdx < records.length - 1"></view>
      </view>
    </view>

    <!-- 底部 Tab（共享组件，我的激活） -->
    <Tabbar active="profile" :dark="dk" ></Tabbar>

    <!-- 滚动防穿透遮罩：页内内联 fixed 视图（StickyTop 组件实测双故障：遮罩不渲染＋宿主内渲染整页幻影副本） -->
    <view v-if="scrolled" class="pf-st-mask" :style="{ height: sbH + 'px', backgroundColor: dk ? '#162924' : '#EEF7F4' }"></view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onPageScroll } from '@dcloudio/uni-app'
// #ifdef MP-WEIXIN
import { onShow } from '@dcloudio/uni-app'
// #endif
import Tabbar from '../../components/Tabbar.uvue'
import { useFoodStore } from '../../stores/food'
import { useGoalStore, getCalorieStatus } from '../../stores/goal'
import { useUserStore } from '../../stores/user'
import { useSettingsStore } from '../../stores/settings'

/**
 * 接 store 读数（种子精确还原：历史 1950超+150/1720达/1580达；趋势 1580…1950/1368；
 * 周 dots 按 1800 判定，6/7 达标——稿面 4/7 与自家数据矛盾，以真值为准）。
 */

let sbH = 0
try {
  sbH = uni.getSystemInfoSync().statusBarHeight ?? 0
} catch (e) {
  sbH = 0
}

const settings = useSettingsStore()
const dk = computed((): boolean => settings.darkMode)

// 滚动防穿透两态：跨阈值才翻一次，避免逐帧 setData
const scrolled = ref<boolean>(false)
// 三端生效（原包在 MP-WEIXIN 内，App／Web 端滚动时状态栏遮罩无响应是既有缺口）
// #29 的 tabFade 渐显已随 2026-09-22 液态玻璃胶囊重构废弃（新胶囊恒常可见）
onPageScroll((e) => {
  // 遮罩阈值＝头图高 sbH+89 − sbH：内容将穿透状态栏带才盖
  const v = e.scrollTop > 89
  if (v !== scrolled.value) scrolled.value = v
})

// 设置齿轮位置：默认稿面（右 25、状态栏下 13）；小程序端移到胶囊左侧、与胶囊垂直居中对齐
const gearRight = ref('25px')
const gearTop = ref((sbH + 13) + 'px')
// #ifdef MP-WEIXIN
const placeGear = () => {
  try {
    const sys = uni.getSystemInfoSync()
    const capsule = uni.getMenuButtonBoundingClientRect()
    // 窗口尺寸切换瞬间胶囊 rect 可能越界（left≥窗宽），校验后再用；onShow 重算兜底
    if (capsule != null && capsule.left > 0 && capsule.left < sys.windowWidth - 40) {
      gearRight.value = (sys.windowWidth - capsule.left + 10) + 'px'
      // 齿轮挂在页面根上，页面坐标系即屏幕坐标；模拟器/真机对胶囊 top 的基准不一致，
      // 小于半个状态栏高度视为「状态栏下相对值」，补回 sbH 再定位
      let capTop = capsule.top
      if (capTop < sbH / 2) {
        capTop = capTop + sbH
      }
      gearTop.value = (capTop + (capsule.height - 24) / 2) + 'px'
    }
  } catch (e) {
    // 取不到胶囊信息时保持默认位置
  }
}
placeGear()
// 状态栏字色随暗黑反转（Boss P2 指令）：小程序走 setNavigationBarColor；
// TODO App 原生端改 plus.navigator.setStatusBarStyle 实测后补
function syncBar(): void {
  uni.setNavigationBarColor({ frontColor: dk.value ? '#ffffff' : '#000000', backgroundColor: '#000000' })
}
onShow(() => {
  placeGear()
  syncBar()
})
// #endif

const food = useFoodStore()
const goal = useGoalStore()
const user = useUserStore()

const goSettings = () => {
  uni.navigateTo({ url: '/pages/settings/Settings' })
}

const goRecords = () => {
  // Records 已升级为一级 Tab 页（无返回钮）→ 用 redirectTo 换页，不压栈
  uni.redirectTo({ url: '/pages/records/Records' })
}

const remainCal = computed(() => goal.calorieGoal - food.totalCal)
const calStatus = computed(() => getCalorieStatus(food.totalCal, goal.calorieGoal))
const displayRemainCal = computed<number>(() => (remainCal.value > 0 ? remainCal.value : 0))

const progPct = computed<number>(() => {
  if (goal.calorieGoal <= 0) return 0
  const p = Math.round((food.totalCal / goal.calorieGoal) * 100)
  return p > 100 ? 100 : p
})

/** 圆环样式字符串：100% 满额时直接使用实色 color，低于 100% 时使用 conic-gradient，彻底解决全满时圆环消失问题 */
const ringStyleText = computed<string>(() => {
  const c = calStatus.value.color
  if (progPct.value >= 100) {
    return 'background-color: ' + c + ';'
  }
  return 'background-image: conic-gradient(' + c + ' 0% ' + progPct.value + '%, #E5F0EC ' + progPct.value + '% 100%);'
})

/** 今日吃过的有效餐次数 */
const activeMealCount = computed<number>(() => {
  return food.mealRows.filter((m) => (typeof m.cal === 'number' ? m.cal : 0) > 0).length
})

/**
 * 达标 Banner 状态机：
 * 1. 达标：至少记录 2 个餐次且未超额（food.totalCal <= goal.calorieGoal && activeMealCount >= 2 && food.totalCal > 0）
 * 2. 不达标：超额（food.totalCal > goal.calorieGoal）-> 橙色图标，请减少进食，加油啊
 * 3. 记录中：未超额但不足 2 餐
 */
const bannerState = computed(() => {
  const isOver = food.totalCal > goal.calorieGoal
  if (isOver) {
    return {
      type: 'over',
      title: '今日不达标',
      sub: '请减少进食，加油啊',
      cardClass: 'banner-over',
      circleClass: 'circle-orange',
      isOk: false,
    }
  }
  if (activeMealCount.value >= 2 && food.totalCal > 0) {
    return {
      type: 'ok',
      title: '今日已达标',
      sub: '继续保持，做得很好！',
      cardClass: 'banner-ok',
      circleClass: 'circle-green',
      isOk: true,
    }
  }
  return {
    type: 'pending',
    title: '今日记录中',
    sub: '记录 2 餐及以上且未超标即算达标',
    cardClass: 'banner-pending',
    circleClass: 'circle-green',
    isOk: true,
  }
})

const WEEKDAY = ['日', '一', '二', '三', '四', '五', '六']

function fmtMD(ts: number): string {
  const d = new Date(ts)
  return (d.getMonth() + 1).toString() + '/' + d.getDate().toString()
}

function fmtMDLong(ts: number): string {
  const d = new Date(ts)
  return (d.getMonth() + 1).toString() + '月' + d.getDate().toString() + '日'
}

type WeekDot = { state: string; bg: string; lbl: string }
// 连续 7 天位置标签一..日；三态：绿底白勾达标 / 珊瑚底白「!」超标 / 灰圈空缺
const weekDots = computed<WeekDot[]>(() => {
  const labels = ['一', '二', '三', '四', '五', '六', '日']
  return food.weekTotals.map((d, i) => ({
    state: d.total === 0 ? 'none' : (d.total <= goal.calorieGoal ? 'ok' : 'over'),
    bg: d.total === 0 ? '#00000000' : (d.total <= goal.calorieGoal ? '#25AE8C' : '#FD6E4D'),
    lbl: labels[i] ?? '',
  }))
})

const weekOkCount = computed(() =>
  food.weekTotals.filter((d) => d.total <= goal.calorieGoal).length
)

type Bar = { val: number; h: number; date: string; over: boolean }
// 柱高 = val / 2400 * 100（稿面纵轴）；日期取实际 M/D
const bars = computed<Bar[]>(() =>
  food.weekTotals.map((d, i) => ({
    val: d.total,
    h: Math.round(d.total / 2400 * 100),
    date: fmtMD(d.ts),
    over: d.total > goal.calorieGoal,
  }))
)

type Rec = {
  date: string
  wday: string
  num: number
  badge: string
  over: boolean
  chev: string
}
const REC_CHEVS = [
  '/static/profile/chev_r1.png',
  '/static/profile/chev_r2.png',
  '/static/profile/chev_r3.png',
]
// 最近 3 天（不含今天）：日期/周几/总量/达标态（超标态徽章内含超出值，按 Pencil 稿「超标 150 kcal」）
const records = computed<Rec[]>(() => {
  const days = food.weekTotals.slice(-4, -1)
  return days.map((d, i) => {
    const over = d.total > goal.calorieGoal
    const dt = new Date(d.ts)
    return {
      date: fmtMDLong(d.ts),
      wday: '周' + WEEKDAY[dt.getDay()],
      num: d.total,
      badge: over ? '超标 ' + (d.total - goal.calorieGoal) + ' kcal' : '达标',
      over,
      chev: REC_CHEVS[i] ?? REC_CHEVS[0],
    }
  }).reverse()
})
</script>

