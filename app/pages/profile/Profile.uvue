<template>
  <view class="page">
    <!-- 液体头图 -->
    <view class="hero">
      <view class="status-bar" />
      <view class="avatar-row">
        <view class="avatar" />
        <view class="name-col">
          <text class="name">老刘</text>
          <text class="name-sub">记录 128 天 · 目标 1800 kcal</text>
        </view>
      </view>
      <view class="stat-bar">
        <view class="stat">
          <text class="stat-val">126</text>
          <text class="stat-label">累计记录</text>
        </view>
        <view class="stat-divider" />
        <view class="stat">
          <text class="stat-val">1350</text>
          <text class="stat-label">日均摄入 kcal</text>
        </view>
      </view>
      <!-- 波浪收边：CSS 椭圆近似设计稿 SVG path（形差已标注） -->
      <view class="wave w1" />
      <view class="wave w2" />
      <view class="bubble b1" />
      <view class="bubble b2" />
      <view class="bubble b3" />
    </view>

    <view class="content">
      <!-- 本周概览玻璃卡 -->
      <view class="week-card">
        <view class="week-head">
          <text class="week-title">本周概览</text>
          <view class="week-badge"><text class="week-badge-text">{{ weekBadgeText }}</text></view>
        </view>
        <view class="week-drops">
          <view v-for="d in drops" :key="d.day" class="drop">
            <view class="drop-shape" :class="d.state" />
            <text class="drop-day" :class="{ today: d.state === 'today' }">{{ d.day }}</text>
          </view>
        </view>
      </view>

      <!-- 历史趋势 -->
      <view class="trend">
        <text class="trend-title">历史趋势 · 本周</text>
        <view class="chart">
          <view v-for="(b, i) in bars" :key="i" class="bar" :class="b.type" :style="barStyle(b.h)" />
          <view class="goal-line" />
          <view class="goal-tag"><text class="goal-tag-text">目标 1800</text></view>
        </view>
        <view class="history">
          <view v-for="h in history" :key="h.date" class="h-row">
            <text class="h-date">{{ h.date }}</text>
            <view class="h-cal">
              <text class="h-val">{{ h.cal }}</text>
              <text class="h-unit">kcal</text>
            </view>
            <view class="h-status">
              <view class="h-dot" :class="h.over ? 'dot-over' : 'dot-ok'" />
              <text class="h-status-text" :class="h.over ? 't-over' : 't-ok'">{{ h.over ? '超标' : '达标内' }}</text>
            </view>
          </view>
        </view>
        <text class="view-all">查看全部 30 天记录 ›</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { useFoodStore } from '../../stores/food_store.ts'
import { useGoalStore } from '../../stores/goal.uts'

const foodStore = useFoodStore()
const goalStore = useGoalStore()

// ── 七天数据全部由 foodStore.weekTotals 派生（seed 演示数据，热量为库值计算）──

type Drop = { day: string, state: string }
const WEEK_LABELS = ['日', '一', '二', '三', '四', '五', '六']

function isSameDay(a: number, b: number): boolean {
  const da = new Date(a)
  const db = new Date(b)
  return da.getFullYear() === db.getFullYear() && da.getMonth() === db.getMonth() && da.getDate() === db.getDate()
}

function dayState(total: number, ts: number, goal: number): string {
  if (total <= 0) return 'empty'
  if (isSameDay(ts, Date.now())) return 'today'
  return total > goal ? 'over' : 'ok'
}

const drops = computed((): Drop[] => {
  return foodStore.weekTotals.map((w): Drop => {
    const d = new Date(w.ts)
    return { day: WEEK_LABELS[d.getDay()], state: dayState(w.total, w.ts, goalStore.calorieGoal) }
  })
})

/** 徽章「达标 X 天」：过去 6 天（不含今日）中 0 < 总量 ≤ 目标 的天数 */
const weekBadgeText = computed((): string => {
  const now = Date.now()
  const okDays = foodStore.weekTotals.filter((w) => {
    return !isSameDay(w.ts, now) && w.total > 0 && w.total <= goalStore.calorieGoal
  }).length
  return `达标 ${okDays} 天`
})

type Bar = { h: number, type: string }
const bars = computed((): Bar[] => {
  return foodStore.weekTotals.map((w): Bar => {
    // 高度：目标=68px 基准，钳位 8~92px
    const h = w.total <= 0 ? 8 : Math.min(92, Math.max(8, Math.round(w.total / goalStore.calorieGoal * 68)))
    return { h, type: dayState(w.total, w.ts, goalStore.calorieGoal) }
  })
})

type His = { date: string, cal: string, over: boolean }
const history = computed((): His[] => {
  // 最近 3 个完整日（不含今天）：weekTotals 倒数第 2~4 位
  const arr = foodStore.weekTotals
  const rows: His[] = []
  for (let i = arr.length - 2; i >= arr.length - 4 && i >= 0; i--) {
    const w = arr[i]
    const d = new Date(w.ts)
    const label = `${d.getMonth() + 1}月${d.getDate()}日 · 周${WEEK_LABELS[d.getDay()]}`
    rows.push({ date: label, cal: Math.round(w.total).toString(), over: w.total > goalStore.calorieGoal })
  }
  return rows
})

function barStyle(h: number): string {
  return 'height: ' + h.toString() + 'px;'
}
</script>

<style>
