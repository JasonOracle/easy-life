
<template>
  <view class="page" :style="{ backgroundColor: theme.bg }">
    <!-- [变更日志] 2026-09-27: 品牌渐变头第三档 accentDeep→accentMid（消除底部发黑） -->
    <!-- [变更日志] 2026-09-24: 头图简化为与日历页顶栏同源的纯净绿色渐变，移除 liquid_wave 矢量水波层 -->
    <!-- 头图（与日历页顶栏同源的纯净绿色渐变） -->
    <view class="header" :style="headerStyle">
      <view class="header-row">
        <view class="avatar-ring">
          <image class="avatar" :src="asset('profile/avatar.png')" mode="aspectFill"></image>
        </view>
        <view class="header-text">
          <text class="name" :style="{ color: headerTitleColor }">{{ user.name }}</text>
          <text class="sub" :style="{ color: headerSubColor }">{{ streakText }}</text>
        </view>
      </view>
    </view>
    <!-- 设置齿轮：挂在页面根上相对 .page 定位（小程序端 .header 内的 absolute 基准实测会偏移一个状态栏高度） -->
    <view class="gear-circle" :style="{ right: gearRight, top: gearTop }" @click="goSettings">
      <image class="gear" :src="asset('profile/gear.svg')" mode="aspectFit"></image>
    </view>

    <!-- 今日热量卡 -->
    <view class="cal-card" :style="{ backgroundColor: theme.card }">
      <view class="cal-head">
        <image class="cal-flame" :src="asset('profile/flame.svg')" mode="aspectFit"></image>
        <text class="cal-title" :style="{ color: theme.ink1 }">{{ t('pf.todayCal') }}</text>
        <view class="pill" :style="{ backgroundColor: theme.chip }">
          <text class="pill-text" :style="{ color: theme.accentDeep }">{{ remainCal > 0 ? t('pf.remain') : t('pf.over') }}</text>
        </view>
      </view>
      <view class="ring" :style="ringStyleText">
        <view class="ring-inner" :style="{ backgroundColor: theme.card }">
          <text class="ring-pct" :style="{ color: theme.ink1 }">{{ progPct }}%</text>
          <text class="ring-lbl" :style="{ color: theme.ink3 }">{{ t('pf.consumed') }}</text>
        </view>
      </view>
      <view class="bignum-row">
        <text class="bignum" :style="{ color: theme.ink1 }">{{ Math.abs(remainCal) }}</text>
        <text class="bignum-unit" :style="{ color: theme.ink1 }">kcal</text>
      </view>
      <view class="prog-track" :style="{ backgroundColor: theme.line }">
        <view class="prog-fill" :style="progFillStyle"></view>
      </view>
      <view class="prog-row">
        <view class="pl-side">
          <text class="pl-txt" :style="{ color: theme.ink3 }">{{ t('pf.consumed') }}</text>
          <text class="pl-num" :style="{ color: theme.ink1 }">{{ food.totalCal }}</text>
          <text class="pl-txt pl-txt2" :style="{ color: theme.ink3 }">kcal</text>
        </view>
        <view class="pl-side pl-right">
          <text class="pl-txt" :style="{ color: theme.ink3 }">{{ t('pf.goal') }}</text>
          <text class="pl-num" :style="{ color: theme.ink1 }">{{ goal.calorieGoal }}</text>
          <text class="pl-txt pl-txt2" :style="{ color: theme.ink3 }">kcal</text>
        </view>
      </view>
      <view class="stat-panel" :style="{ backgroundColor: theme.cardSoft }">
        <view class="stat-col">
          <view class="stat-top">
            <view class="stat-chip" :style="{ backgroundColor: theme.chip }">
              <image class="stat-ico" :src="asset('profile/stat_target.svg')" mode="aspectFit"></image>
            </view>
            <text class="stat-num" :style="{ color: theme.ink1 }">{{ goal.calorieGoal }}</text>
          </view>
          <text class="stat-lbl" :style="{ color: theme.ink3 }">{{ t('pf.statGoal') }}</text>
        </view>
        <view class="stat-div" :style="{ backgroundColor: theme.line }"></view>
        <view class="stat-col">
          <view class="stat-top">
            <view class="stat-chip" :style="{ backgroundColor: theme.chip }">
              <image class="stat-ico" :src="asset('profile/stat_consumed.svg')" mode="aspectFit"></image>
            </view>
            <text class="stat-num" :style="{ color: theme.ink1 }">{{ food.totalCal }}</text>
          </view>
          <text class="stat-lbl" :style="{ color: theme.ink3 }">{{ t('pf.statConsumed') }}</text>
        </view>
        <view class="stat-div" :style="{ backgroundColor: theme.line }"></view>
        <view class="stat-col">
          <view class="stat-top">
            <view class="stat-chip" :style="{ backgroundColor: theme.chip }">
              <image class="stat-ico" :src="asset('profile/stat_remain.svg')" mode="aspectFit"></image>
            </view>
            <text class="stat-num" :style="{ color: remainNumColor }">{{ displayRemainCal }}</text>
          </view>
          <text class="stat-lbl" :style="{ color: theme.ink3 }">{{ t('pf.statRemain') }}</text>
        </view>
      </view>
      <!-- 达标 Banner：支持达标绿态与超额橙态状态机自适应 -->
      <view class="banner" :style="{ backgroundColor: bannerFill }">
        <view class="check-circle" :style="{ backgroundColor: bannerCircleFill }">
          <image v-if="bannerState.isOk" class="check" :src="asset('profile/check_white.svg')" mode="aspectFit"></image>
          <text v-else class="banner-excl">!</text>
        </view>
        <view class="banner-text">
          <text class="banner-title" :style="{ color: bannerTitleColor }">{{ bannerState.title }}</text>
          <text class="banner-sub" :style="{ color: theme.ink3 }">{{ bannerState.sub }}</text>
        </view>
        <image class="banner-chev" :src="asset('profile/chev_right.svg')" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 本周概览 -->
    <view class="card week-card" :style="{ backgroundColor: theme.card }">
      <view class="card-head">
        <text class="card-title" :style="{ color: theme.ink1 }">{{ t('pf.weekTitle') }}</text>
        <view class="head-right">
          <text class="week-num" :style="{ color: theme.accentDeep }">{{ weekOkCount }}/7</text>
          <text class="week-lbl" :style="{ color: theme.accentDeep }">{{ t('pf.weekLbl') }}</text>
          <image class="chev-mini" :src="asset('profile/chev_right.svg')" mode="aspectFit"></image>
        </view>
      </view>
      <view class="dots-row">
        <view class="dot-col" v-for="(dayItem, dayIdx) in weekDots" :key="dayIdx">
          <view class="dot" :class="{ 'dot-empty': dayItem.state === 'none' }" :style="{ backgroundColor: dayItem.bg, borderColor: theme.line }">
            <image v-if="dayItem.state === 'ok'" class="dot-check" :src="asset('profile/check.svg')" mode="aspectFit"></image>
            <text v-else-if="dayItem.state === 'over'" class="dot-excl">!</text>
          </view>
          <text class="dot-lbl" :style="{ color: theme.ink3 }">{{ dayItem.lbl }}</text>
        </view>
      </view>
    </view>

    <!-- 热量趋势 -->
    <view class="card trend-card" :style="{ backgroundColor: theme.card }">
      <view class="card-head">
        <image class="trend-icon" :src="asset('profile/trend_icon.svg')" mode="aspectFit"></image>
        <text class="card-title" :style="{ color: theme.ink1 }">{{ t('pf.trend') }}</text>
        <view class="head-right">
          <text class="view-all" :style="{ color: theme.ink3 }">{{ t('pf.viewAll') }}</text>
          <image class="chev-mini" :src="asset('profile/chev_right.svg')" mode="aspectFit"></image>
        </view>
      </view>
      <view class="chart">
        <view class="yaxis">
          <text class="ax" :style="{ color: theme.ink3 }">2400</text>
          <text class="ax-green" :style="{ color: theme.accentDeep }">1800</text>
          <text class="ax" :style="{ color: theme.ink3 }">1200</text>
          <text class="ax" :style="{ color: theme.ink3 }">600</text>
          <text class="ax" :style="{ color: theme.ink3 }">0</text>
        </view>
        <view class="bars-area">
          <view class="target-line" :style="{ borderTopColor: theme.dashLine }"></view>
          <view class="bars-row">
            <view class="bar-col" v-for="(barItem, barIdx) in bars" :key="barIdx">
              <text class="bar-val" :style="{ color: barValColor(barItem.over) }">{{ barItem.val }}</text>
              <view class="bar" :style="{ height: barItem.h + 'rpx', backgroundColor: barFillColor(barItem.over) }"></view>
              <text class="bar-date" :style="{ color: theme.ink3 }">{{ barItem.date }}</text>
            </view>
          </view>
          <view class="target-tag">
            <text class="target-tag-text" :style="{ color: theme.ink3 }">{{ t('pf.goal') }}</text>
            <text class="target-tag-text" :style="{ color: theme.ink3 }">{{ goal.calorieGoal }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 最近记录 -->
    <view class="card rec-card" :style="{ backgroundColor: theme.card }">
      <view class="card-head">
        <text class="card-title" :style="{ color: theme.ink1 }">{{ t('pf.recent') }}</text>
        <view class="head-right view-all-hot" @click="goRecords">
          <text class="view-all" :style="{ color: theme.ink3 }">{{ t('pf.viewAll') }}</text>
          <image class="chev-mini" :src="asset('profile/chev_right.svg')" mode="aspectFit"></image>
        </view>
      </view>
      <view v-for="(recItem, recIdx) in records" :key="recIdx">
        <view class="rec-row">
          <view class="rec-left">
            <text class="rec-date" :style="{ color: theme.ink1 }">{{ recItem.date }}</text>
            <text class="rec-wday" :style="{ color: theme.ink3 }">{{ recItem.wday }}</text>
          </view>
          <view class="rec-right">
            <text class="rec-num" :style="{ color: theme.ink1 }">{{ recItem.num }}</text>
            <text class="rec-unit" :style="{ color: theme.ink3 }">kcal</text>
            <view class="rec-badge" :style="{ backgroundColor: recBadgeFill(recItem.over) }">
              <text class="rec-badge-text" :style="{ color: recBadgeTextColor(recItem.over) }">{{ recItem.badge }}</text>
            </view>
          </view>
          <image class="chev-row" :src="asset(recItem.chev)" mode="aspectFit"></image>
        </view>
        <view class="rec-div" :style="{ backgroundColor: theme.line }" v-if="recIdx < records.length - 1"></view>
      </view>
    </view>

    <!-- 底部 Tab（共享组件，我的激活） -->
    <Tabbar active="profile" ></Tabbar>

    <!-- 滚动防穿透遮罩：页内内联 fixed 视图（StickyTop 组件实测双故障：遮罩不渲染＋宿主内渲染整页幻影副本） -->
    <view v-if="scrolled" class="pf-st-mask" :style="{ height: sbH + 'px', backgroundColor: isDark ? theme.card : theme.bg }"></view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onPageScroll } from '@dcloudio/uni-app'
// #ifdef MP-WEIXIN
import { onShow } from '@dcloudio/uni-app'
// #endif
import Tabbar from '../../components/Tabbar.uvue'
import { useFoodStore } from '../../stores/food'
import { useGoalStore, getCalorieStatus } from '../../stores/goal'
import { useUserStore } from '../../stores/user'
import { useSettingsStore } from '../../stores/settings'
import { t, tf } from '../../composables/i18n'
import { useTheme, themeAsset, syncStatusBarStyle } from '../../composables/useTheme'

/**
 * 接 store 读数（种子精确还原：历史 1950超+150/1720达/1580达；趋势 1580…1950/1368；
 * 周 dots 按 1800 判定，6/7 达标——稿面 4/7 与自家数据矛盾，以真值为准）。
 */

let sbH = 0
try {
  sbH = uni.getSystemInfoSync().statusBarHeight ?? 0
} catch (e) {
  sbH = 0
}

// [变更日志] 2026-09-28: 设置齿轮「大一点 + 往下一点」（老板指截图）——
//   胶囊 48→56rpx、图标 26→32rpx、top 由 sbH+13 落到 sbH+21（+8px）；MP 端胶囊对齐常数同步 24→28。
// [变更日志] 2026-09-28: 头像换新（static/profile/avatar.png＝192² 薄荷瓶插画）、
//   昵称默认值「老刘」→「轻律生活」（见 stores/user.ts）。

const settings = useSettingsStore()
const dk = computed((): boolean => settings.darkMode)

const { theme, isDark, accentId } = useTheme()

// 状态栏字色按当前主题同步（下方 ifdef 内的 syncBar 只在小程序端注册）
onShow(() => {
  syncStatusBarStyle(isDark.value)
})

/** 资产按 (accent, mode) 取五档变体；未登记底稿（语义色／无彩稿／png）自动回落原路径 */
function asset(path: string): string {
  return themeAsset(accentId.value, isDark.value, '/static/' + path)
}

/** 品牌渐变头：浅态走 accent 三档渐变，暗态改该档 card 纯色（同首页／日历页既定处理） */
const headerStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['padding-top'] = sbH.toString() + 'px'
  if (isDark.value) {
    st['background-color'] = theme.value.card
  } else {
    st['background-color'] = theme.value.accent
    st['background-image'] = 'linear-gradient(' + theme.value.accent2 + ' 0%, ' + theme.value.accent + ' 60%, ' + theme.value.accentMid + ' 100%)'
  }
  return st
})
const headerTitleColor = computed((): string => isDark.value ? theme.value.ink1 : theme.value.onAccent)
const headerSubColor = computed((): string => isDark.value ? theme.value.ink2 : 'rgba(255, 255, 255, 0.85)')

// 滚动防穿透两态：跨阈值才翻一次，避免逐帧 setData
const scrolled = ref<boolean>(false)
// 三端生效（原包在 MP-WEIXIN 内，App／Web 端滚动时状态栏遮罩无响应是既有缺口）
// #29 的 tabFade 渐显已随 2026-09-22 液态玻璃胶囊重构废弃（新胶囊恒常可见）
onPageScroll((e) => {
  // 遮罩阈值＝头图高 sbH+89 − sbH：内容将穿透状态栏带才盖
  const v = e.scrollTop > 89
  if (v !== scrolled.value) scrolled.value = v
})

// 设置齿轮位置：默认稿面（右 25、状态栏下 21）；小程序端移到胶囊左侧、与胶囊垂直居中对齐
const gearRight = ref('25px')
const gearTop = ref((sbH + 21) + 'px')
// #ifdef MP-WEIXIN
const placeGear = () => {
  try {
    const sys = uni.getSystemInfoSync()
    const capsule = uni.getMenuButtonBoundingClientRect()
    // 窗口尺寸切换瞬间胶囊 rect 可能越界（left≥窗宽），校验后再用；onShow 重算兜底
    if (capsule != null && capsule.left > 0 && capsule.left < sys.windowWidth - 40) {
      gearRight.value = (sys.windowWidth - capsule.left + 10) + 'px'
      // 齿轮挂在页面根上，页面坐标系即屏幕坐标；模拟器/真机对胶囊 top 的基准不一致，
      // 小于半个状态栏高度视为「状态栏下相对值」，补回 sbH 再定位
      let capTop = capsule.top
      if (capTop < sbH / 2) {
        capTop = capTop + sbH
      }
      gearTop.value = (capTop + (capsule.height - 28) / 2) + 'px'
    }
  } catch (e) {
    // 取不到胶囊信息时保持默认位置
  }
}
placeGear()
// 状态栏字色随暗黑反转（Boss P2 指令）：小程序走 setNavigationBarColor；
// TODO App 原生端改 plus.navigator.setStatusBarStyle 实测后补
function syncBar(): void {
  uni.setNavigationBarColor({ frontColor: dk.value ? '#ffffff' : '#000000', backgroundColor: '#000000' })
}
onShow(() => {
  placeGear()
  syncBar()
})
// #endif

const food = useFoodStore()
const goal = useGoalStore()
const user = useUserStore()

const streakText = computed<string>(() => tf('pf.streak', [user.streakDays.toString(), goal.calorieGoal.toString()]))

const goSettings = () => {
  uni.navigateTo({ url: '/pages/settings/Settings' })
}

const goRecords = () => {
  // Records 已升级为一级 Tab 页（无返回钮）→ 用 redirectTo 换页，不压栈
  uni.redirectTo({ url: '/pages/records/Records' })
}

const remainCal = computed(() => goal.calorieGoal - food.totalCal)
const calStatus = computed(() => getCalorieStatus(food.totalCal, goal.calorieGoal))
const displayRemainCal = computed<number>(() => (remainCal.value > 0 ? remainCal.value : 0))

const progPct = computed<number>(() => {
  if (goal.calorieGoal <= 0) return 0
  const p = Math.round((food.totalCal / goal.calorieGoal) * 100)
  return p > 100 ? 100 : p
})

/** 圆环样式字符串：100% 满额时直接使用实色 color，低于 100% 时使用 conic-gradient，彻底解决全满时圆环消失问题 */
const ringStyleText = computed<string>(() => {
  const c = calStatus.value.color
  if (progPct.value >= 100) {
    return 'background-color: ' + c + ';'
  }
  return 'background-image: conic-gradient(' + c + ' 0% ' + progPct.value + '%, ' + theme.value.line + ' ' + progPct.value + '% 100%);'
})

/** 进度条：绿档跟随 accent（§8.3 status-mint 与 accent 同轴），amber/coral 为固定语义色 */
const progFillStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['width'] = progPct.value.toString() + '%'
  st['background-color'] = calStatus.value.type == 'green' ? theme.value.accent : calStatus.value.color
  return st
})
/** 剩余量数字：有余额＝accent-deep 强调字，已超额＝珊瑚语义色（原 .stat-num-coral 字面值） */
const remainNumColor = computed((): string => remainCal.value > 0 ? theme.value.accentDeep : '#FF7043')

/** 今日吃过的有效餐次数 */
const activeMealCount = computed<number>(() => {
  return food.mealRows.filter((m) => (typeof m.cal === 'number' ? m.cal : 0) > 0).length
})

/**
 * 达标 Banner 状态机：
 * 1. 达标：至少记录 2 个餐次且未超额（food.totalCal <= goal.calorieGoal && activeMealCount >= 2 && food.totalCal > 0）
 * 2. 不达标：超额（food.totalCal > goal.calorieGoal）-> 橙色图标，请减少进食，加油啊
 * 3. 记录中：未超额但不足 2 餐
 */
const bannerState = computed(() => {
  const isOver = food.totalCal > goal.calorieGoal
  if (isOver) {
    return {
      type: 'over',
      title: t('pf.bannerOverT'),
      sub: t('pf.bannerOverS'),
      isOk: false,
    }
  }
  if (activeMealCount.value >= 2 && food.totalCal > 0) {
    return {
      type: 'ok',
      title: t('pf.bannerOkT'),
      sub: t('pf.bannerOkS'),
      isOk: true,
    }
  }
  return {
    type: 'pending',
    title: t('pf.bannerPendT'),
    sub: t('pf.bannerPendS'),
    isOk: true,
  }
})

/** 超额＝珊瑚语义浅底（暗态降透明度免刺眼），其余＝card-soft 次级卡底 */
const bannerFill = computed((): string => bannerState.value.type == 'over' ? (isDark.value ? 'rgba(255, 158, 125, 0.18)' : '#FFF2EC') : theme.value.cardSoft)
const bannerCircleFill = computed((): string => bannerState.value.type == 'over' ? '#FF7043' : theme.value.accent)
const bannerTitleColor = computed((): string => bannerState.value.type == 'over' ? '#D94826' : theme.value.accentDeep)

/** 趋势柱／数值：正常档随主题走 accent 轴，超标档保留原珊瑚字面值 */
function barFillColor(over: boolean): string {
  return over ? '#FF7D5C' : theme.value.accent
}
function barValColor(over: boolean): string {
  return over ? '#FA5C38' : theme.value.accentDeep
}

/** 最近记录徽章：达标态托底＝chip、文字＝accent-deep；超标态沿用原珊瑚对 */
function recBadgeFill(over: boolean): string {
  return over ? (isDark.value ? '#3A221C' : '#FDE9E4') : theme.value.chip
}
function recBadgeTextColor(over: boolean): string {
  return over ? (isDark.value ? '#FF8266' : '#FA543A') : theme.value.accentDeep
}

/** 周几全名（getDay 0=周日）：zh 组「周X」，en 查 Mon..Sun，统一走 pf.dN 键 */
function weekdayText(g: number): string {
  return t('pf.d' + g.toString())
}

function fmtMD(ts: number): string {
  const d = new Date(ts)
  return (d.getMonth() + 1).toString() + '/' + d.getDate().toString()
}

function fmtMDLong(ts: number): string {
  const d = new Date(ts)
  return tf('pf.mdLong', [(d.getMonth() + 1).toString(), d.getDate().toString()])
}

type WeekDot = { state: string; bg: string; lbl: string }
// 连续 7 天位置标签一..日；三态：绿底白勾达标 / 珊瑚底白「!」超标 / 灰圈空缺
const weekDots = computed<WeekDot[]>(() => {
  return food.weekTotals.map((d, i) => ({
    state: d.total === 0 ? 'none' : (d.total <= goal.calorieGoal ? 'ok' : 'over'),
    bg: d.total === 0 ? '#00000000' : (d.total <= goal.calorieGoal ? theme.value.accent : '#FD6E4D'),
    lbl: t('pf.w' + (i == 6 ? '0' : (i + 1).toString())),
  }))
})

const weekOkCount = computed(() =>
  food.weekTotals.filter((d) => d.total <= goal.calorieGoal).length
)

type Bar = { val: number; h: number; date: string; over: boolean }
// 柱高 = val / 2400 * 200rpx（稿面纵轴）；日期取实际 M/D
const bars = computed<Bar[]>(() =>
  food.weekTotals.map((d, i) => ({
    val: d.total,
    h: Math.round(d.total / 2400 * 200),
    date: fmtMD(d.ts),
    over: d.total > goal.calorieGoal,
  }))
)

type Rec = {
  date: string
  wday: string
  num: number
  badge: string
  over: boolean
  chev: string
}
const REC_CHEVS = [
  'profile/chev_right.svg',
  'profile/chev_right.svg',
  'profile/chev_right.svg',
]
// 最近 3 天（不含今天）：日期/周几/总量/达标态（超标态徽章内含超出值，按 Pencil 稿「超标 150 kcal」）
const records = computed<Rec[]>(() => {
  const days = food.weekTotals.slice(-4, -1)
  return days.map((d, i) => {
    const over = d.total > goal.calorieGoal
    const dt = new Date(d.ts)
    return {
      date: fmtMDLong(d.ts),
      wday: weekdayText(dt.getDay()),
      num: d.total,
      badge: over ? tf('pf.badgeOver', [(d.total - goal.calorieGoal).toString()]) : t('pf.badgeOk'),
      over,
      chev: REC_CHEVS[i] ?? REC_CHEVS[0],
    }
  }).reverse()
})
</script>

