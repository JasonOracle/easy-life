<template>
  <view class="page">
    <!-- 头图 -->
    <view class="header" :style="{ paddingTop: sbH + 'px' }">
      <view class="header-row">
        <view class="avatar-ring">
          <image class="avatar" :src="'/static/profile/avatar.png'" mode="aspectFill"></image>
        </view>
        <view class="header-text">
          <text class="name">{{ user.name }}</text>
          <text class="sub">已连续记录  {{ user.streakDays }} 天  ·  每日目标  {{ goal.calorieGoal }} kcal</text>
        </view>
        <view class="gear-circle" @click="goSettings">
          <image class="gear" :src="'/static/profile/gear.png'" mode="aspectFit"></image>
        </view>
      </view>
      <image class="header-wave" :src="'/static/profile/header_wave.png'" mode="widthFix"></image>
    </view>

    <!-- 今日热量卡 -->
    <view class="cal-card">
      <view class="pill">
        <text class="pill-text">还可以吃</text>
      </view>
      <view class="bignum-row">
        <text class="bignum">{{ remainCal }}</text>
        <text class="bignum-unit">kcal</text>
      </view>
      <view class="prog-row">
        <text class="cons-num">{{ food.totalCal }}</text>
        <text class="cons-unit">kcal 已摄入</text>
        <view class="goal-right">
          <text class="goal-label">目标</text>
          <text class="goal-num">{{ goal.calorieGoal }}</text>
        </view>
      </view>
      <view class="prog-track">
        <view class="prog-fill" :style="{ width: progPct + '%' }"></view>
      </view>
      <view class="stat-panel">
        <view class="stat-col">
          <text class="stat-num">{{ goal.calorieGoal }}</text>
          <text class="stat-lbl">目标热量 / kcal</text>
        </view>
        <view class="stat-col">
          <text class="stat-num">{{ food.totalCal }}</text>
          <text class="stat-lbl">已摄入 / kcal</text>
        </view>
        <view class="stat-col">
          <text class="stat-num-green">{{ remainCal }}</text>
          <text class="stat-lbl">还能吃 / kcal</text>
        </view>
      </view>
    </view>

    <!-- 达标 Banner -->
    <view class="banner">
      <view class="check-circle">
        <image class="check" :src="'/static/profile/check.png'" mode="aspectFit"></image>
      </view>
      <view class="banner-text">
        <text class="banner-title">今日已达标</text>
        <text class="banner-sub">继续保持，做得很好！</text>
      </view>
      <image class="banner-chev" :src="'/static/profile/chev_banner.png'" mode="aspectFit"></image>
    </view>

    <!-- 本周概览 -->
    <view class="card week-card">
      <view class="card-head">
        <text class="card-title">本周概览</text>
        <view class="head-right">
          <text class="week-num">{{ weekOkCount }}/7</text>
          <text class="week-lbl">天达标</text>
          <image class="chev-mini" :src="'/static/profile/chev_week.png'" mode="aspectFit"></image>
        </view>
      </view>
      <view class="dots-row">
        <view class="dot-col" v-for="(dayItem, dayIdx) in weekDots" :key="dayIdx">
          <view class="dot" :style="{ backgroundColor: dayItem.color }"></view>
          <text class="dot-lbl">{{ dayItem.lbl }}</text>
        </view>
      </view>
    </view>

    <!-- 热量趋势 -->
    <view class="card trend-card">
      <view class="card-head">
        <image class="trend-icon" :src="'/static/profile/trend_icon.png'" mode="aspectFit"></image>
        <text class="card-title">热量趋势</text>
        <view class="head-right">
          <text class="view-all">查看全部</text>
          <image class="chev-mini" :src="'/static/profile/chev_trend.png'" mode="aspectFit"></image>
        </view>
      </view>
      <view class="chart">
        <view class="yaxis">
          <text class="ax">2400</text>
          <text class="ax-green">1800</text>
          <text class="ax">1200</text>
          <text class="ax">600</text>
          <text class="ax">0</text>
        </view>
        <view class="bars-area">
          <view class="target-line"></view>
          <view class="bars-row">
            <view class="bar-col" v-for="(barItem, barIdx) in bars" :key="barIdx">
              <text class="bar-val" :class="{ 'bar-val-over': barItem.over }">{{ barItem.val }}</text>
              <view class="bar" :class="{ 'bar-over': barItem.over }" :style="{ height: barItem.h + 'px' }"></view>
              <text class="bar-date">{{ barItem.date }}</text>
            </view>
          </view>
          <view class="target-tag">
            <text class="target-tag-text">目标 1800</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 最近记录 -->
    <view class="card rec-card">
      <view class="card-head">
        <text class="card-title">最近记录</text>
        <view class="head-right">
          <text class="view-all">查看全部</text>
          <image class="chev-mini" :src="'/static/profile/chev_rec.png'" mode="aspectFit"></image>
        </view>
      </view>
      <view v-for="(recItem, recIdx) in records" :key="recIdx">
        <view class="rec-row">
          <view class="rec-left">
            <text class="rec-date">{{ recItem.date }}</text>
            <text class="rec-wday">{{ recItem.wday }}</text>
          </view>
          <view class="rec-right">
            <text class="rec-num">{{ recItem.num }}</text>
            <text class="rec-unit">kcal</text>
            <view class="rec-badge" :class="{ 'rec-badge-over': recItem.over }">
              <text class="rec-badge-text" :class="{ 'rec-badge-text-over': recItem.over }">{{ recItem.badge }}</text>
            </view>
            <text class="rec-over" v-if="recItem.over">+{{ recItem.overKcal }} kcal</text>
          </view>
          <image class="chev-row" :src="recItem.chev" mode="aspectFit"></image>
        </view>
        <view class="rec-div" v-if="recIdx < records.length - 1"></view>
      </view>
    </view>

    <!-- 底部 Tab（共享组件，我的激活） -->
    <Tabbar active="profile" />
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { computed } from 'vue'
import Tabbar from '../../components/Tabbar.uvue'
import { useFoodStore } from '../../stores/food'
import { useGoalStore } from '../../stores/goal'
import { useUserStore } from '../../stores/user'

/**
 * 接 store 读数（种子精确还原：历史 1950超+150/1720达/1580达；趋势 1580…1950/1368；
 * 周 dots 按 1800 判定，6/7 达标——稿面 4/7 与自家数据矛盾，以真值为准）。
 */

let sbH = 0
try {
  sbH = uni.getSystemInfoSync().statusBarHeight ?? 0
} catch (e) {
  sbH = 0
}

const food = useFoodStore()
const goal = useGoalStore()
const user = useUserStore()

const goSettings = () => {
  uni.navigateTo({ url: '/pages/settings/Settings' })
}

const remainCal = computed(() => goal.calorieGoal - food.totalCal)
const progPct = computed(() => {
  if (goal.calorieGoal <= 0) return 0
  const p = Math.round(food.totalCal / goal.calorieGoal * 100)
  return p > 100 ? 100 : p
})

const WEEKDAY = ['日', '一', '二', '三', '四', '五', '六']

function fmtMD(ts: number): string {
  const d = new Date(ts)
  return (d.getMonth() + 1).toString() + '/' + d.getDate().toString()
}

function fmtMDLong(ts: number): string {
  const d = new Date(ts)
  return (d.getMonth() + 1).toString() + '月' + d.getDate().toString() + '日'
}

type WeekDot = { color: string; lbl: string }
// 连续 7 天位置标签一..日；颜色按目标判定（绿达标/珊瑚超标）
const weekDots = computed<WeekDot[]>(() => {
  const labels = ['一', '二', '三', '四', '五', '六', '日']
  return food.weekTotals.map((d, i) => ({
    color: d.total <= goal.calorieGoal ? '#25AE8C' : '#FD6E4D',
    lbl: labels[i] ?? '',
  }))
})

const weekOkCount = computed(() =>
  food.weekTotals.filter((d) => d.total <= goal.calorieGoal).length
)

type Bar = { val: number; h: number; date: string; over: boolean }
// 柱高 = val / 2400 * 100（稿面纵轴）；日期取实际 M/D
const bars = computed<Bar[]>(() =>
  food.weekTotals.map((d, i) => ({
    val: d.total,
    h: Math.round(d.total / 2400 * 100),
    date: i < 4 ? fmtMD(d.ts) : '',
    over: d.total > goal.calorieGoal,
  }))
)

type Rec = {
  date: string
  wday: string
  num: number
  badge: string
  over: boolean
  overKcal: number
  chev: string
}
const REC_CHEVS = [
  '/static/profile/chev_r1.png',
  '/static/profile/chev_r2.png',
  '/static/profile/chev_r3.png',
]
// 最近 3 天（不含今天）：日期/周几/总量/达标态
const records = computed<Rec[]>(() => {
  const days = food.weekTotals.slice(-4, -1)
  return days.map((d, i) => {
    const over = d.total > goal.calorieGoal
    const dt = new Date(d.ts)
    return {
      date: fmtMDLong(d.ts),
      wday: '周' + WEEKDAY[dt.getDay()],
      num: d.total,
      badge: over ? '超标' : '达标',
      over,
      overKcal: over ? d.total - goal.calorieGoal : 0,
      chev: REC_CHEVS[i] ?? REC_CHEVS[0],
    }
  }).reverse()
})
</script>

