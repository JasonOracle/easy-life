          <image class="chip-icon" :src="'/static/settings/icon_moon.png'" mode="aspectFit"></image>
        </view>
        <text class="row-title">深色模式</text>
        <view class="toggle toggle-on">
          <view class="knob knob-on"></view>
        </view>
      </view>
      <view class="row-div"></view>
      <view class="row">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_bell.png'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">用餐提醒</text>
          <text class="row-sub">早中晚各提醒一次，敬请期待</text>
        </view>
        <view class="soon-pill">
          <text class="soon-pill-text">即将上线</text>
        </view>
      </view>
    </view>

    <!-- 目标管理 -->
    <text class="sec-title">目标管理</text>
    <view class="card">
      <view class="row" @click="openGoal">
