  color: #8FAEAF;
  margin-top: 4rpx;
}
.pf-check {
  font-size: 36rpx;
  font-weight: bold;
}
/* ===== 深色模式（Boss P2：与个人中心同薄荷深色板；后代选择器仅 mp 端生效，App 端须改逐元素 :class） ===== */
/* #ifdef MP-WEIXIN */
