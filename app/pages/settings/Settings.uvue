  font-size: 20rpx;
  color: #8FAEAF;
  margin-top: 6rpx;
}
/* ===== 主题/语言 sheet（pf- 前缀避跨文件类名冲突） ===== */
.row-pressed {
  opacity: 0.75;
}
.pf-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
.pf-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 900;
  justify-content: flex-end;
  opacity: 0;
  transition-property: opacity;
  transition-duration: 220ms;
}
.pf-mask-active {
  opacity: 1;
}
.pf-sheet {
  background-color: #FFFFFF;
  border-top-left-radius: 68rpx;
  border-top-right-radius: 68rpx;
  padding-left: 40rpx;
  padding-right: 40rpx;
  padding-top: 20rpx;
  transform: translateY(100%);
  transition-property: transform;
  transition-duration: 260ms;
}
.pf-sheet-active {
  transform: translateY(0%);
}
.pf-grip {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: #D5E5DD;
  margin-left: 295rpx;
  margin-bottom: 24rpx;
}
.pf-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #0A4F3D;
  margin-bottom: 8rpx;
}
