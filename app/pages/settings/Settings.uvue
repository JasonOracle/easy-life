<template>
  <view class="page" :class="{ 'page-dark': dk }">
    <!-- 头图（稿 T0IUr：140 高含 27 状态栏；渐变＋光晕＋双弧＋大波浪，返回箭/标题/副题绝对定位对齐稿面坐标） -->
    <view class="header" :style="{ height: (113 + sbH) + 'px' }">
      <view class="hd-glow" :style="{ top: (sbH - 170) + 'px' }"></view>
      <view class="hd-arc1" :style="{ top: (sbH + 69) + 'px' }"></view>
      <view class="hd-arc2" :style="{ top: (sbH + 91) + 'px' }"></view>
      <view class="hd-back" :style="{ top: (sbH + 10) + 'px' }" @click="goBack">
        <image class="hd-back-icon" :src="'/static/settings/chev_back.png'" mode="aspectFit"></image>
      </view>
      <text class="hd-title" :style="{ top: (sbH + 19) + 'px' }">设置</text>
      <text class="hd-sub" :style="{ top: (sbH + 47) + 'px' }">管理你的饮食记录与偏好</text>
    </view>

    <!-- 偏好 -->
    <text class="sec-title sec-first">偏好</text>
    <view class="card">
      <view class="row">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_moon.png'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">深色模式</text>
        </view>
        <view class="toggle" :class="{ 'toggle-on': settings.darkMode }" @click="toggleDark">
          <view class="knob" :class="{ 'knob-on': settings.darkMode }"></view>
        </view>
      </view>
      <view class="row-div"></view>
      <view class="row">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_bell.png'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">用餐提醒</text>
          <text class="row-sub">早中晚各提醒一次，敬请期待</text>
        </view>
        <view class="soon-pill">
          <text class="soon-pill-text">即将上线</text>
        </view>
      </view>
    </view>

    <!-- 目标管理 -->
    <text class="sec-title">目标管理</text>
    <view class="card">
      <view class="row" @click="openGoal">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_target.png'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">每日热量目标</text>
          <text class="row-sub">当前目标 {{ goal.calorieGoal }} kcal</text>
        </view>
        <image class="chev" :src="'/static/home/chev_right.png'" mode="aspectFit"></image>
      </view>
      <view class="row-div"></view>
      <view class="row">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_mega.png'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">自定义餐次</text>
          <text class="row-sub">早餐、午餐、晚餐、加餐…</text>
        </view>
        <image class="chev" :src="'/static/home/chev_right.png'" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 数据管理 -->
    <text class="sec-title">数据管理</text>
    <view class="card">
      <view class="row">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_down.png'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">导出数据</text>
          <text class="row-sub">备份到本地</text>
        </view>
        <image class="chev" :src="'/static/home/chev_right.png'" mode="aspectFit"></image>
      </view>
      <view class="row-div"></view>
      <view class="row">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_up.png'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">导入数据</text>
          <text class="row-sub">从文件恢复</text>
        </view>
        <image class="chev" :src="'/static/home/chev_right.png'" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 本机声明 -->
    <view class="shield-row">
      <image class="shield-icon" :src="'/static/settings/icon_shield.png'" mode="aspectFit"></image>
      <text class="shield-note">所有数据仅保存在本机</text>
    </view>

    <!-- 危险区 -->
    <view class="card-danger">
      <view class="chip-danger">
        <image class="chip-icon" :src="'/static/settings/icon_trash.png'" mode="aspectFit"></image>
      </view>
      <text class="danger-text">清空所有数据</text>
    </view>

    <!-- 页脚 -->
    <view class="footer">
      <image class="brand-icon" :src="'/static/settings/icon_leaf.png'" mode="aspectFit"></image>
      <text class="brand">轻律生活  CalTrack</text>
      <text class="ver">v1.0.0</text>
      <text class="footnote">数据仅保存在本机</text>
    </view>

    <!-- 每日热量目标弹窗 -->
    <GoalModal v-model:show="goalShow" :initial="goal.calorieGoal" @save="goal.setGoal" ></GoalModal>

    <!-- 常驻导航栏（#28：替代 P1 遮罩＋fx-back 两件套）：滚动跨阈后整栏出现＝末色底＋返回箭＋标题，三端生效 -->
    <view v-if="scrolled" class="set-nav" :style="{ height: (sbH + 58) + 'px', paddingTop: sbH + 'px', backgroundColor: dk ? '#162924' : '#39AD95' }">
      <view class="set-nav-back" @click="goBack">
        <image class="set-nav-icon" :src="'/static/settings/chev_back.png'" mode="aspectFit"></image>
      </view>
      <text class="set-nav-title">设置</text>
    </view>
  </view>
</template>

<script setup lang="uts">
/**
 * 接 store 读数：目标管理行读 goal；深色模式开关接 settings.setDarkMode（Boss 拍板：
 * 点击切换，个人中心按该值渲染暗黑主题）。
 * 缩放系数 0.794：v2 画布 472px → 应用 375px。
 */
import { useGoalStore } from '../../stores/goal'
import { useSettingsStore } from '../../stores/settings'
import { ref, computed } from 'vue'
import { onPageScroll } from '@dcloudio/uni-app'
// #ifdef MP-WEIXIN
import { onShow } from '@dcloudio/uni-app'
// #endif
import GoalModal from '../../components/GoalModal.uvue'

const goal = useGoalStore()
const settings = useSettingsStore()
const goalShow = ref(false)
const dk = computed((): boolean => settings.darkMode)

// 状态栏字色随暗黑反转（Boss P2 指令）：小程序走 setNavigationBarColor；
// TODO App 原生端改 plus.navigator.setStatusBarStyle 实测后补
function syncBar(): void {
  // #ifdef MP-WEIXIN
  uni.setNavigationBarColor({ frontColor: dk.value ? '#ffffff' : '#000000', backgroundColor: '#000000' })
  // #endif
}
// #ifdef MP-WEIXIN
onShow(() => {
  syncBar()
})
// #endif

// 常驻导航栏两态（跨阈值才写 ref，避免逐帧触发 setData）：>40 即整栏出现——
// 该滚位头图渐变已近末色 #39AD95，栏底实色与稿面无缝；onPageScroll 三端通用（#28 去 MP-only）
const scrolled = ref<boolean>(false)
onPageScroll((e) => {
  const v = e.scrollTop > 40
  if (v !== scrolled.value) scrolled.value = v
})

function openGoal(): void {
  goalShow.value = true
}

function toggleDark(): void {
  settings.setDarkMode(!settings.darkMode)
  syncBar()
  try { uni.vibrateShort() } catch (e) {}
}

let sbH = 0
try {
  sbH = uni.getSystemInfoSync().statusBarHeight ?? 0
} catch (e) {
  sbH = 0
}

const goBack = () => {
  uni.navigateBack()
}
</script>

