<template>
   <view class="page" :class="{ 'page-dark': dk }">
     <!-- [变更日志] 2026-09-24: Header 简化为与日历页同源的纯净绿色渐变（三页统一） -->
    <!-- 头图（与日历页顶栏同源的纯净绿色渐变） -->
    <view class="header" :style="{ backgroundColor: dk ? '#162924' : '#29B385', backgroundImage: dk ? 'none' : 'linear-gradient( #32D0A0 0%, #1FBF8F 60%, #159C72 100%)' }">
      <!-- 状态栏独立占位，杜绝混合 calc(rpx+px) 塌陷 -->
      <view :style="{ height: sbH + 'px' }"></view>
      <view class="header-inner">
        <view class="hd-bar">
          <view class="hd-back" hover-class="icon-pressed" :hover-stay-time="120" @click="goBack">
            <image class="hd-back-icon" :src="'/static/settings/chev_back.svg'" mode="aspectFit"></image>
          </view>
          <view class="hd-info">
            <text class="hd-title">{{ t('st.title') }}</text>
            <text class="hd-sub">{{ t('st.sub') }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 偏好 -->
    <text class="sec-title sec-first">{{ t('st.pref') }}</text>
    <view class="card">
      <view class="row">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_moon.svg'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">{{ t('st.dark') }}</text>
        </view>
        <view class="toggle" :class="{ 'toggle-on': settings.darkMode }" @click="toggleDark">
          <view class="knob" :class="{ 'knob-on': settings.darkMode }"></view>
        </view>
      </view> 
      <view class="row-div"></view>
      <view class="row">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_bell.svg'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">{{ t('st.remind') }}</text>
          <text class="row-sub">{{ t('st.remindSub') }}</text>
        </view>
        <view class="soon-pill">
          <text class="soon-pill-text">{{ t('st.soon') }}</text>
        </view> 
      </view>
      <view class="row-div"></view>
      <view class="row" hover-class="row-pressed" :hover-stay-time="120" @click="openPref('accent')">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_palette.svg'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">{{ t('st.theme') }}</text>
          <text class="row-sub">{{ accentLabel }}</text>
        </view>
        <view class="pf-dot" :style="{ backgroundColor: theme.accent }"></view>
        <image class="chev" :src="'/static/home/chev_right.svg'" mode="aspectFit"></image>
      </view>
      <view class="row-div"></view>
      <view class="row" hover-class="row-pressed" :hover-stay-time="120" @click="openPref('locale')">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_globe.svg'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">{{ t('st.lang') }}</text>
          <text class="row-sub">{{ localeLabel }}</text>
        </view>
        <image class="chev" :src="'/static/home/chev_right.svg'" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 目标管理 -->
    <text class="sec-title">{{ t('st.goalSec') }}</text>
    <view class="card">
      <view class="row" @click="openGoal">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_target.svg'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">{{ t('st.goalDaily') }}</text>
          <text class="row-sub">{{ tf('st.goalCur', [goal.calorieGoal.toString()]) }}</text>
        </view>
        <image class="chev" :src="'/static/home/chev_right.svg'" mode="aspectFit"></image>
      </view>
      <view class="row-div"></view>
      <view class="row">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_mega.svg'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">{{ t('st.mealCustom') }}</text>
          <text class="row-sub">{{ t('st.mealCustomSub') }}</text>
        </view>
        <image class="chev" :src="'/static/home/chev_right.svg'" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 数据管理 -->
    <text class="sec-title">{{ t('st.dataSec') }}</text>
    <view class="card">
      <view class="row">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_down.svg'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">{{ t('st.export') }}</text>
          <text class="row-sub">{{ t('st.exportSub') }}</text>
        </view>
        <image class="chev" :src="'/static/home/chev_right.svg'" mode="aspectFit"></image>
      </view>
      <view class="row-div"></view>
      <view class="row">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_up.svg'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">{{ t('st.import') }}</text>
          <text class="row-sub">{{ t('st.importSub') }}</text>
        </view>
        <image class="chev" :src="'/static/home/chev_right.svg'" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 本机声明 -->
    <view class="shield-row">
      <image class="shield-icon" :src="'/static/settings/icon_shield.svg'" mode="aspectFit"></image>
      <text class="shield-note">{{ t('st.shield') }}</text>
    </view>

    <!-- 危险区 -->
    <view class="card-danger">
      <view class="chip-danger">
        <image class="chip-icon" :src="'/static/settings/icon_trash.svg'" mode="aspectFit"></image>
      </view>
      <text class="danger-text">{{ t('st.clear') }}</text>
    </view>

    <!-- 页脚 -->
    <view class="footer">
      <image class="brand-icon" :src="'/static/settings/icon_leaf.svg'" mode="aspectFit"></image>
      <text class="brand">{{ t('st.brand') }}</text>
      <text class="ver">v1.0.0</text>
      <text class="footnote">{{ t('st.foot') }}</text>
    </view>

    <!-- 每日热量目标弹窗 -->
    <GoalModal :show="goalShow" @update:show="updateGoalShow" :initial="goal.calorieGoal" @save="goal.setGoal"></GoalModal>

    <!-- 主题/语言选择半屏 sheet（仿 GoalModal：v-if render + active 两态，即点即换） -->
    <view class="pf-mask" :class="{ 'pf-mask-active': pfActive }" v-if="pfRender" @click="closePref">
      <view class="pf-sheet" :class="{ 'pf-sheet-active': pfActive }" :style="{ paddingBottom: (40 + safeBottom) + 'px' }" @click.stop="noop">
        <view class="pf-grip"></view>
        <text class="pf-title">{{ pfKind == 'accent' ? t('st.theme') : t('st.lang') }}</text>
        <view class="pf-opt" v-for="(opt, idx) in pfOptions" :key="idx" hover-class="pf-opt-pressed" :hover-stay-time="100" @click="pickPref(opt.id)">
          <view class="pf-swatch" v-if="opt.swatch.length > 0" :style="{ backgroundColor: opt.swatch }"></view>
          <view class="pf-opt-text">
            <text class="pf-opt-label">{{ opt.label }}</text>
            <text class="pf-opt-sub" v-if="opt.sub.length > 0">{{ opt.sub }}</text>
          </view>
          <text class="pf-check" v-if="pfCurrent == opt.id" :style="{ color: theme.accent }">✓</text>
        </view>
      </view>
    </view>

    <!-- 常驻导航栏（#28：替代 P1 遮罩＋fx-back 两件套）：滚动跨阈后整栏出现＝末色底＋返回箭＋标题，三端生效 -->
    <view v-if="scrolled" class="set-nav" :style="{ height: navBarH + 'px', paddingTop: sbH + 'px', backgroundColor: dk ? '#162924' : '#39AD95' }">
      <view class="set-nav-back" @click="goBack">
        <image class="set-nav-icon" :src="'/static/settings/chev_back.svg'" mode="aspectFit"></image>
      </view>
      <text class="set-nav-title">{{ t('st.title') }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
/**
 * 接 store 读数：目标管理行读 goal；深色模式开关接 settings.setDarkMode（Boss 拍板：
 * 点击切换，个人中心按该值渲染暗黑主题）。
 * 缩放系数 0.794：v2 画布 472px → 应用 375px。
 */
import { useGoalStore } from '../../stores/goal'
import { useSettingsStore } from '../../stores/settings'
import { triggerHaptic } from '../../stores/settings'
import { useTheme, ACCENT_OPTIONS } from '../../composables/useTheme'
import { t, tf } from '../../composables/i18n'
import { ref, computed } from 'vue'
import { onPageScroll } from '@dcloudio/uni-app'
import { onShow } from '@dcloudio/uni-app'
import GoalModal from '../../components/GoalModal.uvue'

type PrefOpt = { id: string; label: string; sub: string; swatch: string }

const goal = useGoalStore()
const settings = useSettingsStore()
const { theme } = useTheme()
const goalShow = ref(false)
const dk = computed((): boolean => settings.darkMode)

const sbH = ref<number>(uni.getSystemInfoSync().statusBarHeight ?? 0)

// 常驻导航栏高度计算：58px (116rpx) 内容高 + 状态栏高，避免跨端 calc(rpx+px) 错误
const navBarH = computed<number>(() => sbH.value + 58)

// 状态栏字色随暗黑反转（Boss P2 指令）：小程序走 setNavigationBarColor；
// TODO App 原生端改 plus.navigator.setStatusBarStyle 实测后补
function syncBar(): void {
  uni.setNavigationBarColor({ frontColor: dk.value ? '#ffffff' : '#000000', backgroundColor: '#000000' })
}
onShow(() => {
  syncBar()
})

// 常驻导航栏两态（跨阈值才写 ref，避免逐帧触发 setData）：>40 即整栏出现——
// 该滚位头图渐变已近末色 #39AD95，栏底实色与稿面无缝；onPageScroll 三端通用（#28 去 MP-only）
const scrolled = ref<boolean>(false)
onPageScroll((e) => {
  const v = e.scrollTop > 40
  if (v !== scrolled.value) scrolled.value = v
})

function openGoal(): void {
  goalShow.value = true
}

function updateGoalShow(v: boolean): void {
  goalShow.value = v
}

function toggleDark(): void {
  settings.setDarkMode(!settings.darkMode)
  syncBar()
}

/* ===== 主题 / 语言 半屏选择 sheet（即点即换 + 持久化在 store 层） ===== */
const pfRender = ref(false)
const pfActive = ref(false)
const pfKind = ref('accent')
let pfTimer = 0

let safeBottom = 0
const insets = uni.getSystemInfoSync().safeAreaInsets
if (insets != null) safeBottom = insets.bottom

const accentOpts = computed<PrefOpt[]>((): PrefOpt[] => [
  { id: 'mint', label: t('st.mint'), sub: t('st.mintSub'), swatch: '#20C997' },
  { id: 'ocean', label: t('st.ocean'), sub: t('st.oceanSub'), swatch: '#2F9FE0' },
  { id: 'lavender', label: t('st.lav'), sub: t('st.lavSub'), swatch: '#8B7BE8' },
])
const localeOpts = computed<PrefOpt[]>((): PrefOpt[] => [
  { id: '', label: t('st.sys'), sub: t('st.sysSub'), swatch: '' },
  { id: 'zh', label: t('st.zh'), sub: t('st.zhSub'), swatch: '' },
  { id: 'en', label: t('st.en'), sub: t('st.enSub'), swatch: '' },
])

const pfOptions = computed((): PrefOpt[] => pfKind.value == 'accent' ? accentOpts.value : localeOpts.value)
const pfCurrent = computed((): string => pfKind.value == 'accent' ? settings.accent : settings.locale)

const accentLabel = computed((): string => {
  const opts = accentOpts.value
  for (let i = 0; i < opts.length; i++) {
    if (opts[i].id == settings.accent) return opts[i].label
  }
  return t('st.mint')
})
const localeLabel = computed((): string => {
  const opts = localeOpts.value
  for (let i = 0; i < opts.length; i++) {
    if (opts[i].id == settings.locale) return opts[i].label
  }
  return t('st.sys')
})

function openPref(kind: string): void {
  pfKind.value = kind
  if (pfTimer > 0) { clearTimeout(pfTimer); pfTimer = 0 }
  pfRender.value = true
  triggerHaptic('light')
  setTimeout(() => {
    pfActive.value = true
  }, 16)
}

function closePref(): void {
  pfActive.value = false
  if (pfTimer > 0) { clearTimeout(pfTimer); pfTimer = 0 }
  pfTimer = setTimeout(() => {
    pfRender.value = false
    pfTimer = 0
  }, 220) as unknown as number
}

function pickPref(id: string): void {
  triggerHaptic('light')
  if (pfKind.value == 'accent') {
    settings.setAccent(id)
  } else {
    settings.setLocale(id)
  }
  closePref()
}

function noop(): void { }

const goBack = () => {
  uni.navigateBack()
}
</script>

<style>
