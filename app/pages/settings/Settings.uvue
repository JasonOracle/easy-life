      <view class="row">
        <view class="chip">
          <image class="chip-icon" :src="'/static/settings/icon_up.svg'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">导入数据</text>
          <text class="row-sub">从文件恢复</text>
        </view>
        <image class="chev" :src="'/static/home/chev_right.svg'" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 本机声明 -->
    <view class="shield-row">
      <image class="shield-icon" :src="'/static/settings/icon_shield.svg'" mode="aspectFit"></image>
      <text class="shield-note">所有数据仅保存在本机</text>
    </view>

    <!-- 危险区 -->
    <view class="card-danger">
      <view class="chip-danger">
        <image class="chip-icon" :src="'/static/settings/icon_trash.svg'" mode="aspectFit"></image>
      </view>
      <text class="danger-text">清空所有数据</text>
    </view>

    <!-- 页脚 -->
    <view class="footer">
      <image class="brand-icon" :src="'/static/settings/icon_leaf.svg'" mode="aspectFit"></image>
      <text class="brand">轻律生活  CalTrack</text>
      <text class="ver">v1.0.0</text>
      <text class="footnote">数据仅保存在本机</text>
    </view>

    <!-- 每日热量目标弹窗 -->
    <GoalModal :show="goalShow" @update:show="updateGoalShow" :initial="goal.calorieGoal" @save="goal.setGoal"></GoalModal>

    <!-- 常驻导航栏（#28：替代 P1 遮罩＋fx-back 两件套）：滚动跨阈后整栏出现＝末色底＋返回箭＋标题，三端生效 -->
    <view v-if="scrolled" class="set-nav" :style="{ height: navBarH + 'px', paddingTop: sbH + 'px', backgroundColor: dk ? '#162924' : '#39AD95' }">
      <view class="set-nav-back" @click="goBack">
        <image class="set-nav-icon" :src="'/static/settings/chev_back.svg'" mode="aspectFit"></image>
      </view>
      <text class="set-nav-title">设置</text>
    </view>
  </view>
</template>

<script setup lang="uts">
/**
 * 接 store 读数：目标管理行读 goal；深色模式开关接 settings.setDarkMode（Boss 拍板：
 * 点击切换，个人中心按该值渲染暗黑主题）。
 * 缩放系数 0.794：v2 画布 472px → 应用 375px。
 */
import { useGoalStore } from '../../stores/goal'
import { useSettingsStore } from '../../stores/settings'
import { ref, computed } from 'vue'
import { onPageScroll } from '@dcloudio/uni-app'
import { onShow } from '@dcloudio/uni-app'
import GoalModal from '../../components/GoalModal.uvue'

const goal = useGoalStore()
const settings = useSettingsStore()
const goalShow = ref(false)
const dk = computed((): boolean => settings.darkMode)

const sbH = ref<number>(uni.getSystemInfoSync().statusBarHeight ?? 0)

// 常驻导航栏高度计算：58px (116rpx) 内容高 + 状态栏高，避免跨端 calc(rpx+px) 错误
const navBarH = computed<number>(() => sbH.value + 58)

// 状态栏字色随暗黑反转（Boss P2 指令）：小程序走 setNavigationBarColor；
// TODO App 原生端改 plus.navigator.setStatusBarStyle 实测后补
function syncBar(): void {
  uni.setNavigationBarColor({ frontColor: dk.value ? '#ffffff' : '#000000', backgroundColor: '#000000' })
}
onShow(() => {
  syncBar()
})

// 常驻导航栏两态（跨阈值才写 ref，避免逐帧触发 setData）：>40 即整栏出现——
// 该滚位头图渐变已近末色 #39AD95，栏底实色与稿面无缝；onPageScroll 三端通用（#28 去 MP-only）
const scrolled = ref<boolean>(false)
onPageScroll((e) => {
  const v = e.scrollTop > 40
  if (v !== scrolled.value) scrolled.value = v
})

function openGoal(): void {
  goalShow.value = true
}

function updateGoalShow(v: boolean): void {
  goalShow.value = v
}

function toggleDark(): void {
  settings.setDarkMode(!settings.darkMode)
  syncBar()
}

const goBack = () => {
  uni.navigateBack()
}
</script>

