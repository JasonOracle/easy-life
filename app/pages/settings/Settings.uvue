          <image class="chip-icon" :src="'/static/settings/icon_target.png'" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title">每日热量目标</text>
          <text class="row-sub">当前目标 {{ goal.calorieGoal }} kcal</text>
        </view>
        <image class="chev" :src="'/static/home/chev_right.png'" mode="aspectFit"></image>
      </view>
      <view class="row-div"></view>
      <view class="row">
