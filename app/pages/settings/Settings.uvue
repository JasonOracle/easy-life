<template>
  <!-- [变更日志] 2026-09-27(4):「主题切换」三套主题的纯色圆点 → 意象 SVG 图标（薄荷叶／水滴／薰衣草花穗），
       图标用该主题自己的品牌色 + 浅色圆底；资源 `static/settings/theme_{mint,ocean,lavender}[_dark].svg`。 -->
  <!-- [变更日志] 2026-09-27: 保存按钮三色渐变第三档 accentDeep→accentMid（消除右下角发黑）。 -->
  <!-- [变更日志] 2026-09-26: Settings 中段按设计稿还原几何 —— 卡片左右边距 28→46rpx；
       行高 128→140rpx（.row padding 26→32）；删掉 5 处 .row-div 行分隔线（稿面实测仅 #F6FAF8，
       与卡底差 6 级肉眼不可见，而 theme.line=#D8EFE5 差 39 级 → 观感上是「多出一条线」）；
       危险卡补齐缺失的 border-style 并把描边 1px→1.5rpx；
       盾行→危险卡过渡 82→106rpx；页脚叶片由「独立一行」改为「内联在脚注左侧」。字号与色值一律不动。 -->
   <view class="page" :style="{ backgroundColor: theme.bg }">
     <!-- [变更日志] 2026-09-27: 行尾 chevron .chev 12x22rpx→24x24rpx（实测箭头 2.6x4.5dp→5.3x8.9dp，
          对齐 Records .lr-link-chev；原 22rpx 高度因方形 SVG 受宽度先约束而浪费 10rpx）。
          类名 .chev 仅用于本页 6 处，改动无外溢。 -->
     <!-- [变更日志] 2026-09-24: Header 简化为与日历页同源的纯净绿色渐变（三页统一） -->
    <!-- 头图（与日历页顶栏同源的纯净绿色渐变） -->
    <view class="header" :style="headerStyle">
      <!-- 状态栏独立占位，杜绝混合 calc(rpx+px) 塌陷 -->
      <view :style="{ height: sbH + 'px' }"></view>
      <view class="header-inner">
        <view class="hd-bar">
          <view class="hd-back" hover-class="icon-pressed" :hover-stay-time="120" @click="goBack">
            <image class="hd-back-icon" :src="asset('settings/chev_back.svg')" mode="aspectFit"></image>
          </view>
          <view class="hd-info">
            <text class="hd-title" :style="{ color: headerTitleColor }">{{ t('st.title') }}</text>
            <text class="hd-sub" :style="{ color: headerSubColor }">{{ t('st.sub') }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 偏好 -->
    <text class="sec-title sec-first" :style="{ color: theme.ink1 }">{{ t('st.pref') }}</text>
    <view class="st-card" :style="{ backgroundColor: theme.card }">
      <view class="row">
        <view class="chip" :style="{ backgroundColor: theme.chip }">
          <image class="chip-icon" :src="asset('settings/icon_moon.svg')" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title" :style="{ color: theme.ink1 }">{{ t('st.dark') }}</text>
        </view>
        <view class="toggle" :style="{ backgroundColor: toggleFill }" @click="toggleDark">
          <view class="knob" :class="{ 'knob-on': settings.darkMode }"></view>
        </view>
      </view> 
      <view class="row">
        <view class="chip" :style="{ backgroundColor: theme.chip }">
          <image class="chip-icon" :src="asset('settings/icon_bell.svg')" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title" :style="{ color: theme.ink1 }">{{ t('st.remind') }}</text>
          <text class="row-sub" :style="{ color: theme.ink3 }">{{ t('st.remindSub') }}</text>
        </view>
        <view class="soon-pill" :style="{ backgroundColor: theme.cardSoft }">
          <text class="soon-pill-text" :style="{ color: theme.ink3 }">{{ t('st.soon') }}</text>
        </view> 
      </view>
      <view class="row" hover-class="row-pressed" :hover-stay-time="120" @click="openPref('accent')">
        <view class="chip" :style="{ backgroundColor: theme.chip }">
          <image class="chip-icon" :src="asset('settings/icon_palette.svg')" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title" :style="{ color: theme.ink1 }">{{ t('st.theme') }}</text>
          <text class="row-sub" :style="{ color: theme.ink3 }">{{ accentLabel }}</text>
        </view>
        <view class="pf-dot" :style="{ backgroundColor: theme.accent }"></view>
        <image class="chev" :src="asset('home/chev_right.svg')" mode="aspectFit"></image>
      </view>
      <view class="row" hover-class="row-pressed" :hover-stay-time="120" @click="openPref('locale')">
        <view class="chip" :style="{ backgroundColor: theme.chip }">
          <image class="chip-icon" :src="asset('settings/icon_globe.svg')" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title" :style="{ color: theme.ink1 }">{{ t('st.lang') }}</text>
          <text class="row-sub" :style="{ color: theme.ink3 }">{{ localeLabel }}</text>
        </view>
        <image class="chev" :src="asset('home/chev_right.svg')" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 目标管理 -->
    <text class="sec-title" :style="{ color: theme.ink1 }">{{ t('st.goalSec') }}</text>
    <view class="st-card" :style="{ backgroundColor: theme.card }">
      <view class="row" @click="openGoal">
        <view class="chip" :style="{ backgroundColor: theme.chip }">
          <image class="chip-icon" :src="asset('settings/icon_target.svg')" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title" :style="{ color: theme.ink1 }">{{ t('st.goalDaily') }}</text>
          <text class="row-sub" :style="{ color: theme.ink3 }">{{ tf('st.goalCur', [goal.calorieGoal.toString()]) }}</text>
        </view>
        <image class="chev" :src="asset('home/chev_right.svg')" mode="aspectFit"></image>
      </view>
      <view class="row">
        <view class="chip" :style="{ backgroundColor: theme.chip }">
          <image class="chip-icon" :src="asset('settings/icon_mega.svg')" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title" :style="{ color: theme.ink1 }">{{ t('st.mealCustom') }}</text>
          <text class="row-sub" :style="{ color: theme.ink3 }">{{ t('st.mealCustomSub') }}</text>
        </view>
        <image class="chev" :src="asset('home/chev_right.svg')" mode="aspectFit"></image>
      </view>
    </view>

    <!-- [变更日志] 2026-09-28: 【1.0 不做】「数据管理」模块整块注释掉（老板：「先把设置的数据管理模块
         注释掉，1.0 版本不做这个了」）。该模块此前本来就是没接 @click 的空桩，注释掉不影响任何行为；
         备份/恢复方案已出计划书 docs/plan-2026-09-28-records-nav-and-backup.md，整体挪到 1.1。
         i18n 键 st.dataSec / st.export / st.exportSub / st.import / st.importSub 与图标
         settings/icon_down + icon_up（含五档主题变体）**刻意保留不删**，便于 1.1 直接复用。
    <text class="sec-title" :style="{ color: theme.ink1 }">{{ t('st.dataSec') }}</text>
    <view class="st-card" :style="{ backgroundColor: theme.card }">
      <view class="row">
        <view class="chip" :style="{ backgroundColor: theme.chip }">
          <image class="chip-icon" :src="asset('settings/icon_down.svg')" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title" :style="{ color: theme.ink1 }">{{ t('st.export') }}</text>
          <text class="row-sub" :style="{ color: theme.ink3 }">{{ t('st.exportSub') }}</text>
        </view>
        <image class="chev" :src="asset('home/chev_right.svg')" mode="aspectFit"></image>
      </view>
      <view class="row">
        <view class="chip" :style="{ backgroundColor: theme.chip }">
          <image class="chip-icon" :src="asset('settings/icon_up.svg')" mode="aspectFit"></image>
        </view>
        <view class="row-text">
          <text class="row-title" :style="{ color: theme.ink1 }">{{ t('st.import') }}</text>
          <text class="row-sub" :style="{ color: theme.ink3 }">{{ t('st.importSub') }}</text>
        </view>
        <image class="chev" :src="asset('home/chev_right.svg')" mode="aspectFit"></image>
      </view>
    </view>
    -->

    <!-- 本机声明 -->
    <view class="shield-row">
      <image class="shield-icon" :src="asset('settings/icon_shield.svg')" mode="aspectFit"></image>
      <text class="shield-note" :style="{ color: theme.ink2 }">{{ t('st.shield') }}</text>
    </view>

    <!-- 危险区 -->
    <view class="card-danger" :style="{ backgroundColor: theme.card }">
      <view class="chip-danger" :style="{ backgroundColor: dangerChipFill }">
        <image class="chip-icon" :src="asset('settings/icon_trash.svg')" mode="aspectFit"></image>
      </view>
      <text class="danger-text" :style="{ color: dangerTextColor }">{{ t('st.clear') }}</text>
    </view>

    <!-- 页脚 -->
    <view class="footer">
      <text class="brand" :style="{ color: theme.ink1 }">{{ t('st.brand') }}</text>
      <text class="ver" :style="{ color: theme.ink3 }">v1.0.0</text>
      <view class="foot-row">
        <image class="foot-icon" :src="asset('settings/icon_leaf.svg')" mode="aspectFit"></image>
        <text class="footnote" :style="{ color: theme.ink3 }">{{ t('st.foot') }}</text>
      </view>
    </view>

    <!-- 每日热量目标弹窗 -->
    <GoalModal :show="goalShow" @update:show="updateGoalShow" :initial="goal.calorieGoal" @save="goal.setGoal"></GoalModal>

    <!-- 主题/语言选择半屏 sheet（仿 GoalModal：v-if render + active 两态，即点即换） -->
    <view class="pf-mask" :class="{ 'pf-mask-active': pfActive }" v-if="pfRender" @click="closePref">
      <view class="pf-sheet" :class="{ 'pf-sheet-active': pfActive }" :style="{ paddingBottom: (40 + safeBottom) + 'px', backgroundColor: theme.card }" @click.stop="noop">
        <view class="pf-grip" :style="{ backgroundColor: theme.line }"></view>
        <text class="pf-title" :style="{ color: theme.ink1 }">{{ pfKind == 'accent' ? t('st.theme') : t('st.lang') }}</text>
        <view class="pf-opt" v-for="(opt, idx) in pfOptions" :key="idx" :style="{ borderBottomColor: theme.line }" hover-class="pf-opt-pressed" :hover-stay-time="100" @click="pickPref(opt.id)">
          <view class="pf-swatch" v-if="opt.swatch.length > 0" :style="{ backgroundColor: opt.soft }">
            <image class="pf-swatch-ic" :src="accentIcon(opt.id)" mode="aspectFit"></image>
          </view>
          <view class="pf-opt-text">
            <text class="pf-opt-label" :style="{ color: theme.ink1 }">{{ opt.label }}</text>
            <text class="pf-opt-sub" v-if="opt.sub.length > 0" :style="{ color: theme.ink3 }">{{ opt.sub }}</text>
          </view>
          <text class="pf-check" v-if="pfCurrent == opt.id" :style="{ color: theme.accent }">✓</text>
        </view>
      </view>
    </view>

    <!-- 常驻导航栏（#28：替代 P1 遮罩＋fx-back 两件套）：滚动跨阈后整栏出现＝末色底＋返回箭＋标题，三端生效 -->
    <view v-if="scrolled" class="set-nav" :style="navBarStyle">
      <view class="set-nav-back" @click="goBack">
        <image class="set-nav-icon" :src="asset('settings/chev_back.svg')" mode="aspectFit"></image>
      </view>
      <text class="set-nav-title" :style="{ color: headerTitleColor }">{{ t('st.title') }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
/**
 * 接 store 读数：目标管理行读 goal；深色模式开关接 settings.setDarkMode（Boss 拍板：
 * 点击切换，个人中心按该值渲染暗黑主题）。
 * 缩放系数 0.794：v2 画布 472px → 应用 375px。
 */
import { useGoalStore } from '../../stores/goal'
import { useSettingsStore } from '../../stores/settings'
import { triggerHaptic } from '../../stores/settings'
import { useTheme, themeAsset, ACCENT_OPTIONS, syncStatusBarStyle } from '../../composables/useTheme'
import { t, tf } from '../../composables/i18n'
import { ref, computed } from 'vue'
import { onPageScroll } from '@dcloudio/uni-app'
import { onShow } from '@dcloudio/uni-app'
import GoalModal from '../../components/GoalModal.uvue'

/** swatch = 该主题品牌色（图标用色，暗态取该档更亮的一档）；soft = 图标浅色圆底（各档 chip 色） */
type PrefOpt = { id: string; label: string; sub: string; swatch: string; soft: string }

const goal = useGoalStore()
const settings = useSettingsStore()
const { theme, isDark, accentId } = useTheme()
const goalShow = ref(false)
const dk = computed((): boolean => settings.darkMode)

const sbH = ref<number>(uni.getSystemInfoSync().statusBarHeight ?? 0)

// 常驻导航栏高度计算：58px (116rpx) 内容高 + 状态栏高，避免跨端 calc(rpx+px) 错误
const navBarH = computed<number>(() => sbH.value + 58)

// 状态栏字色随暗黑反转：小程序走 setNavigationBarColor，App 原生端走 plus.navigator
function syncBar(): void {
  syncStatusBarStyle(dk.value)
}
onShow(() => {
  syncBar()
})

// 常驻导航栏两态（跨阈值才写 ref，避免逐帧触发 setData）：>40 即整栏出现——
// 该滚位头图渐变已近末色 #39AD95，栏底实色与稿面无缝；onPageScroll 三端通用（#28 去 MP-only）
const scrolled = ref<boolean>(false)
onPageScroll((e) => {
  const v = e.scrollTop > 40
  if (v !== scrolled.value) scrolled.value = v
})

function openGoal(): void {
  goalShow.value = true
}

function updateGoalShow(v: boolean): void {
  goalShow.value = v
}

function toggleDark(): void {
  settings.setDarkMode(!settings.darkMode)
  syncBar()
}

/* ===== 主题 / 语言 半屏选择 sheet（即点即换 + 持久化在 store 层） ===== */
const pfRender = ref(false)
const pfActive = ref(false)
const pfKind = ref('accent')
let pfTimer = 0

let safeBottom = 0
const insets = uni.getSystemInfoSync().safeAreaInsets
if (insets != null) safeBottom = insets.bottom

/** 资产按 (accent, mode) 取五档变体；未登记底稿（危险色／无彩稿）自动回落原路径 */
function asset(path: string): string {
  return themeAsset(accentId.value, isDark.value, '/static/' + path)
}

/** 主题意象图标：薄荷叶／水滴／薰衣草花穗 → `/static/settings/theme_<key>[_dark].svg`。
 *  这三枚是「代表各自主题」的固定色图标，**不走 themeAsset**（那不是跟随当前主题的资产）。 */
function accentIcon(id: string): string {
  const key = id == 'ocean' ? 'ocean' : (id == 'lavender' ? 'lavender' : 'mint')
  return '/static/settings/theme_' + key + (isDark.value ? '_dark' : '') + '.svg'
}

/** 品牌渐变头：浅态走该档 accent 三档渐变，暗态改 card 纯色（同日历页既定处理） */
const headerStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['background-color'] = isDark.value ? theme.value.card : theme.value.accent
  if (!isDark.value) {
    st['background-image'] = 'linear-gradient(' + theme.value.accent2 + ' 0%, ' + theme.value.accent + ' 60%, ' + theme.value.accentMid + ' 100%)'
  }
  return st
})
const headerTitleColor = computed((): string => isDark.value ? theme.value.ink1 : theme.value.onAccent)
const headerSubColor = computed((): string => isDark.value ? theme.value.ink2 : 'rgba(255, 255, 255, 0.82)')

/** 滚动跨阈后的常驻栏与头图末色无缝接续，几何与配色一并运行时下发 */
const navBarStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['height'] = navBarH.value + 'px'
  st['padding-top'] = sbH.value + 'px'
  st['background-color'] = isDark.value ? theme.value.card : theme.value.accent
  if (!isDark.value) st['box-shadow'] = '0 4rpx 20rpx rgba(10, 79, 61, 0.10)'
  return st
})

const toggleFill = computed((): string => settings.darkMode ? theme.value.accent : theme.value.line)

/** 危险区：珊瑚系语义色不随主题轮值（§8.3），暗态沿用已定稿的深底亮字 */
const dangerChipFill = computed((): string => isDark.value ? '#3A221C' : '#FDE9E4')
const dangerTextColor = computed((): string => isDark.value ? '#FF8266' : '#E0633C')

const accentOpts = computed<PrefOpt[]>((): PrefOpt[] => {
  const dk = isDark.value
  return [
    { id: 'mint', label: t('st.mint'), sub: t('st.mintSub'), swatch: dk ? '#52D6AC' : '#20C997', soft: dk ? '#2A4238' : '#E6F9F6' },
    { id: 'ocean', label: t('st.ocean'), sub: t('st.oceanSub'), swatch: dk ? '#5BC8FF' : '#2F9FE0', soft: dk ? '#1E3A4C' : '#E1F0FA' },
    { id: 'lavender', label: t('st.lav'), sub: t('st.lavSub'), swatch: dk ? '#A99BFF' : '#8B7BE8', soft: dk ? '#2B2350' : '#EFEAFC' },
  ]
})
const localeOpts = computed<PrefOpt[]>((): PrefOpt[] => [
  { id: '', label: t('st.sys'), sub: t('st.sysSub'), swatch: '', soft: '' },
  { id: 'zh', label: t('st.zh'), sub: t('st.zhSub'), swatch: '', soft: '' },
  { id: 'en', label: t('st.en'), sub: t('st.enSub'), swatch: '', soft: '' },
])

const pfOptions = computed((): PrefOpt[] => pfKind.value == 'accent' ? accentOpts.value : localeOpts.value)
const pfCurrent = computed((): string => pfKind.value == 'accent' ? settings.accent : settings.locale)

const accentLabel = computed((): string => {
  const opts = accentOpts.value
  for (let i = 0; i < opts.length; i++) {
    if (opts[i].id == settings.accent) return opts[i].label
  }
  return t('st.mint')
})
const localeLabel = computed((): string => {
  const opts = localeOpts.value
  for (let i = 0; i < opts.length; i++) {
    if (opts[i].id == settings.locale) return opts[i].label
  }
  return t('st.sys')
})

function openPref(kind: string): void {
  pfKind.value = kind
  if (pfTimer > 0) { clearTimeout(pfTimer); pfTimer = 0 }
  pfRender.value = true
  triggerHaptic('light')
  setTimeout(() => {
    pfActive.value = true
  }, 16)
}

function closePref(): void {
  pfActive.value = false
  if (pfTimer > 0) { clearTimeout(pfTimer); pfTimer = 0 }
  pfTimer = setTimeout(() => {
    pfRender.value = false
    pfTimer = 0
  }, 220) as unknown as number
}

function pickPref(id: string): void {
  triggerHaptic('light')
  if (pfKind.value == 'accent') {
    settings.setAccent(id)
  } else {
    settings.setLocale(id)
  }
  closePref()
}

function noop(): void { }

const goBack = () => {
  uni.navigateBack()
}
</script>

<style>
.page {
  padding-bottom: 60rpx;
}
.header {
  position: relative;
  overflow: hidden;
  padding-bottom: 56rpx;
}
.header-inner {
  position: relative;
  height: 160rpx;
  justify-content: center;
}
.hd-bar {
  flex-direction: row;
  align-items: center;
  padding-left: 16rpx;
  padding-right: 32rpx;
}
.hd-back {
  width: 72rpx;
  height: 72rpx;
  justify-content: center;
  align-items: center;
}
.hd-back-icon {
  width: 32rpx;
  height: 48rpx;
}
.hd-info {
  margin-left: 12rpx;
  justify-content: center;
}
.hd-title {
  font-size: 38rpx;
  font-weight: bold;
  line-height: 48rpx;
}
.hd-sub {
  font-size: 22rpx;
  line-height: 32rpx;
  margin-top: 4rpx;
}
/* 常驻导航栏（#28）：滚动后整栏出现，返回箭＋标题，z45 压顶遮罩档与 Tabbar */
.set-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 45;
  flex-direction: row;
  align-items: center;
}
.set-nav-back {
  width: 88rpx;
  height: 88rpx;
  margin-left: 6rpx;
  justify-content: center;
  align-items: center;
}
.set-nav-icon {
  width: 32rpx;
  height: 48rpx;
}
.set-nav-title {
  font-size: 34rpx;
  font-weight: bold;
}
.sec-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-left: 52rpx;
  margin-top: 40rpx;
  margin-bottom: 14rpx;
}
.sec-first {
  margin-top: 20rpx;
}
.st-card {
  border-radius: 36rpx;
  margin-left: 46rpx;
  margin-right: 46rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
}
.row {
  flex-direction: row;
  align-items: center;
  padding-top: 32rpx;
  padding-bottom: 32rpx;
}
.chip {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  justify-content: center;
  align-items: center;
}
.chip-icon {
  width: 40rpx;
  height: 40rpx;
}
.row-text {
  flex: 1;
  margin-left: 20rpx;
}
.row-title {
  font-size: 28rpx;
}
.row-sub {
  font-size: 22rpx;
  margin-top: 6rpx;
}
/* 行尾 chevron：SVG 为 24x24 方形 viewBox、箭头本体仅占 6x12 单位，
   aspectFit 先被宽度约束 → 容器宽必须给到 24rpx 箭头才够大（12rpx 时实测仅 2.6x4.5dp，
   仅 iOS disclosure 8x13dp 的 35%）。24x24rpx 时实测箭头 5.3x8.9dp，与 Records .lr-link-chev 一致。 */
.chev {
