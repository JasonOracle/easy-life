  border-color: #FBA095;
  margin-left: 42rpx;
  margin-right: 42rpx;
  margin-top: 24rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
}
.chip-danger {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background-color: #FDE9E4;
  justify-content: center;
  align-items: center;
}
.danger-text {
  font-size: 28rpx;
  color: #E0633C;
  margin-left: 20rpx;
}
.footer {
  align-items: center;
