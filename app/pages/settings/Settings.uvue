<script setup lang="uts">
/**
 * 接 store 读数：目标管理行读 goal；开关暂为稿面静态（v1.0 深色模式不做，store 恒关，
 * 若绑定会把 ON 画成 OFF，与稿面漂移，故展示层保持稿面）。
 * 缩放系数 0.794：v2 画布 472px → 应用 375px。
 */
import { useGoalStore } from '../../stores/goal'
import { ref } from 'vue'
import GoalModal from '../../components/GoalModal.uvue'

const goal = useGoalStore()
const goalShow = ref(false)

function openGoal(): void {
  goalShow.value = true
}

let sbH = 0
try {
  sbH = uni.getSystemInfoSync().statusBarHeight ?? 0
} catch (e) {
  sbH = 0
}

const goBack = () => {
  uni.navigateBack()
}
</script>

