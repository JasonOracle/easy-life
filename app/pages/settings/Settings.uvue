}
.page-dark .row-sub,
.page-dark .soon-pill-text,
.page-dark .shield-note,
.page-dark .ver,
.page-dark .footnote {
  color: rgba(234, 249, 243, 0.5);
}
.page-dark .row-div {
  background-color: #1E352F;
}
.page-dark .toggle {
  background-color: #23443B;
}
.page-dark .soon-pill {
  background-color: #1E3B33;
}
.page-dark .card-danger {
  background-color: #162924;
}
.page-dark .chip-danger {
  background-color: #3A221C;
}
.page-dark .danger-text {
  color: #FF8266;
}
.page-dark .pf-sheet {
  background-color: #162924;
}
.page-dark .pf-title,
.page-dark .pf-opt-label {
  color: #EAF9F3;
