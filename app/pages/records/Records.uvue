    接 StickyTop 两态遮罩（scrollTop>80 显示，色取 Header 渐变末色 #39AD95，高 sbH+58）；
    新增常驻返回钮 rec-fx-back（fixed z45，44×44 热区中心对准稿面 lr-back 图标中心 (25, sbH+15)）；
    onPageScroll 走 MP-WEIXIN 条件编译，仅跨阈值写 ref]
-->
<!--
  [变更日志]
  修改时间：2026-09-21
  AI模型：Qoder (Claude)
  修改内容：[新建：还原 Pencil「最近记录」页 bTPUq（绿色渐变 Header + 月历卡〔前后月导航/记录圆点/选中渐变 pill/今日浅 mint pill〕
    + 选中日汇总卡〔火焰总量/超标 pill/目标刻度能量条〕+ 三餐摄入四小卡 + 主要食物四卡）；
    入口＝首页日历图标 / 个人中心「查看全部」；「查看详情」→ 单日详情页（带日参）。]
-->
<template>
  <view class="page">
    <!-- Header（稿面 k8TS5：渐变 + 白字，CalCard 上叠 34px） -->
    <view class="lr-header" :style="{ paddingTop: sbH + 'px', height: (108 + sbH) + 'px' }">
      <view class="lr-glow"></view>
      <view class="lr-arc lr-arc1"></view>
      <view class="lr-arc lr-arc2"></view>
      <view class="lr-nav">
        <image class="lr-back" :src="'/static/records/lr_back.png'" mode="aspectFit" @click="goBack"></image>
        <view class="lr-navtxt">
          <text class="lr-title">最近记录</text>
          <text class="lr-sub">查看过去的饮食记录与热量摄入</text>
        </view>
      </view>
    </view>

    <!-- 月历卡 -->
    <view class="lr-cal">
      <view class="lr-mrow">
        <image class="lr-mnav" :src="'/static/records/lr_prev.png'" mode="aspectFit" @click="prevMonth"></image>
        <text class="lr-mlabel">{{ monthLabel }}</text>
        <image class="lr-mnav" :src="'/static/records/lr_next.png'" mode="aspectFit" @click="nextMonth"></image>
      </view>
      <view class="lr-wrow">
        <text class="lr-wd" v-for="(wdItem, wdIdx) in weekNames" :key="wdIdx">{{ wdItem }}</text>
      </view>
      <view class="lr-drow" v-for="(rowItem, rowIdx) in calRows" :key="rowIdx">
        <view class="lr-cell" v-for="(cellItem, cellIdx) in rowItem" :key="cellIdx" @click="pickDay(cellItem)">
          <view class="lr-pill" :class="pillClass(cellItem)"></view>
          <text class="lr-daynum" :class="numClass(cellItem)">{{ cellItem.num }}</text>
          <view class="lr-dot" :class="dotClass(cellItem)"></view>
        </view>
      </view>
    </view>

    <!-- 选中日汇总卡 -->
    <view class="lr-sum">
      <view class="lr-sum-left">
        <text class="lr-sum-date">{{ selDateText }}</text>
        <text class="lr-sum-wd">{{ selWdText }}</text>
      </view>
      <view class="lr-sum-div"></view>
      <view class="lr-sum-mid">
        <image class="lr-flame" :src="'/static/profile/flame.png'" mode="aspectFit"></image>
        <view class="lr-sum-numrow">
          <text class="lr-sum-num">{{ selTotal }}</text>
          <text class="lr-sum-unit">kcal</text>
        </view>
        <text class="lr-sum-in">已摄入</text>
      </view>
      <view class="lr-sum-right">
        <view class="lr-overpill" v-if="selOver > 0">
          <text class="lr-overtxt">超标 {{ selOver }} kcal</text>
        </view>
        <text class="lr-goaltxt">目标 {{ goalVal }} kcal</text>
      </view>
      <view class="lr-bar-track">
        <view class="lr-bar-green" :style="{ width: barGreenW + 'px' }"></view>
        <view class="lr-bar-over" :style="{ width: barOverW + 'px' }" v-if="barOverW > 0"></view>
        <view class="lr-bar-tick" :style="{ left: barTickX + 'px' }"></view>
      </view>
    </view>

    <!-- 三餐摄入 -->
    <view class="lr-secrow">
      <view class="lr-acc"></view>
      <text class="lr-sec">三餐摄入</text>
      <view class="lr-sec-link" @click="goDetail">
        <text class="lr-link-txt">查看详情</text>
        <image class="lr-link-chev" :src="'/static/records/lr_chev.png'" mode="aspectFit"></image>
      </view>
    </view>
    <view class="lr-mcard-row">
      <view class="lr-mcard" v-for="(mItem, mIdx) in mealCards" :key="mIdx">
        <view class="lr-mcirc">
          <image class="lr-mic" :src="mItem.icon" mode="aspectFit"></image>
        </view>
        <text class="lr-mname">{{ mItem.name }}</text>
        <view class="lr-mkcal-row">
          <text class="lr-mkcal">{{ mItem.cal }}</text>
          <text class="lr-mkcal-u">kcal</text>
        </view>
        <view class="lr-mfoot-row">
          <text class="lr-mtime">{{ mItem.time }}</text>
          <text class="lr-mcount">{{ mItem.count }}项</text>
        </view>
      </view>
    </view>

    <!-- 主要食物 -->
    <view class="lr-secrow">
      <view class="lr-acc"></view>
      <text class="lr-sec">主要食物</text>
      <view class="lr-sec-link" @click="goDetail">
        <text class="lr-link-txt">查看全部</text>
        <image class="lr-link-chev" :src="'/static/records/lr_chev.png'" mode="aspectFit"></image>
      </view>
    </view>
    <view class="lr-fcard-row">
      <view class="lr-fcard" v-for="(fItem, fIdx) in foodCards" :key="fIdx">
        <image class="lr-fphoto" :src="fItem.img" mode="aspectFill"></image>
        <text class="lr-fname">{{ fItem.name }}</text>
        <text class="lr-fkcal">{{ fItem.kcal }} kcal</text>
      </view>
    </view>
    <view v-if="foodCards.length === 0" class="lr-empty">
      <text class="lr-empty-txt">这一天还没有记录</text>
    </view>

    <view class="lr-bottom-space"></view>
    <Tabbar active="home" :fade="tabFade" ></Tabbar>

    <!-- 常驻导航栏（#28：替代 P1 遮罩＋fx-back 两件套）：滚动跨阈后整栏出现＝末色底＋返回箭＋标题，三端生效 -->
    <view v-if="scrolled" class="rec-nav" :style="{ height: (sbH + 58) + 'px', paddingTop: sbH + 'px' }">
      <view class="rec-nav-back" @click="goBack">
        <image class="rec-nav-icon" :src="'/static/records/lr_back.png'" mode="aspectFit"></image>
      </view>
      <text class="rec-nav-title">最近记录</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onPageScroll } from '@dcloudio/uni-app'
import { useFoodStore, dayKeyOf, dayRange, MEAL_KEYS, MEAL_LABELS, FoodEntry } from '../../stores/food'
import { useGoalStore } from '../../stores/goal'
import Tabbar from '../../components/Tabbar.uvue'

/**
 * 最近记录（Pencil bTPUq 逐节点量取）。
 * 月历按周一起始 7 列 flex:1（列心 24.79+i*49.57 与稿面一致）；
 * 圆点/汇总/小卡全部由选中日 selKey 驱动，数据源＝food store 全量 entries。
 */

const food = useFoodStore()
const goal = useGoalStore()

const sbH = ref(0)
sbH.value = uni.getSystemInfoSync().statusBarHeight ?? 0

// 常驻导航栏两态（#28，三端生效；跨阈值才写 ref 避免逐帧 setData）：>40 整栏出现＝
// 头图渐变末色 #39AD95 实底＋返回箭＋标题，与滚动中的头图无缝接续
const scrolled = ref<boolean>(false)
// TabBar 渐显（scroll-fade，照官方示例「随滚动渐显的透明导航栏」）：0→60px 线性抬升，
// 按 0.05 量化＝整段渐显最多 20 次 setData，绝不逐帧写。
// 阈值取 60 而非示例的 100＝本页实测最大滚动只有 70px，用 100 会永远到不了满玻璃
const tabFade = ref<number>(0)
onPageScroll((e) => {
  const v = e.scrollTop > 40
  if (v !== scrolled.value) scrolled.value = v
  let q = e.scrollTop / 60
  if (q > 1) q = 1
  const fq = Math.round(q * 20) / 20
  if (fq !== tabFade.value) tabFade.value = fq
})

const weekNames = ['一', '二', '三', '四', '五', '六', '日']

const todayKey = dayKeyOf(Date.now())
const nowDate = new Date()
const viewYear = ref(nowDate.getFullYear())
const viewMonth = ref(nowDate.getMonth()) // 0-based
const selKey = ref(todayKey)

interface DayCell {
  key: string
  num: number
  inMonth: boolean
}

const monthLabel = computed<string>(() => {
  return viewYear.value + '年' + (viewMonth.value + 1) + '月'
})

function pad2(v: number): string {
  return v < 10 ? '0' + v.toString() : v.toString()
}

/** 6 行 × 7 列网格（末行整行为出月则裁掉，稿面 5 行为准） */
const calRows = computed<DayCell[][]>(() => {
  const y = viewYear.value
  const m = viewMonth.value
  const first = new Date(y, m, 1)
  const lead = (first.getDay() + 6) % 7 // 周一起始的前置天数
  const daysInMonth = new Date(y, m + 1, 0).getDate()
  const cells: DayCell[] = []
  for (let i = lead - 1; i >= 0; i--) {
    const d = new Date(y, m, 0 - i)
    cells.push({ key: dayKeyOf(d.getTime()), num: d.getDate(), inMonth: false })
  }
  for (let day = 1; day <= daysInMonth; day++) {
    cells.push({ key: y + '-' + pad2(m + 1) + '-' + pad2(day), num: day, inMonth: true })
  }
  let tail = 1
  while (cells.length < 42) {
    const d = new Date(y, m + 1, tail)
    cells.push({ key: dayKeyOf(d.getTime()), num: d.getDate(), inMonth: false })
    tail++
  }
  const rows: DayCell[][] = []
  for (let i = 0; i < cells.length; i += 7) {
    const row = cells.slice(i, i + 7)
    if (i >= 35 && row.every((c: DayCell): boolean => !c.inMonth)) break
    rows.push(row)
  }
  return rows
})

function pillClass(cell: DayCell): string {
  if (cell.key === selKey.value) return 'lr-pill-sel'
  if (cell.key === todayKey) return 'lr-pill-today'
  return ''
}
function numClass(cell: DayCell): string {
  if (cell.key === selKey.value) return 'lr-daynum-sel'
  if (cell.key === todayKey) return 'lr-daynum-today'
  if (!cell.inMonth) return 'lr-daynum-out'
  return ''
}
function dotClass(cell: DayCell): string {
  const t = food.dayTotals[cell.key] ?? 0
  if (cell.key === selKey.value) return t > 0 ? 'lr-dot-sel' : ''
  if (t <= 0) return ''
  if (t > goalVal.value) return 'lr-dot-over'
  return 'lr-dot-on'
}

function pickDay(cell: DayCell): void {
  selKey.value = cell.key
  const parts = cell.key.split('-')
  const cy = parseInt(parts[0])
  const cm = parseInt(parts[1]) - 1
  if (cy !== viewYear.value || cm !== viewMonth.value) {
    viewYear.value = cy
    viewMonth.value = cm
  }
  try { uni.vibrateShort() } catch (e) {}
}

function prevMonth(): void {
  if (viewMonth.value === 0) {
    viewMonth.value = 11
    viewYear.value = viewYear.value - 1
  } else {
    viewMonth.value = viewMonth.value - 1
  }
  try { uni.vibrateShort() } catch (e) {}
}

function nextMonth(): void {
  if (viewMonth.value === 11) {
    viewMonth.value = 0
    viewYear.value = viewYear.value + 1
  } else {
    viewMonth.value = viewMonth.value + 1
  }
  try { uni.vibrateShort() } catch (e) {}
}

/** 选中日全部记录（按时间升序） */
const selEntries = computed<FoodEntry[]>(() => {
  const range = dayRange(selKey.value)
  const list = food.entries.filter((e: FoodEntry): boolean => e.ts >= range[0] && e.ts < range[1])
  list.sort((a: FoodEntry, b: FoodEntry): number => a.ts - b.ts)
  return list
})

const goalVal = computed<number>(() => goal.calorieGoal)

const selTotal = computed<number>(() => {
  return selEntries.value.reduce((s: number, e: FoodEntry): number => s + e.kcal, 0)
})

const selOver = computed<number>(() => {
  const o = selTotal.value - goalVal.value
  return o > 0 ? o : 0
})

const selDateText = computed<string>(() => {
  const parts = selKey.value.split('-')
  return parseInt(parts[1]) + '月' + parseInt(parts[2]) + '日'
})

const selWdText = computed<string>(() => {
  const parts = selKey.value.split('-')
  const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]))
  return '周' + weekNames[(d.getDay() + 6) % 7]
})

/** 能量条：轨道 = max(总量, 目标) 满轨；白刻度钉在目标位 */
const barScale = computed<number>(() => {
  return selTotal.value > goalVal.value ? selTotal.value : goalVal.value
})
const barGreenW = computed<number>(() => {
  return Math.round(Math.min(selTotal.value, goalVal.value) / barScale.value * 315 * 10) / 10
})
const barOverW = computed<number>(() => {
  return Math.round(selOver.value / barScale.value * 315 * 10) / 10
})
const barTickX = computed<number>(() => {
  return Math.round(goalVal.value / barScale.value * 315) - 1
})

interface MealCard {
  icon: string
  name: string
  cal: number
  time: string
  count: number
}

const MEAL_ICONS: Record<string, string> = {
  breakfast: '/static/records/lr_meal_breakfast.png',
  lunch: '/static/records/lr_meal_lunch.png',
  dinner: '/static/records/lr_meal_dinner.png',
  snack: '/static/records/lr_meal_snack.png',
}

const mealCards = computed<MealCard[]>(() => {
  const out: MealCard[] = []
  for (const mk of MEAL_KEYS) {
    const entries = selEntries.value.filter((e: FoodEntry): boolean => e.meal === mk)
    let cal = 0
    for (const e of entries) cal += e.kcal
    let time = ''
    if (entries.length > 0) {
      const d = new Date(entries[0].ts)
      const hh = d.getHours() < 10 ? '0' + d.getHours().toString() : d.getHours().toString()
      const mm = d.getMinutes() < 10 ? '0' + d.getMinutes().toString() : d.getMinutes().toString()
      time = hh + ':' + mm
    }
    out.push({
      icon: MEAL_ICONS[mk] ?? '',
      name: MEAL_LABELS[mk] ?? mk,
      cal,
      time,
      count: entries.length,
    })
  }
  return out
})

interface FoodCard {
  img: string
  name: string
  kcal: number
}

/** 主要食物 = 选中日按热量降序前 4 条（同名合并展示留待真机复核） */
const foodCards = computed<FoodCard[]>(() => {
  const sorted = selEntries.value.slice()
  sorted.sort((a: FoodEntry, b: FoodEntry): number => b.kcal - a.kcal)
  const out: FoodCard[] = []
  for (let i = 0; i < sorted.length && out.length < 4; i++) {
    const e = sorted[i]
    out.push({
      img: e.img != null && e.img !== '' ? '/static/icons/' + e.img : '',
      name: e.name,
      kcal: e.kcal,
    })
  }
  return out
})

function goBack(): void {
  uni.navigateBack()
}

function goDetail(): void {
  food.viewDay = selKey.value
  uni.navigateTo({ url: '/pages/records/DayDetail' })
}
</script>

<style>
.page {
  background-color: #F2FAF5;
  min-height: 100%;
}

/* ===== Header（稿面 375×152，含状态栏；CalCard 上叠 34） ===== */
.lr-header {
  background-image: linear-gradient(180deg, #5CC4AC, #39AD95);
  overflow: visible;
}
.lr-glow {
  position: absolute;
  left: 180px;
  top: -60px;
  width: 260px;
  height: 200px;
  border-radius: 130px;
  background-color: rgba(255, 255, 255, 0.16);
}
.lr-arc {
  position: absolute;
  border-radius: 500px;
}
.lr-arc1 {
  left: -70px;
  top: 40px;
  width: 220px;
  height: 220px;
  background-color: rgba(255, 255, 255, 0.08);
}
.lr-arc2 {
  right: -90px;
  top: 60px;
  width: 260px;
  height: 260px;
  background-color: rgba(255, 255, 255, 0.06);
}
.lr-nav {
  flex-direction: row;
  align-items: flex-start;
  height: 46px;
  padding-left: 16px;
}
.lr-back {
  width: 18px;
  height: 18px;
  margin-top: 6px;
}
.lr-navtxt {
  margin-left: 12px;
}
.lr-title {
  font-size: 18px;
  font-weight: bold;
  color: #FFFFFF;
  height: 26px;
  line-height: 26px;
}
.lr-sub {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.8);
  height: 16px;
  line-height: 16px;
  margin-top: 2px;
}

/* ===== 月历卡 347×292 r18，上叠 header 34 ===== */
.lr-cal {
  margin: -34px 14px 0 14px;
  background-color: #FFFFFF;
  border-radius: 18px;
  padding: 13px 0 19px 0;
  flex-shrink: 0;
  overflow: visible;
  box-shadow: 0 4px 16px rgba(10, 79, 61, 0.06);
}
.lr-mrow {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 20px;
  padding: 0 12px 0 12px;
}
.lr-mnav {
  width: 16px;
  height: 16px;
}
.lr-mlabel {
  font-size: 14px;
  font-weight: bold;
  color: #0A4F3D;
}
.lr-wrow {
  flex-direction: row;
  margin-top: 14px;
}
.lr-wd {
  flex: 1;
  text-align: center;
  font-size: 11px;
  font-weight: 500;
  color: rgba(15, 79, 61, 0.34);
}
.lr-drow {
  flex-direction: row;
  margin-top: 17px;
  overflow: visible;
}
.lr-cell {
  flex: 1;
  height: 42px;
  align-items: center;
  overflow: visible;
}
.lr-pill {
  position: absolute;
  top: -9px;
  left: 0;
  right: 0;
  margin-left: auto;
  margin-right: auto;
  width: 34px;
  height: 36px;
  border-radius: 11px;
}
.lr-pill-sel {
  background-image: linear-gradient(180deg, #45C4A2, #0A7A5C);
}
.lr-pill-today {
  background-color: #EAF9F3;
}
.lr-daynum {
  font-size: 12.5px;
  font-weight: 600;
  color: #0F5B44;
  z-index: 1;
}
.lr-daynum-sel {
  color: #FFFFFF;
  font-weight: 700;
}
.lr-daynum-today {
  color: #0A7A5C;
  font-weight: 700;
}
.lr-daynum-out {
  color: #C6D6CE;
}
.lr-dot {
  width: 4px;
  height: 4px;
  border-radius: 2px;
  margin-top: 3px;
  z-index: 1;
  background-color: transparent;
}
.lr-dot-on {
  background-color: #1FBF8F;
}
.lr-dot-over {
  background-color: #FB5D37;
}
.lr-dot-sel {
  background-color: #FFFFFF;
}

