<template>
  <view class="page" :style="{ backgroundColor: theme.bg }">
    <!-- [变更日志] 2026-09-28: 月历翻页加上下界（老板拍板）——左不过「最远一次有记录的那天」所在月，
         右不过今天所在月；到界时箭头换灰色 SVG 且点击无效；本月内的未来日一并置灰不可选。
         原实现零边界，且点跨月的灰色未来格会连视图一起跳到下个月。 -->
    <!-- [变更日志] 2026-09-25: 「主要食物」卡片接入百科页入口（携 foodId 跳 pages/encyclopedia/Detail） -->
    <!-- [变更日志] 2026-09-27: 渐变第三档 accentDeep→accentMid（消除发黑）；
         .lr-fcard-row 由 space-between 改 flex-start + 固定 18rpx 间距（2 张卡时不再两端顶死） -->
    <scroll-view class="lr-scroll" direction="vertical" :show-scrollbar="false" @scroll="onScroll">
      <!-- Header（纯净自然的高级绿色平滑渐变） -->
      <view class="lr-header" :style="headerStyle">
        <!-- 状态栏独立占位层，杜绝跨端 calc(rpx+px) 塌陷 -->
        <view :style="{ height: sbH + 'px' }"></view>
        <view class="lr-nav">
          <view class="lr-navtxt">
            <text class="lr-title" :style="{ color: headerTitleColor }">{{ t('rec.title') }}</text>
            <text class="lr-sub" :style="{ color: headerSubColor }">{{ t('rec.sub') }}</text>
          </view>
        </view>
      </view>

      <!-- 月历卡 -->
      <view class="lr-cal" :style="{ backgroundColor: theme.card }">
      <view class="lr-mrow">
        <view class="lr-mnav-hot" @click="prevMonth">
          <image class="lr-mnav" :src="prevIcon" mode="aspectFit"></image>
        </view>
        <text class="lr-mlabel" :style="{ color: theme.ink1 }">{{ monthLabel }}</text>
        <view class="lr-mnav-hot" @click="nextMonth">
          <image class="lr-mnav" :src="nextIcon" mode="aspectFit"></image>
        </view>
      </view>
      <view class="lr-wrow">
        <text class="lr-wd" :style="{ color: theme.ink3 }" v-for="(wdItem, wdIdx) in weekNames" :key="wdIdx">{{ wdItem }}</text>
      </view>
      <view class="lr-drow" v-for="(rowItem, rowIdx) in calRows" :key="rowIdx">
        <view class="lr-cell" v-for="(cellItem, cellIdx) in rowItem" :key="cellIdx" @click="pickDay(cellItem)">
          <view class="lr-pill" :style="pillStyle(cellItem)"></view>
          <text class="lr-daynum" :class="numClass(cellItem)" :style="numStyle(cellItem)">{{ cellItem.num }}</text>
          <view class="lr-dot" :class="dotClass(cellItem)" :style="dotStyle(cellItem)"></view>
        </view>
      </view>
    </view>

    <!-- 选中日汇总卡 -->
    <view class="lr-sum" :style="{ backgroundColor: theme.card }">
      <view class="lr-sum-left">
        <text class="lr-sum-date" :style="{ color: theme.ink1 }">{{ selDateText }}</text>
        <text class="lr-sum-wd" :style="{ color: theme.ink3 }">{{ selWdText }}</text>
      </view>
      <view class="lr-sum-div" :style="{ backgroundColor: theme.line }"></view>
      <view class="lr-sum-mid">
        <image class="lr-flame" :src="'/static/profile/flame.svg'" mode="aspectFit"></image>
        <view class="lr-sum-numrow">
          <text class="lr-sum-num" :style="{ color: statusTextColor }">{{ selTotal }}</text>
          <text class="lr-sum-unit" :style="{ color: statusUnitColor }">kcal</text>
        </view>
        <text class="lr-sum-in" :style="{ color: theme.ink3 }">{{ t('rec.in') }}</text>
      </view>
      <view class="lr-sum-right">
        <view class="lr-overpill" v-if="selOver > 0" :style="{ backgroundColor: overpillFill }">
          <text class="lr-overtxt" :style="{ color: overTextColor }">{{ tf('rec.over', [selOver.toString()]) }}</text>
        </view>
        <text class="lr-goaltxt" :style="{ color: theme.ink2 }">{{ tf('rec.goal', [goalVal.toString()]) }}</text>
      </view>
      <view class="lr-bar-track" :style="{ backgroundColor: theme.line }">
        <view class="lr-bar-green" :style="barGreenStyle"></view>
        <view class="lr-bar-over" :style="{ width: barOverW + 'rpx' }" v-if="barOverW > 0"></view>
        <view class="lr-bar-tick" :style="{ left: barTickX + 'rpx', backgroundColor: theme.bg }"></view>
      </view>
    </view>

    <!-- 三餐摄入 -->
    <view class="lr-secrow">
      <view class="lr-acc" :style="{ backgroundColor: theme.accent }"></view>
      <text class="lr-sec" :style="{ color: theme.ink1 }">{{ t('rec.meals') }}</text>
      <view class="lr-sec-link" @click="goDetail">
        <text class="lr-link-txt" :style="{ color: theme.ink3 }">{{ t('rec.detail') }}</text>
        <image class="lr-link-chev" :src="asset('records/lr_chev.svg')" mode="aspectFit"></image>
      </view>
    </view>
    <view class="lr-mcard-row">
      <view class="lr-mcard" v-for="(mItem, mIdx) in mealCards" :key="mIdx" :style="{ backgroundColor: theme.card }">
        <view class="lr-mcirc" :style="{ backgroundColor: theme.chip }">
          <image class="lr-mic" :src="mItem.icon" mode="aspectFit"></image>
        </view>
        <text class="lr-mname" :style="{ color: theme.ink1 }">{{ mItem.name }}</text>
        <view class="lr-mkcal-row">
          <text class="lr-mkcal" :style="{ color: theme.ink1 }">{{ mItem.cal }}</text>
          <text class="lr-mkcal-u" :style="{ color: theme.ink2 }">kcal</text>
        </view>
        <view class="lr-mfoot-row">
          <text class="lr-mtime" :style="{ color: theme.ink3 }">{{ mItem.time }}</text>
          <text class="lr-mcount" :style="{ color: theme.ink3 }">{{ tf('rec.itemN', [mItem.count.toString()]) }}</text>
        </view>
      </view>
    </view>

    <!-- 主要食物 -->
    <view class="lr-secrow">
      <view class="lr-acc" :style="{ backgroundColor: theme.accent }"></view>
      <text class="lr-sec" :style="{ color: theme.ink1 }">{{ t('rec.mains') }}</text>
      <view class="lr-sec-link" @click="goDetail">
        <text class="lr-link-txt" :style="{ color: theme.ink3 }">{{ t('rec.all') }}</text>
        <image class="lr-link-chev" :src="asset('records/lr_chev.svg')" mode="aspectFit"></image>
      </view>
    </view>
    <view class="lr-fcard-row">
      <view class="lr-fcard" v-for="(fItem, fIdx) in foodCards" :key="fIdx" :style="{ backgroundColor: theme.card }" @click="openEncyclopedia(fItem.img)">
        <image class="lr-fphoto" :src="fItem.img" mode="aspectFill"></image>
        <text class="lr-fname" :style="{ color: theme.ink1 }">{{ fItem.name }}</text>
        <text class="lr-fkcal" :style="{ color: theme.ink2 }">{{ fItem.kcal }} kcal</text>
      </view>
    </view>
    <view v-if="foodCards.length === 0" class="lr-empty">
      <text class="lr-empty-txt" :style="{ color: theme.ink3 }">{{ t('rec.empty') }}</text>
    </view>

    <view class="lr-bottom-space"></view>
    </scroll-view>

    <Tabbar active="records" ></Tabbar>

    <!-- 常驻导航栏（#28）：本页已升为一级 Tab 页，跨阈出栏只留标题，无返回钮（Boss 拍板第 4 条） -->
    <view v-if="scrolled" class="rec-nav" :style="navBarStyle">
      <text class="rec-nav-title" :style="{ color: navBarTitleColor }">{{ t('rec.title') }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { t, tf } from '../../composables/i18n'
import { onPageScroll, onShow } from '@dcloudio/uni-app'
import { useFoodStore, dayKeyOf, dayRange, MEAL_KEYS, MEAL_LABELS, FoodEntry } from '../../stores/food'
import { useGoalStore, getCalorieStatus } from '../../stores/goal'
import { foodIdFromImg } from '../../stores/encyclopedia'
import { triggerHaptic } from '../../stores/settings'
import { useTheme, themeAsset, FIXED_COLORS, syncStatusBarStyle } from '../../composables/useTheme'
import Tabbar from '../../components/Tabbar.uvue'

/**
 * 最近记录（Pencil bTPUq 逐节点量取）。
 * 月历按周一起始 7 列 flex:1（列心 24.79+i*49.57 与稿面一致）；
 * 圆点/汇总/小卡全部由选中日 selKey 驱动，数据源＝food store 全量 entries。
 */

const food = useFoodStore()
const goal = useGoalStore()

const sbH = ref<number>(uni.getSystemInfoSync().statusBarHeight ?? 0)

// 常驻导航栏高度计算：58px (116rpx) 内容高 + 状态栏高，避免跨端 calc(rpx+px) 错误
const navBarH = computed<number>(() => sbH.value + 58)

// 常驻导航栏两态（#28，三端生效；跨阈值才写 ref 避免逐帧 setData）：>40 整栏出现＝
// 头图渐变末色 #39AD95 实底＋标题，与滚动中的头图无缝接续
const scrolled = ref<boolean>(false)

function onScroll(e: any): void {
  const top = (e.detail != null && e.detail.scrollTop != null) ? (e.detail.scrollTop as number) : 0
  const v = top > 40
  if (v !== scrolled.value) scrolled.value = v
}

// 页面级滚动备用兼容
onPageScroll((e) => {
  const v = e.scrollTop > 40
  if (v !== scrolled.value) scrolled.value = v
})

const weekNames = computed<string[]>((): string[] => [t('pf.w1'), t('pf.w2'), t('pf.w3'), t('pf.w4'), t('pf.w5'), t('pf.w6'), t('pf.w0')])

const todayKey = dayKeyOf(Date.now())
const nowDate = new Date()
const viewYear = ref(nowDate.getFullYear())
const viewMonth = ref(nowDate.getMonth()) // 0-based
const selKey = ref(todayKey)

interface DayCell {
  key: string
  num: number
  inMonth: boolean
}

const monthLabel = computed<string>(() => {
  return tf('rec.year', [viewYear.value.toString(), (viewMonth.value + 1).toString()])
})

function pad2(v: number): string {
  return v < 10 ? '0' + v.toString() : v.toString()
}

/** 6 行 × 7 列网格（末行整行为出月则裁掉，稿面 5 行为准） */
const calRows = computed<DayCell[][]>(() => {
  const y = viewYear.value
  const m = viewMonth.value
  const first = new Date(y, m, 1)
  const lead = (first.getDay() + 6) % 7 // 周一起始的前置天数
  const daysInMonth = new Date(y, m + 1, 0).getDate()
  const cells: DayCell[] = []
  for (let i = lead - 1; i >= 0; i--) {
    const d = new Date(y, m, 0 - i)
    cells.push({ key: dayKeyOf(d.getTime()), num: d.getDate(), inMonth: false })
  }
  for (let day = 1; day <= daysInMonth; day++) {
    cells.push({ key: y + '-' + pad2(m + 1) + '-' + pad2(day), num: day, inMonth: true })
  }
  let tail = 1
  while (cells.length < 42) {
    const d = new Date(y, m + 1, tail)
    cells.push({ key: dayKeyOf(d.getTime()), num: d.getDate(), inMonth: false })
    tail++
  }
  const rows: DayCell[][] = []
  for (let i = 0; i < cells.length; i += 7) {
    const row = cells.slice(i, i + 7)
    if (i >= 35 && row.every((c: DayCell): boolean => !c.inMonth)) break
    rows.push(row)
  }
  return rows
})

function numClass(cell: DayCell): string {
  if (cell.key === selKey.value) return 'lr-daynum-sel'
  if (cell.key === todayKey) return 'lr-daynum-today'
  return ''
}
/** 超标圆点用全局危险色（class），常规与选中态跟主题（style） */
function dotClass(cell: DayCell): string {
  if (cell.key === selKey.value) return ''
  if ((food.dayTotals[cell.key] ?? 0) > goalVal.value) return 'lr-dot-over'
  return ''
}

function pickDay(cell: DayCell): void {
  // 未来日不可选（含跨月的灰色未来格）：原实现会把视图一起跳到下个月
  if (cell.key > todayKey) return
  selKey.value = cell.key
  const parts = cell.key.split('-')
  const cy = parseInt(parts[0])
  const cm = parseInt(parts[1]) - 1
  if (cy !== viewYear.value || cm !== viewMonth.value) {
    viewYear.value = cy
    viewMonth.value = cm
  }
}

/** 上一页：到界（视图月＝最远有记录月）时不可点 */
function prevMonth(): void {
  if (!canPrev.value) return
  if (viewMonth.value === 0) {
    viewMonth.value = 11
    viewYear.value = viewYear.value - 1
  } else {
    viewMonth.value = viewMonth.value - 1
  }
}

/** 下一页：到界（视图月＝今天所在月）时不可点，不支持翻到未来月 */
function nextMonth(): void {
  if (!canNext.value) return
  if (viewMonth.value === 11) {
    viewMonth.value = 0
    viewYear.value = viewYear.value + 1
  } else {
    viewMonth.value = viewMonth.value + 1
  }
}

/** 选中日全部记录（按时间升序） */
const selEntries = computed<FoodEntry[]>(() => {
  const range = dayRange(selKey.value)
  const list = food.entries.filter((e: FoodEntry): boolean => e.ts >= range[0] && e.ts < range[1])
  list.sort((a: FoodEntry, b: FoodEntry): number => a.ts - b.ts)
  return list
})

const goalVal = computed<number>(() => goal.calorieGoal)

const selTotal = computed<number>(() => {
  return selEntries.value.reduce((s: number, e: FoodEntry): number => s + e.kcal, 0)
})

const selOver = computed<number>(() => {
  const o = selTotal.value - goalVal.value
  return o > 0 ? o : 0
})
const selStatus = computed(() => getCalorieStatus(selTotal.value, goalVal.value))

const { theme, isDark, accentId } = useTheme()

// 状态栏字色按当前主题同步：原生端 pages.json 的静态项只覆盖亮态，切页/切主题都要重下
onShow(() => {
  syncStatusBarStyle(isDark.value)
})

/** 资产按 (accent, mode) 取五档变体；未登记底稿（语义色／无彩稿）自动回落原路径 */
function asset(path: string): string {
  return themeAsset(accentId.value, isDark.value, '/static/' + path)
}

/* ===== 翻页上下界（2026-09-28 老板拍板） ===== */

/** 年月序号（y*12+m，m 0-based）：边界只比大小，不做 Date 运算 */
function ymOf(y: number, m: number): number {
  return y * 12 + m
}

/** 今天所在年月＝右边界 */
const todayYM = ymOf(nowDate.getFullYear(), nowDate.getMonth())

/** 当前视图年月 */
const viewYM = computed<number>((): number => ymOf(viewYear.value, viewMonth.value))

/**
 * 左边界＝「最远一次有记录的那天」所在年月。
 * 取 food.entries 的最小 ts（不按 dayTotals 取键：那要 Object.keys，uvue 的 uts 侧没先例；
 * 遍历取 min 是纯算术，三端零风险）。全库无记录时回落今天 → 左右同时到界，符合「没历史可翻」。
 */
const firstDataYM = computed<number>((): number => {
  let minTs = 0
  for (const e of food.entries) {
    if (minTs === 0 || e.ts < minTs) minTs = e.ts
  }
  if (minTs === 0) return todayYM
  const d = new Date(minTs)
  return ymOf(d.getFullYear(), d.getMonth())
})

const canPrev = computed<boolean>((): boolean => viewYM.value > firstDataYM.value)
const canNext = computed<boolean>((): boolean => viewYM.value < todayYM)

/**
 * 翻页箭头：可翻＝主题色箭头（走 asset 五档变体）；到界＝固定灰。
 * 禁用属「状态色」，不随主题轮值（同 .lr-dot-over 的 #FB5D37 口径），
 * 故**不登记进 THEMEABLE_ASSETS**，直接按亮暗二选一取灰箭头。
 */
const prevIcon = computed<string>((): string => {
  if (canPrev.value) return asset('records/lr_prev.svg')
  return '/static/records/lr_prev_off' + (isDark.value ? '_dark' : '') + '.svg'
})
const nextIcon = computed<string>((): string => {
  if (canNext.value) return asset('records/lr_next.svg')
  return '/static/records/lr_next_off' + (isDark.value ? '_dark' : '') + '.svg'
})

/** 品牌渐变头：浅态走该档 accent 三档渐变，暗态改 card 纯色（同 Settings 页既定处理） */
const headerStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  if (isDark.value) {
    st['background-color'] = theme.value.card
  } else {
    st['background-color'] = theme.value.accent
    st['background-image'] = 'linear-gradient(' + theme.value.accent2 + ' 0%, ' + theme.value.accent + ' 60%, ' + theme.value.accentMid + ' 100%)'
  }
  return st
})
const headerTitleColor = computed((): string => isDark.value ? theme.value.ink1 : theme.value.onAccent)
const headerSubColor = computed((): string => isDark.value ? theme.value.ink2 : 'rgba(255, 255, 255, 0.85)')

/** 常驻导航栏＝滚动后与头图末色无缝接续的实底栏，几何与配色一并运行时下发 */
const navBarStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['height'] = navBarH.value + 'px'
  st['padding-top'] = sbH.value + 'px'
  st['background-color'] = isDark.value ? theme.value.card : theme.value.accent
  if (!isDark.value) st['box-shadow'] = '0 4rpx 20rpx rgba(10, 79, 61, 0.10)'
  return st
})
const navBarTitleColor = computed((): string => isDark.value ? theme.value.ink1 : theme.value.onAccent)

/** 绿档文字跟主题 ink 轴；接近上限／超标落全局语义色（§8.3 状态色不随主题轮值） */
const statusTextColor = computed((): string => {
  if (selStatus.value.type == 'green') return theme.value.ink1
  return selStatus.value.color
})
const statusUnitColor = computed((): string => selStatus.value.type == 'green' ? theme.value.ink2 : statusTextColor.value)

const barGreenStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['width'] = barGreenW.value + 'rpx'
  if (selStatus.value.type == 'green') {
    st['background-color'] = theme.value.accent
    st['background-image'] = 'linear-gradient(to right, ' + theme.value.accent2 + ', ' + theme.value.accent + ')'
  } else {
    st['background-color'] = selStatus.value.color
  }
  return st
})

/** 超标胶囊＝珊瑚语义色浅底，暗态改同色低透明度以免整块刺眼 */
const overpillFill = computed((): string => isDark.value ? 'rgba(255, 158, 125, 0.18)' : 'rgba(255, 158, 125, 0.25)')
const overTextColor = computed((): string => isDark.value ? FIXED_COLORS.statusCoral : '#FA543A')

function pillStyle(cell: DayCell): Record<string, string> {
  const st = {} as Record<string, string>
  if (cell.key === selKey.value) {
    st['background-color'] = theme.value.accentDeep
    st['background-image'] = 'linear-gradient(' + theme.value.accent2 + ', ' + theme.value.accentMid + ')'
  } else if (cell.key === todayKey) {
    st['background-color'] = theme.value.chip
  }
  return st
}

function numStyle(cell: DayCell): Record<string, string> {
  const st = {} as Record<string, string>
  if (cell.key === selKey.value) {
    st['color'] = theme.value.onAccent
  } else if (cell.key === todayKey) {
    st['color'] = theme.value.accent
  } else if (cell.key > todayKey) {
    // 未来日：与跨月格同一档灰（不可选，见 pickDay）
    st['color'] = theme.value.sysIndicator
  } else if (!cell.inMonth) {
    st['color'] = theme.value.sysIndicator
  } else {
    st['color'] = theme.value.ink1
  }
  return st
}

/** 超标圆点保留全局危险色（由 .lr-dot-over 承担），其余两态跟主题 */
function dotStyle(cell: DayCell): Record<string, string> {
  const st = {} as Record<string, string>
  const total = food.dayTotals[cell.key] ?? 0
  if (cell.key === selKey.value) {
    if (total > 0) st['background-color'] = theme.value.onAccent
  } else if (total > 0 && total <= goalVal.value) {
    st['background-color'] = theme.value.accent
  }
  return st
}

/** 319px 宽，最大跨度 2x goal */
const selDateText = computed<string>(() => {
  const parts = selKey.value.split('-')
  return tf('rec.md', [parts[1], parts[2]])
})

const selWdText = computed<string>(() => {
  const parts = selKey.value.split('-')
  const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]))
  const idx = (d.getDay() + 6) % 7
  return idx == 6 ? t('pf.d0') : t('pf.d' + (idx + 1).toString())
})

/** 能量条：轨道 = max(总量, 目标) 满轨；白刻度钉在目标位 */
const barScale = computed<number>(() => {
  return selTotal.value > goalVal.value ? selTotal.value : goalVal.value
})
const barGreenW = computed<number>(() => {
  return Math.round(Math.min(selTotal.value, goalVal.value) / barScale.value * 630 * 10) / 10
})
const barOverW = computed<number>(() => {
  return Math.round(selOver.value / barScale.value * 630 * 10) / 10
})
const barTickX = computed<number>(() => {
  return Math.round(goalVal.value / barScale.value * 630) - 1
})

interface MealCard {
  icon: string
  name: string
  cal: number
  time: string
  count: number
}

const MEAL_ICONS: Record<string, string> = {
  breakfast: 'records/lr_meal_breakfast.svg',
  lunch: 'records/lr_meal_lunch.svg',
  dinner: 'records/lr_meal_dinner.svg',
  snack: 'records/lr_meal_snack.svg',
}

const mealCards = computed<MealCard[]>(() => {
  const out: MealCard[] = []
  for (const mk of MEAL_KEYS) {
    const entries = selEntries.value.filter((e: FoodEntry): boolean => e.meal === mk)
    let cal = 0
    for (const e of entries) cal += e.kcal
    let time = ''
    if (entries.length > 0) {
      const d = new Date(entries[0].ts)
      const hh = d.getHours() < 10 ? '0' + d.getHours().toString() : d.getHours().toString()
      const mm = d.getMinutes() < 10 ? '0' + d.getMinutes().toString() : d.getMinutes().toString()
      time = hh + ':' + mm
    }
    out.push({
      icon: asset(MEAL_ICONS[mk] ?? ''),
      name: t('meal.' + mk),
      cal,
      time,
      count: entries.length,
    })
  }
  return out
})

interface FoodCard {
  img: string
  name: string
  kcal: number
}

/** 主要食物 = 选中日按热量降序前 4 条（同名合并展示留待真机复核） */
const foodCards = computed<FoodCard[]>(() => {
  const sorted = selEntries.value.slice()
  sorted.sort((a: FoodEntry, b: FoodEntry): number => b.kcal - a.kcal)
  const out: FoodCard[] = []
  for (let i = 0; i < sorted.length && out.length < 4; i++) {
    const e = sorted[i]
    out.push({
      img: e.img != null && e.img !== '' ? '/static/icons/' + e.img : '',
      name: e.name,
      kcal: e.kcal,
    })
  }
  return out
})

function goDetail(): void {
  food.viewDay = selKey.value
  uni.navigateTo({ url: '/pages/records/DayDetail' })
}

/** 百科入口：主要食物卡片图解析 foodId 跳详情页 */
function openEncyclopedia(img: string): void {
  const fid = foodIdFromImg(img)
  if (fid.length == 0) return
  triggerHaptic('light')
  uni.navigateTo({ url: '/pages/encyclopedia/Detail?id=' + fid })
}
</script>

