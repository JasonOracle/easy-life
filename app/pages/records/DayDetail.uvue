}
.dd-stat {
  margin: 12px 10px 0 10px;
  height: 76px;
  border-radius: 11px;
  background-color: #F2F8F9;
  padding: 7px 12px 0 12px;
}
.dd-stat-title {
  font-size: 9.5px;
  font-weight: 700;
  color: #0A7A5C;
}
.dd-stat-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 8px;
}
.dd-stat-col {
  flex-direction: row;
  align-items: center;
}
.dd-mg {
  width: 20px;
  height: 20px;
  margin-right: 6px;
}
.dd-stat-txt {
  align-items: flex-start;
}
.dd-stat-num {
  font-size: 17.5px;
  font-weight: 700;
  color: #082731;
}
.dd-stat-lbl {
  font-size: 8.6px;
  font-weight: bold;
  color: #5A7380;
  margin-top: 1px;
}
.dd-stat-div {
  width: 1px;
  height: 36px;
