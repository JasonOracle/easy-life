    大数字/进度环 conic/能量条/营养分布三列〕+ 餐次记录四卡（记录行长按 → uni.showActionSheet 删除，
    Boss 拍板交互）+ 今日饮食总结条）；查看日＝food.viewDay（Records 跳转前写入）；
    「添加食物」复用 FoodPicker→AddFood→SettleBadge 链路。]
-->
<template>
  <view class="page">
    <!-- Header（稿面 P1xTZv 375×152 渐变；Card 上叠 56） -->
    <view class="dd-header" :style="{ paddingTop: sbH + 'px', height: (108 + sbH) + 'px' }">
      <view class="dd-nav">
        <image class="dd-back" :src="'/static/records/lr_back.png'" mode="aspectFit" @click="goBack"></image>
        <text class="dd-title">{{ headerTitle }}</text>
      </view>
    </view>

    <!-- 今日热量卡 -->
    <view class="dd-card">
      <view class="dd-card-head">
        <image class="dd-flame" :src="'/static/profile/flame.png'" mode="aspectFit"></image>
        <text class="dd-card-title">今日热量</text>
        <view class="dd-overpill" v-if="dayOver > 0">
          <text class="dd-overtxt">超标 {{ dayOver }} kcal</text>
        </view>
      </view>
      <view class="dd-ring" :style="ringStyle">
        <view class="dd-ring-hole"></view>
        <text class="dd-ring-pct">{{ ringPct }}%</text>
        <text class="dd-ring-label">已摄入</text>
      </view>
      <view class="dd-bignum-row">
        <text class="dd-bignum" :class="calStatus.textClass">{{ dayTotal }}</text>
        <text class="dd-bigunit" :class="calStatus.textClass">kcal</text>
      </view>
      <view class="dd-track">
        <view class="dd-fill" :class="calStatus.bgClass" :style="{ width: fillW + 'px' }"></view>
      </view>
      <view class="dd-prog-foot">
        <view class="dd-prog-left">
          <text class="dd-plabel">已摄入</text>
          <text class="dd-pnum">{{ dayTotal }}</text>
          <text class="dd-punit">kcal</text>
        </view>
        <view class="dd-prog-right">
          <text class="dd-plabel">目标</text>
          <text class="dd-pnum">{{ goalVal }}</text>
          <text class="dd-punit">kcal</text>
        </view>
      </view>
      <view class="dd-stat">
        <text class="dd-stat-title">营养分布</text>
        <view class="dd-stat-row">
          <view class="dd-stat-col">
            <image class="dd-mg" :src="'/static/home/macro_protein.svg'" mode="aspectFit"></image>
            <view class="dd-stat-txt">
              <text class="dd-stat-num">{{ dayProtein }}g</text>
              <text class="dd-stat-lbl">蛋白质</text>
            </view>
          </view>
          <view class="dd-stat-div"></view>
          <view class="dd-stat-col">
            <image class="dd-mg" :src="'/static/home/macro_carb.svg'" mode="aspectFit"></image>
            <view class="dd-stat-txt">
              <text class="dd-stat-num">{{ dayCarb }}g</text>
              <text class="dd-stat-lbl">碳水</text>
            </view>
          </view>
          <view class="dd-stat-div"></view>
          <view class="dd-stat-col">
            <image class="dd-mg" :src="'/static/home/macro_fat.svg'" mode="aspectFit"></image>
            <view class="dd-stat-txt">
              <text class="dd-stat-num">{{ dayFat }}g</text>
              <text class="dd-stat-lbl">脂肪</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 餐次记录 -->
    <view class="dd-secrow">
      <view class="dd-acc"></view>
      <text class="dd-sec">餐次记录</text>
      <view class="dd-add" @click="openPicker">
        <image class="dd-add-ic" :src="'/static/records/dd_add.png'" mode="aspectFit"></image>
        <text class="dd-add-txt">添加食物</text>
      </view>
    </view>
    <view class="dd-meal" v-for="(mealItem, mealIdx) in mealGroups" :key="mealIdx">
      <view class="dd-meal-head">
        <view class="dd-meal-circ">
          <image class="dd-meal-ic" :src="mealItem.icon" mode="aspectFit"></image>
        </view>
        <text class="dd-meal-name">{{ mealItem.name }}</text>
        <text class="dd-meal-time">{{ mealItem.time }}</text>
        <view class="dd-meal-cal">
          <text class="dd-meal-num">{{ mealItem.cal }}</text>
          <text class="dd-meal-unit">kcal</text>
        </view>
      </view>
      <view
        class="dd-row"
        v-for="(rowItem, rowIdx) in mealItem.rows"
        :key="rowIdx"
        @longpress="confirmDelete(rowItem)"
      >
        <image class="dd-row-ph" :src="rowItem.img" mode="aspectFill"></image>
        <text class="dd-row-name">{{ rowItem.name }}</text>
        <text class="dd-row-portion">{{ rowItem.portion }}</text>
        <text class="dd-row-kcal">{{ rowItem.kcal }} kcal</text>
      </view>
    </view>

    <!-- 今日饮食总结 -->
    <view class="dd-band">
      <view class="dd-band-circ">
        <image class="dd-band-ic" :src="'/static/records/dd_sum.png'" mode="aspectFit"></image>
      </view>
      <view class="dd-band-txt">
        <text class="dd-band-title">今日饮食总结</text>
        <text class="dd-band-sub">继续保持，明天会更好！</text>
      </view>
    </view>

    <view class="dd-bottom-space"></view>

    <FoodPicker v-model:show="pickerShow" @confirm="onAddConfirm" ></FoodPicker>
    <SettleBadge v-model:show="settleShow" :kcal="settleKcal" :after="settleAfter" :goal="goal.calorieGoal" :meal="settleMeal" ></SettleBadge>

    <!-- 常驻导航栏（#28：替代 P1 遮罩＋fx-back 两件套）：滚动跨阈后整栏出现＝末色底＋返回箭＋日期标题，三端生效 -->
    <view v-if="scrolled" class="dd-nav-fixed" :style="{ height: (sbH + 58) + 'px', paddingTop: sbH + 'px' }">
      <view class="dd-nav-back" @click="goBack">
        <image class="dd-nav-icon" :src="'/static/records/lr_back.png'" mode="aspectFit"></image>
      </view>
      <text class="dd-nav-title">{{ headerTitle }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onPageScroll } from '@dcloudio/uni-app'
import { useFoodStore, dayKeyOf, dayRange, amountText, getFoodById, computeEntry, MEAL_KEYS, MEAL_LABELS } from '../../stores/food'
import type { FoodEntry } from '../../stores/food'
import { useGoalStore, getCalorieStatus } from '../../stores/goal'
import FoodPicker from '../../components/FoodPicker.uvue'
import type { AddPayload } from '../../components/FoodPicker.uvue'
import SettleBadge from '../../components/SettleBadge.uvue'

/**
 * 单日详情（Pencil VEWYt 逐节点量取）。
 * 查看日＝food.viewDay（Records 跳转前写入，空则今日）；
 * 记录行长按 → uni.showActionSheet「删除这条记录」→ removeEntry（Boss 拍板）。
 */

const food = useFoodStore()
const goal = useGoalStore()

const sbH = ref(0)
sbH.value = uni.getSystemInfoSync().statusBarHeight ?? 0

// 常驻导航栏两态（#28，三端生效；跨阈值才写 ref 避免逐帧 setData）：>40 整栏出现＝
// 头图渐变末色 #39AD95 实底＋返回箭＋日期标题，与滚动中的头图无缝接续
const scrolled = ref<boolean>(false)
onPageScroll((e) => {
  const v = e.scrollTop > 40
  if (v !== scrolled.value) scrolled.value = v
})

const weekNames = ['一', '二', '三', '四', '五', '六', '日']

const dayKey = computed<string>(() => {
  const v = food.viewDay
  return v != null && v.length === 10 ? v : dayKeyOf(Date.now())
})

const dayEntries = computed<FoodEntry[]>(() => {
  const range = dayRange(dayKey.value)
  const list = food.entries.filter((e: FoodEntry): boolean => e.ts >= range[0] && e.ts < range[1])
  list.sort((a: FoodEntry, b: FoodEntry): number => a.ts - b.ts)
  return list
})

const headerTitle = computed<string>(() => {
  const parts = dayKey.value.split('-')
  const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]))
  return parseInt(parts[1]) + '月' + parseInt(parts[2]) + '日 · 周' + weekNames[(d.getDay() + 6) % 7]
})

const goalVal = computed<number>(() => goal.calorieGoal)
const dayTotal = computed<number>(() => dayEntries.value.reduce((s: number, e: FoodEntry): number => s + e.kcal, 0))
const dayOver = computed<number>(() => {
  const o = dayTotal.value - goalVal.value
  return o > 0 ? o : 0
})
const ringPct = computed<number>(() => {
  if (goalVal.value <= 0) return 0
  return Math.round(dayTotal.value / goalVal.value * 100)
})

const calStatus = computed(() => getCalorieStatus(dayTotal.value, goalVal.value))

/** 进度环：MP 端 conic-gradient（SettleBadge 同款通路），App 端 canvas 未接（真机待验，见 DayDetail.md） */
const ringStyle = computed<any>(() => {
  const turn = (dayTotal.value > goalVal.value ? 1 : dayTotal.value / (goalVal.value > 0 ? goalVal.value : 1))
  return {
    backgroundImage: `conic-gradient(from -90deg, ${calStatus.value.hex} 0turn, ${calStatus.value.hex} ${(turn * 0.9999).toString()}turn, #E5F1F0 ${(turn * 0.9999).toString()}turn)`,
  }
})

const fillW = computed<number>(() => {
  const scale = dayTotal.value > goalVal.value ? dayTotal.value : goalVal.value
  if (scale <= 0) return 0
  return Math.round(Math.min(dayTotal.value, goalVal.value) / scale * 319 * 10) / 10
})

const dayProtein = computed<number>(() => Math.round(dayEntries.value.reduce((s: number, e: FoodEntry): number => s + e.protein, 0)))
const dayCarb = computed<number>(() => Math.round(dayEntries.value.reduce((s: number, e: FoodEntry): number => s + e.carb, 0)))
const dayFat = computed<number>(() => Math.round(dayEntries.value.reduce((s: number, e: FoodEntry): number => s + e.fat, 0)))

interface Row {
  id: string
  img: string
  name: string
  portion: string
  kcal: number
}

interface MealGroup {
  icon: string
  name: string
  time: string
  cal: number
  rows: Row[]
}

const MEAL_ICONS: Record<string, string> = {
  breakfast: '/static/records/lr_meal_breakfast.png',
  lunch: '/static/records/lr_meal_lunch.png',
  dinner: '/static/records/lr_meal_dinner.png',
  snack: '/static/records/lr_meal_snack.png',
}

const mealGroups = computed<MealGroup[]>(() => {
  const out: MealGroup[] = []
  for (const mk of MEAL_KEYS) {
    const entries = dayEntries.value.filter((e: FoodEntry): boolean => e.meal === mk)
    if (entries.length === 0) continue
    let cal = 0
    for (const e of entries) cal += e.kcal
    const d = new Date(entries[0].ts)
    const hh = d.getHours() < 10 ? '0' + d.getHours().toString() : d.getHours().toString()
    const mm = d.getMinutes() < 10 ? '0' + d.getMinutes().toString() : d.getMinutes().toString()
    const rows: Row[] = []
    for (const e of entries) {
      rows.push({
        id: e.id,
        img: e.img != null && e.img !== '' ? '/static/icons/' + e.img : '',
        name: e.name,
        portion: amountText(e),
        kcal: e.kcal,
      })
    }
    out.push({
      icon: MEAL_ICONS[mk] ?? '',
      name: MEAL_LABELS[mk] ?? mk,
      time: hh + ':' + mm,
      cal,
      rows,
    })
  }
  return out
})

/** 长按删除（Boss 拍板：uni.showActionSheet 底部菜单加删除项） */
function confirmDelete(row: Row): void {
  uni.showActionSheet({
    itemList: ['删除这条记录'],
    success: () => {
      food.removeEntry(row.id)
    },
    fail: () => {},
  })
}

// ===== 添加食物链路（方案 A 单流程） =====
const pickerShow = ref(false)
const settleShow = ref(false)
const settleKcal = ref(0)
const settleAfter = ref(0)
const settleMeal = ref('')

function openPicker(): void {
  pickerShow.value = true
}

function onAddConfirm(payload: AddPayload): void {
  const f = getFoodById(payload.foodId)
  if (f != null) {
    food.addEntry(computeEntry(f, payload.amount, payload.unit, payload.meal, payload.extraKcal))
  }
  settleKcal.value = payload.kcal
  settleAfter.value = food.totalCal
  settleMeal.value = MEAL_LABELS[payload.meal] ?? ''
  settleShow.value = true
}

function goBack(): void {
  uni.navigateBack()
}
</script>

<style>
.page {
  background-image: linear-gradient(180deg, #E2F5EC, #F6FCF9);
  min-height: 100%;
}

