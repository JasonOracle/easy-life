  background-color: #E5F1F0;
}
.dd-fill {
  height: 9px;
  border-radius: 4.5px;
  background-image: linear-gradient(90deg, #12A581, #23B391);
}
.dd-prog-foot {
  flex-direction: row;
  justify-content: space-between;
  padding: 5px 0 0 15px;
  width: 319px;
}
.dd-prog-left {
  flex-direction: row;
  align-items: flex-end;
}
.dd-prog-right {
  flex-direction: row;
  align-items: flex-end;
  margin-right: 16px;
}
.dd-plabel {
  font-size: 9.5px;
  font-weight: bold;
  color: #4A6171;
}
.dd-pnum {
  font-size: 11.1px;
  font-weight: 700;
  color: #00222B;
  margin-left: 6px;
}
.dd-prog-right .dd-pnum {
  font-weight: 400;
  color: #1C4455;
}
