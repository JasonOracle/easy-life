<template>
  <view class="page" :style="{ backgroundColor: theme.bg, backgroundImage: pageGradient }">
    <!-- [变更日志] 2026-09-24: Header 简化为与日历页同源的纯净绿色渐变，移除 liquid_wave 矢量水波层 -->
    <!-- [变更日志] 2026-09-27: 渐变头第三档 accentDeep→accentMid（消除底部发黑）；
         .dd-ring-label / .dd-add-txt / .dd-row-kcal 由 accentDeep 改 accentMid，
         恢复改造前「标题深墨(#0A7A5C) + 数值中亮绿(#12A87B/#16A880)」的两档层次 -->
    <!-- [变更日志] 2026-09-25: 记录行食物图接入百科页入口（携 foodId 跳 pages/encyclopedia/Detail） -->
    <!-- Header（与日历页顶栏同源的纯净绿色渐变） -->
    <view class="dd-header" :style="headerStyle">
      <view :style="{ height: sbH + 'px' }"></view>
      <view class="dd-nav">
        <view class="dd-back-hot" @click="goBack">
          <image class="dd-back" :src="asset('records/lr_back.svg')" mode="aspectFit"></image>
        </view>
        <text class="dd-title" :style="{ color: headerTitleColor }">{{ headerTitle }}</text>
      </view>
    </view>

    <!-- 今日热量卡 -->
    <view class="dd-card" :style="{ backgroundColor: theme.card }">
      <view class="dd-card-head">
        <image class="dd-flame" :src="asset('profile/flame.svg')" mode="aspectFit"></image>
        <text class="dd-card-title" :style="{ color: theme.ink1 }">{{ t('dd.today') }}</text>
        <view class="dd-overpill" v-if="dayOver > 0" :style="{ backgroundColor: overpillFill }">
          <text class="dd-overtxt" :style="{ color: overTextColor }">{{ tf('rec.over', [dayOver.toString()]) }}</text>
        </view>
      </view>
      <view class="dd-ring" :style="ringStyle">
        <view class="dd-ring-hole" :style="{ backgroundColor: theme.card }"></view>
        <text class="dd-ring-pct" :style="{ color: theme.ink1 }">{{ ringPct }}%</text>
        <text class="dd-ring-label" :style="{ color: theme.accentMid }">{{ t('dd.ring') }}</text>
      </view>
      <view class="dd-bignum-row">
        <text class="dd-bignum" :style="{ color: statusTextColor }">{{ dayTotal }}</text>
        <text class="dd-bigunit" :style="{ color: statusUnitColor }">kcal</text>
      </view>
      <view class="dd-track" :style="{ backgroundColor: theme.line }">
        <view class="dd-fill" :style="barFillStyle"></view>
      </view>
      <view class="dd-prog-foot">
        <view class="dd-prog-left">
          <text class="dd-plabel" :style="{ color: theme.ink2 }">{{ t('dd.ring') }}</text>
          <text class="dd-pnum" :style="{ color: theme.ink1 }">{{ dayTotal }}</text>
          <text class="dd-punit" :style="{ color: theme.ink3 }">kcal</text>
        </view>
        <view class="dd-prog-right">
          <text class="dd-plabel" :style="{ color: theme.ink2 }">{{ t('dd.goal') }}</text>
          <text class="dd-pnum dd-pnum-target" :style="{ color: theme.ink2 }">{{ goalVal }}</text>
          <text class="dd-punit" :style="{ color: theme.ink3 }">kcal</text>
        </view>
      </view>
      <view class="dd-stat" :style="{ backgroundColor: theme.cardSoft }">
        <text class="dd-stat-title" :style="{ color: theme.accentDeep }">{{ t('dd.nutrition') }}</text>
        <view class="dd-stat-row">
          <view class="dd-stat-col">
            <image class="dd-mg" :src="asset('home/macro_protein.svg')" mode="aspectFit"></image>
            <view class="dd-stat-txt">
              <text class="dd-stat-num" :style="{ color: theme.ink1 }">{{ dayProtein }}g</text>
              <text class="dd-stat-lbl" :style="{ color: theme.ink3 }">{{ t('dd.protein') }}</text>
            </view>
          </view>
          <view class="dd-stat-div" :style="{ backgroundColor: theme.line }"></view>
          <view class="dd-stat-col">
            <image class="dd-mg" :src="asset('home/macro_carb.svg')" mode="aspectFit"></image>
            <view class="dd-stat-txt">
              <text class="dd-stat-num" :style="{ color: theme.ink1 }">{{ dayCarb }}g</text>
              <text class="dd-stat-lbl" :style="{ color: theme.ink3 }">{{ t('dd.carb') }}</text>
            </view>
          </view>
          <view class="dd-stat-div" :style="{ backgroundColor: theme.line }"></view>
          <view class="dd-stat-col">
            <image class="dd-mg" :src="asset('home/macro_fat.svg')" mode="aspectFit"></image>
            <view class="dd-stat-txt">
              <text class="dd-stat-num" :style="{ color: theme.ink1 }">{{ dayFat }}g</text>
              <text class="dd-stat-lbl" :style="{ color: theme.ink3 }">{{ t('dd.fat') }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 餐次记录 -->
    <view class="dd-secrow">
      <view class="dd-acc" :style="{ backgroundColor: theme.accent }"></view>
      <text class="dd-sec" :style="{ color: theme.ink1 }">{{ t('dd.meals') }}</text>
      <view class="dd-add" @click="openPicker">
        <image class="dd-add-ic" :src="asset('records/dd_add.svg')" mode="aspectFit"></image>
        <text class="dd-add-txt" :style="{ color: theme.accentMid }">{{ t('dd.add') }}</text>
      </view>
    </view>
    <view class="dd-meal" v-for="(mealItem, mealIdx) in mealGroups" :key="mealIdx" :style="{ backgroundColor: theme.card }">
      <view class="dd-meal-head">
        <view class="dd-meal-circ" :style="{ backgroundColor: theme.chip }">
          <image class="dd-meal-ic" :src="asset(mealItem.icon)" mode="aspectFit"></image>
        </view>
        <text class="dd-meal-name" :style="{ color: theme.ink1 }">{{ mealItem.name }}</text>
        <text class="dd-meal-time" :style="{ color: theme.ink3 }" v-if="mealItem.time !== ''">{{ mealItem.time }}</text>
        <view class="dd-meal-cal">
          <text class="dd-meal-num" :style="{ color: theme.ink1 }">{{ mealItem.cal }}</text>
          <text class="dd-meal-unit" :style="{ color: theme.ink3 }">kcal</text>
        </view>
      </view>
      <view v-if="mealItem.rows.length === 0" class="dd-empty">
        <text class="dd-empty-txt" :style="{ color: theme.ink3 }">{{ t('dd.none') }}</text>
      </view>
      <view
        v-else
        class="dd-row"
        v-for="(rowItem, rowIdx) in mealItem.rows"
        :key="rowIdx"
        @longpress="confirmDelete(rowItem)"
      >
        <image class="dd-row-ph" :src="rowItem.img" mode="aspectFill" @click="openEncyclopedia(rowItem.img)"></image>
        <text class="dd-row-name" :style="{ color: theme.ink1 }">{{ rowItem.name }}</text>
        <text class="dd-row-portion" :style="{ color: theme.ink3 }">{{ rowItem.portion }}</text>
        <text class="dd-row-kcal" :style="{ color: theme.accentMid }">{{ rowItem.kcal }} kcal</text>
      </view>
    </view>

    <!-- 今日饮食总结 -->
    <view class="dd-band" :style="{ backgroundColor: theme.card }">
      <view class="dd-band-circ" :style="{ backgroundColor: theme.chip }">
        <image class="dd-band-ic" :src="asset('records/dd_sum.svg')" mode="aspectFit"></image>
      </view>
      <view class="dd-band-txt">
        <text class="dd-band-title" :style="{ color: theme.accentDeep }">{{ t('dd.sumTitle') }}</text>
        <text class="dd-band-sub" :style="{ color: theme.ink2 }">{{ t('dd.sumSub') }}</text>
      </view>
    </view>

    <view class="dd-bottom-space"></view>

    <FoodPicker v-model:show="pickerShow" @confirm="onAddConfirm" ></FoodPicker>
    <SettleBadge v-model:show="settleShow" :kcal="settleKcal" :after="settleAfter" :goal="goal.calorieGoal" :meal="settleMeal" ></SettleBadge>

    <!-- 常驻导航栏（#28：替代 P1 遮罩＋fx-back 两件套）：滚动跨阈后整栏出现＝末色底＋返回箭＋日期标题，三端生效 -->
    <view v-if="scrolled" class="dd-nav-fixed" :style="navBarStyle">
      <view class="dd-nav-back" @click="goBack">
        <image class="dd-nav-icon" :src="asset('records/lr_back.svg')" mode="aspectFit"></image>
      </view>
      <text class="dd-nav-title" :style="{ color: navBarTitleColor }">{{ headerTitle }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { t, tf } from '../../composables/i18n'
import { onPageScroll, onShow } from '@dcloudio/uni-app'
import { useFoodStore, dayKeyOf, dayRange, amountText, getFoodById, computeEntry, MEAL_KEYS } from '../../stores/food'
import type { FoodEntry } from '../../stores/food'
import { useGoalStore, getCalorieStatus } from '../../stores/goal'
import { foodIdFromImg } from '../../stores/encyclopedia'
import { triggerHaptic } from '../../stores/settings'
import { MEAL_WINDOWS } from '../../composables/mealWindow'
import { useTheme, themeAsset, FIXED_COLORS, syncStatusBarStyle } from '../../composables/useTheme'
import FoodPicker from '../../components/FoodPicker.uvue'
import type { AddPayload } from '../../composables/pickerTypes'
import SettleBadge from '../../components/SettleBadge.uvue'

/**
 * 单日详情（Pencil VEWYt 逐节点量取）。
 * 查看日＝food.viewDay（Records 跳转前写入，空则今日）；
 * 记录行长按 → uni.showActionSheet「删除这条记录」→ removeEntry（Boss 拍板）。
 */

const food = useFoodStore()
const goal = useGoalStore()

const sbH = ref<number>(uni.getSystemInfoSync().statusBarHeight ?? 0)

// 常驻导航栏高度计算：58px (116rpx) 内容高 + 状态栏高，避免跨端 calc(rpx+px) 错误
const navBarH = computed<number>(() => sbH.value + 58)

// 常驻导航栏两态（#28，三端生效；跨阈值才写 ref 避免逐帧 setData）：>40 整栏出现＝
// 头图渐变末色 #39AD95 实底＋返回箭＋日期标题，与滚动中的头图无缝接续
const scrolled = ref<boolean>(false)
onPageScroll((e) => {
  const v = e.scrollTop > 40
  if (v !== scrolled.value) scrolled.value = v
})


const dayKey = computed<string>(() => {
  const v = food.viewDay
  return v != null && v.length === 10 ? v : dayKeyOf(Date.now())
})

const dayEntries = computed<FoodEntry[]>(() => {
  const range = dayRange(dayKey.value)
  const list = food.entries.filter((e: FoodEntry): boolean => e.ts >= range[0] && e.ts < range[1])
  list.sort((a: FoodEntry, b: FoodEntry): number => a.ts - b.ts)
  return list
})

const headerTitle = computed<string>(() => {
  const parts = dayKey.value.split('-')
  const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]))
  const idx = (d.getDay() + 6) % 7
  return tf('dd.mdw', [parts[1], parts[2], idx == 6 ? t('pf.d0') : t('pf.d' + (idx + 1).toString())])
})

const goalVal = computed<number>(() => goal.calorieGoal)
const dayTotal = computed<number>(() => dayEntries.value.reduce((s: number, e: FoodEntry): number => s + e.kcal, 0))
const dayOver = computed<number>(() => {
  const o = dayTotal.value - goalVal.value
  return o > 0 ? o : 0
})
const ringPct = computed<number>(() => {
  if (goalVal.value <= 0) return 0
  return Math.round(dayTotal.value / goalVal.value * 100)
})

const calStatus = computed(() => getCalorieStatus(dayTotal.value, goalVal.value))

const { theme, isDark, accentId } = useTheme()

// 状态栏字色按当前主题同步：原生端 pages.json 的静态项只覆盖亮态，切页/切主题都要重下
onShow(() => {
  syncStatusBarStyle(isDark.value)
})

/** 资产按 (accent, mode) 取五档变体；未登记底稿（语义色／无彩稿）自动回落原路径 */
function asset(path: string): string {
  return themeAsset(accentId.value, isDark.value, '/static/' + path)
}

/** 页底：浅态走 hero→bg 柔和渐变，暗态改纯色免脏底 */
const pageGradient = computed((): string => isDark.value ? 'none' : 'linear-gradient(' + theme.value.heroBg + ', ' + theme.value.bg + ')')

/** 品牌渐变头：浅态走该档 accent 三档渐变，暗态改 card 纯色（同首页／日历页既定处理） */
const headerStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  if (isDark.value) {
    st['background-color'] = theme.value.card
  } else {
    st['background-color'] = theme.value.accent
    st['background-image'] = 'linear-gradient(' + theme.value.accent2 + ' 0%, ' + theme.value.accent + ' 60%, ' + theme.value.accentMid + ' 100%)'
  }
  return st
})
const headerTitleColor = computed((): string => isDark.value ? theme.value.ink1 : theme.value.onAccent)

/** 常驻导航栏＝滚动后与头图末色无缝接续的实底栏，几何与配色一并运行时下发 */
const navBarStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['height'] = navBarH.value + 'px'
  st['padding-top'] = sbH.value + 'px'
  st['background-color'] = isDark.value ? theme.value.card : theme.value.accent
  if (!isDark.value) st['box-shadow'] = '0 4rpx 20rpx rgba(10, 79, 61, 0.10)'
  return st
})
const navBarTitleColor = computed((): string => isDark.value ? theme.value.ink1 : theme.value.onAccent)

/** 绿档文字跟主题 ink 轴；接近上限／超标落全局语义色（§8.3 状态色不随主题轮值） */
const statusTextColor = computed((): string => calStatus.value.type == 'green' ? theme.value.ink1 : calStatus.value.color)
const statusUnitColor = computed((): string => calStatus.value.type == 'green' ? theme.value.ink2 : statusTextColor.value)

/** 超标胶囊＝珊瑚语义色浅底，暗态改同色低透明度以免整块刺眼 */
const overpillFill = computed((): string => isDark.value ? 'rgba(255, 158, 125, 0.18)' : 'rgba(255, 158, 125, 0.25)')
const overTextColor = computed((): string => isDark.value ? FIXED_COLORS.statusCoral : '#FA543A')

const barFillStyle = computed((): Record<string, string> => {
  const st = {} as Record<string, string>
  st['width'] = fillW.value + 'rpx'
  if (calStatus.value.type == 'green') {
    st['background-color'] = theme.value.accent
    st['background-image'] = 'linear-gradient(to right, ' + theme.value.accent2 + ', ' + theme.value.accent + ')'
  } else {
    st['background-color'] = calStatus.value.color
  }
  return st
})

/** 进度环：MP 端 conic-gradient（SettleBadge 同款通路），App 端 canvas 未接（真机待验，见 DayDetail.md） */
const ringStyle = computed<any>(() => {
  const turn = (dayTotal.value > goalVal.value ? 1 : dayTotal.value / (goalVal.value > 0 ? goalVal.value : 1))
  return {
    backgroundImage: `conic-gradient(from -90deg, ${calStatus.value.color} 0turn, ${calStatus.value.color} ${(turn * 0.9999).toString()}turn, ${theme.value.line} ${(turn * 0.9999).toString()}turn)`,
  }
})

const fillW = computed<number>(() => {
  const scale = dayTotal.value > goalVal.value ? dayTotal.value : goalVal.value
  if (scale <= 0) return 0
  return Math.round(Math.min(dayTotal.value, goalVal.value) / scale * 638 * 10) / 10
})

const dayProtein = computed<number>(() => Math.round(dayEntries.value.reduce((s: number, e: FoodEntry): number => s + e.protein, 0)))
const dayCarb = computed<number>(() => Math.round(dayEntries.value.reduce((s: number, e: FoodEntry): number => s + e.carb, 0)))
const dayFat = computed<number>(() => Math.round(dayEntries.value.reduce((s: number, e: FoodEntry): number => s + e.fat, 0)))

interface Row {
  id: string
  img: string
  name: string
  portion: string
  kcal: number
}

interface MealGroup {
  icon: string
  name: string
  time: string
  cal: number
  rows: Row[]
}

const MEAL_ICONS: Record<string, string> = {
  breakfast: 'records/lr_meal_breakfast.svg',
  lunch: 'records/lr_meal_lunch.svg',
  dinner: 'records/lr_meal_dinner.svg',
  snack: 'records/lr_meal_snack.svg',
}

const mealGroups = computed<MealGroup[]>(() => {
  const out: MealGroup[] = []
  for (const mk of MEAL_KEYS) {
    const entries = dayEntries.value.filter((e: FoodEntry): boolean => e.meal === mk)
    let cal = 0
    let time = ''
    if (entries.length > 0) {
      for (const e of entries) cal += e.kcal
      const d = new Date(entries[0].ts)
      const hh = d.getHours() < 10 ? '0' + d.getHours().toString() : d.getHours().toString()
      const mm = d.getMinutes() < 10 ? '0' + d.getMinutes().toString() : d.getMinutes().toString()
      time = hh + ':' + mm
    }
    const rows: Row[] = []
    for (const e of entries) {
      rows.push({
        id: e.id,
        img: e.img != null && e.img !== '' ? '/static/icons/' + e.img : '',
        name: e.name,
        portion: amountText(e),
        kcal: e.kcal,
      })
    }
    out.push({
      icon: MEAL_ICONS[mk] ?? '',
      name: t('meal.' + mk),
      time,
      cal,
      rows,
    })
  }
  return out
})

/** 长按删除（Boss 拍板：uni.showActionSheet 底部菜单加删除项） */
function confirmDelete(row: Row): void {
  uni.showActionSheet({
    itemList: [t('dd.del')],
    success: () => {
      food.removeEntry(row.id)
    },
    fail: () => {},
  })
}

/** 百科入口：记录行食物图解析 foodId 跳详情页 */
function openEncyclopedia(img: string): void {
  const fid = foodIdFromImg(img)
  if (fid.length == 0) return
  triggerHaptic('light')
  uni.navigateTo({ url: '/pages/encyclopedia/Detail?id=' + fid })
}

// ===== 添加食物链路（方案 A 单流程） =====
const pickerShow = ref(false)
const settleShow = ref(false)
const settleKcal = ref(0)
const settleAfter = ref(0)
const settleMeal = ref('')

function openPicker(): void {
  pickerShow.value = true
}

function onAddConfirm(payload: AddPayload): void {
  const f = getFoodById(payload.foodId)
  if (f != null) {
    const entry = computeEntry(f, payload.amount, payload.unit, payload.meal, payload.extraKcal)
    // 补记：查看非当日时 computeEntry 的 ts=Date.now() 会落到今天，页面看起来「添加无效」。
    // 锚定到所选日期该餐次最后一条记录之后；餐次为空则取该日餐窗起点。
    const range = dayRange(dayKey.value)
    if (Date.now() < range[0] || Date.now() >= range[1]) {
      const sameMeal = dayEntries.value.filter((e: FoodEntry): boolean => e.meal === payload.meal)
      if (sameMeal.length > 0) {
        entry.ts = sameMeal[sameMeal.length - 1].ts + 1000
      } else {
        const win = MEAL_WINDOWS.find((w): boolean => w.key === payload.meal)
        const hour = win != null ? win.startHour : 12
        entry.ts = range[0] + hour * 3600 * 1000
      }
    }
    food.addEntry(entry)
  }
  settleKcal.value = payload.kcal
  settleAfter.value = food.totalCal
  settleMeal.value = t('meal.' + payload.meal)
  settleShow.value = true
}

function goBack(): void {
  uni.navigateBack()
}
</script>

<style>
/* ===== Header（与日历页同源的纯净绿色平滑渐变） ===== */
.dd-header {
  position: relative;
  overflow: hidden;
  padding-bottom: 64rpx;
}
.dd-nav {
  flex-direction: row;
  align-items: center;
  height: 88rpx;
  padding-left: 10rpx;
}
.dd-back-hot {
  width: 72rpx;
  height: 72rpx;
  justify-content: center;
  align-items: center;
}
.dd-back {
  width: 36rpx;
  height: 36rpx;
}
.dd-title {
  font-size: 38rpx;
  font-weight: bold;
  height: 52rpx;
  line-height: 52rpx;
  margin-left: 2rpx;
}

/* ===== 今日热量卡 348×229 r16，统一自然浮岛层叠 ===== */
.dd-card {
  margin: -32rpx 28rpx 0 28rpx;
  height: 458rpx;
  border-radius: 36rpx;
  flex-shrink: 0;
  position: relative;
  box-shadow: 0 8rpx 32rpx rgba(10, 79, 61, 0.06);
}
.dd-card-head {
  flex-direction: row;
  align-items: center;
  padding: 26rpx 0 0 30rpx;
}
.dd-flame {
  width: 24rpx;
  height: 28rpx;
}
.dd-card-title {
  font-size: 23rpx;
  font-weight: 700;
  margin-left: 16rpx;
}
.dd-overpill {
  height: 28rpx;
  padding: 0 14rpx 0 16rpx;
  border-radius: 14rpx;
  justify-content: center;
  margin-left: 16rpx;
}
.dd-overtxt {
  font-size: 17rpx;
  font-weight: bold;
}
.dd-ring {
  position: absolute;
  right: 40rpx;
  top: 26rpx;
  width: 144rpx;
  height: 144rpx;
  border-radius: 72rpx;
  align-items: center;
}
.dd-ring-hole {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border-radius: 64rpx;
}
.dd-ring-pct {
  font-size: 29rpx;
  font-weight: 700;
  margin-top: 36rpx;
  z-index: 1;
}
.dd-ring-label {
  font-size: 16rpx;
  margin-top: 2rpx;
  z-index: 1;
}
.dd-bignum-row {
  flex-direction: row;
  align-items: flex-end;
  padding: 0 0 0 26rpx;
}
.dd-bignum {
  font-size: 92rpx;
  font-weight: 700;
  line-height: 110rpx;
}
.dd-bigunit {
  font-size: 29rpx;
  font-weight: 700;
  margin-left: 10rpx;
  margin-bottom: 12rpx;
}
.dd-track {
  margin: 28rpx 30rpx 0 28rpx;
  height: 18rpx;
  border-radius: 9rpx;
}
.dd-fill {
  height: 18rpx;
  border-radius: 9rpx;
}
.dd-prog-foot {
  flex-direction: row;
  justify-content: space-between;
  padding: 10rpx 0 0 30rpx;
  width: 638rpx;
}
.dd-prog-left {
  flex-direction: row;
  align-items: flex-end;
