<template>
  <view class="dialog-container">
    <view class="dialog-content">
      <view class="dialog-header">
        <text class="dialog-title">{{ t('pd.title') }}</text>
      </view>
      <view class="dialog-body">
        <text class="dialog-text">
          <text class="dt-run">{{ t('pd.run1') }}</text>
          <text class="dialog-href" @click="hrefClick('https://www.example.com/agreement')"> {{ t('pd.agreement') }}</text>
          <text class="dt-run">{{ t('pd.run2') }}</text>
          <text class="dialog-href" @click="hrefClick('https://www.example.com/privacy')"> {{ t('pd.policy') }}</text>
          <text class="dt-run">{{ t('pd.run3') }}</text>
          <text class="dt-run">{{ t('pd.run4') }}</text>
        </text>
      </view>
      <view class="dialog-actions">
        <button class="btn btn-reject" @click="reject">{{ t('pd.reject') }}</button>
        <!-- #ifdef MP-WEIXIN -->
        <button class="btn btn-agree" type="primary" open-type="agreePrivacyAuthorization" @agreeprivacyauthorization="agree">{{ t('pd.agree') }}</button>
        <!-- #endif -->
        <!-- #ifndef MP-WEIXIN -->
        <button class="btn btn-agree" type="primary" @click="agree">{{ t('pd.agree') }}</button>
        <!-- #endif -->
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
// [变更日志] 2026-09-24: 正文 scroll-view 改普通 view；行高/字号下沉到每个 text 片段（原生端无样式继承，隐式 text 丢样式）
import { t, tf } from '../../composables/i18n'

const currentPage = getCurrentInstance()?.proxy?.$page

function agree() {
  if (currentPage != null) {
    uni.closeDialogPage({
      dialogPage: currentPage
    })
  }
}

function reject() {
  uni.resetPrivacyAuthorization()
  if (currentPage != null) {
    uni.closeDialogPage({
      dialogPage: currentPage
    })
  }
}

function hrefClick(href : string) {
  uni.showToast({
    title: tf('pd.browser', [href]),
    icon: 'none'
  })
}
</script>

<style>
.dialog-container {
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.4);
  display: flex;
  justify-content: center;
  align-items: center;
}

.dialog-content {
  width: 560rpx;
  background-color: #FFFFFF;
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.dialog-header {
  align-items: center;
  margin-bottom: 32rpx;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #0A4F3D;
}

.dialog-body {
  margin-bottom: 32rpx;
}

.dialog-text {
  font-size: 28rpx;
  color: #333333;
  /* 原生端无样式继承，行高必须写在实际渲染的 text 片段上 */
  line-height: 44rpx;
}

.dt-run {
  font-size: 28rpx;
  color: #333333;
  line-height: 44rpx;
}

.dialog-href {
  color: #1FBF8F;
  font-weight: bold;
  font-size: 28rpx;
  line-height: 44rpx;
}

.dialog-actions {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.btn {
  width: 220rpx;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-reject {
  background-color: #F2FAF5;
  color: #0A4F3D;
  border: none;
}

.btn-agree {
  background-color: #1FBF8F;
  color: #FFFFFF;
  border: none;
}
</style>
