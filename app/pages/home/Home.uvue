<template>
  <view class="page">
    <!-- 常驻标题块导航栏（#28 方案A：Boss 拍板 Home 标题块三端固定顶部）：页内内联 fixed（禁组件——幻影副本），
         z45 常驻置顶；内容以 margin-top 避让整栏，无透明态故不存在点击穿透问题 -->
    <view class="hm-nav" :style="{ height: (sbH + 64) + 'px', paddingTop: sbH + 'px' }">
      <view class="hm-nav-inner">
        <view class="hm-nav-left">
          <text class="title">轻律生活</text>
          <text class="subtitle">让健康饮食成为一种习惯</text>
        </view>
        <view class="fab" :style="{ right: fabRight, top: fabTop }" @click="openAdd">
          <text class="fab-plus">＋</text>
        </view>
      </view>
    </view>

    <!-- 顶栏文档流占位（随内容滚走）：日期行 -->
    <view class="header" :style="{ paddingTop: (sbH + 64) + 'px' }">
      <view class="date-row">
        <image class="date-icon" :src="'/static/home/date_icon.png'" mode="aspectFit"></image>
        <text class="date-text">9月19日 · 周五</text>
      </view>
    </view>

    <!-- Hero（常驻标题块 #28：避让已由 .header 的 paddingTop 完成，此处保持原 -18 上叠，勿重复加 sbH） -->
    <view class="hero">
      <image class="hero-wave" :src="'/static/home/hero_wave.png'" mode="widthFix"></image>
      <image class="bottle" :src="'/static/home/bottle.png'" mode="aspectFit"></image>
      <image class="sticker" :src="'/static/home/sticker.png'" mode="aspectFit"></image>
      <view class="hero-text">
        <view class="remain-head">
          <text class="remain-label">还能吃</text>
          <image class="remain-leaf" :src="'/static/home/leaf.png'" mode="aspectFit"></image>
        </view>
        <view class="remain-num-row">
          <text class="remain-num">{{ remainCal }}</text>
          <text class="remain-unit">kcal</text>
        </view>
        <text class="consumed">已摄入 {{ food.totalCal }} / {{ goal.calorieGoal }} kcal</text>
        <view class="goal-pill">
          <image class="pill-cal" :src="'/static/home/pill_calendar.png'" mode="aspectFit" @click="openRecords"></image>
          <text class="goal-pill-text">每日目标 {{ goal.calorieGoal }} kcal</text>
          <image class="pill-edit" :src="'/static/home/pill_edit.png'" mode="aspectFit" @click="openGoal"></image>
        </view>
      </view>
    </view>

    <!-- 宏量卡 -->
    <view class="macro-card">
      <view class="macro-col">
        <image class="macro-icon" :src="'/static/home/macro_protein.png'" mode="aspectFit"></image>
        <text class="macro-num">{{ macroP }}g</text>
        <text class="macro-label">蛋白质</text>
      </view>
      <view class="macro-div"></view>
      <view class="macro-col">
        <image class="macro-icon" :src="'/static/home/macro_carb.png'" mode="aspectFit"></image>
        <text class="macro-num">{{ macroC }}g</text>
        <text class="macro-label">碳水</text>
      </view>
      <view class="macro-div"></view>
      <view class="macro-col">
        <image class="macro-icon" :src="'/static/home/macro_fat.png'" mode="aspectFit"></image>
        <text class="macro-num">{{ macroF }}g</text>
        <text class="macro-label">脂肪</text>
      </view>
    </view>

    <!-- 今日餐次 -->
    <view class="meal-section-head">
      <text class="meal-section-title">今日餐次</text>
      <view class="all-records">
        <text class="all-records-text">全部记录</text>
        <image class="chev-right" :src="'/static/home/chev_right.png'" mode="aspectFit"></image>
      </view>
    </view>

    <view class="meal-block" v-for="(meal, mealIdx) in meals" :key="mealIdx">
      <view class="meal-rail">
        <view class="meal-circle">
          <image class="meal-circle-icon" :src="meal.icon" mode="aspectFit"></image>
        </view>
        <view class="rail-line" v-if="mealIdx < meals.length - 1"></view>
      </view>
      <view class="meal-main">
        <view class="meal-head">
          <text class="meal-name">{{ meal.name }}<text class="meal-time"> · {{ meal.time }}</text></text>
          <text class="meal-kcal">{{ meal.totalKcal }} kcal</text>
        </view>
        <view class="meal-card" v-if="meal.key !== 'dinner' || showDinner">
          <view v-for="(rowItem, rowIdx) in meal.rows" :key="rowIdx">
            <view class="meal-row">
              <image class="meal-thumb" :src="rowItem.img" mode="aspectFill"></image>
              <text class="meal-row-name">{{ rowItem.name }}</text>
              <text class="meal-row-portion">{{ rowItem.portion }}</text>
              <text class="meal-row-kcal">{{ rowItem.kcal }} kcal</text>
            </view>
            <view class="meal-row-div" v-if="rowIdx < meal.rows.length - 1"></view>
          </view>
        </view>
        <view class="meal-expand" v-if="meal.key === 'dinner' && !showDinner">
          <view class="expand-btn" @click="toggleDinner">
            <image class="chev-down" :src="'/static/home/chev_down.png'" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部 Tab（共享组件，Tabbar 终案前按 v2 两 Tab 落地） -->
    <Tabbar active="home" :fade="tabFade" ></Tabbar>

    <!-- 弹层⓪ 食物选择列表 → 弹窗① 添加食物（更换时回到列表并回显） -->
    <FoodPicker v-model:show="pickerShow" :selected-id="addFoodId" @select="onPickFood" ></FoodPicker>
    <AddFood v-model:show="addShow" :food-id="addFoodId" @confirm="onAddConfirm" @change="onAddChange" ></AddFood>
    <SettleBadge v-model:show="settleShow" :kcal="settleKcal" :after="settleAfter" :goal="goal.calorieGoal" :meal="settleMeal" ></SettleBadge>
    <GoalModal v-model:show="goalShow" :initial="goal.calorieGoal" @save="goal.setGoal" ></GoalModal>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onPageScroll } from '@dcloudio/uni-app'

/**
 * 演示数据（稿面静态值，store 重建后再接真实数据）。
 * 缩放系数 0.794：v2 画布 472px → 应用 375px。
 */

// 状态栏高度（自定义导航时顶栏避让）
let sbH = 0
try {
  const sysInfo = uni.getSystemInfoSync()
  sbH = sysInfo.statusBarHeight ?? 0
} catch (e) {
  sbH = 0
}

// TabBar 渐显（scroll-fade，照官方示例「随滚动渐显的透明导航栏」）：0→60px 线性，
// 按 0.05 量化＝整段渐显最多 20 次 setData，绝不逐帧写；三端生效。
// 阈值取 60 而非示例的 100＝实测 Records 页最大滚动只有 70px，100 会让该页永远到不了满玻璃
const tabFade = ref<number>(0)
onPageScroll((e) => {
  let q = e.scrollTop / 60
  if (q > 1) q = 1
  const fq = Math.round(q * 20) / 20
  if (fq !== tabFade.value) tabFade.value = fq
})

// 右上加号位置：默认稿面位置；小程序端放到胶囊左侧防遮挡
const fabRight = ref('14px')
const fabTop = ref('2px')
// #ifdef MP-WEIXIN
try {
  const sys = uni.getSystemInfoSync()
  const capsule = uni.getMenuButtonBoundingClientRect()
  if (capsule != null && capsule.left > 0) {
    fabRight.value = (sys.windowWidth - capsule.left + 10) + 'px'
    fabTop.value = (capsule.top - (sys.statusBarHeight ?? 0)) + 'px'
  }
} catch (e) {
  // 取不到胶囊信息时保持默认位置
}
// #endif

import Tabbar from '../../components/Tabbar.uvue'
import { computed } from 'vue'
import AddFood from '../../components/AddFood.uvue'
import type { AddPayload } from '../../components/AddFood.uvue'
import FoodPicker from '../../components/FoodPicker.uvue'
import SettleBadge from '../../components/SettleBadge.uvue'
import GoalModal from '../../components/GoalModal.uvue'
import { useFoodStore } from '../../stores/food'
import { useGoalStore } from '../../stores/goal'
import { getFoodById, computeEntry } from '../../stores/food'

/**
 * 接 store 读数（今日种子精确还原 v2 行：早 420 / 午 560 / 晚 390，宏量 68/156/42）。
 * 稿面「已摄入 1270 / 还能吃 530」自身与餐和 1370 矛盾，以 store 真值（1368/432）为准。
 */
const food = useFoodStore()
const goal = useGoalStore()

const remainCal = computed(() => goal.calorieGoal - food.totalCal)
const macroP = computed(() => Math.round(food.totalProtein))
const macroC = computed(() => Math.round(food.totalCarbs))
const macroF = computed(() => Math.round(food.totalFat))

type MealRow = {
  img: string
  name: string
  portion: string
  kcal: number
}

type Meal = {
  key: string
  icon: string
  name: string
  time: string
  totalKcal: number
  rows: MealRow[]
}

const MEAL_ICONS: Record<string, string> = {
  breakfast: '/static/home/meal_sun.png',
  lunch: '/static/home/meal_sun_l.png',
  dinner: '/static/home/meal_moon.png',
}

/** 弹层⓪ 选择食物 → 弹窗① 添加（确认写库＋弹弹层③ 结算徽章）；Pill 铅笔 → GoalModal */
const pickerShow = ref(false)
const addShow = ref(false)
const addFoodId = ref('')
const settleShow = ref(false)
const settleKcal = ref(0)
const settleAfter = ref(0)
const settleMeal = ref('')
const goalShow = ref(false)

function openGoal(): void {
  goalShow.value = true
}

function openRecords(): void {
  uni.navigateTo({ url: '/pages/records/Records' })
}

const MEAL_LABELS: Record<string, string> = {
  breakfast: '早餐',
  lunch: '午餐',
  dinner: '晚餐',
  snack: '夜宵',
}

function openAdd(): void {
  pickerShow.value = true
}

function onPickFood(id: string): void {
  addFoodId.value = id
  addShow.value = true
}

function onAddChange(): void {
  addShow.value = false
  pickerShow.value = true
}

function onAddConfirm(payload: AddPayload): void {
  addShow.value = false
  // 落库（2026-09-21 Boss 拍板：确认即写真实记录，供首页/最近记录/单日详情消费）
  const f = getFoodById(payload.foodId)
  if (f != null) food.addEntry(computeEntry(f, payload.amount, payload.unit, payload.meal, payload.extraKcal))
  settleKcal.value = payload.kcal
  settleAfter.value = food.totalCal
  settleMeal.value = MEAL_LABELS[payload.meal] ?? ''
  settleShow.value = true
}

/** 晚餐按稿面默认收起（点展开钮可看明细） */
const showDinner = ref(false)

function toggleDinner(): void {
  showDinner.value = !showDinner.value
}

const meals = computed<Meal[]>(() =>
  food.mealRows
    .filter((m) => m.key === 'breakfast' || m.key === 'lunch' || m.key === 'dinner')
    .map((m) => ({
      key: m.key,
      icon: MEAL_ICONS[m.key] ?? '/static/home/meal_sun.png',
      name: m.name,
      time: m.time,
      totalKcal: typeof m.cal === 'number' ? m.cal : 0,
      rows: m.details.map((d) => ({
        img: '/static/icons/' + d.img,
        name: d.name,
        portion: d.amountText,
        kcal: d.kcal,
      })),
    }))
)
</script>

<style>
.page {
  background-color: #F2FAF5;
  padding-bottom: 40px;
}
/* 常驻标题块导航栏（#28 方案A：Boss 拍板三端固定顶部，替代 P1 hm-st-mask 两态遮罩）：
   z45 全时段置顶，底色同页面底 #F2FAF5（非透明→无状态栏带穿透，也无需滚动阈值） */
.hm-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 45;
  background-color: #F2FAF5;
  padding-left: 17px;
  padding-right: 14px;
}
.hm-nav-inner {
  position: relative;
  margin-top: 6px;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
}
.hm-nav-left {
  flex-direction: column;
}
.title {
  font-size: 24px;
  font-weight: bold;
  color: #0F5B44;
}
.subtitle {
  font-size: 13px;
  color: #46706B;
  margin-top: 4px;
}
.fab {
  position: absolute;
  width: 40px;
  height: 40px;
  border-radius: 20px;
  background-image: linear-gradient(180deg, #5CD9A6, #2EB889);
  justify-content: center;
  align-items: center;
  box-shadow: 0 5px 13px rgba(31, 140, 97, 0.28);
}
.fab-plus {
  font-size: 20px;
  color: #FFFFFF;
}
/* 顶栏文档流带（随内容滚走）：仅剩日期行，paddingTop 避开常驻栏整高 */
.header {
  padding-left: 17px;
  padding-right: 14px;
}
.date-row {
  flex-direction: row;
  align-items: center;
  margin-top: 10px;
}
.date-icon {
  width: 17px;
  height: 16px;
  margin-right: 4px;
}
.date-text {
  font-size: 13px;
  color: #2F7E6E;
}
.hero {
  position: relative;
  height: 235px;
  margin-top: -18px;
}
.hero-wave {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 220px;
}
.bottle {
  position: absolute;
  left: 4px;
  top: 33px;
  width: 178px;
  height: 192px;
}
.sticker {
  position: absolute;
  right: 4px;
  top: 40px;
  width: 100px;
  height: 98px;
}
.hero-text {
  position: absolute;
  left: 173px;
  bottom: 15px;
}
.remain-head {
  flex-direction: row;
  align-items: center;
