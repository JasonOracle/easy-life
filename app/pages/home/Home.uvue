
<template>
  <view class="page">
    <!-- [变更日志] 2026-09-24: Hero 水瓶液体由 CSS 水波图重构为 BottleLiquid Canvas 2D 物理引擎渲染；瓶身/刻度/叶片独立分层，废弃 liquid_wave 水体渐变头图。同日重排第一批：补定义 status-text-coral/amber/green 死类（超标报警色此前静默失效）、顶部带压缩（spacer 220→190 / hero 470→440）、贴纸由右上悬空改入右列流内（并清除整画布 alpha≈10 白雾层）、删悬空小 leaf 改状态色竖条、宏量/餐次字号降档拉开层级阶梯。第二批 S4：.hero-text right 20→28rpx，贴纸/pill 右缘与全页卡片 margin-right 28 统一对齐轴。S7：独立宏量卡并入 hero 底缘玻璃横条（hm-macro-strip，左右 28 同轴），hero 440→552、hero-text bottom 24→136，页面白卡 3→2。第三批：FAB 与左列垂直居中（top 35rpx）、hero 渐变翻转为上白下绿（重心下沉）、贴纸矢量感高清重绘（246px→840px 白椭圆+薄荷描边+行楷双行）并从右列流内迁挂瓶卡左上空白带、左组收拢（bg 卡 352→324 / 瓶左移 12 / 右叶左移 24）使叶-字间隙 2rpx→26rpx 且 goal-pill 退出卡片边线。2026-09-25：餐次行食物图接入百科页入口（openEncyclopedia 携 foodId 跳 pages/encyclopedia/Detail）；食物图 hover 反馈由 <image> 迁到包裹 view（hover-stay-time 不支持 image，编译期 warn）；onShow 消费 ct_pending_add 一次性交接，百科「添加到本餐」回首页直接打开 FoodPicker 详情步预填该食物 -->
    <!-- 标题与操作栏（顶栏常驻+日期整合，对齐设计图规范，保证日期完全外露） -->
    <view class="hm-nav" :style="{ paddingTop: sbH + 'px' }">
      <view class="hm-nav-inner">
        <view class="hm-nav-left">
          <text class="title">{{ t('hm.brand') }}</text>
          <text class="subtitle">{{ t('hm.tagline') }}</text>
          <view class="date-row" hover-class="icon-pressed" :hover-stay-time="120" @click="onDateClick">
            <image class="date-icon" :src="'/static/home/date_icon.svg'" mode="aspectFit"></image>
            <text class="date-text">{{ dateText }}</text>
          </view>
        </view>
        <view class="fab" :style="{ right: fabRight, top: fabTop }" hover-class="icon-pressed" :hover-stay-time="120" @click="openAdd">
          <text class="fab-plus">＋</text>
        </view>
      </view>
    </view>

    <!-- 顶栏文档流占位层（为常驻导航栏腾出充足空间，确保日期完全外露不被切） -->
    <view class="header-spacer" :style="{ height: headerSpacerH }"></view>

    <!-- Hero（常驻标题块：紧接导航栏下方，纯净绿色渐变底） -->
    <view class="hero">
      <!-- 独立底层背景：柔和底色渐变 + 流体斑块 + 装饰气泡星芒（bg.svg） -->
      <image class="bottle-bg" :src="bottleAsset('bg')" mode="aspectFit"></image>
      <!-- 左侧独立叶子（yezi-zuo.svg，旋转支点在茎底，自然微风往复微摆） -->
      <image
        class="leaf-left"
        :style="{ transform: 'rotate(' + leafLeftDeg + 'deg)' }"
        @transitionend="onLeafLeftEnd"
        :src="bottleAsset('yezi-zuo')"
        mode="aspectFit"
      ></image>
      <!-- 右侧独立叶子（yezi-you.svg，旋转支点在茎底，自然微风错相往复微摆） -->
      <image
        class="leaf-right"
        :style="{ transform: 'rotate(' + leafRightDeg + 'deg)' }"
        @transitionend="onLeafRightEnd"
        :src="bottleAsset('yezi-you')"
        mode="aspectFit"
      ></image>
      <!-- 水瓶交互主体：底层内胆流体 + 表层纯净瓶身本体（pingzi.svg，独立物理动效） -->
      <view class="bottle-wrap" :style="bottleAnimStyle" @click="onBottleTap" @longpress="onBottleLongPress" @touchstart="onBottleTouchStart" @touchend="onBottleTouchEnd">
        <!-- 玻璃层（最底）：App 端 SVG 渲染不识别 evenodd 镂空，瓶体在原生端是实心色块，故液体必须叠在它之上 -->
        <image class="bottle-mask" :src="bottleAsset('pingzi')" mode="aspectFit"></image>
        <view class="bottle-cavity">
          <BottleLiquid :ratio="liquidRatio" :color-mode="liquidColorMode" :cmd-rev="liquidCmdRev" :cmd-kind="liquidCmdKind"></BottleLiquid>
        </view>
        <!-- 刻度层（最上）：水位上涨后刻度仍需可读，与玻璃层同源同几何 -->
        <image class="bottle-ticks" :src="bottleAsset('pingzi_tick')" mode="aspectFit"></image>
      </view>
      <!-- 贴纸：高清重绘后挂 hero 顶部空白带右侧（与右列 28rpx 边距同轴），DOM 序在瓶/叶之后 -->
      <image class="hm-sticker" :src="stickerSrc" mode="aspectFit"></image>
      <view class="hero-text">
        <view class="remain-head">
          <view class="hm-status-bar" :style="{ backgroundColor: calStatus.color }"></view>
          <text class="remain-label" :class="calStatus.textClass">{{ remainCal >= 0 ? t('hm.remain') : t('pf.over') }}</text>
        </view>
        <view class="remain-num-row">
          <text class="remain-num" :class="calStatus.textClass">{{ Math.abs(remainCal) }}</text>
          <text class="remain-unit" :class="calStatus.textClass">kcal</text>
        </view>
        <text class="consumed">{{ tf('hm.consumed', [food.totalCal.toString(), goal.calorieGoal.toString()]) }}</text>
        <view class="goal-pill ui-pressable" hover-class="ui-pressed" :hover-stay-time="120" @click="openGoal">
          <image class="pill-cal" :src="'/static/home/pill_calendar.svg'" mode="aspectFit"></image>
          <text class="goal-pill-text">{{ tf('hm.goalPill', [goal.calorieGoal.toString()]) }}</text>
          <image class="pill-edit" :src="'/static/home/pill_edit.svg'" mode="aspectFit"></image>
        </view>
      </view>
      <!-- 宏量横条（S7）：原独立宏量卡收进 hero 底缘第三段，页面白卡 3→2，打破三连同族卡 -->
      <view class="hm-macro-strip">
        <view class="hm-macro-cell">
          <image class="hm-macro-ic" :src="'/static/home/macro_protein.svg'" mode="aspectFit"></image>
          <view class="hm-macro-txt">
            <text class="hm-macro-val">{{ macroP }}g</text>
            <text class="hm-macro-cap">{{ t('dd.protein') }}</text>
          </view>
        </view>
        <view class="hm-macro-sep"></view>
        <view class="hm-macro-cell">
          <image class="hm-macro-ic" :src="'/static/home/macro_carb.svg'" mode="aspectFit"></image>
          <view class="hm-macro-txt">
            <text class="hm-macro-val">{{ macroC }}g</text>
            <text class="hm-macro-cap">{{ t('dd.carb') }}</text>
          </view>
        </view>
        <view class="hm-macro-sep"></view>
        <view class="hm-macro-cell">
          <image class="hm-macro-ic" :src="'/static/home/macro_fat.svg'" mode="aspectFit"></image>
          <view class="hm-macro-txt">
            <text class="hm-macro-val">{{ macroF }}g</text>
            <text class="hm-macro-cap">{{ t('dd.fat') }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 今日餐次 -->
    <view class="meal-section-head">
      <text class="meal-section-title">{{ t('hm.mealSec') }}</text>
      <view class="all-records">
        <text class="all-records-text">{{ t('hm.allRec') }}</text>
        <image class="chev-right" :src="'/static/home/chev_right.svg'" mode="aspectFit"></image>
      </view>
    </view>

    <view class="meal-block" v-for="(meal, mealIdx) in meals" :key="mealIdx">
      <view class="meal-rail">
        <view class="meal-circle">
          <image class="meal-circle-icon" :src="meal.icon" mode="aspectFit"></image>
        </view>
        <view class="rail-line" v-if="mealIdx < meals.length - 1"></view>
      </view>
      <view class="meal-main">
        <view class="meal-head">
          <text class="meal-name">{{ meal.name }}<text class="meal-time"> · {{ meal.time }}</text></text>
          <text class="meal-kcal">{{ meal.totalKcal }} kcal</text>
        </view>
        <view class="meal-card">
          <view v-if="meal.rows.length === 0" class="meal-empty">
            <text class="meal-empty-txt">{{ t('dd.none') }}</text>
          </view>
          <view v-else>
            <view v-for="(rowItem, rowIdx) in meal.rows" :key="rowIdx">
              <view class="meal-row" @longpress="onFoodLongPress(rowItem.id, rowItem.name)">
                <view class="meal-thumb-hit" hover-class="icon-pressed" :hover-stay-time="120" @click="openEncyclopedia(rowItem.img)">
                  <image class="meal-thumb" :src="rowItem.img" mode="aspectFill"></image>
                </view>
                <text class="meal-row-name">{{ rowItem.name }}</text>
                <text class="meal-row-portion">{{ rowItem.portion }}</text>
                <text class="meal-row-kcal">{{ rowItem.kcal }} kcal</text>
              </view>
              <view class="meal-row-div" v-if="rowIdx < meal.rows.length - 1"></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部 Tab（共享组件：液态玻璃悬浮胶囊，三 Tab 首页／日历／我的） -->
    <Tabbar active="home" ></Tabbar>

    <!-- 弹层⓪ 食物选择与添加单流程（列表+详情内部无缝切换） -->
    <FoodPicker v-model:show="pickerShow" :selected-id="pickerSelectedId" :start-step="pickerStartStep" @confirm="onAddConfirm" ></FoodPicker>
    <SettleBadge v-model:show="settleShow" :kcal="settleKcal" :after="settleAfter" :goal="goal.calorieGoal" :meal="settleMeal" @close="onSettleClose" ></SettleBadge>
    <GoalModal v-model:show="goalShow" :initial="goal.calorieGoal" @save="goal.setGoal" ></GoalModal>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { onShow } from '@dcloudio/uni-app'

/**
 * 演示数据（稿面静态值，store 重建后再接真实数据）。
 * 缩放系数 0.794：v2 画布 472px → 应用 375px。
 */

// 状态栏高度（自定义导航时顶栏避让）
let sbH = 0
let winW = 375
try {
  const sysInfo = uni.getSystemInfoSync()
  sbH = sysInfo.statusBarHeight ?? 0
  winW = sysInfo.windowWidth ?? 375
} catch (e) {
  sbH = 0
  winW = 375
}

// 顶栏占位高度：原生端 :style 不接受 rpx+px 跨单位 calc，按 750 稿宽在 UTS 侧折算为 px
const headerSpacerH = (190 / 750 * winW + sbH) + 'px'

// TabBar 随滚动渐显（#29）已于 2026-09-22 随液态玻璃胶囊重构整体废弃：新胶囊恒常可见，
// 本页因此不再需要任何滚动监听（#28 定案的常驻标题块 .hm-nav 无阈值）

// 右上加号位置：默认与左侧标题列垂直居中（左列约 149rpx 高，FAB 80rpx → top 35rpx）；小程序端放到胶囊左侧防遮挡
const fabRight = ref('14px')
const fabTop = ref('35rpx')
// #ifdef MP-WEIXIN
try {
  const sys = uni.getSystemInfoSync()
  const capsule = uni.getMenuButtonBoundingClientRect()
  if (capsule != null && capsule.left > 0) {
    fabRight.value = (sys.windowWidth - capsule.left + 10) + 'px'
    fabTop.value = (capsule.top - (sys.statusBarHeight ?? 0)) + 'px'
  }
} catch (e) {
  // 取不到胶囊信息时保持默认位置
}
// #endif

import Tabbar from '../../components/Tabbar.uvue'
import { computed } from 'vue'
import FoodPicker from '../../components/FoodPicker.uvue'
import type { AddPayload } from '../../components/FoodPicker.uvue'
import SettleBadge from '../../components/SettleBadge.uvue'
import GoalModal from '../../components/GoalModal.uvue'
import { useFoodStore } from '../../stores/food'
import { useGoalStore, getCalorieStatus } from '../../stores/goal'
import { t, tf } from '../../composables/i18n'
import { getFoodById, computeEntry } from '../../stores/food'
import { playSound, triggerHaptic } from '../../stores/settings'
import { foodIdFromImg } from '../../stores/encyclopedia'
import BottleLiquid from '../../components/BottleLiquid.uvue'

/**
 * 接 store 读数（今日种子精确还原 v2 行：早 420 / 午 560 / 晚 390，宏量 68/156/42）。
 * 稿面「已摄入 1270 / 还能吃 530」自身与餐和 1370 矛盾，以 store 真值（1368/432）为准。
 */
const food = useFoodStore()
const goal = useGoalStore()

const remainCal = computed(() => goal.calorieGoal - food.totalCal)
const calStatus = computed(() => getCalorieStatus(food.totalCal, goal.calorieGoal))

const macroP = computed(() => Math.round(food.totalProtein))
const macroC = computed(() => Math.round(food.totalCarbs))
const macroF = computed(() => Math.round(food.totalFat))

// 瓶身内胆几何参数与最高水位硬约束（Boss 规则：最高不超过肩线，视觉上液体不进入瓶颈收窄区）
const CAVITY_HEIGHT = 236 // 与 CSS .bottle-cavity (236rpx) 一致
const MAX_FILL_RATIO = 0.68 // 对应瓶身肩线位置（原 0.80 会溢出到瓶颈视觉区）

// 瓶身流体动效状态
const bottleScale = ref(1)
const bottleRotate = ref(0)
const bottleTranslateX = ref(0)
const bottleTransition = ref('transform 0.08s ease-out')

// New liquid engine props (replaces liquidWave/pourOffset/waveX)
const liquidRatio = computed<number>(() => {
  const g = goal.calorieGoal > 0 ? goal.calorieGoal : 2000
  return Math.min(Math.max((food.totalCal / g) * MAX_FILL_RATIO, 0.06), MAX_FILL_RATIO)
})
const liquidColorMode = computed<string>(() => {
  if (calStatus.value.type === 'coral') return 'coral'
  if (calStatus.value.type === 'amber') return 'amber'
  return 'green'
})
/** 瓶身/树叶 SVG 资产后缀：随状态色切换，绿版为原文件不带后缀 */
const bottleSrc = computed<string>(() => {
  const t = calStatus.value.type
  return t === 'coral' ? 'coral' : t === 'amber' ? 'amber' : ''
})
function bottleAsset(base: string): string {
  const s = bottleSrc.value
  return '/static/home/' + base + (s ? '_' + s : '') + '.svg'
}
/** 贴纸文案：三档对应不同鼓励语，绿版为原稿不动 */
const stickerSrc = computed<string>(() => {
  const t = calStatus.value.type
  if (t === 'coral') return '/static/home/sticker_coral.png'
  if (t === 'amber') return '/static/home/sticker_amber.png'
  return '/static/home/sticker_green.png'
})
const liquidCmdRev = ref(0)
const liquidCmdKind = ref('')

const bottleAnimStyle = computed(() => {
  return {
    transform: `translateX(${bottleTranslateX.value}rpx) rotate(${bottleRotate.value}deg) scale(${bottleScale.value})`,
    transformOrigin: '50% 96%',
    transition: bottleTransition.value
  }
})

// 树叶自然往复微风摆动状态
const leafLeftDeg = ref(0)
const leafRightDeg = ref(0)
const leafLeftDir = ref(1)
const leafRightDir = ref(1)
const leafSwinging = ref(false)

function onLeafLeftEnd(): void {
  if (!leafSwinging.value) return
  leafLeftDir.value = -leafLeftDir.value
  leafLeftDeg.value = 2.5 * leafLeftDir.value
}

function onLeafRightEnd(): void {
  if (!leafSwinging.value) return
  leafRightDir.value = -leafRightDir.value
  leafRightDeg.value = -2.2 * leafRightDir.value
}

onMounted(() => {
  leafSwinging.value = true
  setTimeout(() => {
    leafLeftDeg.value = 2.5
    leafRightDeg.value = -2.2
  }, 200)
})

onUnmounted(() => {
  leafSwinging.value = false
})

let tapTimers: any[] = []

function clearTapTimers() {
  for (let i = 0; i < tapTimers.length; i++) {
    clearTimeout(tapTimers[i])
  }
  tapTimers = []
}

function onBottleTap() {
  playSound('click')
  triggerHaptic('light')
  clearTapTimers()

  // Bottle body pendulum kick (engine handles liquid response)
  bottleScale.value = 1
  bottleTranslateX.value = 0
  bottleTransition.value = 'transform 0.075s cubic-bezier(0.2, 0, 0, 1)'
  bottleRotate.value = -14

  tapTimers.push(setTimeout(() => {
    bottleRotate.value = 24
    tapTimers.push(setTimeout(() => {
      bottleRotate.value = -16
      tapTimers.push(setTimeout(() => {
        bottleRotate.value = 8
        tapTimers.push(setTimeout(() => {
          bottleRotate.value = -3
          tapTimers.push(setTimeout(() => {
            bottleRotate.value = 0
          }, 60))
        }, 65))
      }, 70))
    }, 75))
  }, 85))

  // Send tap command to liquid engine
  liquidCmdKind.value = 'tap'
  liquidCmdRev.value++
}

let pressTimers: any[] = []
let isHolding = false

function clearPressTimers() {
  for (let i = 0; i < pressTimers.length; i++) {
    clearTimeout(pressTimers[i])
  }
  pressTimers = []
}

function onBottleTouchStart(): void {
  isHolding = true
}

function onBottleTouchEnd(): void {
  isHolding = false
  liquidCmdKind.value = 'shake_end'
  liquidCmdRev.value++
  clearPressTimers()
  // Decay bottle body motion
  bottleTransition.value = 'transform 0.3s cubic-bezier(0.2, 0, 0, 1)'
  bottleTranslateX.value = 0
}

function onBottleLongPress() {
  playSound('shake')
  triggerHaptic('heavy')
  clearPressTimers()

  bottleScale.value = 1
  bottleRotate.value = 0
  bottleTransition.value = 'transform 0.035s ease-out'

  // Start agitation command
  liquidCmdKind.value = 'shake_start'
  liquidCmdRev.value++

  // Sustained body shake while held
  let dir = 1
  function shakeStep(amp: number): void {
    if (!isHolding) return
    bottleTranslateX.value = amp * dir
    dir = -dir
    pressTimers.push(setTimeout(() => {
      shakeStep(Math.max(3, amp - 1))
    }, 50))
  }
  shakeStep(8)
}

function onDateClick() {
  playSound('click')
  triggerHaptic('light')
  openRecords()
}

type MealRow = {
  id: string
  img: string
  name: string
  portion: string
  kcal: number
}

type Meal = {
  key: string
  icon: string
  name: string
  time: string
  totalKcal: number
  rows: MealRow[]
}

const MEAL_ICONS: Record<string, string> = {
  breakfast: '/static/home/meal_sun.svg',
  lunch: '/static/home/meal_sun_l.svg',
  dinner: '/static/home/meal_moon.svg',
  snack: '/static/home/meal_snack.svg',
}

/** 弹层⓪ 选择并添加食物（确认写库＋弹弹层③ 结算徽章）；Pill 铅笔 → GoalModal */
const pickerShow = ref(false)
const pickerSelectedId = ref('')
const pickerStartStep = ref('list')
const settleShow = ref(false)
const settleKcal = ref(0)
const settleAfter = ref(0)
const settleMeal = ref('')
const goalShow = ref(false)

function openGoal(): void {
  triggerHaptic('light')
  goalShow.value = true
}

function openRecords(): void {
  // Records 已升级为一级 Tab 页（无返回钮）→ 用 redirectTo 换页，不压栈
  uni.redirectTo({ url: '/pages/records/Records' })
}


function openAdd(): void {
  playSound('click')
  triggerHaptic('light')
  pickerSelectedId.value = ''
  pickerStartStep.value = 'list'
  pickerShow.value = true
}

function onFoodLongPress(entryId: string, foodName: string): void {  triggerHaptic('medium')
  uni.showActionSheet({
    itemList: [tf('hm.del', [foodName])],
    itemColor: '#FA543A',
    success: (res) => {
      if (res.tapIndex === 0) {
        food.removeEntry(entryId)
        playSound('delete')
      }
    }
  })
}

/** 百科入口：食物图（"cat/pNNN.webp" 或全路径）解析出 id 后跳详情页 */
function openEncyclopedia(img: string): void {
  const fid = foodIdFromImg(img)
  if (fid.length == 0) return
  triggerHaptic('light')
  uni.navigateTo({ url: '/pages/encyclopedia/Detail?id=' + fid })
}

/** 百科「添加到本餐」一次性交接：读到即清，避免二次 onShow 重复弹层 */
onShow(() => {
  const raw = uni.getStorageSync('ct_pending_add')
  if (raw == null || raw == '') return
  uni.removeStorageSync('ct_pending_add')
  const pending = raw as UTSJSONObject
  const pid = pending.getString('id') ?? ''
  if (pid.length == 0 || getFoodById(pid) == null) return
  pickerSelectedId.value = pid
  pickerStartStep.value = 'detail'
  pickerShow.value = true
})

function onAddConfirm(payload: AddPayload): void {
  // 落库（2026-09-21 Boss 拍板：确认即写真实记录，供首页/最近记录/单日详情消费）
  const f = getFoodById(payload.foodId)
  if (f != null) food.addEntry(computeEntry(f, payload.amount, payload.unit, payload.meal, payload.extraKcal))
  settleKcal.value = payload.kcal
  settleAfter.value = food.totalCal
  settleMeal.value = t('meal.' + payload.meal)
  settleShow.value = true
  
  playSound('success')
}

function onSettleClose(): void {
  // Trigger pour animation when settle badge closes
  liquidCmdKind.value = 'pour'
  liquidCmdRev.value++
}

/** 顶部日期：原为稿面占位「9月19日 · 周五」，现取真实当天并随语言出 中文/英文 两种格式 */
const dateText = computed<string>(() => {
  const nowD = new Date()
  const idx = (nowD.getDay() + 6) % 7
  const wd = idx == 6 ? t('pf.d0') : t('pf.d' + (idx + 1).toString())
  return tf('hm.date', [(nowD.getMonth() + 1).toString(), nowD.getDate().toString(), wd])
})

const meals = computed<Meal[]>(() =>
  food.mealRows
    .filter((m) => m.key === 'breakfast' || m.key === 'lunch' || m.key === 'dinner' || m.key === 'snack')
    .map((m) => ({
      key: m.key,
      icon: MEAL_ICONS[m.key] ?? '/static/home/meal_sun.svg',
      name: t('meal.' + m.key),
      time: m.time,
      totalKcal: typeof m.cal === 'number' ? m.cal : 0,
      rows: m.details.map((d) => ({
        id: d.id,
        img: '/static/icons/' + d.img,
        name: d.name,
        portion: d.amountText,
        kcal: d.kcal,
      })),
    }))
)
</script>

