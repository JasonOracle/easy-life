
<script setup lang="uts">
import { onLaunch } from '@dcloudio/uni-app'
import { useDeviceStore } from './stores/device'

onLaunch(() => {
  // 触发 device store 初始化（state 内自调 detectDeviceCapability，无单独 detect 方法）
  useDeviceStore()

  // 检查并处理隐私授权状态
  uni.getPrivacySetting({
    success: (res) => {
      if (res.needAuthorization) {
        uni.openDialogPage({
          url: '/pages/privacy/PrivacyDialog'
        })
      }
    }
  })
})
</script>

<style>
/* 全局单类热量状态颜色 */
.clr-mint { color: #1FBF8F; }
.clr-amber { color: #E8B54D; }
.clr-coral { color: #FF9E7D; }
.bg-mint { background-color: #1FBF8F; }
.bg-amber { background-color: #E8B54D; }
.bg-coral { background-color: #FF9E7D; }

/* 原生按压交互类 (配合 hover-class="ui-pressed") */
.ui-pressable {
  /* #ifdef MP-WEIXIN */
  transition: transform 0.16s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.16s ease-out, box-shadow 0.16s ease-out;
  /* #endif */
}

.ui-pressed {
  transform: scale(0.965) !important;
  opacity: 0.85 !important;
  /* 按下时极快进入 */
  /* #ifdef MP-WEIXIN */
  transition: transform 0.08s cubic-bezier(0.2, 0, 0, 1), opacity 0.08s ease-out, box-shadow 0.08s ease-out !important;
  /* #endif */
}

.icon-pressed {
  transform: scale(0.92) !important;
  opacity: 0.7 !important;
  /* #ifdef MP-WEIXIN */
  transition: transform 0.08s cubic-bezier(0.2, 0, 0, 1), opacity 0.08s ease-out !important;
  /* #endif */
}
</style>