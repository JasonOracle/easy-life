/**
 * [变更日志]
 * 修改时间：2026-09-19
 * AI模型：CodeBuddy (GLM-5.3-Flash)
 * 修改内容：[新建：底部 Tabbar（ScreenSpecs「TabbarWrap」实测规格）——
 *           Hairline 0.5 #D6E9E1 + 玻璃底 h78（rgba(255,255,255,.74)，backdrop-blur
 *           真机未验证，按项目惯例降级为半透明白）+ 页签 首页/我的（flex1）+
 *           中间 58 占位 + AddButton 58×58 上凸 14 双层薄荷阴影。
 *           页签图标为 CSS 形状（MealIcon 先例，uvue 画不了 SVG）；
 *           跳转 uni.reLaunch（v1.0 简单可靠）；加号 emit('add') 由页面自行消费。
 *           安全区：padding-bottom 叠加 env(safe-area-inset-bottom)（不支持时回退 21px）。]
 */

<template>
  <view class="tabbar-wrap">
    <!-- 上凸加号：58×58，圆心对齐中间 58 占位 -->
    <view class="add-btn" @click="onAdd">
      <view class="add-h" />
      <view class="add-v" />
    </view>

    <view class="hairline" />
    <view class="tabbar">
      <!-- 首页 -->
      <view class="tab" @click="goHome">
        <view class="ic-home" :class="active === 'home' ? 'on' : 'off'">
          <view class="ic-home-roof" />
          <view class="ic-home-body" />
        </view>
        <text class="tab-label" :class="active === 'home' ? 't-on' : 't-off'">首页</text>
      </view>

      <view class="mid-spacer" />

      <!-- 我的 -->
      <view class="tab" @click="goProfile">
        <view class="ic-user" :class="active === 'profile' ? 'on' : 'off'">
          <view class="ic-user-head" />
          <view class="ic-user-body" />
        </view>
        <text class="tab-label" :class="active === 'profile' ? 't-on' : 't-off'">我的</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
const props = defineProps({
  /** 当前激活页签：home / profile */
  active: { type: String, default: 'home' },
})
const emit = defineEmits(['add'])

function goHome() {
  uni.reLaunch({ url: '/pages/home/Home' })
}
function goProfile() {
  uni.reLaunch({ url: '/pages/profile/Profile' })
}
function onAdd() {
  emit('add')
}
</script>

<style>
.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
}
.hairline {
  height: 0.5px;
  background-color: #D6E9E1;
}
.tabbar {
  height: 78px;
  flex-direction: row;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.74);
  /* 安全区：真机 iPhone 底部 Home 指示条，不支持 env 时回退 21px 设计值 */
  padding-bottom: 21px;
  padding-bottom: calc(21px + env(safe-area-inset-bottom));
}

/* ── 页签 ── */
.tab {
  flex: 1;
  height: 57px;
  align-items: center;
  justify-content: center;
  gap: 3px;
}
.mid-spacer {
  width: 58px;
  height: 10px;
}
.tab-label {
  font-size: 10px;
  font-weight: 500;
}
.t-on { color: #0A4F3D; }
.t-off { color: #A9BAB3; }

/* ── 首页图标（房子：三角顶 + 圆角方体，24 盒内居中）── */
.ic-home {
  width: 24px;
  height: 24px;
  align-items: center;
  justify-content: center;
}
.ic-home-roof {
  width: 0;
  height: 0;
  border-left: 10px solid transparent;
  border-right: 10px solid transparent;
  border-bottom: 9px solid #A9BAB3;
}
.ic-home-body {
  width: 14px;
  height: 8px;
  border-radius: 2px 2px 3px 3px;
  margin-top: 1px;
  background-color: #A9BAB3;
}
.ic-home.on .ic-home-roof { border-bottom-color: #1FBF8F; }
.ic-home.on .ic-home-body { background-color: #1FBF8F; }

/* ── 我的图标（人形：圆头 + 肩弧）── */
.ic-user {
  width: 24px;
  height: 24px;
  align-items: center;
  justify-content: center;
}
.ic-user-head {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background-color: #A9BAB3;
}
.ic-user-body {
  width: 14px;
  height: 7px;
  border-radius: 7px 7px 3px 3px;
  margin-top: 2px;
  background-color: #A9BAB3;
}
.ic-user.on .ic-user-head { background-color: #1FBF8F; }
.ic-user.on .ic-user-body { background-color: #1FBF8F; }

/* ── 上凸加号（ScreenSpecs：58×58 y=-14，双层薄荷阴影 showBehind）── */
.add-btn {
  position: absolute;
  left: 50%;
  margin-left: -29px;
  bottom: 64px;   /* = tabbar 78 - 上凸 14；加号锚在 tabbar 顶缘上方 */
  width: 58px;
  height: 58px;
  border-radius: 29px;
  background-image: linear-gradient(180deg, #7DEBC7, #1FBF8F);
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 14px rgba(13,120,90,0.32), 0 12px 26px rgba(13,120,90,0.18);
}
.add-h {
  width: 22px;
  height: 2.5px;
  border-radius: 1.5px;
  background-color: #FFFFFF;
  position: absolute;
}
.add-v {
  width: 2.5px;
  height: 22px;
  border-radius: 1.5px;
  background-color: #FFFFFF;
  position: absolute;
}
</style>
