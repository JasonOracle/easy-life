/**
 * [变更日志]
 * 修改时间：2026-09-19
 * AI模型：CodeBuddy (DeepSeek-V4.1-Flash)
 * 修改内容：[新建：通用底部弹层壳（遮罩 + 面板 + 抓手 + slot）。
 *           规格：Ardot 节点 3:266(SheetMask)/3:267(AddSheet) 实测——
 *           面板 r34 顶部圆角、底面 #FBFEFC、向上投影 0 -8 32 a0.18、
 *           把手 36×4 r2 @y8。添加食物 Sheet 与食物选择 Sheet 复用。]
 */

<template>
  <view v-if="show" class="shell">
    <view class="mask" @click="onClose" />
    <view class="panel">
      <view class="handle" />
      <slot />
    </view>
  </view>
</template>

<script setup lang="uts">
const props = defineProps({
  /** 是否显示（v-if 整层卸载/挂载） */
  show: { type: Boolean, default: false },
})
const emit = defineEmits(['close'])
function onClose() {
  emit('close')
}
</script>

<style>
.shell {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}
/* 设计稿 3:266 的 fill 导出为不透明 #0B4F3C，全屏不透明会完全盖住首页、不符合
   「弹层可透见被盖内容」的常识 —— 按 dim 半透明实现，待与设计稿渲染对比后微调 */
.mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(11, 79, 60, 0.55);
}
.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FBFEFC;
  border-top-left-radius: 34px;
  border-top-right-radius: 34px;
  /* 向上投影（3:267 实测） */
  box-shadow: 0 -8px 32px rgba(10, 79, 61, 0.18);
  padding: 10px 18px 18px;
}
.handle {
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background-color: #0A4F3D;
  align-self: center;
  margin-top: 8px;
}
</style>
