/**
 * [变更日志]
 * 修改时间：2026-09-19
 * AI模型：CodeBuddy (DeepSeek-V4.1-Flash)
 * 修改内容：[新建：食物选择 Sheet（Ardot 3:494）—— 首个接真实数据的 UI：
 *           数据源 app/data/food_library.json（347 条，生成物只读）；
 *           搜索（名称包含匹配）+ 分类 Tab（比设计稿多「菜品」，ScreenSpecs §3 缺项）+
 *           scroll-view 列表（图标=库内真实图）；选中联动待接 store，本轮 emit('pick')。
 *           追记：移除 DEBUG 旁路（allFoods=buildFoods() 恢复 347 条解析）；
 *           「组件不渲染」根因是 dist 缺 .json（增量编译 bug），与数据解析无关。
 *           追记2：库解析收编到 stores/food_store.ts（模块级一次），本组件改引用
 *           ALL_FOODS——AddSheet 也要同一份库数据，避免双份解析。
 *           追记3：适配 food.ts 新字段（kcal 替代 cal，per 字段移除——统一每100g/ml）。]
 */

<template>
  <SheetShell :show="show" @close="emit('close')">
    <view class="body">
      <view class="search-bar">
        <view class="search-icon" />
        <input
          class="search-input"
          type="text"
          :value="keyword"
          placeholder="搜索食物 · 支持拼音 / 别名"
          placeholder-style="color:#A9BAB3;font-size:13.5px"
          @input="onInput"
        />
      </view>

      <scroll-view class="tabs-scroll" scroll-x :show-scrollbar="false">
        <view class="tabs">
          <view v-for="c in cats" :key="c" class="cat-tag" :class="cat === c ? 'sel' : 'idle'" @click="cat = c">
            <text class="cat-text" :class="cat === c ? 't-sel' : 't-idle'">{{ c }}</text>
          </view>
        </view>
      </scroll-view>

      <scroll-view class="list-scroll" scroll-y>
        <view class="food-list">
          <view v-for="f in filtered" :key="f.id" class="food-item" @click="onPick(f)">
            <image class="f-icon" :src="'/static/icons/' + f.img" />
            <view class="f-col">
              <text class="f-name">{{ f.name }}</text>
              <text class="f-conf">{{ confText(f.conf) }}</text>
            </view>
            <view class="f-cal">
              <text class="f-cal-val">{{ f.kcal }}</text>
              <text class="f-cal-unit">kcal/100{{ f.unit }}</text>
            </view>
          </view>
          <view v-if="filtered.length === 0" class="empty">
            <text class="empty-text">没有找到「{{ keyword }}」</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </SheetShell>
</template>

<script setup lang="uts">
import SheetShell from './SheetShell.uvue'
import { ALL_FOODS, type FoodBase } from '../stores/food_store.ts'

const props = defineProps({ show: { type: Boolean, default: false } })
const emit = defineEmits(['close', 'pick'])

// 设计稿 7 个 Tab + 「菜品」（ScreenSpecs §3 缺项，数据侧补齐）
const cats: string[] = ['全部', '主食', '菜品', '肉类蛋类', '蔬菜', '水果', '饮品', '零食']

const keyword = ref('')
const cat = ref('全部')

function onInput(e: InputEvent) {
  keyword.value = e.detail.value
}

// 库数据已由 store 模块级解析（347 条一次），这里直接引用
const allFoods: FoodBase[] = ALL_FOODS

const filtered = computed((): FoodBase[] => {
  return allFoods.filter((f: FoodBase): boolean => {
    const okCat = cat.value === '全部' || f.cat === cat.value
    const okKw = keyword.value === '' || f.name.indexOf(keyword.value) !== -1
    return okCat && okKw
  })
})

// conf=1 为估算值，UI 标注（FoodLibraryPlan 要求）
function confText(conf: number): string {
  return conf === 1 ? '估算' : ''
}

function onPick(f: FoodBase) {
  emit('pick', f.id)
}
</script>

<style>
.body { gap: 12px; height: 460px; }
.search-bar {
  height: 44px; border-radius: 22px; flex-direction: row; align-items: center;
  gap: 8px; padding: 0 14px; background-color: #FFFFFF; border: 1px solid #DCEDE6;
}
.search-icon { width: 14px; height: 14px; border-radius: 8px; border: 1.5px solid rgba(15,79,61,0.34); }
.search-input { flex: 1; font-size: 13.5px; color: #0A4F3D; }
.tabs-scroll { width: 100%; }
.tabs { flex-direction: row; gap: 8px; padding: 4px 0; }
.cat-tag { padding: 6px 14px; border-radius: 20px; }
.cat-tag.sel { background-color: #1FBF8F; }
.cat-tag.idle { background-color: #F8F9FC; }
.cat-text { font-size: 12.5px; }
.t-sel { color: #FFFFFF; font-weight: 500; }
.t-idle { color: rgba(15,79,61,0.6); }
.list-scroll { flex: 1; }
.food-list { gap: 2px; }
.food-item {
  flex-direction: row; align-items: center; gap: 12px; padding: 8px;
  border-radius: 12px;
}
.f-icon { width: 40px; height: 40px; border-radius: 10px; }
.f-col { flex: 1; gap: 2px; }
.f-name { font-size: 14px; font-weight: 500; color: #0A4F3D; }
.f-conf { font-size: 10px; color: #A9BAB3; }
.f-cal { flex-direction: row; align-items: center; gap: 3px; }
.f-cal-val { font-size: 14px; font-weight: 600; color: #0A7A5C; font-variant-numeric: tabular-nums; }
.f-cal-unit { font-size: 10px; color: #A9BAB3; }
.empty { padding: 30px 0; align-items: center; }
.empty-text { font-size: 13px; color: rgba(15,79,61,0.34); }
</style>

