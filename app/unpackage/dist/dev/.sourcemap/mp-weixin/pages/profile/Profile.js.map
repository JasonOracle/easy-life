/**
 * [变更日志]
 * 修改时间：2026-09-19
 * AI模型：CodeBuddy (DeepSeek-V4.1-Flash)
 * 修改内容：[「我的」页从占位升级为完整结构（Ardot 3:573 及子节点 3:608/612/643/654 实测还原）：
 *           液体头图218（头像+统计条）/ 波浪收边（CSS 圆近似，设计稿为 SVG path）/
 *           周概览玻璃卡（徽章+七颗液滴：达标#5BD3AC·超标#FF9E7D·空缺#D5E5DD·今天#1FBF8F+描边）/
 *           趋势柱状图（底部对齐+目标线+目标标签）/ 历史 3 行（StatusDot 状态）。
 *           数据全部为设计稿演示值，待接 store。]
 */

<template>
  <view class="page">
    <!-- 液体头图 -->
    <view class="hero">
      <view class="status-bar" />
      <view class="avatar-row">
        <view class="avatar"><text class="avatar-char">卡</text></view>
        <view class="name-col">
          <text class="name">卡路里记录者</text>
          <text class="name-sub">已坚持记录 38 天</text>
        </view>
      </view>
      <view class="stat-bar">
        <view class="stat">
          <text class="stat-val">126</text>
          <text class="stat-label">累计记录</text>
        </view>
        <view class="stat-divider" />
        <view class="stat">
          <text class="stat-val">1350</text>
          <text class="stat-label">日均摄入 kcal</text>
        </view>
      </view>
      <!-- 波浪收边：CSS 椭圆近似设计稿 SVG path（形差已标注） -->
      <view class="wave w1" />
      <view class="wave w2" />
      <view class="bubble b1" />
      <view class="bubble b2" />
      <view class="bubble b3" />
    </view>

    <view class="content">
      <!-- 本周概览玻璃卡 -->
      <view class="week-card">
        <view class="week-head">
          <text class="week-title">本周概览</text>
          <view class="week-badge"><text class="week-badge-text">达标 4 天</text></view>
        </view>
        <view class="week-drops">
          <view v-for="d in drops" :key="d.day" class="drop">
            <view class="drop-shape" :class="d.state" />
            <text class="drop-day" :class="{ today: d.state === 'today' }">{{ d.day }}</text>
          </view>
        </view>
      </view>

      <!-- 历史趋势 -->
      <view class="trend">
        <text class="trend-title">历史趋势 · 本周</text>
        <view class="chart">
          <view v-for="(b, i) in bars" :key="i" class="bar" :class="b.type" :style="barStyle(b.h)" />
          <view class="goal-line" />
          <view class="goal-tag"><text class="goal-tag-text">目标 1800</text></view>
        </view>
        <view class="history">
          <view v-for="h in history" :key="h.date" class="h-row">
            <text class="h-date">{{ h.date }}</text>
            <view class="h-cal">
              <text class="h-val">{{ h.cal }}</text>
              <text class="h-unit">kcal</text>
            </view>
            <view class="h-status">
              <view class="h-dot" :class="h.over ? 'dot-over' : 'dot-ok'" />
              <text class="h-status-text" :class="h.over ? 't-over' : 't-ok'">{{ h.over ? '超标' : '达标内' }}</text>
            </view>
          </view>
        </view>
        <text class="view-all">查看全部 ›</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
// ── 演示数据（Ardot 3:612/3:643/3:654 原文照抄，非编造）── 待接 store
type Drop = { day: string, state: string }
const drops: Drop[] = [
  { day: '一', state: 'ok' }, { day: '二', state: 'ok' }, { day: '三', state: 'ok' },
  { day: '四', state: 'ok' }, { day: '五', state: 'over' }, { day: '六', state: 'empty' },
  { day: '日', state: 'today' },
]
type Bar = { h: number, type: string }
const bars: Bar[] = [
  { h: 68, type: 'ok' }, { h: 54, type: 'ok' }, { h: 80, type: 'ok' }, { h: 62, type: 'ok' },
  { h: 92, type: 'over' }, { h: 8, type: 'empty' }, { h: 74, type: 'today' },
]
type His = { date: string, cal: string, over: boolean }
const history: His[] = [
  { date: '9月18日 · 周五', cal: '1950', over: true },
  { date: '9月17日 · 周四', cal: '1720', over: false },
  { date: '9月16日 · 周三', cal: '1580', over: false },
]
function barStyle(h: number): string {
  return 'height: ' + h.toString() + 'px;'
}
</script>

<style>
.page { flex: 1; background-color: #F2FAF5; }
.status-bar { height: 62px; }

/* ── 液体头图（3:574：h218 渐变 180°）── */
.hero {
  height: 218px; padding: 0 18px;
  background-image: linear-gradient(180deg, #7DEBC7, #1FBF8F);
  position: relative; overflow: hidden;
}
.avatar-row { flex-direction: row; align-items: center; gap: 14px; padding: 8px 0 18px; }
.avatar {
  width: 62px; height: 62px; border-radius: 20px;
  background-color: #FFFFFF; border: 2px solid #FFFFFF;
  align-items: center; justify-content: center;
}
/* 渐变裁字（background-clip:text）uvue 不支持 → 纯色深绿近似 */
.avatar-char { font-size: 26px; font-weight: 700; color: #0A7A5C; }
.name-col { gap: 4px; }
.name { font-size: 17px; font-weight: 600; color: #FFFFFF; }
.name-sub { font-size: 12px; color: rgba(255,255,255,0.82); }
.stat-bar {
  height: 64px; border-radius: 18px;
  flex-direction: row; align-items: center;
  background-color: rgba(255,255,255,0.92); border: 1px solid #FFFFFF;
}
.stat { flex: 1; align-items: center; gap: 2px; }
.stat-val { font-size: 20px; font-weight: 700; color: #0A4F3D; letter-spacing: -0.5px; font-variant-numeric: tabular-nums; }
.stat-label { font-size: 11px; color: rgba(15,79,61,0.6); }
.stat-divider { width: 1px; height: 30px; background-color: rgba(255,255,255,0.9); }

/* 波浪收边近似（设计稿为 SVG path 375×44） */
.wave { position: absolute; border-radius: 50%; background-color: #F2FAF5; }
.w1 { width: 260px; height: 70px; left: -70px; bottom: -42px; }
.w2 { width: 300px; height: 80px; right: -90px; bottom: -52px; }
/* 三颗气泡（3:603~605 实测 8/6/5 @66,10 @297,15 @212.5,5.5）*/
.bubble { position: absolute; border-radius: 30px; background-color: rgba(255,255,255,0.6); }
.b1 { width: 8px; height: 8px; left: 84px; top: 130px; }
.b2 { width: 6px; height: 6px; left: 315px; top: 135px; }
.b3 { width: 5px; height: 5px; left: 230px; top: 125px; }

.content { flex: 1; padding: 10px 18px 0; gap: 12px; }

/* ── 本周概览玻璃卡 ── */
.week-card {
  border-radius: 20px; padding: 16px; gap: 12px;
  background-color: rgba(255,255,255,0.74);
  border: 1px solid rgba(255,255,255,0.6);
  box-shadow: 0 6px 18px rgba(13,120,90,0.10);
}
.week-head { flex-direction: row; justify-content: space-between; align-items: center; }
.week-title { font-size: 15.5px; font-weight: 600; color: #0A4F3D; }
.week-badge { padding: 4px 9px; border-radius: 10px; background-color: #E2F7EE; }
.week-badge-text { font-size: 11px; font-weight: 600; color: #0A7A5C; }
.week-drops { flex-direction: row; justify-content: space-between; }
.drop { align-items: center; gap: 5px; }
/* 液滴 14×21（3:615 实测）：CSS 四值圆角近似水滴形 */
.drop-shape { width: 14px; height: 21px; border-radius: 7px 7px 10px 10px; }
.drop-shape.ok { background-color: #5BD3AC; }
.drop-shape.over { background-color: #FF9E7D; }
.drop-shape.empty { background-color: #D5E5DD; }
/* 今天：#1FBF8F 填充 + #0B7A5C 描边（3:639 实测），dropBob 浮动动画待加 */
.drop-shape.today { background-color: #1FBF8F; border: 1.5px solid #0A7A5C; }
.drop-day { font-size: 10px; color: #A9BAB3; }
.drop-day.today { font-weight: 600; color: #0A4F3D; }

/* ── 历史趋势 ── */
.trend { gap: 8px; }
.trend-title { font-size: 15.5px; font-weight: 600; color: #0A4F3D; }
.chart {
  height: 100px; flex-direction: row; align-items: flex-end;
  gap: 10px; padding: 0 2px; position: relative;
}
.bar { flex: 1; border-radius: 6px; }
.bar.ok { background-color: #CBD9D3; }
.bar.over { background-image: linear-gradient(180deg, #FFCAB5, #FF9E7D); }
.bar.empty { background-color: #E4F0EA; border-radius: 4px; }
.bar.today {
  background-image: linear-gradient(180deg, #7DEBC7, #1FBF8F);
  box-shadow: 0 4px 10px rgba(13,120,90,0.30);
}
.goal-line { position: absolute; left: 0; right: 0; top: 12px; height: 1.5px; background-color: #8FC5B2; }
.goal-tag {
  position: absolute; right: 2px; top: 0; padding: 2px 7px; border-radius: 8px;
  background-color: #FFFFFF;
}
.goal-tag-text { font-size: 9px; font-weight: 500; color: #4E6A60; }

.history { padding-top: 6px; }
.h-row { height: 44px; flex-direction: row; align-items: center; justify-content: space-between; }
.h-date { font-size: 13.5px; color: #7A8F88; }
.h-cal { flex-direction: row; align-items: center; gap: 3px; }
.h-val { font-size: 15.5px; font-weight: 700; color: #0A4F3D; font-variant-numeric: tabular-nums; }
.h-unit { font-size: 10px; color: #A9BAB3; }
.h-status { width: 52px; flex-direction: row; align-items: center; gap: 5px; }
.h-dot { width: 5px; height: 5px; border-radius: 3px; }
.dot-ok { background-color: #1FBF8F; }
.dot-over { background-color: #FF9E7D; }
.h-status-text { font-size: 12px; }
.t-ok { color: #7A8F88; }
.t-over { color: #E08A6B; }
.view-all { font-size: 12.5px; font-weight: 500; color: #0A7A5C; padding-top: 8px; }
</style>
