:host{display:flex;flex-direction:column}
.box{width:122px;height:171px;align-items:center}.stage{width:120px;height:168px;position:relative}.cap{position:absolute;left:44px;top:2px;width:32px;height:13px;border-radius:4px;background-color:#cfede2}.neck{position:absolute;left:52px;top:13px;width:16px;height:12px;background-color:rgba(255,255,255,.42)}.body{position:absolute;left:14px;top:24px;width:92px;height:140px;border-radius:18px;background-color:rgba(255,255,255,.42);border:1px solid rgba(255,255,255,.9);box-shadow:0 8px 20px rgba(13,120,90,.14)}.cavity{position:absolute;left:4px;top:4px;width:84px;height:132px;border-radius:15px;overflow:hidden}.liquid{position:absolute;left:0;top:0;width:84px;height:132px;background-image:linear-gradient(180deg,#7debc7,#1fbf8f 52%,#0d9c73);transition:transform 1.15s cubic-bezier(.22,1,.36,1)}.liquid.over{background-image:linear-gradient(180deg,#ffc9b4,#ff9e7d 60%,#f0835f)}.surface{position:absolute;left:0;top:0;width:84px;height:3px;background-color:rgba(255,255,255,.5);border-radius:2px}.hl-main{position:absolute;left:9px;top:14px;width:9px;height:92px;border-radius:4.5px;background-color:rgba(255,255,255,.55)}.hl-sub{position:absolute;left:78px;top:28px;width:4px;height:58px;border-radius:2px;background-color:rgba(255,255,255,.32)}