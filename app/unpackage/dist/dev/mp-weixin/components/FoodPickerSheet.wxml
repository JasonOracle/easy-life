<sheet-shell u-s="{{['d']}}" bindclose="{{h}}" u-i="600bf9ec-0" bind:__l="__l" id="{{g}}" virtualHostId="{{g}}" u-p="{{i||''}}" class="{{[j]}}" virtualHostClass="{{[j]}}" style="{{virtualHostStyle}}" virtualHostStyle="{{virtualHostStyle || ''}}" hidden="{{virtualHostHidden || false}}" virtualHostHidden="{{virtualHostHidden || false}}"><view class="body"><view class="search-bar"><view class="search-icon"/><input class="search-input" type="text" value="{{a}}" placeholder="搜索食物 · 支持拼音 / 别名" placeholder-style="color:#A9BAB3;font-size:13.5px" bindinput="{{b}}"/></view><scroll-view class="tabs-scroll" scroll-x show-scrollbar="{{false}}" enable-flex="true" enhanced="true"><view class="tabs"><view wx:for="{{c}}" wx:for-item="c" wx:key="c" class="{{['cat-tag', c.d]}}" bindtap="{{c.e}}"><text class="{{['cat-text', c.b]}}">{{c.a}}</text></view></view></scroll-view><scroll-view class="list-scroll" scroll-y enable-flex="true" enhanced="true"><view class="food-list"><view wx:for="{{d}}" wx:for-item="f" wx:key="f" class="food-item" bindtap="{{f.g}}"><image class="f-icon" src="{{f.a}}"/><view class="f-col"><text class="f-name">{{f.b}}</text><text class="f-conf">{{f.c}}</text></view><view class="f-cal"><text class="f-cal-val">{{f.d}}</text><text class="f-cal-unit">kcal/100{{f.e}}</text></view></view><view wx:if="{{e}}" class="empty"><text class="empty-text">没有找到「{{f}}」</text></view></view></scroll-view></view></sheet-shell>