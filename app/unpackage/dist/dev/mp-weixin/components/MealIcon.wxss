:host{display:flex;flex-direction:column}
.icon{width:42px;height:42px;border-radius:13px;position:relative}.icon.on{background-image:linear-gradient(180deg,#7debc7,#1fbf8f);border:1px solid rgba(255,255,255,.5)}.icon.off{background-color:#dce9e3;border:1px solid rgba(255,255,255,.6)}.ring{position:absolute;left:8.5px;top:8.5px;width:25px;height:25px;border-radius:13px;border:1.5px solid #FFFFFF}.l-dot{position:absolute;left:14.5px;top:14.5px;width:13px;height:13px;border-radius:7px;background-color:#fff}.moon{position:absolute;left:14px;top:9.5px;width:11.5px;height:23px;border-radius:6px;background-color:#fff}.star{position:absolute;left:13.5px;top:12.5px;width:3px;height:3px;border-radius:2px;background-color:rgba(255,255,255,.8)}.b-arc-top{position:absolute;left:14.5px;top:11.5px;width:13px;height:4.5px;border-top:1.5px solid #FFFFFF;border-radius:7px}.b-arc-mid{position:absolute;left:16.5px;top:18px;width:9px;height:4.5px;border-top:1.5px solid #FFFFFF;border-radius:5px}.b-line{position:absolute;left:12px;top:27px;width:18px;height:1.5px;background-color:#fff}.cookie{position:absolute;left:12.5px;top:12.5px;width:17px;height:17px;border-radius:9px;background-color:rgba(255,255,255,.9)}.chip{position:absolute;border-radius:2px;background-color:#8aa79c}.c1{left:16px;top:16.5px;width:3px;height:3px}.c2{left:22.8px;top:18.3px;width:2.4px;height:2.4px}.c3{left:18.1px;top:23.1px;width:2.8px;height:2.8px}.c4{left:24px;top:23px;width:2px;height:2px}