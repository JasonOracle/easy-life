:host{display:flex;flex-direction:column}
.body{gap:12px;height:460px}.search-bar{height:44px;border-radius:22px;flex-direction:row;align-items:center;gap:8px;padding:0 14px;background-color:#fff;border:1px solid #DCEDE6}.search-icon{width:14px;height:14px;border-radius:8px;border:1.5px solid rgba(15,79,61,.34)}.search-input{flex:1;font-size:13.5px;color:#0a4f3d}.tabs-scroll{width:100%}.tabs{flex-direction:row;gap:8px;padding:4px 0}.cat-tag{padding:6px 14px;border-radius:20px}.cat-tag.sel{background-color:#1fbf8f}.cat-tag.idle{background-color:#f8f9fc}.cat-text{font-size:12.5px}.t-sel{color:#fff;font-weight:500}.t-idle{color:rgba(15,79,61,.6)}.list-scroll{flex:1}.food-list{gap:2px}.food-item{flex-direction:row;align-items:center;gap:12px;padding:8px;border-radius:12px}.f-icon{width:40px;height:40px;border-radius:10px}.f-col{flex:1;gap:2px}.f-name{font-size:14px;font-weight:500;color:#0a4f3d}.f-conf{font-size:10px;color:#a9bab3}.f-cal{flex-direction:row;align-items:center;gap:3px}.f-cal-val{font-size:14px;font-weight:600;color:#0a7a5c;font-variant-numeric:tabular-nums}.f-cal-unit{font-size:10px;color:#a9bab3}.empty{padding:30px 0;align-items:center}.empty-text{font-size:13px;color:rgba(15,79,61,.34)}