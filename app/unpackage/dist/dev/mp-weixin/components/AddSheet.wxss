:host{display:flex;flex-direction:column}
.body{gap:13px}.cal-area{gap:4px;padding-top:10px;align-items:center}.cal-row{flex-direction:row;align-items:center;gap:8px}.cal-value{font-size:28px;font-weight:700;color:#0a4f3d;font-variant-numeric:tabular-nums}.cal-unit{font-size:13.5px;color:rgba(15,79,61,.6)}.cal-sub{font-size:12px;color:#7a8f88}.food-row{flex-direction:row;align-items:center;gap:10px;padding:10px 12px;border-radius:20px;background-color:#fff;border:1px solid #DCEDE6}.food-icon-wrap{width:40px;height:40px;border-radius:12px;background-image:linear-gradient(160deg,#eaf7f1,#dcf1e8);align-items:center;justify-content:center;overflow:hidden}.food-icon{width:40px;height:40px}.food-col{gap:2px;flex:1}.food-name{font-size:15px;font-weight:600;color:#0a4f3d}.food-spec{font-size:12.5px;color:#7a8f88}.sec{gap:8px}.sec-label{font-size:13.5px;font-weight:500;color:#7a8f88}.seg-row{flex-direction:row;gap:6px}.wrap-row{flex-wrap:wrap}.pill{flex:1;align-items:center;justify-content:center;gap:3px;padding:8px 6px;border-radius:11px}.pill.sel{background-color:rgba(31,191,143,.15);border:1px solid rgba(31,191,143,.4)}.pill.idle{background-color:rgba(120,140,130,.09)}.pill-text{font-size:12.5px;font-weight:500}.t-sel{font-weight:600;color:#0a7a5c}.t-idle{color:rgba(15,79,61,.6)}.sugar{flex-direction:row;gap:2px}.s-dot{width:5px;height:5px;border-radius:3px;background-color:#0e9c74}.sugar-none{width:9px;height:9px;border-radius:5px;border:1px dashed rgba(120,140,130,.45)}.confirm{height:52px;border-radius:26px;align-items:center;justify-content:center;background-image:linear-gradient(160deg,#7debc7,#1fbf8f);box-shadow:0 8px 18px rgba(13,120,90,.34)}.confirm-text{font-size:15.5px;font-weight:600;color:#fff}