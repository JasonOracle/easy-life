@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
.page{flex:1;background-color:#f2faf5}.status-bar{height:62px}.hero{height:218px;padding:0 18px;background-image:linear-gradient(180deg,#7debc7,#1fbf8f);position:relative;overflow:hidden}.avatar-row{flex-direction:row;align-items:center;gap:14px;padding:8px 0 18px}.avatar{width:62px;height:62px;border-radius:20px;background-color:#fff;border:2px solid #FFFFFF;align-items:center;justify-content:center}.avatar-char{font-size:26px;font-weight:700;color:#0a7a5c}.name-col{gap:4px}.name{font-size:17px;font-weight:600;color:#fff}.name-sub{font-size:12px;color:rgba(255,255,255,.82)}.stat-bar{height:64px;border-radius:18px;flex-direction:row;align-items:center;background-color:rgba(255,255,255,.92);border:1px solid #FFFFFF}.stat{flex:1;align-items:center;gap:2px}.stat-val{font-size:20px;font-weight:700;color:#0a4f3d;letter-spacing:-.5px;font-variant-numeric:tabular-nums}.stat-label{font-size:11px;color:rgba(15,79,61,.6)}.stat-divider{width:1px;height:30px;background-color:rgba(255,255,255,.9)}.wave{position:absolute;border-radius:50%;background-color:#f2faf5}.w1{width:260px;height:70px;left:-70px;bottom:-42px}.w2{width:300px;height:80px;right:-90px;bottom:-52px}.bubble{position:absolute;border-radius:30px;background-color:rgba(255,255,255,.6)}.b1{width:8px;height:8px;left:84px;top:130px}.b2{width:6px;height:6px;left:315px;top:135px}.b3{width:5px;height:5px;left:230px;top:125px}.content{flex:1;padding:10px 18px 0;gap:12px}.week-card{border-radius:20px;padding:16px;gap:12px;background-color:rgba(255,255,255,.74);border:1px solid rgba(255,255,255,.6);box-shadow:0 6px 18px rgba(13,120,90,.1)}.week-head{flex-direction:row;justify-content:space-between;align-items:center}.week-title{font-size:15.5px;font-weight:600;color:#0a4f3d}.week-badge{padding:4px 9px;border-radius:10px;background-color:#e2f7ee}.week-badge-text{font-size:11px;font-weight:600;color:#0a7a5c}.week-drops{flex-direction:row;justify-content:space-between}.drop{align-items:center;gap:5px}.drop-shape{width:14px;height:21px;border-radius:7px 7px 10px 10px}.drop-shape.ok{background-color:#5bd3ac}.drop-shape.over{background-color:#ff9e7d}.drop-shape.empty{background-color:#d5e5dd}.drop-shape.today{background-color:#1fbf8f;border:1.5px solid #0A7A5C}.drop-day{font-size:10px;color:#a9bab3}.drop-day.today{font-weight:600;color:#0a4f3d}.trend{gap:8px}.trend-title{font-size:15.5px;font-weight:600;color:#0a4f3d}.chart{height:100px;flex-direction:row;align-items:flex-end;gap:10px;padding:0 2px;position:relative}.bar{flex:1;border-radius:6px}.bar.ok{background-color:#cbd9d3}.bar.over{background-image:linear-gradient(180deg,#ffcab5,#ff9e7d)}.bar.empty{background-color:#e4f0ea;border-radius:4px}.bar.today{background-image:linear-gradient(180deg,#7debc7,#1fbf8f);box-shadow:0 4px 10px rgba(13,120,90,.3)}.goal-line{position:absolute;left:0;right:0;top:12px;height:1.5px;background-color:#8fc5b2}.goal-tag{position:absolute;right:2px;top:0;padding:2px 7px;border-radius:8px;background-color:#fff}.goal-tag-text{font-size:9px;font-weight:500;color:#4e6a60}.history{padding-top:6px}.h-row{height:44px;flex-direction:row;align-items:center;justify-content:space-between}.h-date{font-size:13.5px;color:#7a8f88}.h-cal{flex-direction:row;align-items:center;gap:3px}.h-val{font-size:15.5px;font-weight:700;color:#0a4f3d;font-variant-numeric:tabular-nums}.h-unit{font-size:10px;color:#a9bab3}.h-status{width:52px;flex-direction:row;align-items:center;gap:5px}.h-dot{width:5px;height:5px;border-radius:3px}.dot-ok{background-color:#1fbf8f}.dot-over{background-color:#ff9e7d}.h-status-text{font-size:12px}.t-ok{color:#7a8f88}.t-over{color:#e08a6b}.view-all{font-size:12.5px;font-weight:500;color:#0a7a5c;padding-top:8px}