@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page[class] {
  background-color: #F2FAF5;
  padding-bottom: 40px;
}
/* 常驻标题块导航栏（#28 方案A：Boss 拍板三端固定顶部，替代 P1 hm-st-mask 两态遮罩）：
   z45 全时段置顶，底色同页面底 #F2FAF5（非透明→无状态栏带穿透，也无需滚动阈值） */
.hm-nav[class] {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 45;
  background-color: #F2FAF5;
  padding-left: 17px;
  padding-right: 14px;
}
.hm-nav-inner[class] {
  position: relative;
  margin-top: 6px;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
}
.hm-nav-left[class] {
  flex-direction: column;
}
.title[class] {
  font-size: 24px;
  font-weight: bold;
  color: #0F5B44;
}
.subtitle[class] {
  font-size: 13px;
  color: #46706B;
  margin-top: 4px;
}
.fab[class] {
  position: absolute;
  width: 40px;
  height: 40px;
  border-radius: 20px;
  background-image: linear-gradient(180deg, #5CD9A6, #2EB889);
  justify-content: center;
  align-items: center;
  box-shadow: 0 5px 13px rgba(31, 140, 97, 0.28);
}
.fab-plus[class] {
  font-size: 20px;
  color: #FFFFFF;
}
/* 顶栏文档流带（随内容滚走）：仅剩日期行，paddingTop 避开常驻栏整高 */
.header[class] {
  padding-left: 17px;
  padding-right: 14px;
}
.date-row[class] {
  flex-direction: row;
  align-items: center;
  margin-top: 10px;
}
.date-icon[class] {
  width: 17px;
  height: 16px;
  margin-right: 4px;
}
.date-text[class] {
  font-size: 13px;
  color: #2F7E6E;
}
.hero[class] {
  position: relative;
  height: 235px;
  margin-top: -18px;
}
.hero-wave[class] {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 220px;
}
.bottle[class] {
  position: absolute;
  left: 4px;
  top: 33px;
  width: 178px;
  height: 192px;
}
.sticker[class] {
  position: absolute;
  right: 4px;
  top: 40px;
  width: 100px;
  height: 98px;
}
.hero-text[class] {
  position: absolute;
  left: 173px;
  bottom: 15px;
}
.remain-head[class] {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 110px;
}
.remain-leaf[class] {
  width: 19px;
  height: 18px;
}
.remain-label[class] {
  font-size: 19px;
  font-weight: bold;
  color: #0F5B44;
}
.remain-num-row[class] {
  flex-direction: row;
  align-items: flex-end;
}
.remain-num[class] {
  font-size: 52px;
  font-weight: bold;
  color: #0A5A40;
  line-height: 58px;
}
.remain-unit[class] {
  font-size: 19px;
  font-weight: bold;
  color: #0A5A40;
  margin-left: 6px;
  margin-bottom: 10px;
}
.consumed[class] {
  font-size: 13px;
  color: #618585;
  margin-top: 2px;
}
.goal-pill[class] {
  flex-direction: row;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 18px;
  padding-left: 14px;
  padding-right: 12px;
  height: 36px;
  margin-top: 8px;
  box-shadow: 0 3px 10px rgba(26, 102, 77, 0.08);
}
.pill-cal[class] {
  width: 16px;
  height: 14px;
}
.goal-pill-text[class] {
  font-size: 12px;
  color: #0B7954;
  margin-left: 12px;
}
.pill-edit[class] {
  width: 13px;
  height: 13px;
  margin-left: 10px;
}
.macro-card[class] {
  flex-direction: row;
  background-color: #FFFFFF;
  border-radius: 19px;
  margin-left: 14px;
  margin-right: 14px;
  margin-top: 6px;
  padding-top: 19px;
  padding-bottom: 14px;
  box-shadow: 0 5px 13px rgba(26, 102, 77, 0.07);
}
.macro-col[class] {
  flex: 1;
  align-items: center;
}
.macro-icon[class] {
  width: 27px;
  height: 21px;
}
.macro-num[class] {
  font-size: 21px;
  font-weight: bold;
  color: #0A5A40;
  margin-top: 2px;
}
.macro-label[class] {
  font-size: 12px;
  color: #73918B;
  margin-top: 4px;
}
.macro-div[class] {
  width: 1px;
  background-color: #E3F0EA;
  margin-top: 25px;
  margin-bottom: 25px;
}
.meal-section-head[class] {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-left: 17px;
  margin-right: 14px;
  margin-top: 19px;
}
.meal-section-title[class] {
  font-size: 17px;
  font-weight: bold;
  color: #0F5B44;
}
.all-records[class] {
  flex-direction: row;
  align-items: center;
}
.all-records-text[class] {
  font-size: 12px;
  color: #8FAEAF;
}
.chev-right[class] {
  width: 8px;
  height: 12px;
  margin-left: 4px;
}
.meal-block[class] {
  flex-direction: row;
  margin-left: 17px;
  margin-right: 14px;
  margin-top: 18px;
}
.meal-rail[class] {
  width: 42px;
  align-items: center;
}
.meal-circle[class] {
  width: 37px;
  height: 37px;
  border-radius: 19px;
  background-color: #29B385;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4px 10px rgba(31, 140, 97, 0.25);
}
.meal-circle-icon[class] {
  width: 27px;
  height: 25px;
}
.rail-line[class] {
  flex: 1;
  width: 2px;
  background-color: #BFE8D6;
  margin-top: 6px;
  margin-bottom: -18px;
}
.meal-main[class] {
  flex: 1;
  margin-left: 6px;
}
.meal-head[class] {
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
}
.meal-name[class] {
  font-size: 17px;
  font-weight: bold;
  color: #0F5B44;
}
.meal-time[class] {
  font-size: 16px;
  font-weight: normal;
  color: #8FAEAF;
}
.meal-kcal[class] {
  font-size: 17px;
  font-weight: bold;
  color: #0A5A40;
}
.meal-card[class] {
  background-color: #FFFFFF;
  border-radius: 16px;
  margin-top: 8px;
  padding-left: 10px;
  padding-right: 12px;
  padding-top: 2px;
  padding-bottom: 2px;
  box-shadow: 0 4px 11px rgba(26, 102, 77, 0.06);
}
.meal-row[class] {
  flex-direction: row;
  align-items: center;
  height: 40px;
}
.meal-thumb[class] {
  width: 37px;
  height: 37px;
  border-radius: 8px;
}
.meal-row-name[class] {
  font-size: 13px;
  color: #14584A;
  margin-left: 8px;
  margin-right: 10px;
}
.meal-row-portion[class] {
  flex: 1;
  font-size: 12px;
  color: #8FAEAF;
}
.meal-row-kcal[class] {
  width: 79px;
  font-size: 13px;
  color: #0B7954;
  text-align: right;
}
.meal-row-div[class] {
  height: 1px;
  background-color: #F0F5F2;
  margin-right: 18px;
}
.meal-expand[class] {
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 8px;
}
.expand-btn[class] {
  width: 29px;
  height: 29px;
  border-radius: 15px;
  background-color: #FFFFFF;
  justify-content: center;
  align-items: center;
  box-shadow: 0 3px 8px rgba(26, 102, 77, 0.08);
}
.chev-down[class] {
  width: 10px;
  height: 13px;
}