@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
.page{flex:1;background-color:#f2faf5}.status-bar{height:62px}.content{flex:1;padding:0 18px 8px;gap:9px}.header{flex-direction:row;justify-content:space-between;align-items:center}.header-left{gap:1px}.app-name{font-size:17px;font-weight:600;color:#0a4f3d;letter-spacing:-.2px}.date{font-size:12.5px;color:rgba(15,79,61,.6)}.add-entry{width:44px;height:44px;align-items:center;justify-content:center}.add-entry-btn{width:30px;height:30px;border-radius:15px;background-color:#1fbf8f;align-items:center;justify-content:center;box-shadow:0 4px 10px rgba(13,120,90,.3)}.add-entry-text{font-size:18px;font-weight:600;color:#fff}.bottle-wrap{align-items:center;padding:6px 0}.number-area{align-items:center;gap:2px}.num-label{font-size:12px;font-weight:600;color:#0a7a5c}.num-row{flex-direction:row;align-items:center;gap:6px}.num-value{font-size:46px;font-weight:700;color:#0a4f3d;letter-spacing:-1.6px;font-variant-numeric:tabular-nums}.num-edit{font-size:15px;color:rgba(15,79,61,.6)}.num-sub{font-size:13.5px;color:rgba(15,79,61,.6);font-variant-numeric:tabular-nums}.nutrient-card{flex-direction:row;align-items:center;padding:14px;border-radius:20px;background-color:rgba(255,255,255,.74);border:1px solid rgba(255,255,255,.6);box-shadow:0 6px 18px rgba(13,120,90,.1)}.n-item{flex:1;align-items:center;gap:3px}.n-value{font-size:17px;font-weight:700;color:#0a4f3d;font-variant-numeric:tabular-nums}.n-name{font-size:11px;color:rgba(15,79,61,.6)}.n-divider{width:1px;height:32px;background-color:#e3f0ea}.meal-section{gap:8px}.meal-list{position:relative;gap:8px}.timeline-line{position:absolute;left:20.25px;top:42px;width:1.5px;height:164px;background-color:#cbd9d3}.meal-row{flex-direction:row;gap:12px}.meal-info{flex:1}.meal-name-row{height:40px;flex-direction:row;justify-content:space-between;align-items:center}.meal-name{font-size:15.5px;font-weight:600;color:#0a4f3d}.meal-cal{font-size:13.5px;font-weight:600;color:#0a7a5c;font-variant-numeric:tabular-nums}.meal-cal-idle{font-size:12.5px;color:#a9bab3}.meal-detail{gap:6px;padding:2px 0 0 2px}.food-row{flex-direction:row;align-items:center;gap:8px}.food-thumb{width:28px;height:28px;border-radius:8px;background-image:linear-gradient(160deg,#e8f7f1,#d8efe6);align-items:center;justify-content:center;overflow:hidden}.food-thumb-img{width:28px;height:28px}.food-name{font-size:13px;color:#0a4f3d;max-width:96px;overflow:hidden;text-overflow:ellipsis;lines:1}.food-amount{font-size:11.5px;color:#a9bab3}.food-time{flex:1;text-align:right;font-size:11px;color:#a9bab3;font-variant-numeric:tabular-nums}.food-kcal{font-size:12.5px;font-weight:600;color:#0a7a5c;font-variant-numeric:tabular-nums}