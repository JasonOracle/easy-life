@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
.page{flex:1;background-color:#f2faf5}.status-bar{height:62px}.hero{height:128px;padding:0 18px;background-image:linear-gradient(180deg,#7debc7,#1fbf8f);position:relative;overflow:hidden}.hero-row{flex-direction:row;align-items:center;gap:10px}.back-btn{width:34px;height:34px;border-radius:17px;background-color:#fff;border:1px solid #FFFFFF;align-items:center;justify-content:center}.back-icon{font-size:20px;color:#0a4f3d}.hero-title{font-size:17px;font-weight:600;color:#fff}.wave{position:absolute;border-radius:50%;background-color:#f2faf5}.w1{width:240px;height:60px;left:-60px;bottom:-36px}.w2{width:280px;height:70px;right:-80px;bottom:-44px}.bubble{position:absolute;border-radius:20px;background-color:rgba(255,255,255,.6)}.b1{width:7px;height:7px;left:104px;top:42px}.b2{width:5px;height:5px;left:295px;top:45px}.content{flex:1;padding:8px 18px 18px;gap:14px}.group{gap:8px}.group-title{font-size:12px;font-weight:600;color:rgba(15,79,61,.6);letter-spacing:.5px}.card{border-radius:20px;background-color:rgba(255,255,255,.74);border:1px solid rgba(255,255,255,.6);box-shadow:0 4px 14px rgba(13,120,90,.08)}.card.danger{background-color:#fff;border:1px solid #F5D5C8;box-shadow:0 4px 14px rgba(224,99,60,.08)}.row{flex-direction:row;align-items:center;gap:13px;padding:14px 16px}.icon-base{width:28px;height:28px;border-radius:14px;align-items:center;justify-content:center}.base-normal{background-color:rgba(31,191,143,.11)}.base-danger{background-color:rgba(255,158,125,.17)}.glyph{width:10px;height:10px;border-radius:5px;background-color:#0a7a5c}.g-danger{background-color:#e0633c}.row-text{flex:1;gap:2px}.row-name{font-size:14px;font-weight:500;color:#0a4f3d}.t-danger{color:#e0633c}.row-sub{font-size:11.5px;color:rgba(15,79,61,.34)}.arrow{font-size:16px;color:rgba(15,79,61,.34)}.a-danger{color:#e0633c}.toggle{width:46px;height:28px;border-radius:14px;position:relative}.toggle.on{background-image:linear-gradient(180deg,#7debc7,#1fbf8f)}.toggle.off{background-color:rgba(120,140,130,.25)}.toggle.td{opacity:.45}.knob{width:24px;height:24px;border-radius:12px;background-color:#fff;position:absolute;top:2px}.k-right{right:2px}.k-left{left:2px}.footer{gap:3px;padding-top:4px}.footer-text{font-size:11px;font-weight:500;color:#a9bab3}.footer-sub{font-size:10.5px;color:#c2d4cc}